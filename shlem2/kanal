def log(*a):
    print(time.strftime('%H:%M:%S'), 'kanal:', *a, flush=True)


def prochest(put):
    try:
        return open(put).read().strip()
    except OSError:
        return ''


def zapisat(put, d, sekret=False):
    os.makedirs(os.path.dirname(put), exist_ok=True)
    old = os.umask(0o077) if sekret else None
    try:
        tmp = put + '.tmp'
        with open(tmp, 'w') as f:
            json.dump(d, f, ensure_ascii=False)
        os.replace(tmp, put)
    finally:
        if old is not None:
            os.umask(old)


def chitat(put, inache=None):
    try:
        return json.load(open(put))
    except (OSError, ValueError):
        return {} if inache is None else inache


def most(path, timeout=5):
    try:
        with urllib.request.urlopen(MOST + path, timeout=timeout) as r:
            return json.loads(r.read().decode('utf-8', 'replace') or '{}')
    except Exception:
        return {}


