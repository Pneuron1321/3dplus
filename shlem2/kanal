    def sobrat_uroki(self, novye):
        I = None
        for m in novye:
            g = IDEYA_RE.match(m['tekst'])
            if g and len(g.group(1).strip()) >= 8:
                I = I if I is not None else chitat(os.path.join(PAPKA, 'idei-zriteley.json'), [])
                I.append({'kto': m['kto'], 'pl': m['pl'], 'tekst': g.group(1).strip()[:300], 'data': time.strftime('%Y-%m-%d')})
        if I is not None:
            zapisat(os.path.join(PAPKA, 'idei-zriteley.json'), I[-50:])
        L = None
        for m in novye:
            g = UROK_RE.match(m['tekst'])
            if g and len(g.group(1).strip()) >= 6:
                L = L if L is not None else chitat(os.path.join(PAPKA, 'uroki.json'), [])
                L.append({'kto': m['kto'], 'pl': m['pl'], 'tekst': g.group(1).strip()[:200],
                          'data': time.strftime('%Y-%m-%d')})
        if L is not None:
            zapisat(os.path.join(PAPKA, 'uroki.json'), L[-30:])


