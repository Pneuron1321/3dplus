            self.poz = 0

    def novye(self):
        try:
            razmer = os.path.getsize(CHAT_LOG)
        except OSError:
            return []
        if razmer < self.poz:
            self.poz = 0
        if razmer == self.poz:
            return []
        with open(CHAT_LOG, 'rb') as f:
            f.seek(self.poz)
            kusok = f.read(razmer - self.poz)
        self.poz = razmer
        out = []
        for l in kusok.decode('utf-8', 'replace').splitlines():
            m = STROKA.match(l.strip())
            if m:
                out.append({'kto': m.group(2), 'pl': {'Kick': 'kick', 'YouTube': 'yt'}.get(m.group(3), 'tw'),
                            'tekst': m.group(4)[:200]})
        return out


