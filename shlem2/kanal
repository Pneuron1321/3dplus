        z = {'t': round(time.time()), 'kto': kto, 'model': model, 'effort': effort or '',
             'in': u.get('input_tokens', 0), 'out': u.get('output_tokens', 0),
             'cache_read': u.get('cache_read_input_tokens', 0), 'cache_new': u.get('cache_creation_input_tokens', 0),
             'usd': d.get('total_cost_usd', 0), 'ms': d.get('duration_ms', 0)}
        with open(UCHET_MODELEY, 'a') as f:
            f.write(json.dumps(z) + '\n')
    except Exception:
