def haiku(sistema, zapros_, model='haiku', timeout=120, effort=None):
    os.makedirs(PAPKA, exist_ok=True)
    env = dict(os.environ, CLAUDE_CODE_DISABLE_CLAUDE_MDS='1', CLAUDE_CODE_DISABLE_AUTO_MEMORY='1', GOLOS_RACIYA='1')
    cmd = [CLAUDE, '-p', '--model', model] + (['--effort', effort] if effort else []) + ['--tools', '', '--no-session-persistence',
           '--settings', '{"disableAllHooks":true}', '--output-format', 'json', '--system-prompt', sistema, zapros_]
    try:
        r = subprocess.run(cmd, cwd=PAPKA, env=env, capture_output=True, text=True, timeout=timeout)
        uchet('kanal:' + ('idei' if sistema.startswith(ZADANIE_IDEI) else 'kritik' if sistema is ZADANIE_KRITIK
                          else model), model, effort, r.stdout)
        t = json.loads(r.stdout).get('result', '')
        m = re.search(r'\{.*\}', t, re.S)
        return json.loads(m.group(0)) if m else None
    except Exception as e:
        log('модель не ответила:', type(e).__name__, str(e)[:80])
        return None


STROKA = re.compile(r'^(\d\d:\d\d) ([\w-]{1,25})(?: \((Kick|YouTube)\))?: (.*)$')


class Chat:
