class SchetEfira:
    """Счёт эфира (05.11, план карьеры): после каждого эфира — сколько пришло, новых, вернувшихся, писали в чат,
    подписались, пик зрителей. Видны: кто писал в чат (все площадки) и кто зашёл в Twitch со входом (JOIN);
    молчащие зрители Kick и YouTube — только в пике. Реестр «кого видели» — /root/.kanal/videli.json."""
    def __init__(self):
        self.t0 = None
        self.net_s = None
        self.prishli, self.pisali, self.follow, self.pik = set(), set(), 0, 0
        try:
            self.poz = os.path.getsize(ZRITELI_SOB)
        except OSError:
            self.poz = 0
        self.posl_pik = 0.0

    @staticmethod
    def kto(pl, nik):
        nik = re.sub(r'[^\w-]', '', (nik or '').lower())[:30]
        return '%s__%s' % (pl, nik) if nik else None

    def chuzhoy(self, nik):
        n = (nik or '').lower()
        return not n or n in svoi() or BOT_IMYA.search(n) is not None

    def zhoiny(self):
        try:
            razmer = os.path.getsize(ZRITELI_SOB)
        except OSError:
            return []
        if razmer < self.poz:
            self.poz = 0
        if razmer == self.poz:
            return []
        with open(ZRITELI_SOB, errors='replace') as f:
            f.seek(self.poz)
            stroki = f.readlines()
            self.poz = f.tell()
        out = []
        for l in stroki:
            try:
                e = json.loads(l)
            except ValueError:
                continue
            if e.get('chto') == 'join':
                out.append(str(e.get('kto', '')))
        return out

    def shag(self, efir, novye, now=None):
        now = now or time.time()
        zh = self.zhoiny()
        if efir:
            self.net_s = None
            if self.t0 is None:
                self.t0 = now
                self.prishli, self.pisali, self.follow, self.pik = set(), set(), 0, 0
                self.dnt = now
            for m in novye:
                if not self.chuzhoy(m.get('kto')):
                    k = self.kto(m.get('pl', 'tw'), m['kto'])
                    if k:
                        self.prishli.add(k)
                        self.pisali.add(k)
            for n in zh:
                if not self.chuzhoy(n):
                    k = self.kto('tw', n)
                    if k:
                        self.prishli.add(k)
            if now - self.posl_pik >= 60 * SEK:
                self.posl_pik = now
                try:
                    d = most('/schet')
                    self.pik = max(self.pik, int(d.get('zriteli_vsego') or 0))
                except (TypeError, ValueError):
                    pass
            return None
        if self.t0 is None:
            return None
        if self.net_s is None:
            self.net_s = now
        if now - self.net_s < SCHET_KONEC * SEK:
            return None
        return self.zakryt(self.net_s)

    def follovery(self, ot, do):
        n = 0
        try:
            for l in open(E('KANAL_DONATY', '/tmp/donaty.jsonl'), errors='replace'):
                try:
                    d = json.loads(l)
                except ValueError:
                    continue
                if d.get('istochnik') == 'follow' and ot <= d.get('t', 0) <= do:
                    n += 1
        except OSError:
            pass
        return n

    def zakryt(self, konec):
        t0, self.t0, self.net_s = self.t0, None, None
        dlit = konec - t0
        if dlit < SCHET_MIN * SEK:
            return None
        put = os.path.join(PAPKA, 'videli.json')
        videli = chitat(put)
        den = time.strftime('%Y-%m-%d', time.localtime(t0))
        novye = sorted(k for k in self.prishli if k not in videli)
        vernulis = sorted(k for k in self.prishli if k in videli and videli[k].get('posl') != den)
        for k in self.prishli:
            v = videli.setdefault(k, {'pervyy': den, 'efirov': 0})
            if v.get('posl') != den:
                v['efirov'] = v.get('efirov', 0) + 1
            v['posl'] = den
        zapisat(put, videli)
        z = {'t0': round(t0), 'den': den, 'minut': int(dlit // 60), 'prishli': len(self.prishli), 'novye': len(novye),
             'vernulis': len(vernulis), 'pisali': len(self.pisali), 'podpisalis': self.follovery(t0, konec),
             'pik': self.pik, 'vernulis_kto': vernulis[:20]}
        with open(os.path.join(PAPKA, 'schet-efirov.jsonl'), 'a') as f:
            f.write(json.dumps(z, ensure_ascii=False) + '\n')
        v_uho('Итог эфира: %d минут; пришло %d, новых %d, вернулись %d, писали %d, подписались %d, пик зрителей %d.' % (
            z['minut'], z['prishli'], z['novye'], z['vernulis'], z['pisali'], z['podpisalis'], z['pik']))
        log('счёт эфира:', z)
        return z


