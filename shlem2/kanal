        v_uho(tekst)
        return
    fraza = 'Саш, идея %d: %s' % (nomer, tekst.strip())
    try:
        os.makedirs(G_Q, exist_ok=True)
        put = '%s/%d.vedu' % (G_Q, time.time_ns())
        with open(put + '.tmp', 'w') as f:
            f.write(fraza)
        os.replace(put + '.tmp', put)
        os.makedirs(os.path.dirname(VED_DIALOG), exist_ok=True)
        with open(VED_DIALOG, 'a') as f:
            f.write(json.dumps({'t': round(time.time(), 1), 'rol': 'ved', 'komu': 'alex', 'tekst': fraza, 'ru': fraza,
                                'vid': 'ideya', 'ideya': nomer}, ensure_ascii=False) + '\n')
