# ---------- запросы ----------

def zapros(metod, url, tok=None, dannye=None, zag=None, forma=False):
    """(код, JSON). Токен — только в заголовок."""
    h = {'User-Agent': UA}
    if tok:
        h['Authorization'] = 'Bearer ' + tok
    h.update(zag or {})
    telo = None
    if dannye is not None:
        if forma:
            telo = urllib.parse.urlencode(dannye).encode()
        else:
            telo = json.dumps(dannye).encode()
            h['Content-Type'] = 'application/json'
    try:
        with urllib.request.urlopen(urllib.request.Request(url, data=telo, method=metod, headers=h), timeout=20) as r:
            b = r.read()
            return r.status, (json.loads(b) if b.strip() else {})
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.loads(e.read() or b'{}')
        except ValueError:
            return e.code, {}


class Twitch:
    """Вход пользователя (12 разрешений, twitch_vhod.py): токен обновляется сам по refresh_token."""
    def __init__(self):
        self.ya = None

    @property
    def cid(self):
        return prochest(TW_APP_ID)

    def est(self):
        return bool(self.cid and prochest(TW_USER))

    def tok(self, novyy=False):
        t = chitat(TW_USER)
        if novyy and t.get('refresh_token'):
            s, n = zapros('POST', TW_TOKEN_URL, dannye={'client_id': self.cid, 'client_secret': prochest(TW_APP_SECRET),
                                                         'grant_type': 'refresh_token',
                                                         'refresh_token': t['refresh_token']}, forma=True)
            if s == 200 and n.get('access_token'):
                zapisat(TW_USER, n, sekret=True)
                t = n
        return t.get('access_token', '')

    def api(self, metod, put, dannye=None):
        for popytka in (0, 1):
            s, d = zapros(metod, HELIX + put, self.tok(popytka == 1), dannye, {'Client-Id': self.cid})
            if s != 401:
                return s, d
        return s, d

    def moy_id(self):
        if not self.ya:
            s, d = self.api('GET', '/users')
            self.ya = ((d.get('data') or [{}])[0]).get('id') if s == 200 else None
        return self.ya

    def kanal(self):
        s, d = self.api('GET', '/channels?broadcaster_id=%s' % self.moy_id())
        return (d.get('data') or [{}])[0] if s == 200 else {}

    def kat(self, igra):
        s, d = self.api('GET', '/search/categories?first=5&query=' + urllib.parse.quote(igra))
        L = d.get('data') or []
        if not L:
            return None
        g = next((x for x in L if x['name'].lower() == igra.lower()), L[0])
        s, _ = self.api('PATCH', '/channels?broadcaster_id=%s' % self.moy_id(), {'game_id': g['id']})
        return g['name'] if s in (200, 204) else None

    def nazvanie(self, t):
        s, _ = self.api('PATCH', '/channels?broadcaster_id=%s' % self.moy_id(), {'title': t[:140]})
        return s in (200, 204)

    def chat(self, t):
        ya = self.moy_id()
        s, d = self.api('POST', '/chat/messages', {'broadcaster_id': ya, 'sender_id': ya, 'message': t[:480]})
        return s == 200 and ((d.get('data') or [{}])[0]).get('is_sent', True)

    def obyavlenie(self, t):
        ya = self.moy_id()
        s, _ = self.api('POST', '/chat/announcements?broadcaster_id=%s&moderator_id=%s' % (ya, ya),
                        {'message': t[:480], 'color': 'purple'})
        return s in (200, 204)

    def klip(self):
        s, d = self.api('POST', '/clips?broadcaster_id=%s' % self.moy_id())
        kid = ((d.get('data') or [{}])[0]).get('id') if s in (200, 202) else None
        return ('https://clips.twitch.tv/' + kid) if kid else None

    def follovery(self):
        s, d = self.api('GET', '/channels/followers?first=20&broadcaster_id=%s' % self.moy_id())
        return (d.get('data') or [], d.get('total')) if s == 200 else (None, None)

    def nagrady(self):
        s, d = self.api('GET', '/channel_points/custom_rewards?only_manageable_rewards=true&broadcaster_id=%s'
                        % self.moy_id())
        return (d.get('data') or []) if s == 200 else []

    def nagrada(self, imya, cena, chto=''):
        s, d = self.api('POST', '/channel_points/custom_rewards?broadcaster_id=%s' % self.moy_id(),
                        {'title': imya[:45], 'cost': int(cena), 'prompt': chto[:200], 'is_enabled': True})
        return s == 200

    def zakazy(self, nagrada_id):
        s, d = self.api('GET', '/channel_points/custom_rewards/redemptions?status=UNFULFILLED&first=20'
                               '&broadcaster_id=%s&reward_id=%s' % (self.moy_id(), nagrada_id))
        return (d.get('data') or []) if s == 200 else []

    def vypolnen(self, nagrada_id, zid):
        self.api('PATCH', '/channel_points/custom_rewards/redemptions?broadcaster_id=%s&reward_id=%s&id=%s'
                 % (self.moy_id(), nagrada_id, zid), {'status': 'FULFILLED'})


class Kick:
    """Вход OAuth 2.1 + PKCE (kick_vhod.py): user:read channel:read channel:write chat:write."""
    def est(self):
        return bool(prochest(KICK_APP_ID) and prochest(KICK_USER))

    def tok(self, novyy=False):
        t = chitat(KICK_USER)
        if novyy and t.get('refresh_token'):
            s, n = zapros('POST', KICK_TOKEN_URL, dannye={'grant_type': 'refresh_token', 'client_id': prochest(KICK_APP_ID),
                                                           'client_secret': prochest(KICK_APP_SECRET),
                                                           'refresh_token': t['refresh_token']}, forma=True)
            if s == 200 and n.get('access_token'):
                zapisat(KICK_USER, n, sekret=True)
                t = n
        return t.get('access_token', '')

    def api(self, metod, put, dannye=None):
        for popytka in (0, 1):
            s, d = zapros(metod, KICK_API + put, self.tok(popytka == 1), dannye)
            if s != 401:
                return s, d
        return s, d

    def kanal(self):
        s, d = self.api('GET', 'channels')
        return (d.get('data') or [{}])[0] if s == 200 else {}

    def kat(self, igra):
        s, d = self.api('GET', 'categories?q=' + urllib.parse.quote(igra))
        L = d.get('data') or []
        if not L:
            return None
        g = next((x for x in L if x['name'].lower() == igra.lower()), L[0])
        s, _ = self.api('PATCH', 'channels', {'category_id': g['id']})
        return g['name'] if s in (200, 204) else None

    def nazvanie(self, t):
        s, _ = self.api('PATCH', 'channels', {'stream_title': t[:140]})
        return s in (200, 204)

    def chat(self, t):
        s, _ = self.api('POST', 'chat', {'type': 'bot', 'content': t[:480]})
        return s in (200, 201)


