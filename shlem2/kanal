def dni():
    return chitat(os.path.join(PAPKA, 'dni.json')) or dict(DNI_SVOI)


def den(pl, segodnya=None):
    """День эфиров на площадке: от записанного дня растёт по календарю (в полночь — следующий)."""
    d = dni().get(pl)
    if not d:
        return None
    segodnya = segodnya or time.strftime('%Y-%m-%d')
    t0 = time.mktime(time.strptime(d['data'], '%Y-%m-%d'))
    t1 = time.mktime(time.strptime(segodnya, '%Y-%m-%d'))
    return int(d['n']) + int(round((t1 - t0) / 86400))


def tablo(pl, igra):
    """«Day 21 · GTA San Andreas · $434/$700» — без дня и цели — то, что есть."""
    chasti = []
    n = den(pl)
    if n:
        chasti.append('Day %d' % n)
    if igra:
        chasti.append(igra)
    cel = most('/cel')
    if cel.get('vidna') and cel.get('tekst'):
        chasti.append(cel['tekst'].replace(' / ', '/'))
    return ' · '.join(chasti)


