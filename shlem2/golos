def iz_transkripta(raw, hvost=262144):
    """JSON хука PreToolUse → текст, который Плюс написал перед этим
    инструментом («Сейчас посмотрю…»): последняя запись ассистента с текстом
    в хвосте журнала разговора. Хук Stop говорит только последний ответ —
    без этого вступление не звучало вовсе, а теперь звучит, пока работает
    инструмент. Вернёт (id сообщения, текст)."""
    try:
        put = json.loads(raw).get('transcript_path') or ''
        with open(put, 'rb') as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - hvost))
            lines = f.read().decode('utf-8', 'replace').splitlines()
    except (ValueError, OSError):
        return None, ''
    for line in reversed(lines):
        try:
            z = json.loads(line)
        except ValueError:
            continue
        if z.get('type') == 'user' and isinstance((z.get('message') or {}).get('content'), str):
            break                                 # дошли до реплики Александра
        if z.get('type') != 'assistant':
            continue
        m = z.get('message') or {}
        t = ' '.join(x.get('text', '') for x in m.get('content') or []
                     if isinstance(x, dict) and x.get('type') == 'text').strip()
        if t:
            return m.get('id') or z.get('uuid'), t
    return None, ''


# ---------- синтез ----------

class Sintez:
    """edge-tts в этом же процессе: без запуска Python на каждый кусок.
    Модуля нет — зовём программу edge-tts (медленнее, но говорит)."""

    def __init__(self):
        try:
            import asyncio
            import edge_tts
            self.asyncio, self.mod = asyncio, edge_tts
        except ImportError:
            self.mod = None
        self.exe = shutil.which('edge-tts')
        self.tl = threading.local()      # границы фраз последнего синтеза — своему потоку

    @property
    def metki(self):
        """Границы фраз (или слов) последнего синтеза этого потока: [(с, длительность, текст)]."""
        return getattr(self.tl, 'metki', None)

    def __call__(self, tekst, temp, put):
        """True — звук готов. None — сказать нечего: edge-tts не вернул звука (одни знаки, смайлы),
        сеть ни при чём. False — не вышел и со второй попытки (11.10: «голос без сети» звучал перед
        нормальным ответом — сбой одного куска при живой сети; теперь он пробуется ещё раз)."""
        tmp = put + '.tmp'
        self.tl.metki = None
        for popytka in (1, 2):
            try:
                if self.mod:
                    metki = []

                    async def go():
                        c = self.mod.Communicate(tekst, VOICE, rate=temp)
                        with open(tmp, 'wb') as f:
                            async for ch in c.stream():
                                if ch['type'] == 'audio':
                                    f.write(ch['data'])
                                elif ch['type'] in ('SentenceBoundary', 'WordBoundary'):
                                    metki.append((ch.get('offset', 0) / 1e7, ch.get('duration', 0) / 1e7,
                                                  ch.get('text', '')))
                    self.asyncio.run(go())
                    self.tl.metki = metki or None
                elif self.exe:
                    subprocess.run([self.exe, '--voice', VOICE, '--rate=' + temp, '--text', tekst,
                                    '--write-media', tmp], stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL, timeout=30)
                if os.path.getsize(tmp) > 0:
                    os.replace(tmp, put)
                    return True
            except Exception as e:
                if type(e).__name__ == 'NoAudioReceived':
                    log('нечего сказать: edge-tts не вернул звука')
                    self.ubrat(tmp)
                    return None
                log('синтез не вышел (попытка %d):' % popytka, type(e).__name__, str(e)[:120])
            if popytka == 1:
                time.sleep(0.3)
        self.ubrat(tmp)
        return False

    @staticmethod
    def ubrat(tmp):
        try:
            os.remove(tmp)
        except OSError:
            pass


# ---------- проигрыватели ----------

class Titry:
    """Субтитры ответа Плюса в эфире (12.10, этап 1): перевод — один на ответ (titr.perevod_mnogo),
    в фоне, пока синтезируется первая порция; показ — по предложению в его время звучания, с
    переводом, если он уже готов (не готов — одним рядом, как сказано). Без эфира — ни перевода,
    ни показа. Остановили, пауза, «тихо» — несказанное не показываем."""

    def __init__(self, modul):
        self.m = modul
        self.cv = threading.Condition()
        self.plan = []               # (когда, поколение, текст, uid, сек)
        self.gen = 0
        self.perevody = {}           # uid → {предложение: перевод}
        self.efir_t, self.efir = 0.0, False
        if self.m:
            threading.Thread(target=self.run, daemon=True).start()

    def efir_idyot(self):
        if time.time() - self.efir_t > 10:
            try:
                self.efir = bool(self.m.efir_idyot())
            except Exception:
                self.efir = False
            self.efir_t = time.time()
        return self.efir

    def perevesti(self, uid, frazy):
        if not self.m or not frazy or not self.efir_idyot():
            return
        with self.cv:
            if uid in self.perevody:
                return
            self.perevody[uid] = {}
            for u in list(self.perevody)[:-30]:       # старые ответы — забыть
                del self.perevody[u]

        def idti():
            try:
                res = self.m.perevod_mnogo(frazy)
            except Exception as e:
                log('перевод не вышел:', type(e).__name__, e)
                return
            with self.cv:
                if uid in self.perevody:
                    self.perevody[uid] = {f: p for f, p in zip(frazy, res) if p}
        threading.Thread(target=idti, daemon=True).start()

    def pokazat(self, k, t0, nachala, dlit):
        """Порция зазвучала: каждое предложение — субтитром в его время."""
        if not self.m or not self.efir_idyot():
            return
        with self.cv:
            for j, f in enumerate(k.predl):
                konec = nachala[j + 1] if j + 1 < len(nachala) else dlit
                heapq.heappush(self.plan, (t0 + nachala[j], self.gen, f, k.uid, max(1.0, konec - nachala[j]) + 0.8))
            self.cv.notify_all()

    def otmena(self):
        with self.cv:
            self.gen += 1
            self.plan = []
            self.cv.notify_all()

    def run(self):
        while True:
            with self.cv:
                while not self.plan or self.plan[0][0] > time.time():
                    self.cv.wait(None if not self.plan else max(0.01, self.plan[0][0] - time.time()))
                kogda, gen, f, uid, sek = heapq.heappop(self.plan)
                if gen != self.gen:
                    continue
                p = self.perevody.get(uid, {}).get(f)
            try:
                self.m.subtitr('plus', f, p, sek)
            except Exception as e:
                log('субтитр не вышел:', type(e).__name__, e)


class Rot:
    """Рот лица Плюса в эфире (приложение 2.2.6): play-audio Termux приложение не слышит —
    говорим ему сами: «звучу N с» (GET /say/rot?sek=N) и «замолчала» (sek=0). Один поток с
    очередью: «замолчала» прежнего куска не обгонит «звучу» следующего. Приложения нет — молча.
    Тем же потоком — «договорила ответ, слушай секунду» (/ear/dosluh, 2.3.1): после «замолчала»."""
    q = queue.Queue()
    potok = None
    lock = threading.Lock()

    @classmethod
    def skazat(cls, sek):
        with cls.lock:
            if cls.potok is None:
                cls.potok = threading.Thread(target=cls.run, daemon=True)
                cls.potok.start()
        cls.q.put(sek)

    @classmethod
    def dosluh(cls):
        cls.skazat('/ear/dosluh')

    @classmethod
    def run(cls):
        while True:
            sek = cls.q.get()
            put = sek if isinstance(sek, str) else '/say/rot?sek=%.1f' % sek
            try:
                urllib.request.urlopen(MOST + put, timeout=1).read()
            except Exception:
                pass


class Termux:
    """play-audio Termux: звук идёт в общий микс — его пишет и стрим."""

    def __init__(self, put):
        self.t0 = time.time()
        self.p = subprocess.Popen([PLAY, put], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        try:                               # edge-tts: 48 кбит/с — 6000 байт на секунду звука
            dl = os.path.getsize(put) / 6000.0
        except OSError:
            dl = 5.0
        self.rot = True
        Rot.skazat(min(60.0, dl + 1.5))    # запас: «замолчала» потеряется — рот встанет сам

    def molchu(self):
        if self.rot:
            self.rot = False
            Rot.skazat(0)

    def konec(self):
        if self.p.poll() is None:
            return None
        self.molchu()
        return 'done'                      # код play-audio не важен: дальше

    def stop(self):
        if self.p.poll() is None:
            self.p.terminate()
            try:
                self.p.wait(2)
            except subprocess.TimeoutExpired:
                self.p.kill()
        self.molchu()


class Most:
    """Играет приложение-мост (POST /say): «uho» — звук помечен «не записывать»,
    захват стрима его пропускает. Ответ приходит, когда кусок доиграл."""

    def __init__(self, put, rezhim):
        self.res, self.err = None, ''
        self.t0 = time.time()
        threading.Thread(target=self.run, args=(put, rezhim), daemon=True).start()

    def run(self, put, rezhim):
        try:
            req = urllib.request.Request('%s/say?mode=%s' % (MOST, rezhim), data=open(put, 'rb').read(),
                                         method='POST', headers={'Content-Type': 'audio/mpeg'})
            with urllib.request.urlopen(req, timeout=180) as r:
                self.res = json.loads(r.read().decode() or '{}').get('end', 'done')
        except Exception as e:
            self.err = '%s %s' % (type(e).__name__, str(e)[:80])
            self.res = 'error'

    def konec(self):
        return self.res

    def stop(self):
        try:
            urllib.request.urlopen(MOST + '/say/stop', timeout=2).read()
        except Exception:
            pass


def most_umeet():
    """Мост умеет играть (/say/status) — без этого режим «в ухо» невозможен."""
    try:
        with urllib.request.urlopen(MOST + '/say/status', timeout=2) as r:
            return r.status == 200
    except Exception:
        return False


def most_umeet_oba():
    """Мост (2.3.9+) сам играет «вслух»: в шлем и прямо в эфир (режим «oba» в /say/status)."""
    try:
        with urllib.request.urlopen(MOST + '/say/status', timeout=2) as r:
            return 'oba' in (json.loads(r.read().decode() or '{}').get('rezhimy') or [])
    except Exception:
        return False


# ---------- демон ----------

class Kusok:
    """Порция речи: одно или несколько предложений (12.10)."""

    def __init__(self, predl, uid, t, pervyy, dosluh=False):
        if isinstance(predl, str):
            predl = [predl]
        self.predl = list(predl)
        self.tekst = ' '.join(self.predl)
        self.uid, self.t, self.pervyy = uid, t, pervyy
        self.dosluh = dosluh      # последний кусок ответа: доиграл — уши слушают ещё секунду
        self.bystro = False
        self.mp3 = {}             # темп → путь, False — не вышел, PUSTO — сказать нечего
        self.nachala = {}         # темп → где в звуке начинается каждое предложение (с)
        self.dlit = {}            # темп → длительность звука (с)

    @property
    def temp(self):
        return BYSTREE if self.bystro else TEMP


class Golos:
    def __init__(self, sintez=None, termux=Termux, most=Most, dosluh=None, dlit=None, titr=False, most_oba=None):
        self.sintez = sintez or Sintez()
        self.Termux, self.Most = termux, most
        self.dosluh = dosluh or Rot.dosluh
        self.dlit_f = dlit or (lambda put: os.path.getsize(put) / BAJT_SEK)
        self.titry = Titry(zagruzit_titr() if titr is False else titr)
        self.most_oba_f = most_oba or most_umeet_oba
        self.most_oba_t, self.most_oba = 0.0, False
        self.most_sloman_do = 0.0  # самооткат: мост не сыграл «вслух» — до этого времени play-audio
        self.q = []
        self.cv = threading.Condition()
        self.igrok = None          # звучащий кусок: проигрыватель
        self.n = 0
        self.start = time.time()
        self.st, self.us = vremya(STOP), vremya(USKOR)
        self.pz = vremya(PAUZA)
        self.dl = max(vremya(DALSHE), self.pz)
        self.vnesh = 0.0           # мост сам оборвал (вызов «плюс плюс» в приложении)
        self.rezhim = self.chitat_rezhim()
        self.skazano = []          # сказанное в этом ходе: вступление не повторять хуком Stop
        self.pozzhe = []           # вступления, которых ещё нет в журнале: (когда, попытка, raw)
        self.bez_seti_t = 0.0      # когда последний раз говорили «Четыре» (голоса нет)
        self.zhdu_dosluh = False   # доиграл ответ: замолчит совсем — уши слушают секунду

    # --- приём ---
    def chitat_rezhim(self):
        try:
            r = open(REZHIM).read().strip()
        except OSError:
            r = ''
        self.termux_vsegda = r == 'termux'   # ручной откат: «вслух» только через play-audio
        return 'uho' if r == 'uho' else 'vsluh'

    def cherez_most(self):
        """«Вслух» играет мост (2.3.9: в шлем и прямо в эфир) — если не «termux», мост умеет и не
        ломался последние MOST_SLOMAN с. Умеет ли — спрашиваем не чаще раза в минуту."""
        if getattr(self, 'termux_vsegda', False) or time.time() < self.most_sloman_do:
            return False
        if time.time() - self.most_oba_t > 60:
            self.most_oba_t = time.time()
            try:
                self.most_oba = bool(self.most_oba_f())
            except Exception:
                self.most_oba = False
        return self.most_oba

    def priyom(self):
        try:
            imena = sorted(os.listdir(Q))
        except OSError:
            return
        now = time.time()
        gotovo = [x for x in self.pozzhe if x[0] <= now]
        self.pozzhe = [x for x in self.pozzhe if x[0] > now]
        for _, popytka, ns, raw in gotovo:
            self.prinyat(ns, 'pre', raw, popytka)
        for imya in imena:
            if imya.endswith('.tmp'):
                continue
            put = os.path.join(Q, imya)
            try:
                raw = open(put, encoding='utf-8', errors='replace').read()
                os.remove(put)
            except OSError:
                continue
            ns, _, vid = imya.partition('.')
            self.prinyat(ns, vid, raw)

    def prinyat(self, ns, vid, raw, popytka=0):
        try:
            t = int(ns) / 1e9
        except ValueError:
            return
        glavnyy = vid in ('hook', 'potok0')   # начало ответа: метки zamer
        if t < self.st or t < self.start - 30 or os.path.exists(OFF):
            if glavnyy:                    # свидетелю zamer: молчит нарочно, не сломалась
                metka('molchit', ns, 'выключена, оборвано или устарело')
            return                         # оборвали после, устарело или Ава молчит
        if vid == 'pre':
            _, tekst = iz_transkripta(raw)
        else:
            tekst = iz_huka(raw) if vid == 'hook' else raw
        tekst = dlya_uha(tekst)
        klyuch = re.sub(r'\W+', '', tekst.lower())
        if vid == 'pre' and (not klyuch or klyuch in self.skazano):
            if popytka < 3:                # журнал мог ещё не дописаться — заглянем позже
                self.pozzhe.append((time.time() + 0.25, popytka + 1, ns, raw))
            return
        if re.fullmatch(r'[\W_]*(?:тихо|молчу)?[\W_]*', tekst.lower()):
            if glavnyy:
                metka('molchit', ns, 'право молчать')
            return                         # право молчать: «тихо» на чат — не звук
        if vid == 'hook':
            try:                           # «плюс плюс повтори» — уши возьмут отсюда
                open(POSL + '.tmp', 'w').write(tekst)
                os.replace(POSL + '.tmp', POSL)
            except OSError:
                pass
        if vid in ('pre', 'hook') and klyuch in self.skazano:
            if vid == 'hook':
                metka('molchit', ns, 'уже сказано вступлением')
            return                         # уже сказано в этом ходе (вступление)
        self.skazano = (self.skazano + [klyuch])[-20:]
        dalshe = vid == 'potok'            # продолжение ответа рации: не начало
        ps = porcii(tekst, pervyy=0 if dalshe else 100)
        if not dalshe:
            metka('golos', ns, '%d кусков' % len(ps))
        # Ответ Александру (хук Stop, рация) и реплика соведущего (skazhi от vedushchiy — «.ved»):
        # договорила — уши ещё секунду слушают без «плюс плюс» (Александр 09.10). Вступление перед
        # инструментом, приветствие зрителям, «не расслышала» — нет.
        dosluh = vid in DOSLUH
        if self.chitat_rezhim() != 'uho':  # субтитры — только вслух: перевод всего ответа сразу
            self.titry.perevesti(ns, [f for p in ps for f in p])
        with self.cv:
            for i, p in enumerate(ps):
                self.q.append(Kusok(p, ns, t, i == 0 and not dalshe, dosluh and i == len(ps) - 1))
            self.cv.notify_all()

    # --- управление ---
    def upravlenie(self):
        st = vremya(STOP)
        if st > self.st:
            self.st = st
            self.stop_igrok()
            self.vybrosit(lambda k: k.t < st)
            self.vnesh, self.dl = 0.0, max(self.dl, st)   # «тихо» снимает и паузу
            self.zhdu_dosluh = False       # оборвал сам — секунду не слушаем
            log('тихо')
        us = vremya(USKOR)
        if us > self.us:
            self.us = us
            self.bystree(us)
            self.skazano = []              # новый ход — повторять можно
        pz = vremya(PAUZA)
        if pz > self.pz:
            self.pz = pz
            if self.igrok:
                proshlo = time.time() - getattr(self.igrok, 't0', time.time())
                igrok = self.igrok
                self.stop_igrok()          # порция останется первой — повторим с прерванной фразы
                self.s_prervannoy(igrok, proshlo)
            self.bystree(pz)
            log('пауза')
        dl = vremya(DALSHE)
        if dl > self.dl:
            self.dl = dl
            log('дальше')
        if self.igrok and os.path.exists(OFF):
            self.stop_igrok()
        rez = self.chitat_rezhim()
        if rez != self.rezhim:
            log('режим', rez)
            self.rezhim = rez
            if rez == 'uho' and self.igrok and (getattr(self.igrok, 'oba', False)
                                                or isinstance(self.igrok, self.Termux)):
                self.stop_igrok()          # «в ухо» — сразу снять из эфира, доскажет мост
        if self.pauza() and time.time() - max(self.pz, self.vnesh) > PAUZA_MAKS:
            granica = max(self.pz, self.vnesh)
            self.vybrosit(lambda k: k.t < granica)
            self.dl = time.time()
            log('пауза затянулась — прерванное не договариваю')

    def pauza(self):
        return max(self.pz, self.vnesh) > self.dl

    def bystree(self, granica):
        with self.cv:
            for i, k in enumerate(self.q):
                if i == 0 and self.igrok:
                    continue               # звучащий доиграет как есть — не синтезировать зря
                if k.t < granica:
                    k.bystro = True
            self.cv.notify_all()

    def vybrosit(self, kogo):
        with self.cv:
            ostav = []
            for k in self.q:
                if kogo(k):
                    self.ubrat_mp3(k)
                else:
                    ostav.append(k)
            self.q = ostav
            self.cv.notify_all()

    def ubrat_mp3(self, k):
        for p in k.mp3.values():
            if p:
                try:
                    os.remove(p)
                except OSError:
                    pass

    def stop_igrok(self):
        if self.igrok:
            self.igrok.stop()
            self.igrok = None
        self.titry.otmena()

    def s_prervannoy(self, igrok, proshlo):
        """Порцию оборвали на proshlo с: дальше — с начала прерванного предложения (по меткам
        синтеза), а не с начала всей порции."""
        with self.cv:
            if not self.q or getattr(igrok, 'kusok', None) is not self.q[0]:
                return
            k = self.q[0]
            nachala = k.nachala.get(getattr(igrok, 'temp', None))
            if len(k.predl) < 2 or not nachala:
                return
            j = max(i for i, n in enumerate(nachala) if n <= proshlo + 0.05)
            if j == 0:
                return
            nov = Kusok(k.predl[j:], k.uid, k.t, False, k.dosluh)
            nov.bystro = k.bystro
            self.ubrat_mp3(k)
            self.q[0] = nov
            self.cv.notify_all()
            log('продолжу с фразы %d из %d' % (j + 1, len(k.predl)))

    # --- игра ---
    def igra(self):
        if self.igrok:
            end = self.igrok.konec()
            if end is None:
                return
            igrok, self.igrok = self.igrok, None
            if getattr(igrok, 'vne_ocheredi', False):
                return                     # «Четыре» (голоса нет) — не кусок очереди
            with self.cv:
                k = self.q[0] if self.q else None
            if end == 'done' or k is None:
                if k is not None:
                    self.vybrosit(lambda x: x is k)
                    self.zhdu_dosluh = self.zhdu_dosluh or k.dosluh
            elif end == 'stopped':
                self.vnesh = time.time()   # мост оборвал сам — это вызов, ждём «дальше»
                self.titry.otmena()
                self.s_prervannoy(igrok, time.time() - getattr(igrok, 't0', time.time()))
                self.bystree(self.vnesh)
                log('мост оборвал — пауза')
            elif getattr(igrok, 'oba', False):
                self.most_sloman_do = time.time() + MOST_SLOMAN
                self.titry.otmena()
                log('мост не сыграл вслух (%s) — %d мин через play-audio' % (
                    getattr(igrok, 'err', '') or end, MOST_SLOMAN // 60))
                return                     # порция осталась первой — сыграет play-audio
            else:
                log('не сыграл:', getattr(igrok, 'err', '') or end)
                uid = k.uid
                self.vybrosit(lambda x: x.uid == uid)   # реплику не мучаем кусками
        if self.pauza() or os.path.exists(OFF):
            self.zhdu_dosluh = False       # Александр позвал сам — его фразу слушают уши
            if os.path.exists(OFF) and self.q:
                self.vybrosit(lambda k: True)
            return
        with self.cv:
            if not self.q:
                if self.zhdu_dosluh:       # договорила всё после ответа — слушай секунду
                    self.zhdu_dosluh = False
                    self.dosluh()
                return
            k = self.q[0]
            put = k.mp3.get(k.temp)
        if put is None:
            return                         # ещё готовится
        if put is False or put == PUSTO:
            self.vybrosit(lambda x: x is k)
            self.zhdu_dosluh = self.zhdu_dosluh or k.dosluh
            if put is False:
                self.bez_seti()
            return
        if k.pervyy:
            metka('zvuk', k.uid, self.rezhim)
            k.pervyy = False
        temp = k.temp
        if self.rezhim == 'uho':
            self.igrok = self.Most(put, 'uho')
        elif self.cherez_most():
            self.igrok = self.Most(put, 'oba')   # мост: в шлем и прямо в эфир, рот знает сам
            self.igrok.oba = True
        else:
            self.igrok = self.Termux(put)
        self.igrok.kusok, self.igrok.temp = k, temp
        if self.rezhim != 'uho':           # субтитр — только вслух: «в ухо» зрители не слышат
            self.titry.pokazat(k, getattr(self.igrok, 't0', time.time()), k.nachala.get(temp) or [0.0],
                               k.dlit.get(temp) or 0.0)

    def gotovit(self):
        """Поток синтеза: готовит первые куски очереди в их нынешнем темпе."""
        while True:
            with self.cv:
                zadacha = None
                while zadacha is None:
                    for k in self.q[:VPERED + 1]:
                        if k.temp not in k.mp3:
                            zadacha = (k, k.temp)
                            break
                    else:
                        self.cv.wait(1)
                k, temp = zadacha
                pervyy = k.pervyy and temp == TEMP
                self.n += 1
                put = os.path.join(MP3, '%d.mp3' % self.n)
            t0 = time.time()
            tl = getattr(self.sintez, 'tl', None)
            if tl is not None:
                tl.metki = None                # фраза из кэша — без чужих меток прошлого синтеза
            ok = self.gotovyy(k.tekst, temp, put)
            nachala, dlit = None, 0.0
            if ok:
                try:
                    dlit = self.dlit_f(put)
                except OSError:
                    dlit = 0.0
                nachala = razmetka(k.predl, getattr(self.sintez, 'metki', None), dlit)
            with self.cv:
                k.mp3[temp] = put if ok else (PUSTO if ok is None else False)
                if ok:
                    k.nachala[temp], k.dlit[temp] = nachala, dlit
                if k not in self.q and ok:
                    try:
                        os.remove(put)
                    except OSError:
                        pass
                self.cv.notify_all()
            if pervyy:
                metka('sintez', k.uid, '%.2f' % (time.time() - t0))

    def gotovyy(self, tekst, temp, put):
        """Синтез с кэшем: короткая фраза, уже сказанная раньше, берётся
        готовым файлом — без похода в сеть (сотни мс). None — сказать нечего."""
        if not re.search(r'\w', tekst):
            return None                    # одни знаки и смайлы: edge-tts всё равно промолчит
        if len(tekst) > 80:
            return self.sintez(tekst, temp, put)
        f = kesh(tekst, temp)
        try:
            shutil.copyfile(f, put)
            os.utime(f)
            return True
        except OSError:
            pass
        ok = self.sintez(tekst, temp, put)
        if not ok:
            return ok
        try:
            os.makedirs(KESH, exist_ok=True)
            shutil.copyfile(put, f + '.tmp')
            os.replace(f + '.tmp', f)
            vse = sorted((os.path.join(KESH, x) for x in os.listdir(KESH)), key=os.path.getmtime)
            for x in vse[:-300]:
                os.remove(x)
        except OSError:
            pass
        return True

    def bez_seti(self):
        """Синтез не вышел и со второй попытки: речь не умирает молча — «Четыре» из кэша."""
        if time.time() - self.bez_seti_t < 60 or not os.path.exists(kesh(BEZ_SETI, TEMP)):
            return
        self.bez_seti_t = time.time()
        metka('bezseti', '-')
        put = os.path.join(MP3, 'bez-seti.mp3')
        try:
            shutil.copyfile(kesh(BEZ_SETI, TEMP), put)
        except OSError:
            return
        log('синтез не вышел — сказала «Четыре»')
        self.igrok = self.Most(put, 'uho') if self.rezhim == 'uho' else self.Termux(put)
        self.igrok.vne_ocheredi = True

    def progret(self):
        """Частые фразы ушей — в кэш заранее, в тишине."""
        for t in ZARANEE:
            put = os.path.join(MP3, 'progrev.mp3')
            self.gotovyy(t, TEMP, put)
            try:
                os.remove(put)
            except OSError:
                pass

    def shag(self):
        self.priyom()
        self.upravlenie()
        self.igra()


def zamok():
    """Один демон: замок держится, пока процесс жив. Две попытки — на случай,
    если хук в этот миг проверяет замок сам."""
    f = open(LOCK, 'w')
    for _ in range(4):
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return f
        except BlockingIOError:
            time.sleep(0.1)
    return None


def nuzhen_drugoy_python():
    """edge-tts стоит через pipx — модуль виден только его Python. Берём его
    из первой строки программы edge-tts."""
    try:
        __import__('edge_tts')
        return None
    except ImportError:
        pass
    exe = shutil.which('edge-tts')
    if not exe or os.environ.get('GOLOS_PEREZAPUSK'):
        return None
    try:
        line = open(exe, 'rb').readline().decode('utf-8', 'replace')
    except OSError:
        return None
    if line.startswith('#!'):
        py = line[2:].strip().split()[0]
        if 'python' not in os.path.basename(py):
            return None                       # не Python (обёртка) — останемся сами
        # Python из pipx — ссылка на тот же системный python3, но запущенный по
        # своему пути он видит свою папку пакетов. Поэтому сравниваем пути как
        # есть, без раскрытия ссылок (realpath дал бы «тот же» — и демон молча
        # остался бы на медленной программе edge-tts).
        if os.path.exists(py) and os.path.abspath(py) != os.path.abspath(sys.executable):
            return py
    return None


