    return os.path.join(KESH, hashlib.sha1(('%s|%s|%s' % (g, temp, tekst)).encode()).hexdigest()
                        + '.mp3')


def metka(imya, uid, dop=''):
    """Метка задержки: мс, что, чья реплика. Смотреть — zamer."""
    try:
        with open(ZAMER, 'a') as f:
            f.write('%d\t%s\t%s\t%s\n' % (time.time() * 1000, imya, uid, dop))
    except OSError:
        pass


def vremya(put):
    """Время из управляющего файла; нет файла или недописан — 0."""
    try:
        return float(open(put).read().strip() or 0)
    except (OSError, ValueError):
        return 0.0


def gromkost_avy():
    """Доля громкости Авы из файла (проценты, 100 — как есть; выше 100 и мусор — 100)."""
    try:
        v = float(open(GROMKOST).read().strip().rstrip('%').replace(',', '.') or 100)
    except (OSError, ValueError):
        return 1.0
    return min(1.0, max(0.0, v / 100.0)) if v >= 0 else 1.0


def umenshit(put):
    """Звук Авы тише по файлу громкости: ffmpeg volume на месте (nice, 48 кбит/с как у edge-tts — длительность
    та же). Сбой — звук как есть, Ава не молчит."""
    d = gromkost_avy()
    if d >= 0.995:
        return
    tmp = put + '.vol.mp3'
    try:
        r = subprocess.run(['nice', '-n', '10', 'ffmpeg', '-y', '-loglevel', 'error', '-i', put, '-af',
                            'volume=%.3f' % d, '-c:a', 'libmp3lame', '-b:a', '48k', tmp],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)
        if r.returncode == 0 and os.path.getsize(tmp) > 0:
            os.replace(tmp, put)
            return
    except Exception as e:
        log('громкость: не вышло:', type(e).__name__, str(e)[:80])
    try:
        os.remove(tmp)
    except OSError:
        pass


