def most_vsluh():
    """Чем мост играет «вслух»: «oba» (2.3.9+: в шлем и прямо в эфир), «vsluh» (старше: обычным звуком —
    его пишет захват звука эфира) или None — мост не отвечает (тогда play-audio Termux)."""
    try:
        with urllib.request.urlopen(MOST + '/say/status', timeout=2) as r:
            if r.status != 200:
                return None
            try:
                d = json.loads(r.read().decode() or '{}')
            except ValueError:
                d = {}
    except Exception:
        return None
    return 'oba' if 'oba' in ((d.get('rezhimy') if isinstance(d, dict) else None) or []) else 'vsluh'


def efir_sostoyanie():
    """Что с эфиром моста: state из /efir («efir», «podklyuchayus», «obryv», иначе выключен); None — мост молчит."""
    try:
        with urllib.request.urlopen(MOST + '/efir', timeout=2) as r:
            return str(json.loads(r.read().decode() or '{}').get('state') or '')
    except Exception:
        return None


# ---------- демон ----------

class Kusok:
    """Порция речи: одно или несколько предложений (12.10)."""

    def __init__(self, predl, uid, t, pervyy, dosluh=False):
        if isinstance(predl, str):
            predl = [predl]
        self.predl = list(predl)
        self.tekst = ' '.join(self.predl)
        self.uid, self.t, self.pervyy = uid, t, pervyy
        self.dosluh = dosluh      # последний кусок ответа: доиграл — уши слушают ещё секунду
        self.chat = False         # сообщение чата вслух: вне очереди, без субтитров
        self.golos = None         # чей голос: None — Ава, VOICE_VED — соведущая
        self.uho = False          # только Александру (.uho), при любом режиме
        self.bystro = False
        self.mp3 = {}             # темп → путь, False — не вышел, PUSTO — сказать нечего
        self.nachala = {}         # темп → где в звуке начинается каждое предложение (с)
        self.dlit = {}            # темп → длительность звука (с)

    @property
    def temp(self):
        return BYSTREE if self.bystro else TEMP


class Golos:
    def __init__(self, sintez=None, termux=Termux, most=Most, dosluh=None, dlit=None, titr=False, most_oba=None,
                 efir=None, mik=None):
        self.sintez = sintez or Sintez()
        self.Termux, self.Most = termux, most
        self.dosluh = dosluh or Rot.dosluh
        self.dlit_f = dlit or (lambda put: os.path.getsize(put) / BAJT_SEK)
        self.titry = Titry(zagruzit_titr() if titr is False else titr)
        self.most_oba_f = most_oba or most_vsluh   # «oba» | «vsluh» | None (True/False — как «oba»/None)
        self.most_oba_t, self.most_oba = 0.0, None
        self.efir_f = efir or efir_sostoyanie
        self.efir_t, self.efir_bylo = 0.0, None    # шёл ли эфир при прошлом взгляде (None — ещё не знаем)
        self.kuda = None                           # куда звучала последняя порция (/tmp/golos.kuda)
        self.most_sloman_do = 0.0  # самооткат: мост не сыграл «вслух» — до этого времени play-audio
        self.q = []
        self.cv = threading.Condition()
        self.igrok = None          # звучащий кусок: проигрыватель
        self.n = 0
        self.start = time.time()
        self.st, self.us = vremya(STOP), vremya(USKOR)
        self.pz = vremya(PAUZA)
        self.dl = max(vremya(DALSHE), self.pz)
        self.vnesh = 0.0           # мост сам оборвал (вызов «плюс плюс» в приложении)
        self.rezhim = self.chitat_rezhim()
        self.skazano = []          # сказанное в этом ходе: вступление не повторять хуком Stop
        self.pozzhe = []           # вступления, которых ещё нет в журнале: (когда, попытка, raw)
        self.bez_seti_t = 0.0      # когда последний раз говорили «Четыре» (голоса нет)
        self.ne_slyshno_t = 0.0    # когда последний раз говорили «Меня не слышно в эфире»
        self.zhdu_dosluh = False   # доиграл ответ: замолчит совсем — уши слушают секунду
        self.dosluh_kto = 'plus'   # чей голос откроет эту секунду
        self.mik_f = mik or mik_db
        self.mik_zhiv = False      # поток слушает микрофон (в демоне; в проверках — по желанию)
        self.mik_ot = None         # с какого времени непрерывно есть данные микрофона (None — нет данных)
        self.mik_gromko = 0.0      # когда Александр последний раз был громче порога
        self.ved_zhdu = None       # (uid реплики соведущей, с какого времени ждёт тишины)
        self.mik_ved = []          # микрофон, пока звучит соведущая (сводка в журнал)
        self.mik_podryad = 0       # замеров подряд, где Александр громче порога, пока звучит соведущая
        self.perebil_plus = 0.0    # 29.10: когда Александр заговорил поверх Плюса (Плюс замолкает до «плюс плюс»)
        self.perebil_plus_uchten = 0.0
        self.perebil_zhdu = 0.0    # 30.10: Плюс молчит из-за Александра (время) — продолжит, когда тот замолчит
        self.mik_plus = 0
        self.perebil = 0.0         # когда Александр заговорил поверх соведущей (её обрываем)
        self.perebil_uchten = 0.0
        self.ved_ostatok = None    # uid реплики соведущей, оборванной Александром: остаток договорит после тишины

    # --- приём ---
    def chitat_rezhim(self):
        try:
            r = open(REZHIM).read().strip()
        except OSError:
            r = ''
        self.termux_vsegda = r == 'termux'   # ручной откат: «вслух» только через play-audio
        return 'uho' if r == 'uho' else 'vsluh'

    def cherez_most(self):
        """Каким режимом «вслух» играет мост: «oba» (2.3.9: в шлем и прямо в эфир), «vsluh» (мост старше:
        обычным звуком — его пишет захват эфира) или None — play-audio Termux («termux» в файле режима,
        мост не отвечает или ломался последние MOST_SLOMAN с). Спрашиваем мост не чаще раза в минуту."""
        if getattr(self, 'termux_vsegda', False) or time.time() < self.most_sloman_do:
            return None
        if time.time() - self.most_oba_t > 60:
            self.most_oba_t = time.time()
            try:
                m = self.most_oba_f()
            except Exception:
                m = None
            self.most_oba = 'oba' if m is True else (m if m in ('oba', 'vsluh') else None)
        return self.most_oba

    def novyy_efir(self):
        """Новый эфир (12.10, Александр: «вся её речь — по умолчанию в эфире»): «в ухо», оставшееся с
        прошлого раза, — снова «вслух». Переподключение того же эфира — не новый: «в ухо», сказанное
        посреди эфира, держится до следующего. Мост не ответил — ничего не решаем."""
        if time.time() - self.efir_t < EFIR_SEK:
            return
        self.efir_t = time.time()
        try:
            s = self.efir_f()
        except Exception:
            s = None
        if s is None:
            return
        idyot = s in EFIR_IDYOT
        if idyot and self.efir_bylo is False and self.chitat_rezhim() == 'uho':
            try:
                open(REZHIM + '.tmp', 'w').write('vsluh\n')
                os.replace(REZHIM + '.tmp', REZHIM)
                log('эфир начался — голос снова вслух (в ухо было с прошлого раза)')
            except OSError:
                pass
        self.efir_bylo = idyot

    def zapisat_kuda(self, kuda):
        """Где звучит голос — в /tmp/golos.kuda (только когда меняется): efir status скажет, слышно ли Аву в эфире."""
        if kuda == self.kuda:
            return
        self.kuda = kuda
        try:
            open(KUDA + '.tmp', 'w').write('%d %s\n' % (time.time(), kuda))
            os.replace(KUDA + '.tmp', KUDA)
        except OSError:
            pass

    def priyom(self):
        try:
            imena = sorted(os.listdir(Q))
        except OSError:
            return
        now = time.time()
        gotovo = [x for x in self.pozzhe if x[0] <= now]
        self.pozzhe = [x for x in self.pozzhe if x[0] > now]
        for _, popytka, ns, raw in gotovo:
            self.prinyat(ns, 'pre', raw, popytka)
        for imya in imena:
            if imya.endswith('.tmp'):
                continue
            put = os.path.join(Q, imya)
            try:
                raw = open(put, encoding='utf-8', errors='replace').read()
                os.remove(put)
            except OSError:
                continue
            ns, _, vid = imya.partition('.')
            self.prinyat(ns, vid, raw)

    def prinyat(self, ns, vid, raw, popytka=0):
        try:
            t = int(ns) / 1e9
        except ValueError:
            return
        glavnyy = vid in ('hook', 'potok0')   # начало ответа: метки zamer
        if t < self.st or t < self.start - 30 or os.path.exists(OFF):
            if glavnyy:                    # свидетелю zamer: молчит нарочно, не сломалась
                metka('molchit', ns, 'выключена, оборвано или устарело')
            return                         # оборвали после, устарело или Ава молчит
        if vid == 'chat':
            self.v_chat(ns, t, raw)
            return
        if vid == 'pre':
            _, tekst = iz_transkripta(raw)
        else:
            tekst = iz_huka(raw) if vid == 'hook' else raw
        tekst = dlya_uha(tekst)
        klyuch = re.sub(r'\W+', '', tekst.lower())
        if vid == 'pre' and (not klyuch or klyuch in self.skazano):
            if popytka < 3:                # журнал мог ещё не дописаться — заглянем позже
                self.pozzhe.append((time.time() + 0.25, popytka + 1, ns, raw))
            return
        if re.fullmatch(r'[\W_]*(?:тихо|молчу)?[\W_]*', tekst.lower()):
            if glavnyy:
                metka('molchit', ns, 'право молчать')
            return                         # право молчать: «тихо» на чат — не звук
        if vid == 'hook':
            try:                           # «плюс плюс повтори» — уши возьмут отсюда
                open(POSL + '.tmp', 'w').write(tekst)
                os.replace(POSL + '.tmp', POSL)
            except OSError:
                pass
        if vid in ('pre', 'hook') and klyuch in self.skazano:
            if vid == 'hook':
                metka('molchit', ns, 'уже сказано вступлением')
            return                         # уже сказано в этом ходе (вступление)
        self.skazano = (self.skazano + [klyuch])[-20:]
        dalshe = vid == 'potok'            # продолжение ответа рации: не начало
        ps = porcii(tekst, pervyy=0 if dalshe else 100)
        if not dalshe:
            metka('golos', ns, '%d кусков' % len(ps))
        # Ответ Александру (хук Stop, рация) и реплика соведущего (skazhi от vedushchiy — «.ved»):
        # договорила — уши ещё секунду слушают без «плюс плюс» (Александр 09.10). Вступление перед
        # инструментом, приветствие зрителям, «не расслышала» — нет.
        dosluh = vid in DOSLUH
        if self.chitat_rezhim() != 'uho' and vid != 'uho':  # субтитры — только вслух: перевод всего ответа сразу
            self.titry.perevesti(ns, [f for p in ps for f in p], ved=vid == 'ved')
        with self.cv:
            for i, p in enumerate(ps):
                k = Kusok(p, ns, t, i == 0 and not dalshe, dosluh and i == len(ps) - 1)
                if vid == 'ved':
                    k.golos = VOICE_VED    # соведущая — голосом Серафины (12.10), остальное как у Авы
                k.uho = vid == 'uho'
                self.q.append(k)
            self.cv.notify_all()

    def v_chat(self, ns, t, raw):
        """Сообщение чата вслух (12.10, Александр: «дословно мне, вне очереди размышлений, не теряя
        мысль»): встаёт перед несказанным ответом (за уже ждущими сообщениями чата); звучащую порцию
        igra оборвёт на границе фраз и доскажет после. Без субтитров (чат и так в кадре), без «дослуха»."""
        tekst = dlya_uha(raw, predel=400)
        if not re.search(r'\w', tekst):
            return
        with self.cv:
            i = 1 if self.igrok is not None and self.q and getattr(self.igrok, 'kusok', None) is self.q[0] else 0
            while i < len(self.q) and self.q[i].chat:
                i += 1
            for p in porcii(tekst, pervyy=0):
                k = Kusok(p, ns, t, False)
                k.chat = True
                self.q.insert(i, k)
                i += 1
            self.cv.notify_all()
        log('чат вслух: %d знаков' % len(tekst))

    def srez_dlya_chata(self):
        """Ждёт чат, а звучит ответ: оборвать порцию в паузе перед следующей фразой (по меткам синтеза),
        несказанные фразы — новой порцией сразу после чата: Ава договорит с той фразы, на которой
        остановилась. Порция из одной фразы или без меток — доиграет целиком, чат — следом."""
        igrok = self.igrok
        with self.cv:
            if (len(self.q) < 2 or not self.q[1].chat or self.q[0].chat
                    or getattr(igrok, 'kusok', None) is not self.q[0]):
                return
            k, c = self.q[0], self.q[1]
            if not c.mp3.get(c.temp):
                return                     # чат ещё синтезируется — ответ пусть звучит
            nachala = k.nachala.get(getattr(igrok, 'temp', None)) or []
            proshlo = time.time() - getattr(igrok, 't0', time.time())
            j = next((i for i, n in enumerate(nachala) if i > 0 and n > proshlo), None)
            if j is None or j >= len(k.predl) or proshlo < nachala[j] - SREZ_ZAPAS:
                return
        self.stop_igrok()
        with self.cv:
            if not self.q or self.q[0] is not k:
                return
            self.q.pop(0)
            self.ubrat_mp3(k)
            nov = Kusok(k.predl[j:], k.uid, k.t, False, k.dosluh)
            nov.bystro, nov.golos = k.bystro, k.golos
            i = 0
            while i < len(self.q) and self.q[i].chat:
                i += 1
            self.q.insert(i, nov)
            self.cv.notify_all()
        log('чат вслух: порцию обрываю перед фразой %d из %d — договорю после' % (j + 1, len(k.predl)))

    # --- управление ---
    def upravlenie(self):
        st = vremya(STOP)
        if st > self.st:
            self.st = st
            self.stop_igrok()
            self.vybrosit(lambda k: k.t < st)
            self.vnesh, self.dl = 0.0, max(self.dl, st)   # «тихо» снимает и паузу
            self.zhdu_dosluh = False       # оборвал сам — секунду не слушаем
            log('тихо')
        us = vremya(USKOR)
        if us > self.us:
            self.us = us
            self.bystree(us)
            self.skazano = []              # новый ход — повторять можно
        pz = vremya(PAUZA)
        if pz > self.pz:
            self.pz = pz
            if self.igrok:
                proshlo = time.time() - getattr(self.igrok, 't0', time.time())
                igrok = self.igrok
                self.stop_igrok()          # порция останется первой — повторим с прерванной фразы
                self.s_prervannoy(igrok, proshlo)
            self.bystree(pz)
            log('пауза')
        if self.perebil > self.perebil_uchten:
            self.perebil_uchten = self.perebil
            k = getattr(self.igrok, 'kusok', None)
            if k is not None and k.golos == VOICE_VED:
                uid, igrok = k.uid, self.igrok
                proshlo = time.time() - getattr(igrok, 't0', time.time())
                self.stop_igrok()
                self.s_prervannoy(igrok, proshlo)       # остаток — с прерванной фразы; договорит после тишины (21.10)
                self.ved_ostatok, self.ved_zhdu = uid, None
                self.zhdu_dosluh = False
                log('соведущая замолчала: Александр заговорил — договорит после тишины')
        if self.perebil_plus > self.perebil_plus_uchten:
            self.perebil_plus_uchten = self.perebil_plus
            ig = self.igrok
            if ig is not None and getattr(getattr(ig, 'kusok', None), 'golos', None) != VOICE_VED:
                proshlo = time.time() - getattr(ig, 't0', time.time())
                self.stop_igrok()
                self.s_prervannoy(ig, proshlo)   # «плюс плюс» — продолжит с прерванной фразы
                self.vnesh = time.time()         # пауза: продолжит, когда Александр замолчит (или «дальше»)
                self.zhdu_dosluh = False
                self.perebil_zhdu = self.mik_gromko = time.time()
                log('Плюс замолчал: Александр заговорил')
        if self.perebil_zhdu:
            now = time.time()
            if self.dl >= self.perebil_zhdu or self.pz > self.perebil_zhdu:
                self.perebil_zhdu = 0.0          # уже «дальше» или вызов «плюс плюс» — решают уши
            elif now - self.mik_gromko >= (PLUS_TISHINA if self.mik_ot is not None else PLUS_BEZ_MIK) \
                    and now - self.perebil_zhdu >= PLUS_TISHINA:
                self.perebil_zhdu = 0.0
                self.dl = now
                log('Александр замолчал — Плюс продолжает')
        self.ostatok_ustarel()
        dl = vremya(DALSHE)
        if dl > self.dl:
            self.dl = dl
            log('дальше')
        if self.igrok and os.path.exists(OFF):
            self.stop_igrok()
        rez = self.chitat_rezhim()
        if rez != self.rezhim:
            log('режим', rez)
            self.rezhim = rez
            if rez == 'uho' and self.igrok and (getattr(self.igrok, 'oba', False)
                                                or isinstance(self.igrok, self.Termux)):
                self.stop_igrok()          # «в ухо» — сразу снять из эфира, доскажет мост
        if self.pauza() and time.time() - max(self.pz, self.vnesh) > PAUZA_MAKS:
            granica = max(self.pz, self.vnesh)
            self.vybrosit(lambda k: k.t < granica)
            self.dl = time.time()
            log('пауза затянулась — прерванное не договариваю')
        self.novyy_efir()

    def ostatok_ustarel(self):
        """Остаток оборванной реплики соведущей не договариваем, если уже есть новая реплика соведущей
        или ответ Плюса (звучит или ждёт в очереди); чат вслух не в счёт. Сам остаток кончился — забываем."""
        uid = self.ved_ostatok
        if uid is None:
            return
        with self.cv:
            est = any(k.uid == uid for k in self.q)
            drugoy = any(k.uid != uid and not k.chat for k in self.q)
        if not est:
            self.ved_ostatok = None
        elif drugoy:
            self.vybrosit(lambda x: x.uid == uid)
            self.ved_ostatok = None
            log('остаток соведущей не договариваю: уже есть новая реплика')

    def pauza(self):
        return max(self.pz, self.vnesh) > self.dl

    def bystree(self, granica):
        with self.cv:
            for i, k in enumerate(self.q):
                if i == 0 and self.igrok:
                    continue               # звучащий доиграет как есть — не синтезировать зря
                if k.t < granica:
                    k.bystro = True
            self.cv.notify_all()

    def vybrosit(self, kogo):
        with self.cv:
            ostav = []
            for k in self.q:
                if kogo(k):
                    self.ubrat_mp3(k)
                else:
                    ostav.append(k)
            self.q = ostav
            self.cv.notify_all()

    def ubrat_mp3(self, k):
        for p in k.mp3.values():
            if p:
                try:
                    os.remove(p)
                except OSError:
                    pass

    def stop_igrok(self):
        if self.igrok:
            self.igrok.stop()
            self.igrok = None
        self.titry.otmena()

    def s_prervannoy(self, igrok, proshlo):
        """Порцию оборвали на proshlo с: дальше — с начала прерванного предложения (по меткам
        синтеза), а не с начала всей порции."""
        with self.cv:
            if not self.q or getattr(igrok, 'kusok', None) is not self.q[0]:
                return
            k = self.q[0]
            nachala = k.nachala.get(getattr(igrok, 'temp', None))
            if len(k.predl) < 2 or not nachala:
                return
            j = max(i for i, n in enumerate(nachala) if n <= proshlo + 0.05)
            if j == 0:
                return
            nov = Kusok(k.predl[j:], k.uid, k.t, False, k.dosluh)
            nov.bystro, nov.golos = k.bystro, k.golos
            self.ubrat_mp3(k)
            self.q[0] = nov
            self.cv.notify_all()
            log('продолжу с фразы %d из %d' % (j + 1, len(k.predl)))

    # --- игра ---
    def igra(self):
        if self.igrok:
            self.srez_dlya_chata()
        if self.igrok:
            end = self.igrok.konec()
            if end is None:
                return
            igrok, self.igrok = self.igrok, None
            if getattr(igrok, 'vne_ocheredi', False):
                return                     # «Четыре» (голоса нет) — не кусок очереди
            with self.cv:
                k = self.q[0] if self.q else None
            if end == 'done' or k is None:
                if k is not None:
                    self.vybrosit(lambda x: x is k)
                    self.zhdat_dosluh(k)
            elif end == 'stopped':
                self.vnesh = time.time()   # мост оборвал сам — это вызов, ждём «дальше»
                self.titry.otmena()
                self.s_prervannoy(igrok, time.time() - getattr(igrok, 't0', time.time()))
                self.bystree(self.vnesh)
                log('мост оборвал — пауза')
            elif getattr(igrok, 'oba', False):     # «вслух» мостом (oba или старое vsluh) не вышло
                v_efire = self.efir_bylo is True
                sek = MOST_SLOMAN_EFIR if v_efire else MOST_SLOMAN
                self.most_sloman_do = time.time() + sek
                self.titry.otmena()
                log('мост не сыграл вслух (%s) — %d с через play-audio%s' % (
                    getattr(igrok, 'err', '') or end, sek, ', а эфир идёт: в эфир не слышно' if v_efire else ''))
                if v_efire:
                    self.ne_slyshno()      # Александру: «Меня не слышно в эфире» — он не думает, что слышат все
                return                     # порция осталась первой — сыграет play-audio
            else:
                log('не сыграл:', getattr(igrok, 'err', '') or end)
                uid = k.uid
                self.vybrosit(lambda x: x.uid == uid)   # реплику не мучаем кусками
        if self.pauza() or os.path.exists(OFF):
            self.zhdu_dosluh = False       # Александр позвал сам — его фразу слушают уши
            if os.path.exists(OFF) and self.q:
                self.vybrosit(lambda k: True)
            return
        with self.cv:
            if not self.q:
                if self.zhdu_dosluh:       # договорила всё после ответа — слушай секунду
                    self.zhdu_dosluh = False
                    self.zapisat_dosluh_kto()
                    self.dosluh()
                return
            k = self.q[0]
            put = k.mp3.get(k.temp)
        if put is None:
            return                         # ещё готовится
        if put is False or put == PUSTO:
            self.vybrosit(lambda x: x is k)
            self.zhdat_dosluh(k)
            if put is False:
                self.bez_seti()
            return
        if k.golos == VOICE_VED and not self.ved_mozhno(k):
            self.plus_vperyod()            # ждёт тишины — ответ Плюса (если есть) не держит
            return
        if k.pervyy:
            metka('zvuk', k.uid, self.rezhim)
            k.pervyy = False
        temp = k.temp
        uho = self.rezhim == 'uho' or k.uho
        m = None if uho else self.cherez_most()
        if uho:
            self.igrok = self.Most(put, 'uho')
            kuda = 'uho'
        elif m:
            self.igrok = self.Most(put, m)       # мост: «oba» — в шлем и прямо в эфир; «vsluh» — его пишет захват
            self.igrok.oba = True                # «вслух» мостом: не сыграл — самооткат на play-audio
            kuda = 'most-' + m
        else:
            self.igrok = self.Termux(put)        # в эфир моста не попадает (см. Termux)
            kuda = 'termux'
        self.zapisat_kuda(kuda)
        self.igrok.kusok, self.igrok.temp = k, temp
        if not uho and not k.chat:  # субтитр — только вслух: «в ухо» зрители не слышат; чат — и так в кадре
            self.titry.pokazat(k, getattr(self.igrok, 't0', time.time()), k.nachala.get(temp) or [0.0],
                               k.dlit.get(temp) or 0.0)

    def zhdat_dosluh(self, k):
        if k.dosluh:
            self.zhdu_dosluh = True
            self.dosluh_kto = 'ved' if k.golos == VOICE_VED else 'plus'

    def zapisat_dosluh_kto(self):
        """Уши: фраза в секунду «дослуха» — тому, чей голос её открыл (соведущей или Плюсу)."""
        try:
            open(DOSLUH_KTO + '.tmp', 'w').write(self.dosluh_kto)
            os.replace(DOSLUH_KTO + '.tmp', DOSLUH_KTO)
        except OSError:
            pass

    # --- соведущая ждёт, пока Александр договорит ---
    def slushat_mik(self, shag=0.15):
        """Поток: пока в очереди есть реплика соведущей — громкость микрофона Александра."""
        self.mik_zhiv = True
        while True:
            ig = self.igrok
            zvuchit_ved = ig is not None and getattr(getattr(ig, 'kusok', None), 'golos', None) == VOICE_VED
            # через play-audio Termux микрофон слышит эхо Плюса — там не перебиваем (мост на время голоса глушит микрофон)
            zvuchit_plus = ig is not None and not zvuchit_ved and getattr(ig, 'kusok', None) is not None and \
                type(ig) is not self.Termux
            if self.mik_ved and not zvuchit_ved:
                v, self.mik_ved = sorted(self.mik_ved), []
                log('соведущая звучала: микрофон медиана %d, громче всего %d дБ (%d замеров)' % (
                    v[len(v) // 2], v[0], len(v)))
            with self.cv:
                nado = any(k.golos == VOICE_VED for k in self.q) or zvuchit_plus or bool(self.perebil_zhdu)
            if not nado:
                self.mik_ot = None
                time.sleep(0.2)
                continue
            db = self.mik_f()
            now = time.time()
            if db is None:
                self.mik_ot = None         # моста или ушей нет — ждать нечего
            else:
                if self.mik_ot is None:
                    self.mik_ot = now
                if db <= ved_porog() and ig is None:   # пока звучит голос, микрофон слышит его эхо, не Александра
                    self.mik_gromko = now
                if self.perebil_zhdu and ig is None and db <= golos_porog():
                    self.mik_gromko = now      # Плюс молчит из-за Александра: тот ещё говорит
                if zvuchit_ved:
                    self.mik_ved.append(db)
                    # 19.10 эфир: пока говорит соведущая, микрофон — 90 (её эха в нём нет), а громче порога — только
                    # голос Александра. Две подряд (0,3 с) — он заговорил: соведущая замолкает (upravlenie)
                    self.mik_podryad = self.mik_podryad + 1 if db <= ved_porog() else 0
                    if self.mik_podryad >= VED_PEREBIT:
                        self.perebil, self.mik_podryad = now, 0
                        self.mik_gromko = now
                else:
                    self.mik_podryad = 0
                if zvuchit_plus:              # 29.10: Плюс — так же: два замера громче порога — замолкает
                    self.mik_plus = self.mik_plus + 1 if db <= golos_porog() else 0
                    if self.mik_plus >= VED_PEREBIT:
                        self.perebil_plus, self.mik_plus = now, 0
                else:
                    self.mik_plus = 0
            time.sleep(shag)

    def ved_mozhno(self, k):
        """Можно ли начать порцию соведущей: Александр молчит VED_TISHINA с. Нет потока или данных микрофона —
        можно (как раньше). Ждёт дольше VED_ZHDAT — реплику выбрасываем: к месту она уже не будет."""
        if not self.mik_zhiv:
            return True
        now = time.time()
        if self.ved_zhdu is None or self.ved_zhdu[0] != k.uid:
            self.ved_zhdu = (k.uid, now)
        ot = self.mik_ot
        if ot is None and now - self.ved_zhdu[1] > 0.6:
            return True                    # поток спросил, а данных нет — мост молчит про микрофон
        tishina = VED_DOGOVOR if k.uid == self.ved_ostatok else VED_TISHINA
        if ot is not None and now - max(ot, self.mik_gromko) >= tishina:
            if now - self.ved_zhdu[1] > tishina + 0.5:
                log('соведущая дождалась паузы: %.1f с' % (now - self.ved_zhdu[1]))
            self.ved_zhdu = None
            return True
        if now - self.ved_zhdu[1] > VED_ZHDAT:
            uid = k.uid
            self.vybrosit(lambda x: x.uid == uid)
            self.ved_zhdu = None
            log('соведущая промолчала: Александр говорил дольше %d с' % VED_ZHDAT)
        return False

    def plus_vperyod(self):
        """Первая не-соведущая порция очереди — вперёд (соведущая ждёт паузы, Плюс отвечает сразу)."""
        with self.cv:
            i = next((i for i, x in enumerate(self.q) if x.golos != VOICE_VED), None)
            if i:
                self.q.insert(0, self.q.pop(i))
                self.cv.notify_all()

    def gotovit(self):
        """Поток синтеза: готовит первые куски очереди в их нынешнем темпе."""
        while True:
            with self.cv:
                zadacha = None
                while zadacha is None:
                    for k in self.q[:VPERED + 1]:
                        if k.temp not in k.mp3:
                            zadacha = (k, k.temp)
                            k.mp3[k.temp] = None   # в работе: второй поток синтеза берёт следующую
                            break
                    else:
                        self.cv.wait(1)
                k, temp = zadacha
                pervyy = k.pervyy and temp == TEMP
                self.n += 1
                put = os.path.join(MP3, '%d.mp3' % self.n)
            t0 = time.time()
            tl = getattr(self.sintez, 'tl', None)
            if tl is not None:
                tl.metki = None                # фраза из кэша — без чужих меток прошлого синтеза
            ok = self.gotovyy(k.tekst, temp, put, k.golos)
            nachala, dlit = None, 0.0
            if ok and k.golos is None:
                umenshit(put)              # громкость Авы; соведущая (.ved) — не трогаем
            if ok:
                try:
                    dlit = self.dlit_f(put)
                except OSError:
                    dlit = 0.0
                nachala = razmetka(k.predl, getattr(self.sintez, 'metki', None), dlit)
            with self.cv:
                k.mp3[temp] = put if ok else (PUSTO if ok is None else False)
                if ok:
                    k.nachala[temp], k.dlit[temp] = nachala, dlit
                if k not in self.q and ok:
                    try:
                        os.remove(put)
                    except OSError:
                        pass
                self.cv.notify_all()
            if pervyy:
                metka('sintez', k.uid, '%.2f' % (time.time() - t0))

    def gotovyy(self, tekst, temp, put, golos=None):
        """Синтез с кэшем: короткая фраза, уже сказанная раньше, берётся
        готовым файлом — без похода в сеть (сотни мс). None — сказать нечего.
        golos — чей голос (None — Ава; соведущая — VOICE_VED)."""
        if not re.search(r'\w', tekst):
            return None                    # одни знаки и смайлы: edge-tts всё равно промолчит
        sintez = (lambda: self.sintez(tekst, temp, put)) if golos is None else \
            (lambda: self.sintez(tekst, temp, put, golos=golos))
        if len(tekst) > 80:
            ok = sintez()
            if ok:
                obrezat_hvost(put, getattr(self.sintez, 'metki', None))
            return ok
        f = kesh(tekst, temp, golos)
        try:
            shutil.copyfile(f, put)
            os.utime(f)
            return True
        except OSError:
            pass
        ok = sintez()
        if not ok:
            return ok
        obrezat_hvost(put, getattr(self.sintez, 'metki', None))
        try:
            os.makedirs(KESH, exist_ok=True)
            shutil.copyfile(put, f + '.tmp')
            os.replace(f + '.tmp', f)
            vse = sorted((os.path.join(KESH, x) for x in os.listdir(KESH)), key=os.path.getmtime)
            for x in vse[:-300]:
                os.remove(x)
        except OSError:
            pass
        return True

