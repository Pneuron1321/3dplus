    def ne_slyshno(self):
        """Эфир идёт, а голос ушёл на play-audio (мост не сыграл): Александру — «Меня не слышно в эфире»
        из кэша, через play-audio (зрители не слышат), не чаще раза в минуту (12.10)."""
        if time.time() - self.ne_slyshno_t < 60 or not os.path.exists(kesh(NE_SLYSHNO, TEMP)):
