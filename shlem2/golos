    в конце файла звучит паузой перед следующей порцией. Где кончилось последнее слово, знают метки синтеза:
    тишину длиннее HVOST_MAKS срезаем до HVOST (копией кадров mp3 — без пережатия). Нет меток — как есть."""
    if not metki:
        return
    konec = max(o + d for o, d, _ in metki)
    try:
        dlit = os.path.getsize(put) / BAJT_SEK
    except Exception:
        return
    if not konec or dlit - konec <= HVOST_MAKS:
        return
    tmp = put + '.hvost.mp3'
    try:
        r = subprocess.run(['nice', '-n', '10', 'ffmpeg', '-y', '-loglevel', 'error', '-i', put, '-t',
                            '%.3f' % (konec + HVOST), '-c', 'copy', tmp],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        if r.returncode == 0 and os.path.getsize(tmp) > 0:
            os.replace(tmp, put)
            log('хвост тишины: %.2f с → %.2f с' % (dlit - konec, HVOST))
            return
    except Exception as e:
        log('хвост: не вышло:', type(e).__name__, str(e)[:80])
    try:
        os.remove(tmp)
    except OSError:
        pass


