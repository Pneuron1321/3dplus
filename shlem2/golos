def eleven_sintez(tekst, temp, put, golos_id):
    """Синтез своим голосом в put (MP3). True — вышло."""
    try:
        p = int(temp.strip().rstrip('%'))
    except ValueError:
        p = 0
    telo = json.dumps({'text': tekst, 'model_id': ELEVEN_MODEL,
                       'voice_settings': {'stability': 0.5, 'similarity_boost': 0.8,
                                          'speed': max(0.7, min(1.2, 1 + p / 100))}}).encode()
    req = urllib.request.Request('%s/v1/text-to-speech/%s?output_format=mp3_44100_128' % (ELEVEN_URL, golos_id),
                                 data=telo, method='POST',
                                 headers={'xi-api-key': open(ELEVEN_KEY).read().strip(),
                                          'Content-Type': 'application/json', 'Accept': 'audio/mpeg'})
    syroy = put + '.el'
    try:
        with urllib.request.urlopen(req, timeout=20) as r, open(syroy, 'wb') as f:
            shutil.copyfileobj(r, f)
    except urllib.error.HTTPError as e:
        log('ElevenLabs HTTP %d — фраза мужским голосом, свой голос отдыхает %d с' % (e.code, ELEVEN_PAUZA))
        if e.code in (401, 402, 403, 429):
            _eleven_otdyh[0] = time.time() + ELEVEN_PAUZA
        return False
    except Exception as e:
        log('ElevenLabs:', type(e).__name__)
        return False
    if os.path.getsize(syroy) == 0:
        return False
    n = eleven_nizhe()
    ff = shutil.which('ffmpeg')
    if n and ff:
        k = 2 ** (-n / 12)                           # ниже на n полутонов: частота × k, темп обратно ÷ k
        r = subprocess.run([ff, '-v', 'error', '-y', '-i', syroy, '-af',
                            'asetrate=44100*%.5f,aresample=44100,atempo=%.5f' % (k, 1 / k),
                            '-c:a', 'libmp3lame', '-b:a', '128k', put], timeout=30)
        if r.returncode == 0 and os.path.exists(put) and os.path.getsize(put) > 0:
            os.remove(syroy)
            return True
    os.replace(syroy, put)
    return True
