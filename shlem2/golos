class Kusok:
    def __init__(self, tekst, uid, t, pervyy):
        self.tekst, self.uid, self.t, self.pervyy = tekst, uid, t, pervyy
        self.bystro = False
        self.mp3 = {}             # темп → путь, или False — не вышел

    @property
    def temp(self):
        return BYSTREE if self.bystro else TEMP


class Golos:
    def __init__(self, sintez=None, termux=Termux, most=Most):
        self.sintez = sintez or Sintez()
        self.Termux, self.Most = termux, most
        self.q = []
        self.cv = threading.Condition()
        self.igrok = None          # звучащий кусок: проигрыватель
        self.n = 0
        self.start = time.time()
        self.st, self.us = vremya(STOP), vremya(USKOR)
        self.pz = vremya(PAUZA)
        self.dl = max(vremya(DALSHE), self.pz)
        self.vnesh = 0.0           # мост сам оборвал (вызов «плюс плюс» в приложении)
        self.rezhim = self.chitat_rezhim()
        self.skazano = []          # сказанное в этом ходе: вступление не повторять хуком Stop
        self.pozzhe = []           # вступления, которых ещё нет в журнале: (когда, попытка, raw)
        self.bez_seti_t = 0.0      # когда последний раз говорили «голос без сети»

    # --- приём ---
    def chitat_rezhim(self):
        try:
            return 'uho' if open(REZHIM).read().strip() == 'uho' else 'vsluh'
        except OSError:
            return 'vsluh'

    def priyom(self):
        try:
            imena = sorted(os.listdir(Q))
        except OSError:
            return
        now = time.time()
        gotovo = [x for x in self.pozzhe if x[0] <= now]
        self.pozzhe = [x for x in self.pozzhe if x[0] > now]
        for _, popytka, ns, raw in gotovo:
            self.prinyat(ns, 'pre', raw, popytka)
        for imya in imena:
            if imya.endswith('.tmp'):
                continue
            put = os.path.join(Q, imya)
            try:
                raw = open(put, encoding='utf-8', errors='replace').read()
                os.remove(put)
            except OSError:
                continue
            ns, _, vid = imya.partition('.')
            self.prinyat(ns, vid, raw)

    def prinyat(self, ns, vid, raw, popytka=0):
        try:
            t = int(ns) / 1e9
        except ValueError:
            return
        glavnyy = vid in ('hook', 'potok0')   # начало ответа: метки zamer
        if t < self.st or t < self.start - 30 or os.path.exists(OFF):
            if glavnyy:                    # свидетелю zamer: молчит нарочно, не сломалась
                metka('molchit', ns, 'выключена, оборвано или устарело')
            return                         # оборвали после, устарело или Ава молчит
        if vid == 'pre':
            _, tekst = iz_transkripta(raw)
        else:
            tekst = iz_huka(raw) if vid == 'hook' else raw
        tekst = dlya_uha(tekst)
        klyuch = re.sub(r'\W+', '', tekst.lower())
        if vid == 'pre' and (not klyuch or klyuch in self.skazano):
            if popytka < 3:                # журнал мог ещё не дописаться — заглянем позже
                self.pozzhe.append((time.time() + 0.25, popytka + 1, ns, raw))
            return
        if re.fullmatch(r'[\W_]*(?:тихо|молчу)?[\W_]*', tekst.lower()):
            if glavnyy:
                metka('molchit', ns, 'право молчать')
            return                         # право молчать: «тихо» на чат — не звук
        if vid == 'hook':
            try:                           # «плюс плюс повтори» — уши возьмут отсюда
                open(POSL + '.tmp', 'w').write(tekst)
                os.replace(POSL + '.tmp', POSL)
            except OSError:
                pass
        if vid in ('pre', 'hook') and klyuch in self.skazano:
            if vid == 'hook':
                metka('molchit', ns, 'уже сказано вступлением')
            return                         # уже сказано в этом ходе (вступление)
        self.skazano = (self.skazano + [klyuch])[-20:]
        dalshe = vid == 'potok'            # продолжение ответа рации: не начало
        ks = kuski(tekst, pervyy=0 if dalshe else 100)
        if not dalshe:
            metka('golos', ns, '%d кусков' % len(ks))
        with self.cv:
            for i, k in enumerate(ks):
                self.q.append(Kusok(k, ns, t, i == 0 and not dalshe))
            self.cv.notify_all()

    # --- управление ---
    def upravlenie(self):
        st = vremya(STOP)
        if st > self.st:
            self.st = st
            self.stop_igrok()
            self.vybrosit(lambda k: k.t < st)
            self.vnesh, self.dl = 0.0, max(self.dl, st)   # «тихо» снимает и паузу
            log('тихо')
        us = vremya(USKOR)
        if us > self.us:
            self.us = us
            self.bystree(us)
            self.skazano = []              # новый ход — повторять можно
        pz = vremya(PAUZA)
        if pz > self.pz:
            self.pz = pz
            if self.igrok:
                self.stop_igrok()          # кусок останется первым — повторим с начала
            self.bystree(pz)
            log('пауза')
        dl = vremya(DALSHE)
        if dl > self.dl:
            self.dl = dl
            log('дальше')
        if self.igrok and os.path.exists(OFF):
            self.stop_igrok()
        rez = self.chitat_rezhim()
        if rez != self.rezhim:
            log('режим', rez)
            self.rezhim = rez
            if rez == 'uho' and isinstance(self.igrok, self.Termux):
                self.stop_igrok()          # «в ухо» — сразу снять из эфира, доскажет мост
        if self.pauza() and time.time() - max(self.pz, self.vnesh) > PAUZA_MAKS:
            granica = max(self.pz, self.vnesh)
            self.vybrosit(lambda k: k.t < granica)
            self.dl = time.time()
            log('пауза затянулась — прерванное не договариваю')

    def pauza(self):
        return max(self.pz, self.vnesh) > self.dl

    def bystree(self, granica):
        with self.cv:
            for i, k in enumerate(self.q):
                if i == 0 and self.igrok:
                    continue               # звучащий доиграет как есть — не синтезировать зря
                if k.t < granica:
                    k.bystro = True
            self.cv.notify_all()

    def vybrosit(self, kogo):
        with self.cv:
            ostav = []
            for k in self.q:
                if kogo(k):
                    self.ubrat_mp3(k)
                else:
                    ostav.append(k)
            self.q = ostav
            self.cv.notify_all()

    def ubrat_mp3(self, k):
        for p in k.mp3.values():
            if p:
                try:
                    os.remove(p)
                except OSError:
                    pass

    def stop_igrok(self):
        if self.igrok:
            self.igrok.stop()
            self.igrok = None

    # --- игра ---
    def igra(self):
        if self.igrok:
            end = self.igrok.konec()
            if end is None:
                return
            igrok, self.igrok = self.igrok, None
            if getattr(igrok, 'vne_ocheredi', False):
                return                     # «голос без сети» — не кусок очереди
            with self.cv:
                k = self.q[0] if self.q else None
            if end == 'done' or k is None:
                if k is not None:
                    self.vybrosit(lambda x: x is k)
            elif end == 'stopped':
                self.vnesh = time.time()   # мост оборвал сам — это вызов, ждём «дальше»
                self.bystree(self.vnesh)
                log('мост оборвал — пауза')
            else:
                log('не сыграл:', getattr(igrok, 'err', '') or end)
                uid = k.uid
                self.vybrosit(lambda x: x.uid == uid)   # реплику не мучаем кусками
        if self.pauza() or os.path.exists(OFF):
            if os.path.exists(OFF) and self.q:
                self.vybrosit(lambda k: True)
            return
        with self.cv:
            if not self.q:
                return
            k = self.q[0]
            put = k.mp3.get(k.temp)
        if put is None:
            return                         # ещё готовится
        if put is False:
            self.vybrosit(lambda x: x is k)
            self.bez_seti()
            return
        if k.pervyy:
            metka('zvuk', k.uid, self.rezhim)
            k.pervyy = False
        if self.rezhim == 'uho':
            self.igrok = self.Most(put, 'uho')
        else:
            self.igrok = self.Termux(put)
            titr_plus(k.tekst, put)        # субтитр — только вслух: «в ухо» зрители не слышат

    def gotovit(self):
        """Поток синтеза: готовит первые куски очереди в их нынешнем темпе."""
        while True:
            with self.cv:
                zadacha = None
                while zadacha is None:
                    for k in self.q[:VPERED + 1]:
                        if k.temp not in k.mp3:
                            zadacha = (k, k.temp)
                            break
                    else:
                        self.cv.wait(1)
                k, temp = zadacha
                pervyy = k.pervyy and temp == TEMP
                self.n += 1
                put = os.path.join(MP3, '%d.mp3' % self.n)
            t0 = time.time()
            ok = self.gotovyy(k.tekst, temp, put)
            with self.cv:
                k.mp3[temp] = put if ok else False
                if k not in self.q and ok:
                    try:
                        os.remove(put)
                    except OSError:
                        pass
                self.cv.notify_all()
            if pervyy:
                metka('sintez', k.uid, '%.2f' % (time.time() - t0))

    def gotovyy(self, tekst, temp, put):
        """Синтез с кэшем: короткая фраза, уже сказанная раньше, берётся
        готовым файлом — без похода в сеть (сотни мс)."""
        if len(tekst) > 80:
            return self.sintez(tekst, temp, put)
        f = kesh(tekst, temp)
        try:
            shutil.copyfile(f, put)
            os.utime(f)
            return True
        except OSError:
            pass
        if not self.sintez(tekst, temp, put):
            return False
        try:
            os.makedirs(KESH, exist_ok=True)
            shutil.copyfile(put, f + '.tmp')
            os.replace(f + '.tmp', f)
            vse = sorted((os.path.join(KESH, x) for x in os.listdir(KESH)), key=os.path.getmtime)
            for x in vse[:-300]:
                os.remove(x)
        except OSError:
            pass
        return True

    def bez_seti(self):
        """Синтез не вышел: речь не умирает молча — «голос без сети» из кэша."""
        if time.time() - self.bez_seti_t < 60 or not os.path.exists(kesh(BEZ_SETI, TEMP)):
            return
        self.bez_seti_t = time.time()
        metka('bezseti', '-')
        put = os.path.join(MP3, 'bez-seti.mp3')
        try:
            shutil.copyfile(kesh(BEZ_SETI, TEMP), put)
        except OSError:
            return
        log('синтез не вышел — сказала «голос без сети»')
        self.igrok = self.Most(put, 'uho') if self.rezhim == 'uho' else self.Termux(put)
        self.igrok.vne_ocheredi = True

    def progret(self):
        """Частые фразы ушей — в кэш заранее, в тишине."""
        for t in ZARANEE:
            put = os.path.join(MP3, 'progrev.mp3')
            self.gotovyy(t, TEMP, put)
            try:
                os.remove(put)
            except OSError:
                pass

    def shag(self):
        self.priyom()
        self.upravlenie()
        self.igra()


def zamok():
    """Один демон: замок держится, пока процесс жив. Две попытки — на случай,
    если хук в этот миг проверяет замок сам."""
    f = open(LOCK, 'w')
    for _ in range(4):
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return f
        except BlockingIOError:
            time.sleep(0.1)
    return None


def nuzhen_drugoy_python():
    """edge-tts стоит через pipx — модуль виден только его Python. Берём его
    из первой строки программы edge-tts."""
    try:
        __import__('edge_tts')
        return None
    except ImportError:
        pass
    exe = shutil.which('edge-tts')
    if not exe or os.environ.get('GOLOS_PEREZAPUSK'):
        return None
    try:
        line = open(exe, 'rb').readline().decode('utf-8', 'replace')
    except OSError:
        return None
    if line.startswith('#!'):
        py = line[2:].strip().split()[0]
        if 'python' not in os.path.basename(py):
            return None                       # не Python (обёртка) — останемся сами
        # Python из pipx — ссылка на тот же системный python3, но запущенный по
        # своему пути он видит свою папку пакетов. Поэтому сравниваем пути как
        # есть, без раскрытия ссылок (realpath дал бы «тот же» — и демон молча
        # остался бы на медленной программе edge-tts).
        if os.path.exists(py) and os.path.abspath(py) != os.path.abspath(sys.executable):
            return py
    return None


def demon():
    py = nuzhen_drugoy_python()
    if py:
        os.environ['GOLOS_PEREZAPUSK'] = '1'
        os.execv(py, [py, ME])
    z = zamok()
    if z is None:
        return 0                            # уже говорит другой
    for d in (Q, MP3):
        os.makedirs(d, exist_ok=True)
    for f in os.listdir(MP3):
        try:
            os.remove(os.path.join(MP3, f))
        except OSError:
            pass
    open(PID, 'w').write(str(os.getpid()))
    try:                                    # лог голоса не растёт вечно
        if os.path.getsize('/tmp/golos.log') > 1024 * 1024:
            os.replace('/tmp/golos.log', '/tmp/golos.log.1')
            f = os.open('/tmp/golos.log', os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
            os.dup2(f, 1)
            os.dup2(f, 2)
    except OSError:
        pass
    g = Golos()
    log('голос готов:', 'edge-tts в памяти' if g.sintez.mod else 'программа edge-tts',
        '· режим', g.rezhim)
    threading.Thread(target=g.gotovit, daemon=True).start()
    threading.Thread(target=g.progret, daemon=True).start()
    st = os.path.getmtime(ME)
    n = 0
    while True:
        try:
            g.shag()
        except Exception as e:
            log('сбой шага:', type(e).__name__, e)
        n += 1
        if n % 50 == 0:                      # ~2 с: обновили golos — перезапуск в тишине
            try:
                nov = os.path.getmtime(ME)
            except OSError:
                nov = st
            if nov != st and not g.q and not g.igrok:
                time.sleep(1)
                try:
                    compile(open(ME).read(), ME, 'exec')
                    log('golos обновлён — перезапуск')
                    z.close()
                    os.execv(sys.executable, [sys.executable, ME])
                except (OSError, SyntaxError) as e:
                    log('новый golos с ошибкой:', e)
                    st = nov
        time.sleep(0.04)


