def iz_transkripta(raw, hvost=262144):
    """JSON хука PreToolUse → текст, который Плюс написал перед этим
    инструментом («Сейчас посмотрю…»): последняя запись ассистента с текстом
    в хвосте журнала разговора. Хук Stop говорит только последний ответ —
    без этого вступление не звучало вовсе, а теперь звучит, пока работает
    инструмент. Вернёт (id сообщения, текст)."""
    try:
        put = json.loads(raw).get('transcript_path') or ''
        with open(put, 'rb') as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - hvost))
            lines = f.read().decode('utf-8', 'replace').splitlines()
    except (ValueError, OSError):
        return None, ''
    for line in reversed(lines):
        try:
            z = json.loads(line)
        except ValueError:
            continue
        if z.get('type') == 'user' and isinstance((z.get('message') or {}).get('content'), str):
            break                                 # дошли до реплики Александра
        if z.get('type') != 'assistant':
            continue
        m = z.get('message') or {}
        t = ' '.join(x.get('text', '') for x in m.get('content') or []
                     if isinstance(x, dict) and x.get('type') == 'text').strip()
        if t:
            return m.get('id') or z.get('uuid'), t
    return None, ''


