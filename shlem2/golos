EMODZI = re.compile('[\U0001F000-\U0001FAFF☀-➿️‍]')
KODY = [(re.compile(r'\bплюс[\s,.!-]+тихо\b', re.I), 'команда тихо'),
        (re.compile(r'\bплюс[\s,.!-]+плюс\b', re.I), 'двойной плюс'),
        (re.compile(r'\bзум[\s,.!-]+зум\b', re.I), 'двойной зум'),
        (re.compile(r'\b(?:копи|капи|copy)[\s,.!-]+(?:копи|капи|copy)\b', re.I), 'двойное копи'),
        (re.compile(r'\bplus[\s,.!-]+plus\b', re.I), 'double plus'),
        (re.compile(r'\bzoom[\s,.!-]+zoom\b', re.I), 'double zoom')]


def dlya_uha(t, predel=1500):
    """Из ответа — то, что можно сказать: без кода, ссылок, путей и разметки.
    Строка без точки в конце (пункт списка, заголовок) получает точку — иначе
    голос сливает пункты в одно предложение."""
    t = re.sub(r'```.*?```', ' ', t, flags=re.S)                 # блоки кода не читаем
    t = re.sub(r'`([^`\n]{1,24})`',                              # короткое слово в `` — читаем
               lambda m: m.group(1) if re.fullmatch(r'[\w\- .]+', m.group(1)) else ' ', t)
    t = re.sub(r'`[^`\n]*`', ' ', t)
    t = re.sub(r'\[([^\]]+)\]\([^)]+\)', r'\1', t)               # [текст](ссылка) → текст
    t = re.sub(r'https?://\S+', ' ', t)
    t = re.sub(r'(?<![\w.])(?:~|\.{1,2})?/[\w.\-/]+', ' ', t)     # пути /root/view.jpg, ~/x
    t = t.replace('→', ' — ').replace('✓', ' ').replace('✗', ' ')
    # Кодовые фразы Ава не произносит буквально: микрофон услышал бы её саму, и
    # уши разбудили бы Плюса её голосом. Смысл остаётся понятным.
    for shablon, zamena in KODY:
        t = shablon.sub(zamena, t)
    t = EMODZI.sub('', t)
    stroki = []
    for s in t.split('\n'):
        s = re.sub(r'^\s*(?:[-•*+]|\d+[.)])\s+', '', s)           # маркеры списков
        s = re.sub(r'[*_#>|]+', ' ', s).strip()
        if not s or re.fullmatch(r'[\s\-—:=]+', s):
            continue
        if s[-1] not in '.!?…:;,':
            s += '.'
        stroki.append(s)
    t = ' '.join(stroki)
    t = re.sub(r'\s*:\s*(?=[.!?…]|$)', '.', t)                   # «вот так:» без самого кода
    t = re.sub(r'\s+([.,!?…:;])', r'\1', t)
    t = re.sub(r'([.!?…])[.:;]+', r'\1', t)
    t = re.sub(r'\s+', ' ', t).strip()
    if len(t) > predel:
        t = t[:predel].rsplit('. ', 1)[0] + '.'
    return t


def kuski(t, predel=220, pervyy=100):
    """По предложению на кусок: на «плюс плюс» Ава продолжит с начала
    прерванного предложения. Длинное — режем по запятой. Первый кусок —
    до первой запятой: первый звук раньше."""
    out = []
    for f in re.split(r'(?<=[.!?…])\s+', t.strip()):
        f = f.strip()
        while len(f) > predel:
            cut = max(f.rfind(', ', 0, predel), f.rfind('; ', 0, predel), f.rfind(' — ', 0, predel))
            if cut < predel // 3:
                cut = f.rfind(' ', 0, predel)
            if cut <= 0:
                break
            out.append(f[:cut + 1].strip())
            f = f[cut + 1:].strip()
        if re.search(r'\w', f):
            out.append(f)
    if out:
        c = out[0].find(', ')
        if 3 <= c <= pervyy and len(out[0]) - c > 25:
            out[0:1] = [out[0][:c + 1], out[0][c + 2:]]
    return out


def porcii(t, pervyy=100):
    """Куски (по предложению) — в порции (12.10): кусок был и единицей перебивания, и единицей
    работы — 6 кусков на ответ в 333 знака, на каждый запуск play-audio, titr, соединение синтеза.
    Теперь работа — порцией, а предложения остаются метками внутри неё. Первая порция — первый
    кусок, как был (первый звук не позже); вторая — до PORCIYA[0] знаков, дальше — до PORCIYA[1].
    Список порций, каждая — список предложений."""
    out = []
    for k in kuski(t, pervyy=pervyy):
        if out and (len(out) > 1 or not pervyy):
            predel = PORCIYA[0] if len(out) == (2 if pervyy else 1) else PORCIYA[-1]
            if len(' '.join(out[-1] + [k])) <= predel:
                out[-1].append(k)
                continue
        out.append([k])
    return out


def razmetka(predl, sobytiya, dlit):
    """Где в звуке порции начинается каждое предложение (с от начала). sobytiya — границы фраз или
    слов от edge-tts: (с, длительность, текст); нет их или не сошлись — по доле знаков от dlit."""
    nachala = [0]
    for f in predl[:-1]:
        nachala.append(nachala[-1] + len(f) + 1)
    vse = max(1, nachala[-1] + len(predl[-1]))
    otvet = [None] * len(predl)
    if sobytiya:
        tekst = ' '.join(predl).lower()
        poz = 0
        for t, _, slova in sobytiya:
            slova = (slova or '').strip().lower()
            if not slova:
                continue
            i = tekst.find(slova, poz)
            if i < 0:
                i = tekst.find(slova.split()[0], poz)
            if i < 0:
                continue
            poz = i + 1
            for j, n in enumerate(nachala):
                if otvet[j] is None and n <= i:
                    otvet[j] = t
    for j, n in enumerate(nachala):
        if otvet[j] is None:
            otvet[j] = dlit * n / vse
    otvet[0] = 0.0
    for j in range(1, len(otvet)):                 # время не идёт назад
        otvet[j] = max(otvet[j], otvet[j - 1])
    return otvet


def zagruzit_titr():
    """titr как модуль (12.10): перевод и показ субтитров — внутри голоса, без запуска программы
    на каждую фразу. Нет titr или старый (без perevod_mnogo) — субтитров нет."""
