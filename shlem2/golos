class Sintez:
    """edge-tts в этом же процессе: без запуска Python на каждый кусок.
    Модуля нет — зовём программу edge-tts (медленнее, но говорит)."""

    def __init__(self):
        try:
            import asyncio
            import edge_tts
            self.asyncio, self.mod = asyncio, edge_tts
        except ImportError:
            self.mod = None
        self.exe = shutil.which('edge-tts')
        self.tl = threading.local()      # границы фраз последнего синтеза — своему потоку

    @property
    def metki(self):
        """Границы фраз (или слов) последнего синтеза этого потока: [(с, длительность, текст)]."""
        return getattr(self.tl, 'metki', None)

    def __call__(self, tekst, temp, put, golos=None):
        """golos — чей голос (по умолчанию Ава; соведущая — VOICE_VED). True — звук готов. None —
        сказать нечего: edge-tts не вернул звука (одни знаки, смайлы), сеть ни при чём. False — не
        вышел ни с одной из попыток (12.10: их четыре, с паузами PAUZY_SINTEZA — 11.10 вечером
        сервис часто отвечал «403», и двух попыток не хватало)."""
        tmp = put + '.tmp'
        self.tl.metki = None
        eg = None if golos else eleven_golos()
        if eg and re.search(r'[^\W\d_]', tekst):              # 2.7.8: свой голос (ElevenLabs); не вышло — Эндрю
            if eleven_sintez(tekst, temp, tmp, eg) and os.path.getsize(tmp) > 0:
                os.replace(tmp, put)
                return True
            self.ubrat(tmp)
        for popytka in range(1, len(PAUZY_SINTEZA) + 2):
            try:
                if self.mod:
                    metki = []

                    async def go():
                        c = self.mod.Communicate(tekst, golos or golos_plusa(), rate=temp,
                                                 pitch='-%dHz' % (0 if golos else ton()))   # Плюс — ниже (30.10)
                        with open(tmp, 'wb') as f:
                            async for ch in c.stream():
                                if ch['type'] == 'audio':
                                    f.write(ch['data'])
                                elif ch['type'] in ('SentenceBoundary', 'WordBoundary'):
                                    metki.append((ch.get('offset', 0) / 1e7, ch.get('duration', 0) / 1e7,
                                                  ch.get('text', '')))
                    self.asyncio.run(go())
                    self.tl.metki = metki or None
                elif self.exe:
                    subprocess.run([self.exe, '--voice', golos or golos_plusa(), '--rate=' + temp,
                                    '--pitch=-%dHz' % (0 if golos else ton()), '--text', tekst,
                                    '--write-media', tmp], stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL, timeout=30)
                if os.path.getsize(tmp) > 0:
                    os.replace(tmp, put)
                    return True
            except Exception as e:
                # 19.10 вечером сервис 30 раз вернул пустоту на обычные фразы («Hi there!», «Я тут, слушаю.») —
                # это сбой, не «одни знаки»: фраза с буквами пробует ещё (те же паузы), пустая — сразу молчит
                if type(e).__name__ == 'NoAudioReceived' and (not re.search(r'[^\W\d_]', tekst)
                                                               or popytka > len(PAUZY_SINTEZA)):
                    log('нечего сказать: edge-tts не вернул звука —', tekst[:60])
                    self.ubrat(tmp)
                    return None
                log('синтез не вышел (попытка %d):' % popytka, type(e).__name__, str(e)[:120])
            if popytka <= len(PAUZY_SINTEZA):
                time.sleep(PAUZY_SINTEZA[popytka - 1])
        self.ubrat(tmp)
        return False

    @staticmethod
    def ubrat(tmp):
        try:
            os.remove(tmp)
        except OSError:
            pass


