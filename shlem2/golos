def log(*a):
    print(time.strftime('%H:%M:%S'), *a, flush=True)


def kesh(tekst, temp):
    """Файл короткой фразы в кэше."""
    return os.path.join(KESH, hashlib.sha1(('%s|%s|%s' % (VOICE, temp, tekst)).encode()).hexdigest()
                        + '.mp3')


def metka(imya, uid, dop=''):
    """Метка задержки: мс, что, чья реплика. Смотреть — zamer."""
    try:
        with open(ZAMER, 'a') as f:
            f.write('%d\t%s\t%s\t%s\n' % (time.time() * 1000, imya, uid, dop))
    except OSError:
        pass


def vremya(put):
    """Время из управляющего файла; нет файла или недописан — 0."""
    try:
        return float(open(put).read().strip() or 0)
    except (OSError, ValueError):
        return 0.0


# ---------- текст для уха ----------

EMODZI = re.compile('[\U0001F000-\U0001FAFF☀-➿️‍]')
KODY = [(re.compile(r'\bплюс[\s,.!-]+тихо\b', re.I), 'команда тихо'),
        (re.compile(r'\bплюс[\s,.!-]+плюс\b', re.I), 'двойной плюс'),
        (re.compile(r'\bзум[\s,.!-]+зум\b', re.I), 'двойной зум'),
        (re.compile(r'\b(?:копи|капи|copy)[\s,.!-]+(?:копи|капи|copy)\b', re.I), 'двойное копи'),
        (re.compile(r'\bplus[\s,.!-]+plus\b', re.I), 'double plus'),
        (re.compile(r'\bzoom[\s,.!-]+zoom\b', re.I), 'double zoom')]


def dlya_uha(t, predel=1500):
    """Из ответа — то, что можно сказать: без кода, ссылок, путей и разметки.
    Строка без точки в конце (пункт списка, заголовок) получает точку — иначе
    голос сливает пункты в одно предложение."""
    t = re.sub(r'```.*?```', ' ', t, flags=re.S)                 # блоки кода не читаем
    t = re.sub(r'`([^`\n]{1,24})`',                              # короткое слово в `` — читаем
               lambda m: m.group(1) if re.fullmatch(r'[\w\- .]+', m.group(1)) else ' ', t)
    t = re.sub(r'`[^`\n]*`', ' ', t)
    t = re.sub(r'\[([^\]]+)\]\([^)]+\)', r'\1', t)               # [текст](ссылка) → текст
    t = re.sub(r'https?://\S+', ' ', t)
    t = re.sub(r'(?<![\w.])(?:~|\.{1,2})?/[\w.\-/]+', ' ', t)     # пути /root/view.jpg, ~/x
    t = t.replace('→', ' — ').replace('✓', ' ').replace('✗', ' ')
    # Кодовые фразы Ава не произносит буквально: микрофон услышал бы её саму, и
    # уши разбудили бы Плюса её голосом. Смысл остаётся понятным.
    for shablon, zamena in KODY:
        t = shablon.sub(zamena, t)
    t = EMODZI.sub('', t)
    stroki = []
    for s in t.split('\n'):
        s = re.sub(r'^\s*(?:[-•*+]|\d+[.)])\s+', '', s)           # маркеры списков
        s = re.sub(r'[*_#>|]+', ' ', s).strip()
        if not s or re.fullmatch(r'[\s\-—:=]+', s):
            continue
        if s[-1] not in '.!?…:;,':
            s += '.'
        stroki.append(s)
    t = ' '.join(stroki)
    t = re.sub(r'\s*:\s*(?=[.!?…]|$)', '.', t)                   # «вот так:» без самого кода
    t = re.sub(r'\s+([.,!?…:;])', r'\1', t)
    t = re.sub(r'([.!?…])[.:;]+', r'\1', t)
    t = re.sub(r'\s+', ' ', t).strip()
    if len(t) > predel:
        t = t[:predel].rsplit('. ', 1)[0] + '.'
    return t


def kuski(t, predel=220, pervyy=100):
    """По предложению на кусок: на «плюс плюс» Ава продолжит с начала
    прерванного предложения. Длинное — режем по запятой. Первый кусок —
    до первой запятой: первый звук раньше."""
    out = []
    for f in re.split(r'(?<=[.!?…])\s+', t.strip()):
        f = f.strip()
        while len(f) > predel:
            cut = max(f.rfind(', ', 0, predel), f.rfind('; ', 0, predel), f.rfind(' — ', 0, predel))
            if cut < predel // 3:
                cut = f.rfind(' ', 0, predel)
            if cut <= 0:
                break
            out.append(f[:cut + 1].strip())
            f = f[cut + 1:].strip()
        if re.search(r'\w', f):
            out.append(f)
    if out:
        c = out[0].find(', ')
        if 3 <= c <= pervyy and len(out[0]) - c > 25:
            out[0:1] = [out[0][:c + 1], out[0][c + 2:]]
    return out


def iz_huka(raw):
    """JSON хука Stop → текст ответа."""
    try:
        return json.loads(raw).get('last_assistant_message') or ''
    except ValueError:
        return ''


def iz_transkripta(raw, hvost=262144):
    """JSON хука PreToolUse → текст, который Плюс написал перед этим
    инструментом («Сейчас посмотрю…»): последняя запись ассистента с текстом
    в хвосте журнала разговора. Хук Stop говорит только последний ответ —
    без этого вступление не звучало вовсе, а теперь звучит, пока работает
    инструмент. Вернёт (id сообщения, текст)."""
    try:
        put = json.loads(raw).get('transcript_path') or ''
        with open(put, 'rb') as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - hvost))
            lines = f.read().decode('utf-8', 'replace').splitlines()
    except (ValueError, OSError):
        return None, ''
    for line in reversed(lines):
        try:
            z = json.loads(line)
        except ValueError:
            continue
        if z.get('type') == 'user' and isinstance((z.get('message') or {}).get('content'), str):
            break                                 # дошли до реплики Александра
        if z.get('type') != 'assistant':
            continue
        m = z.get('message') or {}
        t = ' '.join(x.get('text', '') for x in m.get('content') or []
                     if isinstance(x, dict) and x.get('type') == 'text').strip()
        if t:
            return m.get('id') or z.get('uuid'), t
    return None, ''


# ---------- синтез ----------

class Sintez:
    """edge-tts в этом же процессе: без запуска Python на каждый кусок.
    Модуля нет — зовём программу edge-tts (медленнее, но говорит)."""

    def __init__(self):
        try:
            import asyncio
            import edge_tts
            self.asyncio, self.mod = asyncio, edge_tts
        except ImportError:
            self.mod = None
        self.exe = shutil.which('edge-tts')

    def __call__(self, tekst, temp, put):
        tmp = put + '.tmp'
        try:
            if self.mod:
                async def go():
                    c = self.mod.Communicate(tekst, VOICE, rate=temp)
                    with open(tmp, 'wb') as f:
                        async for ch in c.stream():
                            if ch['type'] == 'audio':
                                f.write(ch['data'])
                self.asyncio.run(go())
            elif self.exe:
                subprocess.run([self.exe, '--voice', VOICE, '--rate=' + temp, '--text', tekst,
                                '--write-media', tmp], stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, timeout=30)
            if os.path.getsize(tmp) > 0:
                os.replace(tmp, put)
                return True
        except Exception as e:
            log('синтез не вышел:', type(e).__name__, str(e)[:120])
        try:
            os.remove(tmp)
        except OSError:
            pass
        return False


# ---------- проигрыватели ----------

def titr_plus(tekst, put):
    """Кусок звучит вслух — субтитр по-английски внизу кадра эфира (titr переводит и шлёт сам,
    в фоне: голос не ждёт). Нет titr или эфира — ничего."""
    if not os.path.exists(TITR):
        return
    try:
        sek = ['--sek', '%.1f' % (os.path.getsize(put) / 6000.0 + 0.8)]
    except OSError:
        sek = []
    try:
        subprocess.Popen([TITR, 'plus'] + sek + ['--', tekst], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


class Rot:
    """Рот лица Плюса в эфире (приложение 2.2.6): play-audio Termux приложение не слышит —
    говорим ему сами: «звучу N с» (GET /say/rot?sek=N) и «замолчала» (sek=0). Один поток с
    очередью: «замолчала» прежнего куска не обгонит «звучу» следующего. Приложения нет — молча."""
    q = queue.Queue()
    potok = None
    lock = threading.Lock()

    @classmethod
    def skazat(cls, sek):
        with cls.lock:
            if cls.potok is None:
                cls.potok = threading.Thread(target=cls.run, daemon=True)
                cls.potok.start()
        cls.q.put(sek)

    @classmethod
    def run(cls):
        while True:
            sek = cls.q.get()
            try:
                urllib.request.urlopen('%s/say/rot?sek=%.1f' % (MOST, sek), timeout=1).read()
            except Exception:
                pass


class Termux:
    """play-audio Termux: звук идёт в общий микс — его пишет и стрим."""

    def __init__(self, put):
        self.p = subprocess.Popen([PLAY, put], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        try:                               # edge-tts: 48 кбит/с — 6000 байт на секунду звука
            dl = os.path.getsize(put) / 6000.0
        except OSError:
            dl = 5.0
        self.rot = True
        Rot.skazat(min(60.0, dl + 1.5))    # запас: «замолчала» потеряется — рот встанет сам

    def molchu(self):
        if self.rot:
            self.rot = False
            Rot.skazat(0)

    def konec(self):
        if self.p.poll() is None:
            return None
        self.molchu()
        return 'done'                      # код play-audio не важен: дальше

    def stop(self):
        if self.p.poll() is None:
            self.p.terminate()
            try:
                self.p.wait(2)
            except subprocess.TimeoutExpired:
                self.p.kill()
        self.molchu()


class Most:
    """Играет приложение-мост (POST /say): «uho» — звук помечен «не записывать»,
    захват стрима его пропускает. Ответ приходит, когда кусок доиграл."""

    def __init__(self, put, rezhim):
        self.res, self.err = None, ''
        threading.Thread(target=self.run, args=(put, rezhim), daemon=True).start()

    def run(self, put, rezhim):
        try:
            req = urllib.request.Request('%s/say?mode=%s' % (MOST, rezhim), data=open(put, 'rb').read(),
                                         method='POST', headers={'Content-Type': 'audio/mpeg'})
            with urllib.request.urlopen(req, timeout=180) as r:
                self.res = json.loads(r.read().decode() or '{}').get('end', 'done')
        except Exception as e:
            self.err = '%s %s' % (type(e).__name__, str(e)[:80])
            self.res = 'error'

    def konec(self):
        return self.res

    def stop(self):
        try:
            urllib.request.urlopen(MOST + '/say/stop', timeout=2).read()
        except Exception:
            pass


def most_umeet():
    """Мост умеет играть (/say/status) — без этого режим «в ухо» невозможен."""
    try:
        with urllib.request.urlopen(MOST + '/say/status', timeout=2) as r:
            return r.status == 200
    except Exception:
        return False


