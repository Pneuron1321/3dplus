#!/bin/sh
# scena — сцены во весь кадр эфира поверх игры (мост 2.7.0, оформление «Визор»): заставка до начала,
# шторка на перерыв, итоги в конце. Живёт до `scena net` или конца эфира; поставленная до эфира —
# встанет в кадр с его началом. Подписи сцен — по-английски крупно и по-русски строкой ниже.
#   scena skoro [5] [фраза]   — «Скоро начнём»: Плюс в полный рост, таймер на 5 минут, фраза Плюса
#   scena otoshyol [3] [фраза] — «Отошёл»: шторка «Саша скоро вернётся» (таймер — если дать минуты)
#   scena konec               — «Конец эфира»: итоги вечера в стиле визора
#   scena net                 — убрать сцену (в кадре снова игра)
#   scena                     — какая сейчас
# Логика — в plus-lib (одна на скрипт и plus-mcp).
L=${0%/*}/plus-lib; [ -f "$L" ] || L=/usr/local/bin/plus-lib
exec python3 -S "$L" scena "$@"
