#!/bin/sh
# klipy — страница «Клипы» для айфона (2.7.0): клипы галереи шлема «Фильмы/Plus» (игра — Мост 3,
# камера — мост 2), новые сверху: кадр, длительность, размер, смотреть и «Скачать». Открыта 15 минут
# по домашней Wi-Fi; адрес с одноразовым ключом — только на экране приложения 2 (не здесь и не голосом).
#   klipy          — открыть (или продлить) на 15 минут
#   klipy zakryt   — закрыть сразу: адрес больше не открывается
#   klipy status   — открыта ли, сколько осталось, сколько клипов
L=${0%/*}/plus-lib; [ -f "$L" ] || L=/usr/local/bin/plus-lib
exec python3 -S "$L" klipy "$@"
