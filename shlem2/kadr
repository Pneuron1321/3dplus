#!/bin/sh
# kadr — один взгляд Плюса: свежий кадр шлема в /root/view.jpg
#   kadr          — весь вид, 768 px (≈450 токенов)
#   kadr x2       — «зум зум»: вдвое больше точек, 1086 px (≈900 токенов)
#   kadr x4       — «зум зум зум»: вчетверо, 1536 px (≈1800 токенов)
#   kadr centr    — «зум зум центр»: центр вида в полном разрешении, 960×540 (≈700 токенов)
#   kadr plenka [мс] [7|13] — плёнка: 13 кадров через 0,5 с, от −3 до +3 с вокруг «плюс плюс»
#                   (или момента мс), одной картинкой 1536×864 (≈1800 токенов) — «зум чек»;
#                   7 кадров, от −1,5 до +1,5 с, 1536×432 (≈900 токенов) — «чек чек»
#   kadr moment мс — кадр того момента из плёнки (последние 30 с; приложение 2.3.9) — так уши берут
#                   кадр вызова для «посмотри», не снимая его на каждое «плюс плюс»
# С 12.10 (этап 2 плана эфира) логика — в plus-lib: одна на этот скрипт и на plus-mcp, через
# который Плюс зовёт kadr без нового процесса на вызов.
L=${0%/*}/plus-lib; [ -f "$L" ] || L=/usr/local/bin/plus-lib
exec python3 -S "$L" kadr "$@"
