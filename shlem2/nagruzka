            r = subprocess.run(['tmux', 'list-panes', '-t', 'plus', '-F', '#{pane_pid}'], capture_output=True,
                               text=True, timeout=3)
            KORNI_KESH[1] = set(r.stdout.split())
        except Exception:
            KORNI_KESH[1] = set()
        KORNI_KESH[0] = time.time()
    return KORNI_KESH[1]


KORNI_KESH = [0.0, set()]


def svoy_uid(pid):
    """Процесс того же пользователя, что и мы (Termux/Ubuntu); игра, мост и система — чужие."""
    try:
        return os.stat('/proc/%s' % pid).st_uid == os.getuid()
    except OSError:
        return False


def predki(pid):
    res, p, n = set(), PPID.get(pid), 0
    while p and p not in ('0', '1') and n < 64:
        res.add(p)
        p, n = PPID.get(p), n + 1
    return res


def verh_pomoshchnika(pid, kor):
    """Верхний процесс дерева помощника, к которому относится pid, или None (свой, Плюс, система).
    18.10: на Android все приложения (игра, мост, сам Termux) растут из одного системного zygote — поэтому
    чужие (другой пользователь) и всё, что выше окна Плюса (общие предки), помощником не бывают никогда."""
    p, verh, n = pid, None, 0
    moy = str(os.getpid())
    while p and n < 64:
        if p == moy or p in kor:
            return verh if p in kor else None
        if not svoy_uid(p) or any(x in SVOI for x in imena_procesa(p)):
            return None
        rod = PPID.get(p)
        if rod in (None, '0', '1') or rod not in PPID:
            # сирота (родитель — init): помощник, если он не предок окна Плюса и не наш
            return None if any(p in predki(k) for k in kor) or p in predki(moy) else p
        if not svoy_uid(rod):
            return None                               # ребёнок системы (сам Termux) — не помощник
        verh, p, n = p, rod, n + 1
    return None


def yadro_slaboe():
    """Самое слабое из доступных ядер (меньше всех частота), иначе первое доступное."""
    dostupno = sorted(os.sched_getaffinity(0))
    def chastota(c):
        try:
            return int(open('/sys/devices/system/cpu/cpu%d/cpufreq/cpuinfo_max_freq' % c).read())
        except (OSError, ValueError):
            return 1 << 40
    return min(dostupno, key=lambda c: (chastota(c), c))


def potoki(pid):
    try:
        return [int(t) for t in os.listdir('/proc/%s/task' % pid)]
    except OSError:
        return []


def poderevo(verh, kor=()):
    """verh и все его потомки (по последнему снимку) — кроме своих демонов, окна Плюса, чужих и всего под ними."""
    deti, res, ochered = {}, [], [verh]
    for p, r in PPID.items():
        deti.setdefault(r, []).append(p)
    moy = str(os.getpid())
    while ochered:
        p = ochered.pop()
        if p != verh and (p in kor or p == moy or not svoy_uid(p) or any(x in SVOI for x in imena_procesa(p))):
            continue
        res.append(p)
        ochered.extend(deti.get(p, []))
    return res


def prizhat(pid, yadro=None):
    """Низший приоритет (SCHED_IDLE, nice 19) — скорость обычная, но любое своё дело и игра впереди; yadro — ещё и
    на одно ядро (когда эфиру тесно)."""
    for t in potoki(pid):
        for f in ((lambda: os.sched_setaffinity(t, {yadro})) if yadro is not None else (lambda: None),
                  lambda: os.sched_setscheduler(t, os.SCHED_IDLE, os.sched_param(0)),
                  lambda: os.setpriority(os.PRIO_PROCESS, t, 19)):
            try:
                f()
            except (OSError, AttributeError):
                pass


def otpustit_pid(pid):
    vse = os.sched_getaffinity(0)
    for t in potoki(pid):
        for f in (lambda: os.sched_setaffinity(t, vse),
                  lambda: os.sched_setscheduler(t, os.SCHED_OTHER, os.sched_param(0)),
                  lambda: os.setpriority(os.PRIO_PROCESS, t, NICE_BYLO)):
            try:
                f()
            except (OSError, AttributeError):
                pass


