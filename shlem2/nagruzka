POVODOK_VYKL = os.environ.get('NAGRUZKA_POVODOK_VYKL', '/root/.nagruzka-povodok-vykl')
GOLOS_Q = os.environ.get('NAGRUZKA_GOLOS_Q', '/tmp/golos/q')
KORNI = os.environ.get('NAGRUZKA_KORNI', '')                  # проверка: pid вместо окна tmux
SVOI = {'ushi', 'sluh', 'golos', 'skazhi', 'tiho', 'sinhron', 'gosti', 'cloudflared', 'vedushchiy', 'muzyka', 'obzor',
        'donaty', 'zriteli', 'raciya', 'nagruzka', 'nagruzka-demon', 'plus', 'plus-mcp', 'golos-hook', 'tmux',
