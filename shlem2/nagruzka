NICE_BYLO = 10                                    # так plus ставит своим (12.10)


def imena_procesa(pid):
    try:
        c = open('/proc/%s/comm' % pid).read().strip()
        a = open('/proc/%s/cmdline' % pid, 'rb').read().split(b'\0')
    except OSError:
        return []
    return [c] + [os.path.basename(x.decode('utf-8', 'replace')) for x in a[:3] if x]


def korotkoe_imya(pid):
    """Имя для уха и журнала — без аргументов (в них бывают адреса и ключи): программа, у интерпретатора — скрипт."""
    im = imena_procesa(pid) or ['?']
    c = im[0]
    if re.match(r'^(python\d*(\.\d+)?|bash|sh|dash|node)$', c) and len(im) > 2 and re.match(r'^[A-Za-z0-9._-]+$', im[2]) \
            and not im[2].startswith('-'):
        return '%s:%s' % (c, im[2])
    return c


def korni():
    """pid Claude Плюса — то, что запущено в окне tmux «plus» (раз в 30 с)."""
    if KORNI:
        return set(KORNI.split(','))
    if time.time() - KORNI_KESH[0] > 30:
        try:
