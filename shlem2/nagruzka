    import signal
    versiya = os.path.getmtime(SKRIPT) if os.path.exists(SKRIPT) else 0
    imena, t0, e0, m0, posl = {}, tiki(), efir(), time.time(), 0.0
    pov = Povodok()

    def proch(*_):                                # выходим — никого не оставляем прижатым
        pov.vse_otpustit()
        pov.zapisat()
        sys.exit(0)
    signal.signal(signal.SIGTERM, proch)
    signal.signal(signal.SIGHUP, proch)
    while True:
        time.sleep(SHAG)
        if os.path.exists(SKRIPT) and os.path.getmtime(SKRIPT) != versiya:
