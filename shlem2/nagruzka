#!/bin/sh
# nagruzka — что открыто в шлеме и что его грузит: программы Termux и Ubuntu по именам, сколько
# штук каждой, память, процессор сейчас, сколько живут; лишние копии — предупреждение.
# Печатает только имена программ (у python/node/sh — имя скрипта), без аргументов: в них бывают
# ключи и адреса. Приложения Android (бридж, игра) отсюда не видно — только через adb с ноутбука.
#   nagruzka        — сводка (меряет процессор 3 с)
# Работает и в обычном Termux, и в Ubuntu (proot-distro login plus2).
#   nagruzka zhurnal [часов] — что было по 5 минут (по умолчанию 4 ч): сообщений в чате, пачек
#                    чата Плюсу, память Termux, свободно у шлема, приложение, просьбы системы отдать память
if [ "$1" = zhurnal ]; then
  python3 - "${2:-4}" "${NAGRUZKA_URL:-http://localhost:8766}" <<'PY'
import datetime as dt, re, sys, urllib.request
CHASOV, URL = float(sys.argv[1]), sys.argv[2]
seychas = dt.datetime.now()
nachalo = seychas - dt.timedelta(hours=CHASOV)
b = {}                                          # «корзина» по 5 мин → что было


def korz(t):
    return t.replace(minute=t.minute - t.minute % 5, second=0, microsecond=0)


def k(t):
    return b.setdefault(korz(t), {'chat': 0, 'plusu': 0, 'termux': 0, 'svob': None, 'pril': 0, 'graf': 0,
                                  'efir': '', 'sob': []})


def stroki(put):
    try:
        return open(put, encoding='utf-8', errors='replace').read().splitlines()
    except OSError:
        return []


def bez_daty(linii, rx):
    """Журналы только со временем (ЧЧ:ММ): даты — с конца назад, через полночь — на день раньше."""
    den, pred, out = seychas.date(), None, []
    for l in reversed(linii):
        m = re.match(rx, l)
        if not m:
            continue
        hh, mm = int(m.group(1)), int(m.group(2))
        t = dt.datetime.combine(den, dt.time(hh, mm))
        if pred is not None and t > pred:
            den -= dt.timedelta(days=1)
            t -= dt.timedelta(days=1)
        if t > seychas + dt.timedelta(minutes=1):
            den -= dt.timedelta(days=1)
            t -= dt.timedelta(days=1)
        pred = t
        out.append((t, l))
    return out


def s_datoy(l):
    m = re.match(r'(\d\d)\.(\d\d) (\d\d):(\d\d):(\d\d) ', l)
    if not m:
        return None
    d, mo, hh, mi, ss = map(int, m.groups())
    t = dt.datetime(seychas.year, mo, d, hh, mi, ss)
    return t if t <= seychas + dt.timedelta(days=1) else t.replace(year=seychas.year - 1)


for t, l in bez_daty(stroki('/tmp/chat.log'), r'(\d\d):(\d\d) '):
    k(t)['chat'] += 1
for t, l in bez_daty(stroki('/tmp/ushi.log'), r'(\d\d):(\d\d):\d\d '):
    if 'чат → Плюсу' in l:
        k(t)['plusu'] += 1
    elif 'потолок' in l:
        k(t)['sob'].append('чат: потолок')
    elif 'Traceback' in l or 'Error' in l:
        k(t)['sob'].append('уши: ошибка')
for l in stroki('/tmp/pamyat.log'):
    t = s_datoy(l)
    m = re.search(r'termux (\d+) МБ', l)
    if t and m:
        x = k(t); x['termux'] = max(x['termux'], int(m.group(1)))
try:
    pril = urllib.request.urlopen(URL + '/pamyat?n=2000', timeout=5).read().decode('utf-8', 'replace').splitlines()
except Exception:
    pril = []
    print('(приложение 2 не ответило — его замера памяти не будет)')
sdvig = dt.timedelta(0)                         # у Android и Ubuntu может быть разный часовой пояс
posl = [t for t in map(s_datoy, pril) if t]
if posl and abs(posl[-1] - seychas) > dt.timedelta(minutes=5):
    chetv = dt.timedelta(minutes=15)
    sdvig = round((posl[-1] - seychas) / chetv) * chetv
for l in pril:
    t = s_datoy(l)
    if not t:
        continue
    x = k(t - sdvig)
    m = re.search(r'свободно (\d+) МБ', l)
    if m:
        v = int(m.group(1)); x['svob'] = v if x['svob'] is None else min(x['svob'], v)
    m = re.search(r'приложение (\d+) МБ', l)
    if m:
        x['pril'] = max(x['pril'], int(m.group(1)))
    m = re.search(r'графика (\d+)', l)
    if m:
        x['graf'] = max(x['graf'], int(m.group(1)))
    if 'эфир идёт' in l:
        x['efir'] = 'да'
    if ', МАЛО' in l and 'МАЛО' not in x['sob']:
        x['sob'].append('МАЛО')
    m = re.search(r'система просит память: (\w+)', l)
    if m and m.group(1) != 'UI_HIDDEN':
        x['sob'].append('просит ' + m.group(1))
    if 'приложение запущено' in l:
        x['sob'].append('приложение запущено заново')
print('время   чат  Плюсу  Termux  свободно  прилож.(графика)  эфир  события')
for t in sorted(b):
    if t < korz(nachalo):
        continue
    x = b[t]
    sob = sorted(set(x['sob']), key=x['sob'].index)
    print('%s %4s %5s %6s %8s %8s(%4s)  %4s  %s' % (
        t.strftime('%H:%M'), x['chat'] or '', x['plusu'] or '', '%d' % x['termux'] if x['termux'] else '',
        '%d' % x['svob'] if x['svob'] is not None else '', '%d' % x['pril'] if x['pril'] else '',
        '%d' % x['graf'] if x['graf'] else '', x['efir'], ', '.join(sob)))
print('(память в МБ: Termux — больше всего за 5 мин, свободно — меньше всего)')
PY
  exit 0
fi
SEK=${NAGRUZKA_SEK:-3}
HZ=100
up() { cut -d' ' -f1 /proc/uptime | cut -d. -f1; }

imya() {   # $1 — pid: имя программы, у интерпретаторов — с именем скрипта
  c=$(cat /proc/$1/comm 2> /dev/null) || return 1
  case "$c" in
    python*|node|sh|bash|dash|perl|ruby)
      a=$(tr '\0' '\n' < /proc/$1/cmdline 2> /dev/null | sed -n '2,4p' | grep -v '^-' | head -n 1)
      b=${a##*/}
      case "$b" in ''|*[!A-Za-z0-9._-]*) ;; *) c="$c:$b" ;; esac ;;
  esac
  printf '%s' "$c"
}

snimok() {   # pid utime+stime rss_kB nachalo(tiki) ppid
  for d in /proc/[0-9]*; do
    p=${d#/proc/}
    s=$(cat "$d/stat" 2> /dev/null) || continue
    s=${s##*) }                                   # после «(имя) »: состояние, ppid, …
    set -- $s
    ppid=$2; t=$(( ${12} + ${13} )); nach=${20}; rss=$(( ${22} * 4 ))
    echo "$p $t $rss $nach $ppid"
  done
}

[ -r /proc/uptime ] || { echo "Нет /proc — запусти в Termux или в Ubuntu шлема."; exit 1; }
A=$(snimok); U0=$(up)
sleep "$SEK"
B=$(snimok); U1=$(up)
# «сейчас» — по началу самой этой проверки (в тиках от включения шлема): /proc/uptime в Ubuntu
# (proot-distro) поддельный, а время начала процессов — настоящее
MOJ=$(echo "$B" | awk -v p=$$ '$1 == p { print $4 }')
SEJCHAS=$(( ${MOJ:-$((U1 * HZ))} / HZ + SEK ))
PODDELKA=; [ "$U1" -lt "$SEJCHAS" ] && PODDELKA=1

echo "=== Шлем: работает без перезагрузки $(( SEJCHAS / 3600 )) ч $(( SEJCHAS % 3600 / 60 )) мин ==="
if [ -r /proc/meminfo ]; then
  awk '/^MemTotal/{t=$2} /^MemAvailable/{a=$2} /^SwapTotal/{st=$2} /^SwapFree/{sf=$2}
       END{printf "Память: свободно %.1f из %.1f ГБ", a/1048576, t/1048576;
           if (st>0) printf "; подкачка занята %.1f ГБ", (st-sf)/1048576; print ""}' /proc/meminfo
fi
[ -r /proc/loadavg ] && [ -z "$PODDELKA" ] && echo "Нагрузка (1/5/15 мин): $(cut -d' ' -f1-3 /proc/loadavg)"
T=
for z in /sys/class/thermal/thermal_zone*/temp /sys/class/power_supply/battery/temp; do
  v=$(cat "$z" 2> /dev/null) || continue
  case "$v" in ''|*[!0-9]*) continue ;; esac
  case "$z" in *battery*) v=$(( v * 100 )) ;; esac          # батарея — в десятых градуса
  [ "$v" -gt 1000 ] && [ -z "$T" -o "$v" -gt "${T:-0}" ] && T=$v
done
[ -n "$T" ] && echo "Температура (самая горячая, что видно): $(( T / 1000 )) °C"

# имена всех живых — один раз
IM=$(echo "$B" | while read -r p t rss nach pp; do n=$(imya "$p") && echo "$p $n"; done)

echo "$A" > /tmp/.nagr.a; echo "$B" > /tmp/.nagr.b; echo "$IM" > /tmp/.nagr.i
awk -v sek="$SEK" -v hz=$HZ -v now="$SEJCHAS" '
  FILENAME ~ /\.a$/ { t0[$1] = $2; next }
  FILENAME ~ /\.i$/ { n[$1] = $2; next }
  {
    p = $1; if (!(p in n)) next
    nm = n[p]
    d = (p in t0) ? $2 - t0[p] : 0
    cpu = d / hz / sek * 100
    vozr = now - $4 / hz; if (vozr < 0) vozr = 0
    k[nm]++; mem[nm] += $3; pr[nm] += cpu
    if (!(nm in star) || vozr > star[nm]) star[nm] = vozr
    if (!(nm in mlad) || vozr < mlad[nm]) mlad[nm] = vozr
    vsego_mem += $3; vsego_cpu += cpu
  }
  function vremya(s) { return s >= 3600 ? sprintf("%d ч %02d мин", s / 3600, s % 3600 / 60) : sprintf("%d мин", s / 60) }
  END {
    printf "Всего у Termux/Ubuntu: память %.0f МБ, процессор сейчас %.0f %% (100 %% — одно ядро)\n", vsego_mem / 1024, vsego_cpu > "/dev/stderr"
    for (x in k) printf "%s\t%d\t%.0f\t%.0f\t%s\t%s\n", x, k[x], mem[x] / 1024, pr[x], vremya(star[x]), vremya(mlad[x])
  }' /tmp/.nagr.a /tmp/.nagr.i /tmp/.nagr.b 2>&1 > /tmp/.nagr.t
echo
echo "программа                  штук  память   проц.  живёт (старшая / младшая)"
sort -t "$(printf '\t')" -k4,4nr -k3,3nr /tmp/.nagr.t | awk -F '\t' '$3 > 0' | head -n 15 |
  awk -F '\t' '{ printf "%-26s %4s %5s МБ %5s %%  %s / %s\n", $1, $2, $3, $4, $5, $6 }'

# лишние копии того, что должно быть одно
echo
LISHN=
for x in bash:plus python3:ushi python3:golos python3:obzor python3:vedushchiy python3:donaty python3:zriteli python3:raciya ffmpeg cloudflared; do
  c=$(awk -v x="$x" '$2 == x' /tmp/.nagr.i | wc -l)
  [ "$c" -gt 1 ] && LISHN="$LISHN $x×$c"
done
CL=$(awk '$2 == "node:claude" || $2 == "claude"' /tmp/.nagr.i | wc -l)
[ "$CL" -gt 3 ] && LISHN="$LISHN claude×$CL"
ZOMBI=$(for d in /proc/[0-9]*; do s=$(cat "$d/stat" 2> /dev/null) || continue; s=${s##*) }; [ "${s%% *}" = Z ] && echo z; done | wc -l)
[ "$ZOMBI" -gt 0 ] && LISHN="$LISHN зомби×$ZOMBI"
if command -v tmux > /dev/null 2>&1; then
  TS=$(tmux ls 2> /dev/null | wc -l)
  [ "$TS" -gt 0 ] && echo "Сессий tmux: $TS ($(tmux ls -F '#S' 2> /dev/null | tr '\n' ' '))"
fi
if [ -n "$LISHN" ]; then
  echo "ЛИШНИЕ КОПИИ:$LISHN"
  echo "(claude — это Плюс, его помощники и разовые автопросмотр/соведущий; больше 3 сразу — много)"
else
  echo "Лишних копий не видно: всё, что должно быть одно, — одно."
fi
rm -f /tmp/.nagr.a /tmp/.nagr.b /tmp/.nagr.i /tmp/.nagr.t
