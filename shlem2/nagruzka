class Povodok:
    def __init__(self):
        self.okna = {}            # верх → последние суммы % ядра
        self.prizhaty = {}        # верх → {'imya', 't', 'sr'}
        self.otpushcheno = False  # Александр сказал «в полную» — до конца эфира не трогаем
        self.tesno = 0            # шагов подряд, когда бридж говорит «тесно»
        self.yadro = yadro_slaboe()
        self.zapisat()

    def zapisat(self):
        try:
            json.dump({'yadro': self.yadro, 'otpushcheno': self.otpushcheno,
                       'prizhaty': [dict(v, pid=k) for k, v in self.prizhaty.items()]},
                      open(POVODOK + '.tmp', 'w'), ensure_ascii=False)
            os.replace(POVODOK + '.tmp', POVODOK)
        except OSError:
            pass

    def vse_otpustit(self):
        for verh in list(self.prizhaty):
            for p in poderevo(verh):
                otpustit_pid(p)
        self.prizhaty.clear()
        self.okna.clear()

    def shag(self, idet, cpu_pid, tesno=False):
        """Раз в шаг: cpu_pid — % ядра каждого процесса за шаг; idet — эфир идёт; tesno — бридж сказал «тесно»."""
        if os.path.exists(OTPUSTIT):
            try:
                os.remove(OTPUSTIT)
            except OSError:
                pass
            self.vse_otpustit()
            self.otpushcheno = True
            self.zapisat()
        if not idet or os.path.exists(POVODOK_VYKL):
            if self.prizhaty:
                self.vse_otpustit()
            self.otpushcheno = self.otpushcheno and idet
            self.zapisat()
            return
        for verh in [v for v in self.prizhaty if v not in PPID]:
            del self.prizhaty[verh]                   # доделал и вышел
        kor = korni()
        summy = {}
        for pid, c in cpu_pid.items():
            v = verh_pomoshchnika(pid, kor)
            if v:
                summy[v] = summy.get(v, 0.0) + c
        for v in list(self.okna):
            if v not in summy:
                del self.okna[v]
        for v, sm in summy.items():
            self.okna.setdefault(v, []).append(sm)
            self.okna[v] = self.okna[v][-OKNO:]
        self.tesno = self.tesno + 1 if tesno else 0
        if self.otpushcheno:
            self.zapisat()
            return
        for v, okno in self.okna.items():             # долго тяжёлое — низший приоритет, скорость обычная
            if v in self.prizhaty or len(okno) < OKNO or sum(okno) / len(okno) < POROG:
                continue
            deti = {}
            for p in poderevo(v, kor)[1:]:
                n = korotkoe_imya(p)
