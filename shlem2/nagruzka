    for d in os.listdir('/proc'):
        if not d.isdigit():
            continue
        try:
            st = open('/proc/%s/stat' % d).read()
        except OSError:
            continue
        f = st[st.rfind(')') + 2:].split()
        out[d] = int(f[11]) + int(f[12])
        PPID[d] = f[1]
