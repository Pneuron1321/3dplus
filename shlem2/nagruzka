def sboi():
    seychas = dt.datetime.now()
    zap = []
    try:
        linii = open(ZHURNAL, encoding='utf-8', errors='replace').read().splitlines()
    except OSError:
        print('Чёрного ящика ещё нет (/tmp/nagruzka.log): он пишет, пока идёт эфир, — после обновления и /exit.')
        return
    for l in linii:
        p = l.split('\t')
        if len(p) < 12 or p[1] == 'нет':
            continue
        try:
            t = dt.datetime.strptime('%d.' % seychas.year + p[0], '%Y.%d.%m %H:%M:%S')
        except ValueError:
            continue
        if t > seychas + dt.timedelta(days=1):
            t = t.replace(year=seychas.year - 1)
        if seychas - t > dt.timedelta(hours=CHASOV):
            continue
        fps, kbps, drops, mic, sbros = float(p[1]), int(p[2]), int(p[3]), int(p[4]), int(p[5])
        cpu = dict(zip(GRUPPY + ('drugoe',), map(float, p[6:13])))

        def chislo(i):
            try:
                return float(p[i])
            except (IndexError, ValueError):
                return None
        zap.append((t, fps, kbps, drops, mic, sbros, cpu, p[13] if len(p) > 13 else '', chislo(14), chislo(15), chislo(17)))
    if not zap:
        print('За %g ч эфира в чёрном ящике нет.' % CHASOV)
        return
    norma = statistics.median(z[1] for z in zap)
    plohie = [z for z in zap if z[1] < norma * 0.8 or z[3] or z[4] or z[5]]
    print('Эфир в чёрном ящике: %d мин, обычно %.0f кадров/с. Спотыкался %d раз из %d замеров (%.0f %%).' % (
        len(zap) * SHAG / 60, norma, len(plohie), len(zap), 100 * len(plohie) / len(zap)))
    def sred(nabor, g):
        return sum(z[6][g] for z in nabor) / len(nabor) if nabor else 0
    horoshie = [z for z in zap if z not in plohie]
    print('Процессор в среднем, % одного ядра:   когда спотыкался   /   когда ровно')
    for g in GRUPPY + ('drugoe',):
        print('  %-11s %18.0f %15.0f' % (g, sred(plohie, g), sred(horoshie, g)))
    gs = [z for z in zap if z[10] is not None]                # 2.5.0: гости и субтитры (sinhron, gosti, cloudflared)
    if gs:
        gp = [z for z in plohie if z[10] is not None]; gh = [z for z in horoshie if z[10] is not None]
        print('  %-11s %18.0f %15.0f' % ('гости', sum(z[10] for z in gp) / max(1, len(gp)), sum(z[10] for z in gh) / max(1, len(gh))))
    ek = [z for z in zap if z[8] is not None]                 # 2.3.9: кадры экрана — сама игра
    if ek:
        norma_e = statistics.median(z[8] for z in ek)
        pe = [z for z in plohie if z[8] is not None]
        igra = [z for z in ek if z[8] < norma_e * 0.8]
        print('Игра (кадры экрана): обычно %.0f/с; в сбоях эфира — %s; сама проседала %d раз из %d.' % (
            norma_e, '%.0f/с' % (sum(z[8] for z in pe) / len(pe)) if pe else 'нет данных', len(igra), len(ek)))
        pl = [z for z in ek if z[9] is not None]
        if pl:
            print('Плашки эфира: %.1f мс в секунду в среднем, в сбоях — %.1f мс.' % (
                sum(z[9] for z in pl) / len(pl),
                sum(z[9] for z in pe if z[9] is not None) / max(1, sum(1 for z in pe if z[9] is not None))))
    for metka in ('говорит', 'слушает', 'тесно'):
        a = sum(1 for z in plohie if metka in z[7]); b = sum(1 for z in horoshie if metka in z[7])
        if metka == 'тесно' and not a and not b:
            continue                                         # бридж до 2.3.9 «тесно» не говорит
        print('%s: в %.0f %% сбоев и в %.0f %% ровного времени' % (
            {'говорит': 'Плюс говорит (голос)', 'слушает': 'Плюс слушает тебя («плюс плюс»)',
             'тесно': 'Бридж говорил «тесно»'}[metka],
            100 * a / max(1, len(plohie)), 100 * b / max(1, len(horoshie))))
    # сбои — отрезками
    otrezki, cur = [], None
    for z in plohie:
        if cur and (z[0] - cur[1]).total_seconds() <= SHAG * 2.5:
            cur[1] = z[0]; cur[2].append(z)
        else:
            cur = [z[0], z[0], [z]]; otrezki.append(cur)
    if otrezki:
        print('\nСамые длинные сбои:')
        for a, b, zz in sorted(otrezki, key=lambda o: -len(o[2]))[:15]:
            cl = max(z[6]['claude'] for z in zz)
            go = max(z[6]['golos'] for z in zz)
            met = sorted({m for z in zz for m in z[7].split(',') if m})
            print('  %s–%s  кадров/с от %.0f, потерь %d, пропусков звука %d · claude до %.0f %%, golos до %.0f %%%s' % (
                a.strftime('%H:%M:%S'), b.strftime('%H:%M:%S'), min(z[1] for z in zz), sum(z[3] for z in zz),
                sum(z[4] + z[5] for z in zz), cl, go, (' · ' + ', '.join(met)) if met else ''))


