# ---------- модель ----------

_SEMAFOR = threading.Semaphore(2)     # шлем: не больше двух вызовов разом


def model(sistema, zapros_, effort='low', timeout=90):
    env = dict(os.environ, CLAUDE_CODE_DISABLE_CLAUDE_MDS='1', CLAUDE_CODE_DISABLE_AUTO_MEMORY='1', GOLOS_RACIYA='1')
    os.makedirs(PAPKA, exist_ok=True)
    cmd = [CLAUDE, '-p', '--model', MODEL, '--effort', effort, '--tools', '', '--no-session-persistence',
           '--settings', '{"disableAllHooks":true}', '--output-format', 'json', '--system-prompt', sistema, zapros_]
    with _SEMAFOR:
        try:
            r = subprocess.run(cmd, cwd=PAPKA, env=env, capture_output=True, text=True, timeout=timeout,
                               stdin=subprocess.DEVNULL)
            t = json.loads(r.stdout).get('result', '') if r.stdout.strip() else ''
            m = re.search(r'\{.*\}', t, re.S)
            return json.loads(m.group(0)) if m else None
        except Exception as e:
            log('модель:', type(e).__name__, str(e)[:80])
            return None


