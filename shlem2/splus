class BotTwitch:
    def est(self):
        return bool(K.TW.cid and K.prochest(TW_BOT))

    def tok(self, novyy=False):
        t = chitat(TW_BOT)
        if novyy and t.get('refresh_token'):
            s, n = K.zapros('POST', K.TW_TOKEN_URL, dannye={'client_id': K.TW.cid, 'client_secret': K.prochest(K.TW_APP_SECRET),
                                                             'grant_type': 'refresh_token', 'refresh_token': t['refresh_token']},
                            forma=True)
            if s == 200 and n.get('access_token'):
                n['login'], n['id'] = t.get('login'), t.get('id')
                zapisat(TW_BOT, n, sekret=True)
                t = n
        return t.get('access_token', '')

    def api(self, metod, put, dannye=None):
        for popytka in (0, 1):
            s, d = K.zapros(metod, K.HELIX + put, self.tok(popytka == 1), dannye, {'Client-Id': K.TW.cid})
            if s != 401:
                return s, d
        return s, d

    def ya(self):
        t = chitat(TW_BOT)
        if not t.get('id'):
            s, d = self.api('GET', '/users')
            u = (d.get('data') or [{}])[0] if s == 200 else {}
            t = chitat(TW_BOT)
            t['id'], t['login'] = u.get('id'), u.get('login')
            zapisat(TW_BOT, t, sekret=True)
        return t.get('id'), (t.get('login') or '').lower()

    def chat(self, tekst):
        bid, _ = self.ya()
        s, d = self.api('POST', '/chat/messages', {'broadcaster_id': K.TW.moy_id(), 'sender_id': bid, 'message': tekst})
        return s == 200 and ((d.get('data') or [{}])[0]).get('is_sent', True)

    def ban(self, login, prichina):
        bid, _ = self.ya()
        s, d = self.api('GET', '/users?login=' + urllib.parse.quote(login))
        uid = ((d.get('data') or [{}])[0]).get('id') if s == 200 else None
        if not uid:
            return False
        s, _ = self.api('POST', '/moderation/bans?broadcaster_id=%s&moderator_id=%s' % (K.TW.moy_id(), bid),
                        {'data': {'user_id': uid, 'reason': prichina[:200]}})
        return s == 200


