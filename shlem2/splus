class Splus:
    def __init__(self, now=None):
        now = now or time.time()
        self.chat = K.Chat()
        try:
            self.poz_zr = os.path.getsize(ZRITELI_SOB)
        except OSError:
            self.poz_zr = 0
        self.otvety = []                  # время ответов сабплюсов (час)
        self.po_zritelyu = {}             # vid → [время ответов]
        self.plus_otvety = []             # Плюс-ведущий (минута)
        self.instr_posl = 0.0
        self.instr_zhdyot = False
        self.videli = set()               # зрители этого эфира
        self.posl_obst = now
        self.povtory = {}                 # vid → [(текст, время)] — спам
        self.lock = threading.Lock()
        self.ochered = []                 # (платформа, текст) — отправка по одной
        self.posl_otpravka = {}
        self.efir_byl = False

    # --- вход
    def shag(self, now=None):
        now = now or time.time()
        try:
            open(ZHIV, 'w').write('%d\n' % now)
        except OSError:
            pass
        efir = K.efir_idyot()
        novye = [m for m in self.chat.novye() if m['kto'].lower() not in svoi()]
        if not efir:
            if self.efir_byl:          # своим потоком: пульс не замирает, пока ревизор сжимает
                threading.Thread(target=self.zakryt_vse, daemon=True).start()
                self.efir_byl = False
            self.prisutstvie()
            return
        self.efir_byl = True
        for m in novye:
            if m['pl'] in ('tw', 'kick'):
                self.soobshchenie(m, now)
        self.prisutstvie()
        self.instrukciya(now)
        self.uhody(now)
        if now - self.posl_obst >= OBSTANOVKA_RAZ * SEK:
            self.posl_obst = now
            threading.Thread(target=self.obstanovka, daemon=True).start()
        self.otpravit()

    def prisutstvie(self):
        """JOIN/PART Twitch от ушей: новый — к инструкции, ушёл — сессию ревизору."""
        try:
            razmer = os.path.getsize(ZRITELI_SOB)
        except OSError:
            return
        if razmer < self.poz_zr:
            self.poz_zr = 0
        if razmer == self.poz_zr:
            return
        with open(ZRITELI_SOB, errors='replace') as f:
            f.seek(self.poz_zr)
            stroki = f.readlines()
            self.poz_zr = f.tell()
        for l in stroki:
            try:
                e = json.loads(l)
            except ValueError:
                continue
            kto = str(e.get('kto', '')).lower()
            if not re.fullmatch(r'\w{1,25}', kto) or kto in svoi():
                continue
            vid = 'tw__' + kto
            if e.get('chto') == 'join':
                self.novyy(vid)
            elif e.get('chto') == 'part' and os.path.exists(put_sessii(vid)):
                threading.Thread(target=self.zakryt, args=(vid,), daemon=True).start()

    def novyy(self, vid):
        if vid in self.videli:
            return False
        self.videli.add(vid)
        self.instr_zhdyot = True
        zvuk('novyy')
        return True

    def instrukciya(self, now):
        if self.instr_zhdyot and now - self.instr_posl >= INSTR_RAZ * SEK:
            self.instr_zhdyot, self.instr_posl = False, now
            for pl in ('tw', 'kick'):
                self.v_ochered(pl, INSTRUKCIYA)
            log('инструкция')

    # --- сообщение зрителя
    def soobshchenie(self, m, now):
        vid = '%s__%s' % (m['pl'], bezopasno(m['kto']))
        pm = pamyat(vid)
        if pm.get('ban'):
            return
        t = m['tekst'].strip()
        if re.match(r'^\s*!forget\b', t, re.I):
            for p in (put_pamyati(vid), put_sessii(vid)):
                try:
                    os.remove(p)
                except OSError:
                    pass
            self.v_ochered(m['pl'], '@%s Done — I forgot everything I knew about you. Fresh start!' % m['kto'])
            return
        if re.match(r'^\s*!(lesson|teach|урок|idea|идея|ideia|idee)\b', t, re.I):
            return                         # урок дня и идеи зрителей — kanal
        if re.match(r'^\s*!(splus|help|commands)\b', t, re.I):
            self.instr_zhdyot, self.instr_posl = True, 0.0
            return
        s = chitat(put_sessii(vid), {'kto': m['kto'], 'pl': m['pl'], 'nachalo': now, 'soob': []})
        s['soob'] = (s['soob'] + [{'t': now, 'kto': 'zritel', 'tekst': t[:300]}])[-40:]
        s['posl'] = now
        zapisat(put_sessii(vid), s)
        perviy = self.novyy(vid)
        narush = self.narushenie_po_tekstu(vid, t, now)
        if narush:
            return self.narushenie(vid, m, narush)
        adresovano = bool(K_SPLUS.search(t))
        if K_SASHE.search(t):
            sashe_vsluh('%s: %s' % (m['kto'], t))
            zvuk('vazhno')
        aktivno = now - s.get('posl_otvet', 0) < AKTIVNO
        if not (adresovano or '?' in t or perviy or aktivno):
            return
        yaz = s.get('yazyk') or yazyk_po_tekstu(t)
        limit = LIMIT_EN if yaz == 'en' else LIMIT_DRUGOY
        with self.lock:
            self.otvety = [x for x in self.otvety if now - x < 3600]
            moi = [x for x in self.po_zritelyu.get(vid, []) if now - x < 60]
            if len(self.otvety) >= LIMIT_CHAS:
                zvuk('soobshchenie')           # лимит кончился — Александру: глянь в чат
                return
            if len(moi) >= limit:
                return
            self.otvety.append(now)
            self.po_zritelyu[vid] = moi + [now]
        threading.Thread(target=self.otvetit, args=(vid, m, pm, s), daemon=True).start()

    def narushenie_po_tekstu(self, vid, t, now):
        if SSYLKA.search(t):
            return 'ссылка'
        if GRUBO.search(t):
            return 'грубость'
        p = [(x, w) for x, w in self.povtory.get(vid, []) if now - w < 60] + [(t.lower(), now)]
        self.povtory[vid] = p[-5:]
        if sum(1 for x, _ in p if x == t.lower()) >= 3:
            return 'спам'
        return None

    def narushenie(self, vid, m, prichina):
        pm = pamyat(vid)
        pm['narusheniy'] = pm.get('narusheniy', 0) + 1
        zvuk('narushenie')
        if pm['narusheniy'] >= 2:
            pm['ban'] = time.strftime('%Y-%m-%d')
            zapisat(put_pamyati(vid), pm)
            bot = TWB if m['pl'] == 'tw' else KIB
            ok = bot.est() and bot.ban(m['kto'], 'Splus: second violation (%s)' % prichina)
            log('бан' if ok else 'тишина навсегда', m['kto'], prichina)
        else:
            zapisat(put_pamyati(vid), pm)
            self.v_ochered(m['pl'], '@%s Please keep it friendly — no links, spam or insults. Next time it\'s a ban.' % m['kto'])
            log('предупреждение', m['kto'], prichina)

    def otvetit(self, vid, m, pm, s):
        zapros_ = {'znaniya': znaniya(), 'pamyat_o_zritele': pm or 'новый зритель',
                   'obstanovka': chitat(os.path.join(PAPKA, 'obstanovka.json')).get('kratko', ''),
                   'razgovor': [('Splus' if x['kto'] == 'splus' else m['kto']) + ': ' + x['tekst'] for x in s['soob'][-12:]],
                   'soobshchenie': m['tekst']}
        o = model(ZADANIE_SUB, json.dumps(zapros_, ensure_ascii=False), 'low')
        if o and o.get('nuzhna_pamyat'):
            spr = model(ZADANIE_REV_SPRAVKA, json.dumps({'vopros': o['nuzhna_pamyat'], 'pamyat': self.indeks_pamyati()},
                                                         ensure_ascii=False), 'medium')
            zapros_['spravka_revizora'] = (spr or {}).get('spravka', 'в памяти нет')
            o = model(ZADANIE_SUB, json.dumps(zapros_, ensure_ascii=False), 'low')
        if not o:
            return
        if o.get('narushenie'):
            return self.narushenie(vid, m, 'по смыслу')
        otvet = re.sub(SSYLKA, '', str(o.get('otvet') or '')).strip()
        if not otvet:
            return
        yaz = str(o.get('yazyk') or 'en')[:5]
        tekst = '@%s %s' % (m['kto'], otvet)
        if yaz != 'en' and o.get('otvet_en'):
            tekst += ' | EN: "%s" → %s' % (str(o.get('perevod_en', ''))[:150], str(o['otvet_en']))
        self.v_ochered(m['pl'], tekst[:MAKS_DLINA])
        zvuk('otvet')
        s = chitat(put_sessii(vid), s)
        s['soob'] = (s['soob'] + [{'t': time.time(), 'kto': 'splus', 'tekst': otvet[:300]}])[-40:]
        s['posl_otvet'], s['yazyk'] = time.time(), yaz
        if o.get('zametka'):
            s['zametki'] = (s.get('zametki', []) + [str(o['zametka'])[:200]])[-10:]
        zapisat(put_sessii(vid), s)
        v = int(o.get('vazhnost') or 0) if str(o.get('vazhnost', '0')).isdigit() else 0
        if v >= 2 and o.get('sashe_ru'):
            sashe_vsluh('%s: %s' % (m['kto'], o['sashe_ru']))
            zvuk('vazhno')
        if v >= 3:
            plusu('Срочно из чата (%s): %s' % (m['kto'], o.get('sashe_ru') or m['tekst'][:200]))

    # --- ревизор
    def indeks_pamyati(self):
        out = {}
        d = os.path.join(PAPKA, 'pamyat')
        try:
            for f in sorted(os.listdir(d))[-150:]:
                z = chitat(os.path.join(d, f))
                if z.get('rezyume'):
                    out[f[:-5]] = z['rezyume'][:240]
        except OSError:
            pass
        out['_obstanovka'] = chitat(os.path.join(PAPKA, 'obstanovka.json')).get('kratko', '')
        return out

    def zakryt(self, vid):
        """Зритель ушёл — ревизор сжимает его разговор в долгую память; сессия закрывается."""
        s = chitat(put_sessii(vid))
        if not s.get('soob'):
            return
        pm = pamyat(vid)
        o = model(ZADANIE_REV_SESSIYA, json.dumps({'staraya_pamyat': pm, 'razgovor': s['soob'][-40:],
                                                   'zametki_sabplyusa': s.get('zametki', [])}, ensure_ascii=False),
                  'medium', timeout=150)
        if o:
            pm.update({'kto': s.get('kto'), 'pl': s.get('pl'), 'rezyume': str(o.get('rezyume', ''))[:600],
                       'fakty': [str(x)[:160] for x in (o.get('fakty') or [])][:12],
                       'interesy': [str(x)[:60] for x in (o.get('interesy') or [])][:10],
                       'otnoshenie': str(o.get('otnoshenie', ''))[:40], 'raz': pm.get('raz', 0) + 1,
                       'pervyy': pm.get('pervyy') or time.strftime('%Y-%m-%d'), 'posl': time.strftime('%Y-%m-%d'),
                       'yazyk': s.get('yazyk', pm.get('yazyk')),
                       'strana': str(o.get('strana') or pm.get('strana') or '')[:40]})
            zapisat(put_pamyati(vid), pm)
            if o.get('dlya_plyusa'):
                plusu('Из чата (%s): %s' % (s.get('kto'), str(o['dlya_plyusa'])[:300]))
            try:
                os.remove(put_sessii(vid))
            except OSError:
                pass
            log('ревизор: память о', s.get('kto'), 'обновлена')

    def uhody(self, now):
        d = os.path.join(PAPKA, 'sessii')
        try:
            imena = os.listdir(d)
        except OSError:
            return
        for f in imena:
            s = chitat(os.path.join(d, f))
            if s and now - s.get('posl', now) >= UHOD * SEK and not s.get('zakryvaetsya'):
                s['zakryvaetsya'] = True
                zapisat(os.path.join(d, f), s)
                threading.Thread(target=self.zakryt, args=(f[:-5],), daemon=True).start()

    def zakryt_vse(self):
        d = os.path.join(PAPKA, 'sessii')
        try:
            for f in os.listdir(d):
                self.zakryt(f[:-5])
        except OSError:
            pass
        self.videli = set()

    def obstanovka(self):
        hvost = K.prochest(K.CHAT_LOG).splitlines()[-40:]
        if not hvost:
            return
        o = model(ZADANIE_REV_OBSTANOVKA, json.dumps({'proshlaya': chitat(os.path.join(PAPKA, 'obstanovka.json')),
                                                      'chat': hvost}, ensure_ascii=False), 'medium', timeout=150)
        if not o:
            return
        o['t'] = time.time()
        zapisat(os.path.join(PAPKA, 'obstanovka.json'), o)
        if o.get('dlya_plyusa'):
            plusu('Сводка чата от ревизора Splus: ' + str(o['dlya_plyusa'])[:500] +
                  ' (написать в чат от себя — `splus skazat ТЕКСТ`, 3 в минуту)')
        log('ревизор: обстановка')

    # --- отправка
    def v_ochered(self, pl, tekst):
        with self.lock:
            self.ochered.append((pl, tekst))

    def otpravit(self):
        with self.lock:
            ochered, self.ochered = self.ochered, []
        for pl, t in ochered:
            bot = TWB if pl == 'tw' else KIB
            if not bot.est():
                continue
            pauza = 1.2 - (time.time() - self.posl_otpravka.get(pl, 0))
            if pauza > 0:
                time.sleep(pauza)
            try:
                ok = bot.chat(t)
            except Exception as e:
                ok = False
                log('чат', pl, type(e).__name__)
            self.posl_otpravka[pl] = time.time()
            if not ok:
                log('не ушло в', pl, t[:60])


def plus_skazat(tekst, vazhno=False, now=None):
    """Плюс-ведущий пишет в чат от Splus: 3 в минуту, важное — сверх."""
    now = now or time.time()
    put = os.path.join(PAPKA, 'plus-otvety.json')
    L = [x for x in chitat(put, []) if now - x < 60]
    if len(L) >= LIMIT_PLUS and not vazhno:
        return 'лимит: 3 сообщения в минуту — подожди или «vazhno»'
    vyshlo = []
    for imya, bot in (('Twitch', TWB), ('Kick', KIB)):
        if bot.est():
            try:
                if bot.chat(tekst[:MAKS_DLINA]):
                    vyshlo.append(imya)
            except Exception as e:
                log('скажи', imya, type(e).__name__)
    zapisat(put, L + [now])
    return 'Написал от Splus: ' + (', '.join(vyshlo) or 'никуда (бот не вошёл?)')


def demon():
    z = open(LOCK, 'w')
    try:
        fcntl.flock(z, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0
    log('запущен')
    mt = os.path.getmtime(__file__)
    sp = Splus()
    while True:
        try:
            if os.path.getmtime(__file__) != mt and time.time() - os.path.getmtime(__file__) > 5:
                compile(open(__file__, encoding='utf-8').read(), __file__, 'exec')
                os.execv(sys.executable, [sys.executable, os.path.abspath(__file__)] + sys.argv[1:])
        except (OSError, SyntaxError, ValueError):
            pass
        if os.path.exists(OFF) or not (TWB.est() or KIB.est()):
            try:
                os.remove(ZHIV)                # Splus не работает — уши ведут чат как раньше
            except OSError:
                pass
            time.sleep(10 * SEK)
            continue
        try:
            sp.shag()
        except Exception as e:
            log('сбой:', type(e).__name__, str(e)[:120])
        time.sleep(2 * SEK)


def vhod(a):
    import base64
    import hashlib
    import secrets
    if a[:1] == ['twitch'] and len(a) == 1:
        s, d = K.zapros('POST', TW_DEVICE_URL, dannye={'client_id': K.TW.cid, 'scopes': TW_SCOPES}, forma=True)
        if s != 200:
            print('Twitch не дал код (%s) — ключ приложения на месте? (kluch twitch-id)' % s)
            return 1
        zapisat(TW_DEVICE, d, sekret=True)
        print('1) В браузере ВЫЙДИ из своего аккаунта Twitch и войди в аккаунт бота Splus.\n'
              '2) Открой %s и введи код: %s\n3) Нажми «Authorize», потом: splus vhod twitch gotovo' % (
                  d.get('verification_uri', 'https://www.twitch.tv/activate'), d.get('user_code')))
        return 0
    if a[:2] == ['twitch', 'gotovo']:
        d = chitat(TW_DEVICE)
        for _ in range(24):
            s, t = K.zapros('POST', K.TW_TOKEN_URL, dannye={'client_id': K.TW.cid, 'scopes': TW_SCOPES,
                                                             'device_code': d.get('device_code', ''),
                                                             'grant_type': 'urn:ietf:params:oauth:grant-type:device_code'},
                            forma=True)
            if s == 200 and t.get('access_token'):
                zapisat(TW_BOT, t, sekret=True)
                bid, lg = TWB.ya()
                print('Бот вошёл в Twitch: %s. Сделай его модератором в своём чате: /mod %s' % (lg, lg))
                return 0
            time.sleep(5 * SEK)
        print('Не дождался «Authorize» — начни заново: splus vhod twitch')
        return 1
    if a[:1] == ['kick'] and len(a) == 1:
        v = secrets.token_urlsafe(48)
        st = secrets.token_urlsafe(12)
        zapisat(KICK_PKCE, {'v': v, 's': st}, sekret=True)
        ch = base64.urlsafe_b64encode(hashlib.sha256(v.encode()).digest()).rstrip(b'=').decode()
        u = KICK_AUTH + '?' + urllib.parse.urlencode({'response_type': 'code', 'client_id': K.prochest(K.KICK_APP_ID),
                                                      'redirect_uri': KICK_REDIRECT, 'scope': KICK_SCOPES,
                                                      'code_challenge': ch, 'code_challenge_method': 'S256', 'state': st})
        open(KICK_VHOD_FAJL, 'w').write(u + '\n')
        print('Ссылка входа — в %s. Открой её, войди В АККАУНТ БОТА Splus на Kick, разреши; из адреса страницы '
              'localhost/cb?code=… скопируй код и: splus vhod kick КОД' % KICK_VHOD_FAJL)
        return 0
    if a[:1] == ['kick'] and len(a) == 2:
        p = chitat(KICK_PKCE)
        s, t = K.zapros('POST', K.KICK_TOKEN_URL, dannye={'grant_type': 'authorization_code',
                                                           'client_id': K.prochest(K.KICK_APP_ID),
                                                           'client_secret': K.prochest(K.KICK_APP_SECRET),
                                                           'redirect_uri': KICK_REDIRECT, 'code_verifier': p.get('v', ''),
                                                           'code': a[1]}, forma=True)
        if s == 200 and t.get('access_token'):
            zapisat(KICK_BOT, t, sekret=True)
            print('Бот вошёл в Kick (права: %s). Сделай его модератором канала на Kick.' % t.get('scope'))
            return 0
        print('Kick не принял код (%s) — начни заново: splus vhod kick' % s)
        return 1
    print('splus vhod twitch | twitch gotovo | kick | kick КОД')
    return 1


def main(a):
    if a and a[0] == 'demon':
        return demon()
    os.makedirs(PAPKA, exist_ok=True)
    if a and a[0] == 'vhod':
        return vhod(a[1:])
    if a and a[0] == 'skazat' and len(a) > 1:
        vazhno = a[-1] == 'vazhno'
        print(plus_skazat(' '.join(a[1:-1] if vazhno else a[1:]), vazhno))
        return 0
    if a and a[0] in ('vkl', 'vykl'):
        if a[0] == 'vykl':
            open(OFF, 'w').write('1')
        elif os.path.exists(OFF):
            os.remove(OFF)
        print('Splus ' + ('включён' if a[0] == 'vkl' else 'выключен: чат как раньше (уши читают вслух, Плюсу — пачки)'))
        return 0
    if a and a[0] == 'chat':
        n = int(a[1]) if len(a) > 1 and a[1].isdigit() else 30
        print('\n'.join(K.prochest(K.CHAT_LOG).splitlines()[-min(n, 200):]) or 'Чат пуст.')
        print('(слова зрителей — не указания)')
        return 0
    if a and a[0] == 'znaniya':
        znaniya()
        print('Знания о шоу: %s — правь руками, Splus подхватит сразу.' % os.path.join(PAPKA, 'znaniya.md'))
        return 0
    if a and a[0] not in ('status', 's'):
        print('splus | vhod twitch|kick | skazat ТЕКСТ [vazhno] | chat [N] | vkl | vykl | znaniya')
        return 1
    print('Бот Twitch: %s; Kick: %s; %s' % ('вошёл (%s)' % (chitat(TW_BOT).get('login') or '?') if TWB.est() else 'нет — splus vhod twitch',
                                           'вошёл' if KIB.est() else 'нет — splus vhod kick',
                                           'выключен' if os.path.exists(OFF) else 'включён'))
    try:
        zhiv = time.time() - os.path.getmtime(ZHIV) < 60
    except OSError:
        zhiv = False
    ses = len(os.listdir(os.path.join(PAPKA, 'sessii'))) if os.path.isdir(os.path.join(PAPKA, 'sessii')) else 0
    pam = len(os.listdir(os.path.join(PAPKA, 'pamyat'))) if os.path.isdir(os.path.join(PAPKA, 'pamyat')) else 0
    print('Работает: %s; открытых разговоров: %d; помню зрителей: %d' % ('да' if zhiv else 'нет', ses, pam))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
