#!/bin/sh
# kluch — ключ из буфера обмена шлема в файл, не показывая его.
#   ! kluch          — ключ Groq (console.groq.com/keys) → /root/.groq-key
#   ! kluch twitch   — ключ трансляции Twitch (dashboard.twitch.tv → Настройки →
#                      Трансляция → Основной ключ) → /root/.twitch-key, для retr
#   ! kluch kick     — Kick (kick.com → Dashboard → Settings → Stream URL & Key): дважды — скопировать
#                      «Stream URL» (rtmps://…/app) и kluch kick, потом «Stream Key» и kluch kick:
#                      адрес → /root/.kick-url, ключ → /root/.kick-key (мульти-эфир, мост 2.7.0)
#   ! kluch youtube  — ключ трансляции YouTube (Студия → Начать трансляцию → Ключ трансляции)
#                      → /root/.youtube-key
#   ! kluch se-youtube — JWT второго StreamElements, подключённого к YouTube (29.10): новые подписчики YouTube —
#                      плашка, звук и «спасибо» (YouTube сам подписчиков в чате не показывает)
#   ! kluch se       — JWT StreamElements (streamelements.com → аватар → Account →
#                      Channels → Show secrets → JWT Token) → /root/.se-jwt: донаты PayPal
#                      и картой со страницы чаевых StreamElements видит donaty
#   ! kluch twitch-id     — Client ID приложения Twitch (dev.twitch.tv → Your Console →
#   ! kluch twitch-secret — Applications → Manage) и его секрет (New Secret): сколько
#                      зрителей смотрят эфир (zriteli). Секрет — /root/.twitch-app-secret
#   ! kluch eleven   — ключ API ElevenLabs (elevenlabs.io → профиль → API Keys) → /root/.eleven-key (2.7.8:
#                      голос Плюса — клон голоса Александра; ID голоса — golos moy ID, не секрет)
# Ключ — секрет: не печатать, не читать вслух, не заливать, не в кадр.
T=${KLUCH_TERMUX:-/data/data/com.termux/files/usr/bin}
D=${KLUCH_DIR:-/root}                 # куда класть ключи Kick и YouTube (проверка — во временную папку)
k=$(timeout 15 $T/termux-clipboard-get 2> /dev/null | tr -d ' \r\n')
[ -n "$k" ] || { echo "Буфер пуст или Termux:API не ответил. Скопируй ключ ещё раз."; exit 1; }
umask 077
if [ "$1" = se ] || [ "$1" = se-youtube ]; then
  case "$k" in eyJ?*.?*.?*) ;; *) echo "В буфере не JWT StreamElements: он начинается с eyJ и в нём две точки."; exit 1 ;; esac
  f=/root/.se-jwt; [ "$1" = se-youtube ] && f=/root/.se-jwt-youtube   # 29.10: второй StreamElements — на YouTube (подписчики)
  printf '%s\n' "$k" > "$f"
  timeout 10 $T/termux-clipboard-set ' ' 2> /dev/null
  h=$(mktemp)
  printf 'Authorization: Bearer %s\n' "$k" > "$h"
  c=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 -H @"$h" https://api.streamelements.com/kappa/v2/channels/me)
  rm -f "$h"
  case "$c" in
    200) echo "Ключ StreamElements сохранён и работает (${#k} знаков). Буфер очищен. Донаты со страницы чаевых пойдут в цель." ;;
    401) echo "Ключ сохранён, но StreamElements его не принял (401). Скопируй JWT заново." ;;
    *) echo "Ключ сохранён; StreamElements не ответил (код $c) — проверь интернет." ;;
  esac
  exit 0
fi
if [ "$1" = eleven ]; then
  case "$k" in *[!A-Za-z0-9_-]*|'') echo "В буфере не ключ ElevenLabs: только латинские буквы, цифры, _ и -."; exit 1 ;; esac
  [ ${#k} -ge 20 ] || { echo "В буфере не ключ ElevenLabs: слишком короткий (${#k})."; exit 1; }
  printf '%s\n' "$k" > "$D/.eleven-key"
  timeout 10 $T/termux-clipboard-set ' ' 2> /dev/null
  h=$(mktemp)
  printf 'xi-api-key: %s\n' "$k" > "$h"
  c=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 -H @"$h" https://api.elevenlabs.io/v1/user)
  rm -f "$h"
  case "$c" in
    200) echo "Ключ ElevenLabs сохранён и работает. Буфер очищен. Дальше: golos moy ID_ГОЛОСА." ;;
    401) echo "Ключ сохранён, но ElevenLabs его не принял (401). Скопируй ключ заново." ;;
    *) echo "Ключ сохранён; ElevenLabs не ответил (код $c) — проверь интернет." ;;
  esac
  exit 0
fi
if [ "$1" = twitch-id ] || [ "$1" = twitch-secret ]; then
  case "$k" in *[!a-z0-9]*|'') echo "В буфере не ${1#twitch-} приложения Twitch: там только строчные латинские буквы и цифры (около 30)."; exit 1 ;; esac
  [ ${#k} -ge 20 ] && [ ${#k} -le 40 ] || { echo "В буфере не ${1#twitch-} приложения Twitch: длина ${#k}, а должно быть около 30."; exit 1; }
  if [ "$1" = twitch-id ]; then
    printf '%s\n' "$k" > /root/.twitch-app-id
    echo "Client ID сохранён. Теперь в той же странице — New Secret, скопировать и ! kluch twitch-secret."
    exit 0
  fi
  printf '%s\n' "$k" > /root/.twitch-app-secret
  rm -f /root/.twitch-app-token
  timeout 10 $T/termux-clipboard-set ' ' 2> /dev/null
  echo "Секрет сохранён (${#k} знаков). Буфер очищен."
  /usr/local/bin/zriteli klyuch
  exit 0
fi
if [ "$1" = kick ]; then
  case "$k" in
    rtmps://*)
      # адрес приёма: только rtmps://<свой>.global-contribute.live-video.net[:443]/app — без хвоста (туда мог попасть ключ)
      h=${k#rtmps://}; h=${h%%/*}; p=${k#rtmps://$h}; h=${h%:443}
      case "$h" in *[!a-z0-9.-]*|'') h= ;; *.global-contribute.live-video.net) ;; *) h= ;; esac
      if [ -z "$h" ] || { [ "$p" != /app ] && [ "$p" != /app/ ] && [ "$p" != / ] && [ -n "$p" ]; }; then
        echo "В буфере не адрес Kick: нужен «Stream URL» вида rtmps://….global-contribute.live-video.net/app (без ключа в конце)."
        exit 1
      fi
      printf 'rtmps://%s:443/app\n' "$h" > "$D/.kick-url"
      if [ -s "$D/.kick-key" ]; then echo "Адрес Kick сохранён. Ключ Kick уже есть — можно efir na twitch,kick."
      else echo "Адрес Kick сохранён. Теперь скопируй «Stream Key» на той же странице и снова kluch kick."; fi
      exit 0 ;;
    live_*) echo "В буфере ключ Twitch, а не Kick. Для Twitch — kluch twitch."; exit 1 ;;
    *[!A-Za-z0-9_-]*) echo "В буфере не ключ Kick: в нём только латинские буквы, цифры, _ и -."; exit 1 ;;
  esac
  [ ${#k} -ge 10 ] && [ ${#k} -le 200 ] || { echo "В буфере не ключ Kick: длина ${#k} — слишком коротко или длинно."; exit 1; }
  printf '%s\n' "$k" > "$D/.kick-key"
  timeout 10 $T/termux-clipboard-set ' ' 2> /dev/null
  if [ -s "$D/.kick-url" ]; then echo "Ключ Kick сохранён (${#k} знаков). Буфер очищен. Эфир на Kick: efir na twitch,kick."
  else echo "Ключ Kick сохранён (${#k} знаков). Буфер очищен. Ещё нужен адрес: скопируй «Stream URL» и снова kluch kick."; fi
  exit 0
fi
if [ "$1" = youtube ]; then
  case "$k" in
    live_*) echo "В буфере ключ Twitch, а не YouTube. Для Twitch — kluch twitch."; exit 1 ;;
    rtmp*) echo "В буфере адрес, а нужен «Ключ трансляции» (адрес YouTube мост знает сам)."; exit 1 ;;
    *[!A-Za-z0-9_-]*) echo "В буфере не ключ YouTube: он вида xxxx-xxxx-xxxx-xxxx-xxxx."; exit 1 ;;
  esac
  [ ${#k} -ge 16 ] && [ ${#k} -le 80 ] || { echo "В буфере не ключ YouTube: длина ${#k}, а он вида xxxx-xxxx-xxxx-xxxx-xxxx."; exit 1; }
  printf '%s\n' "$k" > "$D/.youtube-key"
  timeout 10 $T/termux-clipboard-set ' ' 2> /dev/null
  echo "Ключ YouTube сохранён (${#k} знаков). Буфер очищен. Эфир на YouTube: efir na twitch,youtube."
  exit 0
fi
if [ "$1" = twitch ]; then
  case "$k" in live_?*) ;; *) echo "В буфере не ключ Twitch: он начинается с live_."; exit 1 ;; esac
  printf '%s\n' "$k" > /root/.twitch-key
  timeout 10 $T/termux-clipboard-set ' ' 2> /dev/null
  echo "Ключ Twitch сохранён (${#k} знаков). Буфер очищен. Если стрим через ретранслятор уже идёт — через секунду он уйдёт на Twitch, канал в эфире."
  exit 0
fi
case "$k" in gsk_?*) ;; *) echo "В буфере не ключ Groq: он начинается с gsk_."; exit 1 ;; esac
printf '%s\n' "$k" > /root/.groq-key
timeout 10 $T/termux-clipboard-set ' ' 2> /dev/null   # стереть ключ из буфера
h=$(mktemp)
printf 'Authorization: Bearer %s\n' "$k" > "$h"
c=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 -H @"$h" https://api.groq.com/openai/v1/models)
rm -f "$h"
case "$c" in
  200) echo "Ключ сохранён и работает (${#k} знаков). Буфер очищен." ;;
  401) echo "Ключ сохранён, но Groq его не принял (401). Скопируй ключ заново." ;;
  403) echo "Ключ сохранён, но Groq отказал (403): возможно, страна недоступна." ;;
  *) echo "Ключ сохранён; Groq не ответил (код $c) — проверь интернет." ;;
esac
