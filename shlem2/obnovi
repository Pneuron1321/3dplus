#!/bin/sh
# obnovi — свежие скрипты Плюса 2 из публичного зеркала (3dplus, папка shlem2) в
# /usr/local/bin. Каждый файл сначала проверяется на синтаксис: битый не ставится.
# CLAUDE.md и settings.json не трогает — их ставит Александр (защита авто-режима).
# Уши (ushi) подхватывают новое сами через несколько секунд. Файл с меткой «obnovi: ne trogat»
# (своя версия в шлеме) не затирается.
# Папка shlem — версия 1.0, её «обнови» первой версии; вторая берёт только из shlem2.
B=${OBNOVI_BASE:-https://raw.githubusercontent.com/Pneuron1321/3dplus/claude/tender-goodall-41rwsn/shlem2}
D=${OBNOVI_DIR:-/usr/local/bin}
T=$(mktemp -d)
n=0
for f in plus-lib plus-mcp ushi sluh sluh-test kluch kadr retr efir kamera nalet radar titr donat itogi obzor vedushchiy donaty zriteli golos skazhi tiho uskor zamer chat plus pamyat golos-hook raciya nagruzka gosti sinhron obnovi; do
  if ! curl -fsSL "$B/$f?t=$(date +%s)" -o "$T/$f"; then echo "$f: не скачался"; continue; fi
  case $(head -1 "$T/$f") in
    *python*) python3 -c "import ast,sys; ast.parse(open(sys.argv[1]).read())" "$T/$f" ;;
    *) sh -n "$T/$f" ;;
  esac || { echo "$f: с ошибкой — не ставлю"; continue; }
  cmp -s "$T/$f" "$D/$f" && continue
  # Свой файл в шлеме (12.10: Плюс по просьбе Александра пересобрала соведущего прямо в шлеме и
  # пометила «obnovi: ne trogat») — не затираем: настройка Александра важнее зеркала.
  if [ "$f" != obnovi ] && grep -q 'obnovi: ne trogat' "$D/$f" 2> /dev/null; then echo "$f: свой в шлеме — не трогаю"; continue; fi
  # рядом и переименованием: файл подменяется целиком — работающий скрипт (и сам
  # obnovi, 06.10: «Unterminated quoted string») дочитывает старый, а не новый с середины
  cp "$T/$f" "$D/.$f.novyy" && chmod +x "$D/.$f.novyy" && mv -f "$D/.$f.novyy" "$D/$f" &&
    echo "$f: обновлён" && n=$((n + 1))
done
rm -rf "$T"
echo "Обновлено файлов: $n."
# Гости эфира (2.5.0): туннель Cloudflare — cloudflared (Go, один файл), ставится один раз с GitHub.
if [ -z "$OBNOVI_BEZ_CLOUDFLARED" ] && ! [ -x "$D/cloudflared" ] && ! command -v cloudflared > /dev/null 2>&1; then
  case $(uname -m) in aarch64|arm64) A=arm64 ;; x86_64) A=amd64 ;; *) A= ;; esac
  if [ -n "$A" ] && curl -fsSL "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-$A" -o "$D/.cloudflared.novyy" &&
     chmod +x "$D/.cloudflared.novyy" && "$D/.cloudflared.novyy" --version > /dev/null 2>&1; then
    mv -f "$D/.cloudflared.novyy" "$D/cloudflared" && echo "cloudflared: поставлен (туннель для гостей эфира)"
  else
    rm -f "$D/.cloudflared.novyy"; echo "cloudflared: не скачался — гости эфира без туннеля (попробуй obnovi позже)"
  fi
fi
