def skolko(n, odin, dva, pyat):
    k = n % 100
    slovo = pyat if 11 <= k <= 14 else odin if k % 10 == 1 else dva if 2 <= k % 10 <= 4 else pyat
    return '%d %s' % (n, slovo)


def sostoyanie():
    """Эфир и камера (у приложения, по полсекунды на ответ) и счётчики ушей."""
    d = dict(SCHET)
    for chto in ('efir', 'kamera'):
        try:
            with urllib.request.urlopen(EAR.rsplit('/ear', 1)[0] + '/' + chto, timeout=0.5) as r:
                j = json.loads(r.read())
        except Exception:
            j = {}
        d[chto] = j.get('state')
        if chto == 'efir' and j.get('state') == 'efir' and 'tesno' in j:   # 2.3.9: «тесно» от бриджа
            d['tesno'] = j.get('tesno_pochemu') or '' if j.get('tesno') else None
    return d


def delta_stroka(bylo, stalo):
    """Что изменилось между двумя состояниями — « (с прошлой фразы: …)» или пусто."""
    ch = []
    e0, e1 = bylo.get('efir'), stalo.get('efir')
    if e0 and e1 and e0 != e1:
        ch.append({'efir': 'эфир идёт', 'off': 'эфир закончился', 'obryv': 'эфир оборвался, переподключается',
                   'podklyuchayus': 'эфир подключается'}.get(e1, 'эфир: ' + e1))
    k0, k1 = bylo.get('kamera'), stalo.get('kamera')
    if k0 and k1 and k0 != k1:
        ch.append({'idyot': 'камера подключилась', 'zhdu': 'камера отключилась, ждёт телефон'}.get(
            k1, 'камера выключена'))
    if 'tesno' in bylo and 'tesno' in stalo and bylo['tesno'] != stalo['tesno']:
        ch.append('эфиру тесно: %s' % stalo['tesno'] if stalo['tesno'] is not None else 'эфиру снова свободно')
    for klyuch, formy in (('donaty', ('донат', 'доната', 'донатов')),
                          ('podpiski', ('подписка', 'подписки', 'подписок')),
                          ('reydy', ('рейд', 'рейда', 'рейдов')),
                          ('chat', ('сообщение в чате', 'сообщения в чате', 'сообщений в чате'))):
        n = stalo.get(klyuch, 0) - bylo.get(klyuch, 0)
        if n > 0:
            ch.append('+' + skolko(n, *formy))
    return ' (с прошлой фразы: %s)' % '; '.join(ch) if ch else ''


def golosom(text, pometka='(голосом) '):
    """Фраза Александра: вписать, а если на экране
    вопрос — сказать об этом, фраза ждёт (dognat)."""
    text += ved_pometka()           # о чём он говорил с соведущей — Плюс знает без команд
