        if SSYLKA.search(t):
            return 'ссылка'
        if GRUBO.search(t):
            return 'грубо'
        kto = re.sub(r'[^\w-]', '', kto or login)[:25] or login
        # важность: 2 — тебе (Александру) или от друга, первыми всегда, и в шквал; 1 — Плюсу, вопрос, биты
        vazhnoe = 2 if login in druzya() or k_sashe(t, tags, kanal) else \
            1 if k_plusu(t) or '?' in t or tags.get('bits') else 0
        with self.lock:
            self.vremena = [x for x in self.vremena if now - x < 60] + [now]
            if len(self.vremena) > PEREDACHA_KIPIT and not vazhnoe:
                self.propushcheno += 1
                return 'шквал'
            mid = tags.get('id', '')
            for d in self.derzhim:
                if d[1] == login and len(d[3]) + len(t) < 300:
                    d[3] = d[3] + ('' if d[3][-1:] in '.!?…' else '.') + ' ' + t   # тот же зритель дописывает
                    d[0] = now
                    d[4].append(mid)
                    d[5] = max(d[5], vazhnoe)
                    break
            else:
                self.derzhim.append([now, login, kto, t, [mid], vazhnoe])
            if self.potok is None:
                self.potok = threading.Thread(target=self.run, daemon=True)
                self.potok.start()
        return None

    def ubrat(self, mid=None, login=None, vse=False):
        """Модератор удалил сообщение, забанил зрителя или очистил чат — не читаем."""
        with self.lock:
            if vse:
                self.derzhim = []
            for d in list(self.derzhim):
                if login and d[1] == login.lower():
                    self.derzhim.remove(d)
                elif mid and mid in d[4]:
                    d[4].remove(mid)
                    if not d[4]:
                        self.derzhim.remove(d)

    def otdat(self, now=None):
        """Отстоявшиеся сообщения — голосу. Вернёт тексты, отданные голосу."""
        now = now or time.time()
        out = []
        with self.lock:
            kipit = len([x for x in self.vremena if now - x < 60]) > PEREDACHA_KIPIT
            gotovy = sorted((d for d in self.derzhim if now - d[0] >= PEREDACHA_DERZHAT), key=lambda d: -d[5])
            for d in gotovy:                    # тебе и от друзей — первыми; дальше — как пришли
                if d[5] < 2 and (kipit or now - d[0] > 60):   # шквал: только важное, не чаще раза в KIPIT_RAZ с
                    if not d[5] or now - d[0] > 60:
                        self.derzhim.remove(d)  # пока ждало, чат закипел, или устарело — числом
                        self.propushcheno += 1
                        continue
                    if now - self.posl_vazhnoe < PEREDACHA_KIPIT_RAZ:
                        continue
                    self.posl_vazhnoe = now
                self.derzhim.remove(d)
                out.append('%s: %s' % (d[2], d[3]))
            if self.propushcheno and not self.derzhim and now - self.posl_chislo >= 60:
                n, self.propushcheno, self.posl_chislo = self.propushcheno, 0, now
                out.append('Ещё %d %s в чате — читаю только вопросы и обращения.' % (
                    n, skolko(n, 'сообщение', 'сообщения', 'сообщений').split(' ', 1)[1]))
        for t in out:
            v_golos_chat(t)
        return out

    def run(self):
        while True:
            time.sleep(0.25)
            try:
                self.otdat()
            except Exception as e:
                print(time.strftime('%H:%M:%S'), 'чат вслух:', type(e).__name__, flush=True)


