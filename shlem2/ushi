def raciya(vkl):
    """«Плюс плюс рация» / «окно»: рация встаёт в окно
    Плюса на место Claude или Claude возвращается туда с
    тем же разговором (переключает сама raciya)."""
    if vkl == raciya_zhiva():
        say('Рация уже включена.' if vkl else 'Окно и так открыто.')
        return
    say('Рация.' if vkl else 'Окно.')
    if not vkl:                # сразу в очередь рации: без запуска Python
        v_raciyu('/окно')
        return
    r = subprocess.run(['raciya', 'vkl'], capture_output=True, text=True)
    print(time.strftime('%H:%M:%S'), 'рация:',
          (r.stdout or r.stderr).strip()[:80], flush=True)


def iz_prosmotra():
    """Окно Плюса пролистано вверх (tmux в режиме просмотра —
    колесо, джойстик): набранное ушло бы в просмотр, а не в
    Claude, и Enter закрыл бы просмотр вместо «отправить».
    Сначала выйти."""
    r = subprocess.run(['tmux', 'display-message', '-p', '-t',
                        'plus', '#{pane_in_mode}'],
                       capture_output=True, text=True)
    if r.stdout.strip() == '1':
        subprocess.run(['tmux', 'send-keys', '-t', 'plus', '-X',
                        'cancel'])


def keys(*args):
    iz_prosmotra()
    subprocess.run(['tmux', 'send-keys', '-t', 'plus']
                   + list(args))


