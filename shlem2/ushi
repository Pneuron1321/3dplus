class EkranChata:
    """Чат — и в кадр эфира (приложение 2.3.4 рисует его справа, между Плюсом и камерой): каждое
    сообщение, удалённое модератором, бан и очистка — сразу, своим потоком с очередью (чат не ждёт
    приложение). С 2.3.9 — пачкой раз в 0,3 с (шквал чата не дёргает поток эфира). Нет приложения
    или оно старое — молча."""
    q = queue.Queue(maxsize=200)
    potok = None
    lock = threading.Lock()

    @classmethod
    def poslat(cls, **d):
        with cls.lock:
            if cls.potok is None:
                cls.potok = threading.Thread(target=cls.run, daemon=True)
                cls.potok.start()
        try:
            cls.q.put_nowait(d)
        except queue.Full:
            pass

    @classmethod
    def run(cls):
        while True:
            pachka = [cls.q.get()]
            if most_umeet('chat_pachka'):
                # 2.3.9 (IV.1): всё, что пришло за CHAT_PACHKA с, — одним запросом: в шквал не
                # больше ~3 запросов в секунду, приложение перерисует плашку раз на пачку
                konec = time.time() + CHAT_PACHKA
                while len(pachka) < 50:
                    try:
                        pachka.append(cls.q.get(timeout=max(0.0, konec - time.time())))
                    except queue.Empty:
                        break
                try:                       # строка тела — как запрос /chat/upr
                    urllib.request.urlopen(urllib.request.Request(
                        CHAT_EKRAN_PACHKA, data='\n'.join(urllib.parse.urlencode(d) for d in pachka).encode(),
                        headers={'Content-Type': 'text/plain'}), timeout=2).read()
                except Exception:
                    pass
                continue
            for d in pachka:
                try:
                    urllib.request.urlopen(CHAT_EKRAN + '?' + urllib.parse.urlencode(d), timeout=2).read()
                except Exception:
                    pass


