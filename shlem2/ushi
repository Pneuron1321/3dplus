              '| whisper %s %.1f с:'
              % (sluh.via, time.time() - t0),
              w, '| речь %.1f с' % rech_f
              + (' | вызов %s, слова вызова %.2f с'
                 % (e.get('how') or '?', lead)
                 if lead else '')
              + (' | после ответа' if dosluh else ''), flush=True)
        metka('whisper', e['id'],
              dop='%s %.2f' % (sluh.via, time.time() - t0))
        if w:
