def dognat():
    """Экран свободен — вписать ждущие фразы по
    порядку; старше ZHDAT_MAKS — не вписываем."""
    while ZHDUT:
        t, text, pometka = ZHDUT[0]
        if time.time() - t > ZHDAT_MAKS:
            print(time.strftime('%H:%M:%S'), 'фраза '
                  'устарела, не вписываю:', text[:60],
                  flush=True)
        elif not v_plus(text, pometka):
            return
        ZHDUT.pop(0)


