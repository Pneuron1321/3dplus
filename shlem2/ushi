SOVED = re.compile(r'^' + _RAZD + r'(?:' + _PL + r'[\s,.!?…-]+' + _PL + r'[\s,.!?…-]+)?'
                   r'(?:со[\s-]*ве[дт][уюо][щш]\w*|со[\s-]*вед\w*|co[\s-]?host\w*)(?!\w)' + _RAZD, re.I)
# управление соведущей (Плюс выполняет vedushchiy vkl/vykl/kazhdye): «соведущий, давай», «соведущего выключи»
SOVED_KOMANDA = re.compile(r'^(?:давай|раз в \d+|каждые \d+|вкл\w*|выкл\w*|включ\w*|выключ\w*|отключ\w*|'
