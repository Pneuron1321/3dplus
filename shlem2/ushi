PLUS_LIB = os.environ.get('USHI_PLUS_LIB', '/usr/local/bin/plus-lib')


class PlusLib:
    """plus-lib (kadr) как модуль (12.10, этап 2): кадр вызова на каждое «плюс плюс», «зум зум» и
    плёнка — в этом же процессе, без sh и двух curl (под proot ≈110 мс процессора на кадр).
    Нет plus-lib или не загрузился — программа kadr, как раньше. Обновили — перечитаем."""
    m, mtime, lock = None, 0.0, threading.Lock()

    @classmethod
    def modul(cls):
        with cls.lock:
            try:
                mt = os.path.getmtime(PLUS_LIB)
            except OSError:
                return None
            if cls.m is None or mt != cls.mtime:
                cls.mtime = mt
                try:
                    import importlib.machinery
                    import importlib.util
                    ld = importlib.machinery.SourceFileLoader('plus_lib', PLUS_LIB)
                    m = importlib.util.module_from_spec(importlib.util.spec_from_loader('plus_lib', ld))
                    ld.exec_module(m)
                    cls.m = m if hasattr(m, 'kadr') else None
                except Exception as e:
                    print(time.strftime('%H:%M:%S'), 'plus-lib не загрузился:', type(e).__name__, flush=True)
                    cls.m = None
            return cls.m


