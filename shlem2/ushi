def rechi_net(wav, ot=0.0):
    """Сколько секунд в фразе громче −40 дБ: шум
    без речи Whisper превращает в выдумки.
    ot — с какой секунды считать (после слов вызова)."""
    try:
        import array
        import math
        d = open(wav, 'rb').read()[44 + int(ot * 16000) * 2:]
        a = array.array('h', d[:len(d) // 2 * 2])
        step, golos = 480, 0           # 30 мс
        for i in range(0, len(a) - step, step):
            s = sum(x * x for x in a[i:i + step:4])
            rms = math.sqrt(s / (step / 4)) or 1
            if 20 * math.log10(rms / 32768) > -40:
                golos += 1
        return golos * 0.03
    except Exception:
        return 99.0


class Sluh:
    """Whisper в своём процессе: модель грузится
    один раз (первый запуск — скачивание)."""
    PY = os.environ.get(
        'SLUH_PY', '/opt/sluh/bin/python')
    SCRIPT = os.environ.get(
        'SLUH_SCRIPT', '/usr/local/bin/sluh')

    def __init__(self):
        self.p, self.ready, self.via = None, False, ''
        if os.path.exists(self.PY) and \
                os.path.exists(self.SCRIPT):
            self.p = subprocess.Popen(
                [self.PY, self.SCRIPT],
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=open('/tmp/sluh.log', 'a'),
                text=True, bufsize=1)
            threading.Thread(target=self._ready,
                             daemon=True).start()

    def _ready(self):
        line = self.p.stdout.readline()
        self.ready = '"ready"' in line
        print(time.strftime('%H:%M:%S'), 'слух:',
              'готов' if self.ready else 'не запустился',
              flush=True)

    def hear(self, wav, timeout=25):
        if not wav or not self.ready or \
                self.p.poll() is not None:
            return None
        try:
            self.p.stdin.write(wav + '\n')
            self.p.stdin.flush()
            out = [self.p.stdout]
            if not select.select(out, [], [], timeout)[0]:
                return None
            d = json.loads(self.p.stdout.readline())
            self.via = d.get('via', '')
            return d.get('text', '').strip()
        except Exception:
            return None


