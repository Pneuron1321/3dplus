def bez_vyzova(w, lead):
    """Текст Whisper без слов вызова в начале."""
    if not lead:
        return PLUS2.sub('', w)
    w2 = PLUS_LEAD.sub('', w, count=1)
    return w2 if w2 != w else PLUS1.sub('', w, count=1)
