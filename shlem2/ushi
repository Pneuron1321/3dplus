class TitrModul:
    """titr как модуль (12.10, этап 1): перевод и показ — в этом же процессе, без запуска
    программы на каждую фразу; соединение с Groq живёт с ушами. Обновили titr — перечитаем."""
    m, mtime, lock = None, 0.0, threading.Lock()

    @classmethod
    def vzyat(cls):
        try:
            mt = os.path.getmtime(TITR)
        except OSError:
            return None
        with cls.lock:
            if cls.m is None or mt != cls.mtime:
                try:
                    import importlib.machinery
                    import importlib.util
                    loader = importlib.machinery.SourceFileLoader('titr_modul', TITR)
                    spec = importlib.util.spec_from_loader('titr_modul', loader)
                    m = importlib.util.module_from_spec(spec)
                    loader.exec_module(m)
                    cls.m = m if hasattr(m, 'subtitr') else None
                except Exception:
                    cls.m = None
                cls.mtime = mt
            return cls.m


