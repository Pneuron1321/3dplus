def get(url, timeout=3):
    with urllib.request.urlopen(url, timeout=timeout) as r:
        return json.loads(r.read().decode('utf-8'))


def metka(imya, uid, ms=None, dop=''):
    """Метка задержки для zamer: мс, что, чья фраза."""
    try:
        with open(ZAMER, 'a') as f:
            f.write('%d\t%s\t%s\t%s\n' % (
                ms or time.time() * 1000, imya, uid, dop))
    except OSError:
        pass


def signal(put):
    """Голосу: пауза или «дальше» (время в файл)."""
    try:
        open(put, 'w').write('%.6f' % time.time())
    except OSError:
        pass


def demon_zhiv():
    """Голос-демон держит замок, пока жив."""
    try:
        f = open(G_LOCK, 'a')
    except OSError:
        return False
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        fcntl.flock(f, fcntl.LOCK_UN)
        return False
    except OSError:
        return True
    finally:
        f.close()


def say(text):
    """Фраза ушей — прямо в очередь демона: без запуска
    Python (skazhi) на каждую фразу. Демона нет — skazhi
    поднимет его или скажет по-старому."""
    if demon_zhiv():
        try:
            os.makedirs(G_Q, exist_ok=True)
            put = '%s/%d.txt' % (G_Q, time.time_ns())
            open(put + '.tmp', 'w').write(text)
            os.replace(put + '.tmp', put)
            return
        except OSError:
            pass
    subprocess.run(['skazhi', text])


