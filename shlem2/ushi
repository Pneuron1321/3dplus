                pauza()
                # подняли после убийства (plus --s N):
                # фразы с вызова N — когда Claude готов
                s0 = int(os.environ.get('USHI_S') or 0)
                if 0 < s0 <= last:
                    print(time.strftime('%H:%M:%S'),
                          'подъём: жду Claude, фразы с',
                          s0, flush=True)
                    zhdat_claude()
                    last = s0 - 1
                    podyom = time.time()
            t0 = time.time()
            # wait=3: новое приложение держит запрос,
            # пока не услышит, — без опроса раз в 0,4 с
            e = get('%s?after=%d&wait=3%s%s' % (
                EAR, last, '&plus=1' if alive else '',
                '&strim=1' if strim_live() else ''),
                timeout=8)
            kind = e.get('kind', 'none')
            if kind == 'none':
                if e['id'] < last:
                    last = e['id']   # мост перезапущен
                if vyzov and e.get('state') != 'hearing' \
                        and time.time() - vyzov > 1:
                    signal(G_DALSHE)  # фразы не было
                    vyzov = None
                if time.time() - t0 < 0.3:
                    time.sleep(0.4)  # старое приложение
                continue
            last = e['id']
            if kind == 'wake' and time.time() - podyom < 120 \
                    and time.time() * 1000 - (e.get('ms') or 0) > 5000:
                continue    # старый вызов из подъёма: Ава и так молчит
            if kind == 'wake':
                vyzov = time.time()
            handle(e, sluh)
            if kind in ('text', 'chek'):
                signal(G_DALSHE)     # Ава договаривает
                vyzov = None
        except Exception as x:   # мост выключен — ждём
            last = None if isinstance(x, OSError) else last
            time.sleep(0.4)


