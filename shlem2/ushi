def ved_pometka():
    """«(с соведущей с прошлого раза: Александр: «…» — она: «…»)» — новые записи журнала разговора с ней
    (не больше 3, по 200 знаков, без дублей); нет новых — пусто. Плюс знает о них без команд."""
    ved_plus_otvet()
    try:
        last = float(open(VED_DOSTAVLENO).read() or 0)
    except (OSError, ValueError):
        last = 0.0
    novye, t_max, vidno = [], last, set()
    try:
        for l in open(VED_DIALOG, errors='replace').read().splitlines()[-40:]:
            try:
                z = json.loads(l)
            except ValueError:
                continue
            if not isinstance(z, dict) or z.get('t', 0) <= last:
                continue
            t_max = max(t_max, z.get('t', 0))
            if time.time() - z.get('t', 0) > VED_POMETKA_MIN * 60:
                continue
            if z.get('rol') == 'ved' or (z.get('rol') == 'alex' and z.get('komu') == 'ved'):
                tx = ' '.join(str(z.get('ru') or z.get('tekst') or '').split())[:200]
                kto = 'она' if z.get('rol') == 'ved' else 'Александр'
                if tx and (kto, tx) not in vidno:
                    vidno.add((kto, tx))
                    novye.append('%s: «%s»' % (kto, tx))
    except OSError:
        return ''
    try:
        if t_max > last:
            open(VED_DOSTAVLENO, 'w').write(str(t_max))
    except OSError:
        pass
    if not novye:
        return ''
    return ' (с соведущей с прошлого раза: %s)' % ' — '.join(novye[-3:])


