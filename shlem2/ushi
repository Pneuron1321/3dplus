def pachka_po_vazhnosti(novye, znakomye, n=CHAT_V_PACHKE):
    """Пачка Плюсу по важности (12.10, IV.4): одинаковые сообщения — одной строкой «×N»; первыми —
    обращённые к Плюсу, вопросы, впервые написавшие за вечер; остальное — свежие; в пачке порядок —
    как в чате; не вошедшее — числом. Вернёт (строки, сколько сообщений не вошло)."""
    gruppy, poryadok = {}, []
    for i, (kto, tekst) in enumerate(novye):
        klyuch = ' '.join(re.sub(r'[^\w ]', ' ', tekst.lower()).split()) or tekst
        if klyuch not in gruppy:
            gruppy[klyuch] = [i, [], tekst, 0]
            poryadok.append(klyuch)
        g = gruppy[klyuch]
        if kto not in g[1]:
            g[1].append(kto)
        g[0], g[3] = i, g[3] + 1               # свежесть — по последнему такому; сколько раз
    def ves(k):
        i, kto, tekst, skolko = gruppy[k]
        return (4 if k_sashe(tekst) or any(x.lower() in druzya() for x in kto) else 0) + \
               (3 if k_plusu(tekst) else 0) + (2 if '?' in tekst else 0) + (1 if skolko >= 3 else 0) + \
               (1 if any(x not in znakomye for x in kto) else 0), i
    vzyali = sorted(sorted(poryadok, key=ves, reverse=True)[:n], key=lambda k: gruppy[k][0])
    stroki = []
    for k in vzyali:
        i, kto, tekst, skolko = gruppy[k]
        imya = kto[0] if len(kto) == 1 else '%s и ещё %d' % (kto[0], len(kto) - 1)
        stroki.append('%s: «%s»%s' % (imya, tekst.replace('«', '"').replace('»', '"'),
                                      ' ×%d' % skolko if skolko > 1 else ''))
    return stroki, len(novye) - sum(gruppy[k][3] for k in vzyali)


class Chat(threading.Thread):
    """Чат Twitch анонимно (только чтение, без ключа):
    всё — в /tmp/chat.log (chat покажет). Плюсу —
    сам: раз в 2 мин, если есть новое; быстрее — если
    в сообщении «плюс» или чат молчал 10 мин: когда
    чат помолчит 5 с (не дольше 30 с), не чаще раза в
    минуту.
    Кусочки одного зрителя подряд — одним сообщением.
    Шквал (больше 30 в минуту): пачка раз в 2 мин, по важности,
    одинаковые — «×N», остальное — числом; потолок в час —
    раз в 10 мин только обращённые к Плюсу."""

    def __init__(self, alive):
        super().__init__(daemon=True)
        self.alive = alive          # Claude Плюса жив?
        self.novye, self.lock = [], threading.Lock()
        self.posl = 0.0             # последнее сообщение
        self.otdano = time.time()   # последняя отдача
        self.vremena = []           # когда приходили сообщения (за минуту) — шквал ли
        self.znakomye = set()       # кто уже писал за вечер
        self.novye_t0 = 0.0         # когда пришло первое сообщение копящейся пачки
        self.srochno = False
        self.srochno_s = 0.0        # когда позвали Плюса (ждём тишину CHAT_SOBRAT)
        self.posl_kto = 0.0         # когда пришёл последний кусок в novye
        self.otdachi = []           # времена отдач за последний час

    def kanal(self):
        try:
            k = open(KANAL).read().strip().lstrip('#')
            return k.lower() if re.fullmatch(r'\w{2,25}', k) \
                else None
        except OSError:
            return None

    def run(self):
        threading.Thread(target=self.otdavat,
                         daemon=True).start()
        pauza_ = 5
        while True:
            k = self.kanal()
            if not k:
                time.sleep(30)
                continue
            try:
                self.slushat(k)
                pauza_ = 5
            except Exception as x:
                print(time.strftime('%H:%M:%S'), 'чат:',
                      type(x).__name__, x, flush=True)
            time.sleep(pauza_)
            pauza_ = min(pauza_ * 2, 300)

    def slushat(self, k):
        host, port, vid = (IRC.split(':') + ['tls'])[:3]
        s = socket.create_connection((host, int(port)),
                                     timeout=30)
        if vid == 'tls':
            s = ssl.create_default_context().wrap_socket(
                s, server_hostname=host)
        s.settimeout(400)           # PING раз в ~5 мин
        f = s.makefile('r', encoding='utf-8',
                       errors='replace', newline='\r\n')
        s.sendall(('PASS SCHMOOPIIE\r\nNICK justinfan%d'
                   '\r\nCAP REQ :twitch.tv/tags twitch.tv/commands twitch.tv/membership'
                   '\r\nJOIN #%s\r\n' % (
                       int(time.time()) % 90000 + 10000,
                       k)).encode())
        print(time.strftime('%H:%M:%S'), 'чат: слушаю #'
              + k, flush=True)
        for line in f:
            line = line.rstrip('\r\n')
            if line.startswith('PING'):
                s.sendall(('PONG' + line[4:] + '\r\n')
                          .encode())
                continue
            m = re.match(r'(?:@(\S+) )?:(\w+)!\S+ PRIVMSG '
                         r'#\w+ :(.*)', line)
            if m:
                tags = dict(x.split('=', 1) for x in
                            (m.group(1) or '').split(';')
                            if '=' in x)
                kto = tags.get('display-name') or m.group(2)
                SCHET['chat'] += 1
                self.prishlo(kto, m.group(3))
                donat_iz_chata(tags, kto, m.group(3))
                v_kadr(tags, m.group(2), kto, m.group(3))
                PEREDACHA.prishlo(tags, m.group(2), kto, m.group(3), k)
            elif chistka_chata(line):
                pass
            else:
                u = re.match(r'@(\S+) :tmi\.twitch\.tv USERNOTICE '
                             r'#\w+(?: :(.*))?', line)
                if u:
                    sobytie_chata(dict(
                        x.split('=', 1) for x in u.group(1).split(';')
                        if '=' in x), u.group(2) or '')
                else:
                    zritel_iz_chata(line, k)
            if self.kanal() != k:
                break               # канал сменили
        s.close()

    def prishlo(self, kto, tekst, now=None):
        now = now or time.time()
        # чужие слова — обезвредить (как chuzhoe в
        # dezhurnyy): без управляющих знаков и переносов,
        # коротко, в «ёлочках» — граница чужой речи видна
        if tekst.startswith('\x01ACTION '):       # «/me машет»
            tekst = tekst[8:].rstrip('\x01')
        tekst = ' '.join(re.sub(r'[\x00-\x1f\x7f]', ' ',
                                tekst).split())
        if len(tekst) > 200:
            tekst = tekst[:200] + '…'
        kto = re.sub(r'[^\w-]', '', kto)[:25] or '?'
        try:
            with open(CHAT, 'a') as f:
                f.write('%s %s: %s\n' % (
                    time.strftime('%H:%M', time.localtime(now)),
                    kto, tekst))
            if os.path.getsize(CHAT) > 512 * 1024:   # не растёт вечно
                hvost = open(CHAT).readlines()[-2000:]
                open(CHAT, 'w').writelines(hvost)
        except OSError:
            pass
        with self.lock:
            tiho = now - self.posl >= CHAT_TISHINA
            self.posl = now
            if (self.novye and self.novye[-1][0] == kto
                    and now - self.posl_kto < CHAT_SKLEIT
                    and len(self.novye[-1][1]) + len(tekst) < 300):
                tekst = self.novye[-1][1] + ' ' + tekst   # тот же зритель дописывает
                self.novye[-1] = (kto, tekst)
            else:
                self.novye.append((kto, tekst))
            self.posl_kto = now
            if not self.novye:
                self.novye_t0 = now            # с какого сообщения копится пачка
            if len(self.novye) > 300:          # долгий шквал под потолком — не копить вечно
                self.novye = self.novye[-300:]
            self.vremena = [x for x in self.vremena if now - x < 60] + [now]
            # одинокое «плюс» в чате — это «+1», согласие;
            # к Плюсу обращаются словами
            if tiho or (K_PLUSU.search(tekst)
                        and len(tekst.split()) >= 2):
                if not self.srochno:
                    self.srochno_s = now
                self.srochno = True

    def otdavat(self):
        while True:
            time.sleep(0.5)
            self.otdat()

    def otdat(self, now=None):
        now = now or time.time()
        with self.lock:
            if not self.novye:
                return False
            kipit = len([x for x in self.vremena if now - x < 60]) > CHAT_KIPIT
            if kipit:                     # шквал: дайджест раз в CHAT_DAYDZHEST, тишины ждать нечего
                if now - self.otdano < CHAT_DAYDZHEST or now - self.novye_t0 < CHAT_NAKOPIT:
                    return False
            elif self.srochno:            # позвали: ждём, пока чат помолчит; пачки не чаще CHAT_MIN
                tiho_uzhe = now - self.posl >= CHAT_SOBRAT
                dolgo = now - self.srochno_s >= CHAT_SOBRAT_MAKS
                if not (tiho_uzhe or dolgo) or now - self.otdano < CHAT_MIN:
                    return False
            elif now - self.otdano < CHAT_RAZ:
                return False
            self.otdachi = [x for x in self.otdachi if now - x < 3600]
            tolko_k_plusu = False
            if len(self.otdachi) >= CHAT_CHAS:  # потолок: не молчим — реже и только обращённые
                if now - self.otdano < CHAT_POTOLOK_RAZ or not any(k_plusu(x) for _, x in self.novye):
                    if self.srochno and now - self.otdano < CHAT_POTOLOK_RAZ:
                        self.srochno = False
                        print(time.strftime('%H:%M:%S'), 'чат: потолок',
                              CHAT_CHAS, 'в час — обращённые к Плюсу раз в',
                              int(CHAT_POTOLOK_RAZ // 60), 'мин', flush=True)
                    return False
                tolko_k_plusu = True
            if not self.alive() or ekran_zanyat():
                return False      # вопрос на экране: ждём
            vse, self.novye = self.novye, []
            nabor = [x for x in vse if k_plusu(x[1])] if tolko_k_plusu else vse
            stroki, ne_voshlo = pachka_po_vazhnosti(nabor, self.znakomye)
            self.znakomye.update(k for k, _ in vse)
            self.srochno, self.otdano = False, now
            self.otdachi.append(now)
        t = ' · '.join(stroki)
        dop = []
        if kipit:
            dop.append('чат кипит: %d сообщений за минуту — отвечай одной фразой, одному-двум' % len(self.vremena))
        if ne_voshlo:
            dop.append('ещё %d сообщений не вошло' % ne_voshlo)
        if tolko_k_plusu:
            dop.append('потолок пачек в час: здесь только обращённые к тебе')
        if dop:
            t = '(%s) %s' % ('; '.join(dop), t)
        if not v_plus(t[:900], CHAT_METKA):
            with self.lock:   # вопрос появился только что
                self.novye = vse + self.novye
                self.otdachi.pop()
                self.srochno = True
            return False
        print(time.strftime('%H:%M:%S'), 'чат → Плюсу:',
              len(stroki), 'строк' + (', кипит' if kipit else ''), flush=True)
        return True


PAMYAT = os.environ.get('USHI_PAMYAT', '/tmp/pamyat.log')


def pamyat_termux():
    """Сколько памяти держит Плюс в Termux, по
    процессам (VmRSS, МБ) — раз в 30 с в /tmp/pamyat.log.
    06.10 Quest закрывал по памяти Termux, потом и
    приложение 2: видно, кто сколько ест перед этим.
    Приложение пишет своё — curl localhost:8766/pamyat."""
    gr = {}
    for d in os.listdir('/proc'):
        if not d.isdigit():
            continue
        try:
            st = open('/proc/%s/status' % d).read()
        except OSError:
            continue
        n = re.search(r'^Name:\s*(\S+)', st, re.M)
        r = re.search(r'^VmRSS:\s*(\d+)', st, re.M)
        if n and r:
            gr[n.group(1)] = gr.get(n.group(1), 0) + int(r.group(1))
    top = sorted(gr.items(), key=lambda x: -x[1])[:6]
    stroka = '%s termux %d МБ: %s\n' % (
        time.strftime('%d.%m %H:%M:%S'), sum(gr.values()) // 1024,
        ', '.join('%s %d' % (k, v // 1024) for k, v in top))
    try:
        if os.path.getsize(PAMYAT) > 400000:
            t = open(PAMYAT).read()
            open(PAMYAT, 'w').write(t[len(t) // 2:])
    except OSError:
        pass
    try:
        open(PAMYAT, 'a').write(stroka)
    except OSError:
        pass


