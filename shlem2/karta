#!/bin/sh
# karta — звук карты захвата (2.6.0): Elgato и т. п. для Android — USB-звуковая карта; мост пишет с неё звук
# игры и играет в шлем, а эфир берёт его как звук игры (HDMI Link 20.10 картинку показывал, звук — нет).
#   karta            — идёт ли звук, какие входы видит Android
#   karta vkl|vykl   — включить / выключить (мост запоминает)
#   karta 80         — громкость игры, % (0–150)
L=${0%/*}/plus-lib; [ -f "$L" ] || L=/usr/local/bin/plus-lib
exec python3 -S "$L" karta "$@"
