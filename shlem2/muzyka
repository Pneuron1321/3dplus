def vypolnit(k, a):
    """Команда шторки — то же, что голосом (вывод команды шторке не нужен)."""
    import contextlib
    import io
    a = str(a or '').strip()
    komanda = {'vkl': ['vkl'] + ([a] if a else []), 'stop': ['stop'], 'sled': ['sleduyushchiy'],
               'pred': ['predydushchiy'], 'gromkost': ['gromkost', a, 'bystro'], 'vse': ['pleylist', '-', 'vse'],
               'pleylist': ['pleylist', a, 'vkl']}.get(k)
    if not komanda or (k in ('gromkost', 'pleylist') and not a):
        return
    with contextlib.redirect_stdout(io.StringIO()):
        main(komanda)
        if k in ('pleylist', 'vse') and cfg_chitat()['on'] and demon_zhiv():
            main(['sleduyushchiy'])                          # из шторки — сразу, а не со следующего трека
    log('шторка: %s %s' % (k, a[:60]))


def pult():
    """Демон шторки: раз в ~3 с — состояние мосту (если поменялось или раз в 5 с), между — ждёт команду."""
    lk = open(PULT_LOCK, 'a')
    try:
        fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0
    try:
        os.nice(10)
    except OSError:
        pass
    mt = os.path.getmtime(os.path.abspath(__file__))
    posl, posl_t = None, 0.0
    while True:
        try:
            if os.path.getmtime(os.path.abspath(__file__)) != mt:
                lk.close()
                os.execv(sys.executable, [sys.executable, os.path.abspath(__file__), 'pult'])   # обновили — новой версией
        except OSError:
            pass
        try:
            s = json.dumps(sostoyanie_pleera(), ensure_ascii=False)
            if s != posl or time.time() - posl_t > 5:
                req = urllib.request.Request(MOST + '/fon/pleer', data=s.encode('utf-8'), method='POST',
                                             headers={'Content-Type': 'application/json'})
                urllib.request.urlopen(req, timeout=5).read()
                posl, posl_t = s, time.time()
            with urllib.request.urlopen(MOST + '/fon/komanda?zhdat=3', timeout=10) as r:
                k = json.loads(r.read().decode() or '{}')
            if k.get('k'):
                vypolnit(k['k'], k.get('a'))
                posl = None                                  # сразу новое состояние
        except Exception:
            time.sleep(5)                                    # моста нет (закрыт, старое приложение) — тихо ждём


def demon():
    if 'fon' in most_umeet():
        return demon_fon()
    return demon_staryy()


def demon_staryy():
    try:
        os.nice(10)
    except OSError:
        pass
    lk = open(LOCK, 'a')
    try:
        fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0
    tmpdir = tempfile.mkdtemp(prefix='muzyka-')
    log('демон пошёл')
    cfg = cfg_chitat()
    nonce = cfg['nonce']
    vse = treki()
    ocher = []

    def vybrat(zapros=None, posle=None):
        t = treki()
        if zapros:
            n = naiti(zapros)
            if n:
                return n[0]
        if not t:
            return None
        if not ocher:
            ocher.extend(random.sample(t, len(t)))
            if posle in ocher and len(ocher) > 1 and ocher[0] == posle:
                ocher.append(ocher.pop(0))
        return ocher.pop(0)

    trek = vybrat(cfg.get('track'), None)
    anons = [0, None]
    poz = 0.0
    gotov = None          # (trek, poz, vol) -> (путь, длина, конец): заготовка следующего куска
    ischem = None
    tishina_s = None      # с какого момента мост молчит
    prichina = 'ждёт'

    def zapis(igraet, pr=''):
        try:
            tmp = STATE + '.tmp'
            json.dump({'pid': os.getpid(), 'igraet': igraet, 'trek': imya(trek) if trek else None,
                       'poz': round(poz), 'vol': cfg['vol'], 'prichina': pr, 't': time.time()}, open(tmp, 'w'))
            os.replace(tmp, STATE)
        except OSError:
            pass

    try:
        while trek:
            cfg = cfg_chitat()
            if not cfg['on']:
                break
            if cfg['nonce'] != nonce:                     # vkl трек / sleduyushchiy
                nonce = cfg['nonce']
                trek = vybrat(cfg.get('track'), trek) if cfg.get('track') else vybrat(None, trek)
                cfg['track'] = None
                cfg_pisat(cfg)
                poz, gotov = 0.0, None
                if not trek:
                    break
            p = os.path.join(DIR, trek)
            if not os.path.exists(p):
                trek = vybrat(None, trek)
                poz, gotov = 0.0, None
                continue
            # --- ждём тишины моста ---
            st = most_status()
            svobodno = (st is not None and not st.get('playing') and not golos_v_ocheredi()
                        and not alexandr_govorit())
            if not svobodno:
                tishina_s = None
                zapis(False, 'мост не отвечает' if st is None else 'говорит Ава или Александр')
                time.sleep(0.4)
                continue
            if tishina_s is None:
                tishina_s = time.time()
            if time.time() - tishina_s < TISHINA:
                zapis(False, 'пауза после голоса')
                time.sleep(0.3)
                continue
            # --- кусок ---
            try:
                if gotov and gotov[0] == (trek, poz, cfg['vol']):
                    put, d, konec = gotov[1]
                else:
                    put, d, konec = kusok(p, poz, dlitelnost(p), cfg['vol'], usilenie(p), tmpdir,
                                          0.5 if poz > 0.5 else 0.03)
            except Exception as e:
                log('ffmpeg: %s %s' % (type(e).__name__, str(e)[:100]))
                time.sleep(5)
                continue
            gotov = None
            rez = os.environ.get('MUZYKA_REZHIM') or ('oba' if 'oba' in (st.get('rezhimy') or []) else 'vsluh')
            st2 = most_status()
            if st2 is None or st2.get('playing'):          # за это время заговорила Ава — не лезем
                tishina_s = None
                continue
            ig = Igra(put, rez)
            poz_nach, vol_nach = poz, cfg['vol']
            zapis(True)
            if time.time() - anons[0] > 80 or anons[1] != trek:   # строка «Now playing» в чате эфира (живёт 1,5 мин)
                anons[:] = [time.time(), trek]
                try:
                    tx = urllib.parse.quote('Now playing: %s - Kevin MacLeod (CC BY 4.0)' % imya(trek))
                    urllib.request.urlopen(MOST + '/chat/upr?pokaz=1&kto=Music&login=music&cvet=%23F8CF1E&id=muz&tekst=' + tx, timeout=3).read()
                except Exception:
                    pass
            sled = None
            while ig.res is None:
                time.sleep(0.3)
                c2 = cfg_chitat()
                if (not c2['on'] or c2['nonce'] != nonce or c2['vol'] != vol_nach or alexandr_govorit()):
                    try:
                        urllib.request.urlopen(MOST + '/say/stop', timeout=2).read()
                    except Exception:
                        pass
                    break
                if sled is None and time.time() - ig.t0 > 1.5 and not konec:
                    # заготовка следующего куска, пока играет этот
                    try:
                        sled = kusok(p, poz_nach + d, dlitelnost(p), vol_nach, usilenie(p), tmpdir)
                        gotov = ((trek, poz_nach + d, vol_nach), sled)
                    except Exception as e:
                        log('prefetch: %s' % e)
                        sled = False
            for _ in range(20):                            # ждём ответ моста после stop
                if ig.res is not None:
                    break
                time.sleep(0.1)
            probilo = time.time() - ig.t0
            try:
                os.remove(put)
            except OSError:
                pass
            if ig.res == 'done' and probilo >= d - 1.0:
                poz = poz_nach + d
                tishina_s = time.time() - TISHINA + 0.0     # без паузы между кусками
                if konec:
                    trek = vybrat(None, trek)
                    poz, gotov = 0.0, None
            else:
                # оборвали (Ава заговорила, громкость, команда): продолжим с того же места
                poz = poz_nach + min(probilo, d)
                tishina_s = None
                if poz >= dlitelnost(p) - 1:
                    trek = vybrat(None, trek)
                    poz = 0.0
                if ig.res == 'error':
                    time.sleep(3)
    finally:
        try:
            os.remove(STATE)
        except OSError:
            pass
        try:
            for f in os.listdir(tmpdir):
                os.remove(os.path.join(tmpdir, f))
            os.rmdir(tmpdir)
        except OSError:
            pass
        log('демон вышел')
    return 0


# ---------- команды ----------

def skazat_sostoyanie():
    cfg = cfg_chitat()
    st = sostoyanie()
    if not demon_zhiv() or not cfg['on']:
        return 'Музыка выключена. Треков в папке: %d, громкость %d.' % (len(treki()), cfg['vol'])
    if st.get('igraet'):
        return 'Играет «%s», громкость %d.' % (st.get('trek'), cfg['vol'])
    return 'Включена, сейчас пауза (%s); трек «%s», громкость %d.' % (st.get('prichina') or 'ждёт',
                                                                         st.get('trek'), cfg['vol'])


def main(a):
    if a and a[0] == '--demon':
        return demon()
    if a and a[0] == 'pult':
        return pult()
    cmd = a[0].lower() if a else ''
    rest = ' '.join(a[1:]).strip()
    if cmd in ('', 'status'):
        print(skazat_sostoyanie())
        return 0
    if cmd in ('vkl', 'on', 'start'):
        if not treki():
            print('В папке %s нет треков.' % DIR)
            return 1
        cfg = cfg_chitat()
        if rest:
            n = naiti(rest)
            if not n:
                print('Не нашла трек «%s». Есть: %s.' % (rest, ', '.join(imya(f) for f in treki())))
                return 1
            if len(n) > 1:
                print('Подходит несколько: %s. Уточни.' % ', '.join(imya(f) for f in n))
                return 1
            cfg['track'] = n[0]
        else:
            cfg['track'] = None
        was = demon_zhiv() and cfg['on']
        cfg['on'] = True
        cfg['nonce'] += 1
        cfg_pisat(cfg)
        if not zapustit_demona():
            print('Демон музыки не поднялся, смотри /tmp/muzyka.log.')
            return 1
        print('Музыка %s%s, громкость %d.' % ('переключена' if was else 'включена',
                                            (' на «%s»' % imya(cfg['track'])) if cfg['track'] else '', cfg['vol']))
        return 0
    if cmd in ('stop', 'vykl', 'off'):
        cfg = cfg_chitat()
        cfg['on'] = False
        cfg_pisat(cfg)
        print('Музыка выключена.')
        return 0
    if cmd in ('sleduyushchiy', 'sled', 'next', 'dalshe'):
        cfg = cfg_chitat()
        if not (cfg['on'] and demon_zhiv()):
            print('Музыка не играет — сначала muzyka vkl.')
            return 1
        cfg['track'] = None
        cfg['nonce'] += 1
        cfg_pisat(cfg)
        print('Следующий трек.')
        return 0
    if cmd in ('predydushchiy', 'pred', 'prev', 'nazad'):
        p = proshlyy_trek()
        if not p:
            print('Прошлого трека не помню.')
            return 1
        cfg = cfg_chitat()
        cfg['track'] = p
        cfg['on'] = True
        cfg['nonce'] += 1
        cfg_pisat(cfg)
        if not zapustit_demona():
            print('Демон музыки не поднялся, смотри /tmp/muzyka.log.')
            return 1
        print('Назад: «%s».' % imya(p))
        return 0
    if cmd in ('gromkost', 'gromche', 'tishe', 'bystro'):
        cfg = cfg_chitat()
        slova = rest.split()
        bystro = cmd == 'bystro' or 'bystro' in [w.lower() for w in slova]
        rest = ' '.join(w for w in slova if w.lower() != 'bystro')
        if cmd == 'bystro':
            cmd = 'gromkost'
        m = re.search(r'([+-]?)\s*(\d+)', rest)
        if cmd != 'gromkost' and not m:
            m = re.match(r'()(10)$', '10')
        if not m:
            print('Громкость сейчас %d. Скажи число от 0 до 100.' % cfg['vol'])
            return 0
        n = int(m.group(2))
        if cmd == 'gromche':
            nov = cfg['vol'] + n
        elif cmd == 'tishe':
            nov = cfg['vol'] - n
        elif m.group(1) == '+':
            nov = cfg['vol'] + n
        elif m.group(1) == '-':
            nov = cfg['vol'] - n
        else:
            nov = n
        nov = max(0, min(100, nov))
        was = cfg['vol']
        cfg['vol'] = nov
        bystro = bystro and cfg['on'] and demon_zhiv() and 'fon' in most_umeet()
        if bystro:
            cfg['bystro_n'] = cfg.get('bystro_n', 0) + 1
        cfg_pisat(cfg)
        if bystro:
            baza = sostoyanie().get('baza') or was
            fon_gromkost(round(nov * 100.0 / max(baza, 1)))      # очередь приложения — сразу
        print('Громкость музыки: было %d, стало %d%s.' % (was, nov, ' (сразу)' if bystro else ''))
        return 0
    if cmd in ('pleylist', 'playlist'):
        a = rest.split(None, 2)
        if not a:
            print('Плейлисты: ' + (', '.join(f[10:-4] for f in sorted(os.listdir(DIR)) if f.startswith('.pleylist-') and f.endswith('.txt')) or 'нет') + '.')
            return 0
        num, sub = a[0], (a[1] if len(a) > 1 else '')
        arg = a[2] if len(a) > 2 else ''
        akt = os.path.join(DIR, '.pleylist-aktivnyy')
        if sub in ('dobavit', 'add'):
            if arg in ('', 'tekushchiy'):
                try:
                    arg = (json.load(open(STATE)).get('trek') or '')
                except Exception:
                    arg = ''
            n = naiti(arg) if arg else []
            if len(n) != 1:
                print('Не нашла трек. Скажи название.')
                return 1
            cur = pl_chitat(num)
            if n[0] not in cur:
                cur.append(n[0])
            open(pl_put(num), 'w', encoding='utf-8').write('\n'.join(cur) + '\n')
            print('В плейлист %s добавлен «%s». Там: %s.' % (num, imya(n[0]), ', '.join(imya(f) for f in cur)))
            return 0
        if sub in ('vkl', 'play'):
            if not pl_chitat(num):
                print('Плейлист %s пуст.' % num)
                return 1
            open(akt, 'w', encoding='utf-8').write(num)
            print('Играет плейлист %s (со следующего трека).' % num)
            return 0
        if sub in ('vse', 'sbros'):
            try:
                os.remove(akt)
            except OSError:
                pass
            print('Играют все треки.')
            return 0
        print('Плейлист %s: %s.' % (num, ', '.join(imya(f) for f in pl_chitat(num)) or 'пуст'))
        return 0
    if cmd in ('spisok', 'list'):
        t = treki()
        if not t:
            print('Папка пуста.')
        else:
            print('Треков %d: %s.' % (len(t), ', '.join(imya(f) for f in t)))
        return 0
    if cmd in ('udalit', 'delete', 'rm'):
        if not rest:
            print('Какой трек удалить? Скажи название.')
            return 1
        n = naiti(rest)
        if not n:
            print('Не нашла трек «%s». Есть: %s.' % (rest, ', '.join(imya(f) for f in treki())))
            return 1
        if len(n) > 1:
            print('Подходит несколько: %s. Уточни.' % ', '.join(imya(f) for f in n))
            return 1
        st = sostoyanie()
        igraet_eto = (st.get('trek') == imya(n[0]))
        cfg = cfg_chitat()
        if demon_zhiv() and cfg['on'] and (igraet_eto or not st):
            cfg['track'] = None                            # играет именно его — сразу на другой трек
            cfg['nonce'] += 1
            cfg_pisat(cfg)
        os.remove(os.path.join(DIR, n[0]))                 # демон и сам видит исчезновение файла
        for pl in pleylisty():                             # и из всех плейлистов (17.10: оставались мёртвые имена)
            sp = pl_chitat(pl)
            if n[0] in sp:
                open(pl_put(pl), 'w', encoding='utf-8').write(''.join(x + '\n' for x in sp if x != n[0]))
        try:
            av = json.load(open(AVTORY, encoding='utf-8'))
            if av.pop(imya(n[0]), None) is not None:
                json.dump(av, open(AVTORY, 'w', encoding='utf-8'), ensure_ascii=False, indent=1)
        except (OSError, ValueError):
            pass
        print('Удалила «%s». Осталось треков: %d.' % (imya(n[0]), len(treki())))
        return 0
    if cmd in ('avtor', 'author'):
        print(AVTOR)
        return 0
    print('muzyka [vkl [трек] | stop | sleduyushchiy | predydushchiy | gromkost N | spisok | udalit ИМЯ | avtor | pult]')
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
