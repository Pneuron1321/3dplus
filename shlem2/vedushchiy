def obnovilsya(mt):
    """Новая версия файла на месте (обновление или возврат своей) — перезапуститься ею (замок отпускается сам: exec закрывает файл)."""
    try:
        if os.path.getmtime(__file__) == mt or time.time() - os.path.getmtime(__file__) < 5:
            return
        compile(open(__file__, encoding='utf-8').read(), __file__, 'exec')
    except (OSError, SyntaxError, ValueError):
        return
    log('новая версия — перезапускаюсь')
    os.execv(sys.executable, [sys.executable, os.path.abspath(__file__)] + sys.argv[1:])


