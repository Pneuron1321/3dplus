    print('\033[2mСоведущая — реплики и перевод:\033[0m')
    pechat(hvost(LOG, 4))
    try:
        poz = os.path.getsize(LOG)
    except OSError:
        poz = 0
    ostatok = ''
    while zhiv():
        time.sleep(shag)
        try:
            razmer = os.path.getsize(LOG)
        except OSError:
            continue
        if razmer < poz:                                   # журнал начат заново
            poz, ostatok = 0, ''
        if razmer == poz:
            continue
        try:
            with open(LOG, 'rb') as f:
                f.seek(poz)
                kusok = f.read(razmer - poz)
        except OSError:
            continue
        poz = razmer
        tekst = ostatok + kusok.decode('utf-8', 'replace')
        *stroki, ostatok = tekst.split('\n')
        pechat(stroki)
    return 0


