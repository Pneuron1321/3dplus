    действует сразу): сжатое рядом с книгой, иначе полный /root/deep-transitor.md, иначе запасное в коде."""
    yadro = ''
    for f in (TRANZITOR_V2, TRANZITOR_POLNYY):
        try:
            yadro = open(f, encoding='utf-8').read().strip()
        except OSError:
            continue
        if len(yadro) > 200:
            yadro = yadro[:16000]
            break
        yadro = ''
    return TRANZITOR_GOLOVA + (yadro + '\n' if yadro else TRANZITOR_YADRO) + TRANZITOR_HVOST



