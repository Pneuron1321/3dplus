# ---------- тетрадь ученицы (Александр 18.10: «соведущая-ученица — верно, тетрадь — правильно») ----------
# Память между вечерами: вопросы, догадки, подтверждённое и опровергнутое — у каждой записи предмет, примета, улики.
# Реплика стоит на краю тетради; ответы Александра (sprosi, дослух) и лента меняют статусы. День — вечер эфира;
# в конце эфира разница тетради ложится в дневник пути (zhurnal.md) — шоу «Плюс учится играть».
TETRAD = os.environ.get('VED_TETRAD', os.path.join(PAPKA, 'tetrad.json'))
ZHURNAL = os.environ.get('VED_ZHURNAL', '/root/zhurnal.md')
TETRAD_MAX = 80
STATUSY = {'vopros': 'вопрос', 'gipoteza': 'догадка', 'podtverzhdeno': 'подтверждено', 'oprovergnuto': 'опровергнуто'}
VECHER_PAUZA = 8 * 3600          # дольше без эфира — новый вечер, новый день


def tetrad_chitat():
    try:
        d = json.load(open(TETRAD))
        if isinstance(d, dict) and isinstance(d.get('zapisi'), list):
            d['zapisi'] = [z for z in d['zapisi'] if isinstance(z, dict) and z.get('status') in STATUSY and z.get('tekst')]
            return d
    except (OSError, ValueError):
        pass
    return {'den': 0, 'vecher_t': 0, 'vopros_vechera': '', 'snimok': {}, 'n': 0, 'zapisi': []}


def tetrad_pisat(d):
    zap = d['zapisi']
    if len(zap) > TETRAD_MAX:                         # лишнее — сначала давно решённое, открытое держим
        reshennye = sorted((z for z in zap if z['status'] in ('podtverzhdeno', 'oprovergnuto')), key=lambda z: z.get('t_izm', 0))
        lishnie = {id(z) for z in reshennye[:len(zap) - TETRAD_MAX]}
        d['zapisi'] = [z for z in zap if id(z) not in lishnie]
    _zapisat_json(TETRAD, d)


def tetrad_vecher(d=None):
    """Новый вечер (больше VECHER_PAUZA без эфира): день +1, снимок статусов для дневника, вопрос вечера — самое
    старое открытое. Возвращает тетрадь."""
    d = d or tetrad_chitat()
    if time.time() - d.get('vecher_t', 0) > VECHER_PAUZA:
        d['den'] = d.get('den', 0) + 1
        d['snimok'] = {str(z['id']): z['status'] for z in d['zapisi']}
        otkr = sorted((z for z in d['zapisi'] if z['status'] in ('vopros', 'gipoteza')), key=lambda z: z.get('t', 0))
        d['vopros_vechera'] = otkr[0]['tekst'] if otkr else ''
    d['vecher_t'] = time.time()
    tetrad_pisat(d)
    return d


def tetrad_tekst(d=None):
    """Блок «Тетрадь» для запроса: день, вопрос вечера, открытое (новое сверху) и недавно понятое."""
    d = d or tetrad_chitat()
    stroka = lambda z: '  #%d [%s] %s: %s%s%s' % (z['id'], STATUSY[z['status']], z.get('pro', '?'), z['tekst'],
                                                  ' (примета: %s)' % z['primeta'] if z.get('primeta') else '',
                                                  ' (улики: %s)' % '; '.join(z.get('uliki', [])[-2:]) if z.get('uliki') else '')
    otkr = sorted((z for z in d['zapisi'] if z['status'] in ('vopros', 'gipoteza')), key=lambda z: -z.get('t', 0))[:14]
    ponyato = sorted((z for z in d['zapisi'] if z['status'] not in ('vopros', 'gipoteza')), key=lambda z: -z.get('t_izm', 0))[:8]
    vse = [z for z in d['zapisi'] if z['status'] in ('podtverzhdeno', 'oprovergnuto')]
    return '\n'.join(['День %d пути «Плюс учится играть». Вопрос вечера: %s' % (d.get('den', 0) or 1, d.get('vopros_vechera') or '— (выбери сама)'),
                      'Открытое (вопросы и догадки):'] + ([stroka(z) for z in otkr] or ['  — (тетрадь пустая: начни с вопросов о том, что видишь)']) +
                     ['Понятое недавно:'] + ([stroka(z) for z in ponyato] or ['  —']) +
                     ['Всего понято за путь: %d (подтверждено %d, опровергнуто %d).' % (
                         len(vse), sum(z['status'] == 'podtverzhdeno' for z in vse), sum(z['status'] == 'oprovergnuto' for z in vse))])


def tetrad_primenit(o, otkuda='lenta'):
    """Записи и смены статусов из ответа модели (поле tetrad). Возвращает строки о том, что изменилось."""
    t = o.get('tetrad') if isinstance(o, dict) and isinstance(o.get('tetrad'), dict) else {}
    if not t:
        return []
    d = tetrad_chitat()
    po_id = {z['id']: z for z in d['zapisi']}
    sdelano, now = [], time.time()
    for x in (t.get('izmeneniya') or [])[:4]:
        if not isinstance(x, dict):
            continue
        try:
            z = po_id.get(int(x.get('id')))
        except (TypeError, ValueError):
            z = None
        st = x.get('status')
        if not z or st not in STATUSY or st == z['status']:
            continue
        ulika = _chistaya_stroka(x.get('ulika'), 200, 3)
        z['status'], z['t_izm'] = st, now
        if ulika:
            z.setdefault('uliki', []).append(('Александр: ' if otkuda == 'aleksandr' else '') + ulika)
            z['uliki'] = z['uliki'][-5:]
        sdelano.append('#%d → %s' % (z['id'], STATUSY[st]))
    for x in (t.get('novye') or [])[:2]:
        if not isinstance(x, dict):
            continue
        tekst = _chistaya_stroka(x.get('tekst'), 220)
        if not tekst or x.get('status', 'vopros') not in ('vopros', 'gipoteza'):
            continue
        kl = set(slova(tekst))
        if any(len(kl & set(slova(z['tekst']))) >= max(3, 0.6 * len(kl)) for z in d['zapisi']):
            continue                                  # уже есть такая
        d['n'] = d.get('n', 0) + 1
        d['zapisi'].append({'id': d['n'], 'pro': _chistaya_stroka(x.get('pro'), 60, 1) or '?', 'tekst': tekst,
                            'status': x.get('status', 'vopros'), 'primeta': _chistaya_stroka(x.get('primeta'), 160, 0),
                            'uliki': [], 't': now, 't_izm': now, 'den': d.get('den', 0) or 1})
        sdelano.append('новая #%d' % d['n'])
    if sdelano:
        tetrad_pisat(d)
        log('тетрадь:', ', '.join(sdelano))
    return sdelano


def tetrad_zapis_est(nomer):
    try:
