    if sdelano and not nemoy:
        sohranit(k)
        tablo(k)
    if not nemoy:                                             # вызов за донат — первым, всегда: без срока и без Haiku
        kto = donat_vyzov(k, now)
        if kto:
            POPYTKA_T[1] = 0
            sohranit(k)
            tablo(k)
            return 'вызов от донатера (%s)' % kto
