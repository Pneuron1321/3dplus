def okno_vkladka():
    """Вкладка «ved» в tmux «plus» (не активная — окно Claude остаётся на виду): tail журнала соведущей. Нет tmux — молча."""
    try:
        open(OKNO_LOG, 'a').close()
        try:                                                    # 19.10 слияние: есть полоса `lenta` (/root/.ved-lenta, по умолчанию 6 строк) — вкладка «ved» дублировала бы её
            if int(open('/root/.ved-lenta').read().strip() or 6) > 0:
                return
        except OSError:
            return
        except ValueError:
            return
        if subprocess.run(['tmux', 'has-session', '-t', 'plus'], stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL, timeout=3).returncode != 0:
            return
        r = subprocess.run(['tmux', 'list-windows', '-t', 'plus', '-F', '#{window_name}'],
                           capture_output=True, text=True, timeout=3)
        if 'ved' in r.stdout.split():
            return
        # вкладка не должна держать сессию: Claude вышел (/exit) и других вкладок нет — tail кончается, сессия тоже
        # (иначе скрипт plus не поднимет Плюса снова)
        cmd = ("tail -n 30 -F %s & T=$!; "
               "while tmux list-windows -t plus -F '#{window_name}' | grep -qv '^ved$'; do sleep 2; done; "
               "kill $T") % OKNO_LOG
        subprocess.run(['tmux', 'new-window', '-d', '-t', 'plus:', '-n', 'ved', cmd],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
    except Exception:
        pass


