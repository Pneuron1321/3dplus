            ' / '.join(v.get('slabye', []))[:420], ('; цель: ' + v['cel'][:120]) if v.get('cel') else ''))
    return '\n'.join(res)


def _vremya_stroki(l, opora):
    """Время строки лога «ЧЧ:ММ:СС Имя | …» в секундах эпохи: дата — от опорной метки (реплика), полночь учтена."""
    m = re.match(r'^(\d\d):(\d\d):(\d\d)\s', l)
    if not m:
        return None
    d = time.localtime(opora)
    t = time.mktime((d.tm_year, d.tm_mon, d.tm_mday, int(m.group(1)), int(m.group(2)), int(m.group(3)), 0, 0, -1))
    return t + 86400 if t < opora - 600 else t


def reakcii(repliki):
    """Слова Александра сразу после каждой реплики (до следующей реплики, не дольше REAKCIYA_OKNO): [строка на реплику]."""
    try:
        stroki = open(ISTORIYA, errors='replace').read().splitlines()[-400:]
    except OSError:
        stroki = []
    razobrano = []
    for l in stroki:
        p = l.split(' | ')
        if len(p) < 2 or not re.match(r'^\d\d:\d\d:\d\d\s+Александр\b', p[0]):
            continue
        razobrano.append((p[0], p[1].strip()))
    res = []
    for i, r in enumerate(repliki):
        t0 = r.get('t', 0)
        t1 = min(repliki[i + 1].get('t', t0 + REAKCIYA_OKNO) if i + 1 < len(repliki) else t0 + REAKCIYA_OKNO,
                 t0 + sek(REAKCIYA_OKNO))
        slova_a = [txt[:140] for hd, txt in razobrano if (_vremya_stroki(hd, t0) or 0) >= t0 - 2 and (_vremya_stroki(hd, t0) or 0) < t1]
        res.append(' / '.join('«%s»' % s for s in slova_a[:3]) if slova_a else '(Александр молчал)')
    return res


def iskhody(k, ot):
    """Ставки и вызовы с исходом после момента ot — как сыграли."""
    res = []
    for nm, sp in (('ставка', k.get('stavki', [])), ('вызов', k.get('vyzovy', []))):
        for x in sp:
            if x.get('t_itog', 0) >= ot and x.get('itog') in ('da', 'net'):
                res.append('%s «%s» — %s' % (nm, str(x.get('ru', ''))[:100], 'засчитана' if x['itog'] == 'da' else 'НЕ засчитана'))
    return res


def legkaya_model(sistema, zapros, timeout=150):
    """Один короткий вызов той же модели: без картинок, без инструментов, без хуков, усилие low. dict или None."""
    env = dict(os.environ, CLAUDE_CODE_DISABLE_CLAUDE_MDS='1', CLAUDE_CODE_DISABLE_AUTO_MEMORY='1', GOLOS_RACIYA='1')
    model, _ = golova()
    os.makedirs(DIR, exist_ok=True)
    cmd = [CLAUDE, '-p', '--model', model, '--effort', 'low', '--tools', '', '--no-session-persistence',
           '--settings', '{"disableAllHooks":true}', '--output-format', 'json', '--system-prompt', sistema, zapros]
    try:
        r = subprocess.run(cmd, cwd=DIR, env=env, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
        t = json.loads(r.stdout).get('result', '') if r.stdout.strip() else ''
        m = re.search(r'\{.*\}', t, re.S)
        return json.loads(m.group(0)) if m else None
    except Exception as e:
        log('лёгкий вызов не удался:', type(e).__name__, str(e)[:80])
        return None


def _chistaya_stroka(x, mx, mn=8):
    s = re.sub(r'\s+', ' ', str(x or '')).strip()
    if len(s) < mn or OPASNO_RE.search(s) or re.search(r'[\x00-\x1f]', s):
        return ''
    return s[:mx]


