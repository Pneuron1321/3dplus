def svodka_vechera(prichina='chas'):
    """Сводка вечера в vechera.jsonl: дата, 3 лучших, 3 слабых, итог цели. Реплики после прошлой сводки."""
    if not _SVOD.acquire(blocking=False):
        return 'сводка уже идёт'
    try:
        prosh = vechera_chitat(1)
        posl = prosh[0].get('do_t', 0) if prosh else 0
        novye = [r for r in vse_repliki() if r.get('t', 0) > posl and r.get('rech')]
        if len(novye) < SVODKA_MIN:
            return 'новых реплик %d — сводку не пишу' % len(novye)
        if prichina != 'seychas' and time.time() - _POSL_NEUDACHA['svodka'] < sek(POVTOR_ZHDEM):
            return 'рано (прошлая сводка не вышла)'
        novye = novye[-30:]
        k = kniga()
        zapros = ['Мои реплики за вечер (время | приём | тема — «текст»):']
        for r in novye:
            zapros.append('  %s | %s | %s — «%s»' % (time.strftime('%H:%M', time.localtime(r['t'])), r.get('priem', '?'),
                                                    r.get('tema', '?'), str(r.get('rech', ''))[:200]))
        sh = [x for x in k.get('stavki', []) if x.get('itog') in ('da', 'net')]
        vz = [x for x in k.get('vyzovy', []) if x.get('itog') in ('da', 'net')]
        zapros.append('Ставки %d из %d, вызовы %d из %d.' % (sum(x['itog'] == 'da' for x in sh), len(sh),
                                                          sum(x['itog'] == 'da' for x in vz), len(vz)))
        try:
            cel = subprocess.run(['donat'], capture_output=True, text=True, timeout=8, stdin=subprocess.DEVNULL).stdout.strip()
        except Exception:
            cel = ''
        zapros.append('Цель доната: ' + (cel[:200] or 'неизвестно'))
        zapros.append('Мои заметки о себе:\n' + (zametki_tekst() or '  —'))
        o = legkaya_model(SVODKA_SISTEMA, '\n'.join(zapros))
        if not o or not isinstance(o.get('luchshie'), list) or not isinstance(o.get('slabye'), list):
            _POSL_NEUDACHA['svodka'] = time.time()
            return 'сводка не вышла'
        luch = [s for s in (_chistaya_stroka(x, 200) for x in o['luchshie']) if s][:3]
        slab = [s for s in (_chistaya_stroka(x, 200) for x in o['slabye']) if s][:3]
        if not luch and not slab:
            _POSL_NEUDACHA['svodka'] = time.time()
            return 'сводка пустая'
        zap = {'data': time.strftime('%Y-%m-%d', time.localtime(novye[-1]['t'])), 'ot': novye[0]['t'],
               'do_t': novye[-1]['t'], 'prichina': prichina, 'replik': len(novye), 'luchshie': luch, 'slabye': slab,
               'cel': _chistaya_stroka(o.get('cel'), 200, 0)}
        os.makedirs(PAPKA, exist_ok=True)
        with open(VECHERA, 'a') as f:
            f.write(json.dumps(zap, ensure_ascii=False) + '\n')
        stroki = open(VECHERA).read().splitlines()
        if len(stroki) > 60:
            open(VECHERA, 'w').write('\n'.join(stroki[-40:]) + '\n')
        _POSL_NEUDACHA['svodka'] = 0.0
        log('сводка вечера (%s): %d реплик' % (prichina, len(novye)))
        return 'сводка вечера записана (%d реплик)' % len(novye)
    finally:
        _SVOD.release()


def v_fone(f, *a):
