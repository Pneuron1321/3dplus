MODEL_FILE = os.environ.get('VED_MODEL_FILE', '/root/.vedushchiy-model')   # одна строка: «модель [усилие]», напр. «haiku low»
MODEL = os.environ.get('VED_MODEL', 'claude-sonnet-5-5')    # Александр 11.10: по умолчанию Sonnet со средним усилием
USILIE = os.environ.get('VED_EFFORT', 'medium')


def golova():
    """Какая модель разбирает ленту: файл MODEL_FILE (если есть) главнее констант; вернуть (модель, усилие)."""
    try:
        w = open(MODEL_FILE).read().split()
        if w and re.match(r'^[\w.\-\[\]]+$', w[0]):
            return w[0], (w[1] if len(w) > 1 and w[1] in ('low', 'medium', 'high', 'xhigh', 'max') else USILIE)
    except OSError:
        pass
    return MODEL, USILIE


def haiku(kartinki, kontekst):
    env = dict(os.environ, CLAUDE_CODE_DISABLE_CLAUDE_MDS='1', CLAUDE_CODE_DISABLE_AUTO_MEMORY='1',
               GOLOS_RACIYA='1')
    model, usilie = golova()
    cmd = [CLAUDE, '-p', '--model', model, '--effort', usilie, '--tools', 'Read', '--allowedTools', 'Read',
           '--no-session-persistence', '--settings', '{"disableAllHooks":true}', '--output-format', 'json',
           '--system-prompt', ZADANIE, 'Картинки (читай по порядку Read-ом): %s\n%s' % (' ; '.join(kartinki), kontekst)]
    try:
        r = subprocess.run(cmd, cwd=DIR, env=env, capture_output=True, text=True, timeout=300, stdin=subprocess.DEVNULL)
        t = json.loads(r.stdout).get('result', '') if r.stdout.strip() else ''
        m = re.search(r'\{.*\}', t, re.S)
        if not m:
            log('модель без JSON:', (t or r.stderr or '')[:100].replace('\n', ' '))
        return json.loads(m.group(0)) if m else None
    except Exception as e:
        log('Haiku не ответил:', type(e).__name__, str(e)[:80])
        return None


def skazat(tekst, vid=''):
    """Голосом Плюса — через голос-демон (как её обычная речь): рот, субтитры — сами."""
    try:
        subprocess.run([SKAZHI, tekst], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=10,
                       env=dict(os.environ, SKAZHI_VID='ved'))   # договорит — уши слушают секунду
    except Exception as e:
        log('skazhi:', type(e).__name__)
    try:
        with open(LOG, 'a') as f:
            f.write('%s %s%s\n' % (time.strftime('%H:%M'), vid + ': ' if vid else '', tekst))
    except OSError:
        pass


POPYTKA_T = [0.0, 0]     # когда была последняя попытка и сколько их подряд в этот период


