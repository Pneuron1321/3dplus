OTKAZ = ['']                       # почему отвергнута прошлая попытка — Haiku увидит в следующей
CHAT_RE = re.compile(r"\b(chat|chatters?|viewers?|audience|everyone|everybody|folks|guys|y'all|you all)\b", re.I)
TEHNIKA_RE = re.compile(r"\b(mic(rophone)?|resets?|frames?|bitrate|status line|dropped|latency|uptime)\b", re.I)
OPASNO_RE = re.compile(r"(https?://|rtmp://|oauth:|\bsk-[A-Za-z0-9]|[A-Za-z0-9_\-]{28,})")


def slova(t):
    return re.findall(r"[a-zа-яё0-9']+", t.lower())


def predlozheniya(t):
    return [s for s in re.split(r'(?<=[.!?…])\s+', t.strip()) if s]


def pohozhe(rech, proshlye):
    """Повтор прошлой реплики: много общих слов или общая фраза из пяти слов подряд."""
    a = slova(rech)
    sa = set(w for w in a if len(w) > 3)
    g5 = set(tuple(a[i:i + 5]) for i in range(len(a) - 4))
    for t in proshlye:
        b = slova(t)
        sb = set(w for w in b if len(w) > 3)
        if len(sa) >= 4 and sb and len(sa & sb) / float(len(sa | sb)) >= SHODSTVO:
            return t[:60]
        if g5 and g5 & set(tuple(b[i:i + 5]) for i in range(len(b) - 4)):
            return t[:60]
    return ''


def ukorotit(rech, predel):
    """Не длиннее predel слов: целыми предложениями (первое остаётся всегда), крайний случай — обрезка по слову."""
    if len(rech.split()) <= predel:
        return rech
    res, n = [], 0
    for s in predlozheniya(rech):
        w = len(s.split())
        if res and n + w > predel:
            break
        res.append(s)
        n += w
    t = ' '.join(res)
    if len(t.split()) > predel:
        t = ' '.join(t.split()[:predel]).rstrip(',;:—-') + '.'
    return t


def bez_chata(rech):
    """Пустому чату не обращаемся: предложения про chat / viewers / everyone убираем."""
    return ' '.join(s for s in predlozheniya(rech) if not CHAT_RE.search(s))


def tipy_kozyrej(kozyri):
    """Сколько РАЗНЫХ типов в списке «тип: суть»."""
    return len(set(str(x).split(':', 1)[0].strip().lower() for x in (kozyri or []) if str(x).strip()))


BANAL_STAVKA_RE = re.compile(r"\b(first kill|a kill|any kill|get kills?|land a kill|get a kill|score a kill|you(?:'ll| will) (?:win|survive|live)|"
                             r"you(?:'ll| will) do (?:great|well|fine)|next kill)\b", re.I)
SROK_RE = re.compile(r"\b(\d+|one|two|three|four|five|six|seven|eight|nine|ten|fifteen|next|before|within|by the|until)\b", re.I)


def _otkaz_stavki(o, rech):
    """Ставка продуманная: основа из фактов, условие с порогом, срок, не угадайка. Возвращает причину отказа или ''."""
    pr = (o.get('proverka') or '').strip()
    if len(pr) < 25 or TEHNIKA_RE.search(rech + ' ' + pr):
        return 'ставка без проверки или про технику эфира — ставь на то, что видно в игре'
    osn = [str(x).strip() for x in (o.get('osnova') or []) if str(x).strip()] if isinstance(o.get('osnova'), list) else []
    if len(osn) < 2 or min(len(x) for x in osn) < 12 or not re.search(r'\d', ' '.join(osn)):
        return 'у ставки нет основы: нужно 2–3 конкретных факта из ленты и счёта, хотя бы один с цифрой (поле osnova)'
    if len((o.get('uslovie') or '').strip()) < 15 or len((o.get('stavka_en') or '').strip()) < 8:
        return 'у ставки нет проверяемого условия с порогом (поле uslovie) или короткой подписи для табло'
    try:
        srok = int(o.get('srok_min'))
    except (TypeError, ValueError):
        srok = 0
    if not STAVKA_SROK[0] <= srok <= STAVKA_SROK[1]:
        return 'у ставки нет срока: srok_min — целое от %d до %d минут' % STAVKA_SROK
    if not SROK_RE.search(rech):
        return 'в речи ставки не слышно срока и условия — назови их вслух'
    if BANAL_STAVKA_RE.search(rech) and not re.search(r'\d', rech):
        return 'банальная ставка-угадайка («будет килл», «победишь») — нужна ставка с порогом, основой и сроком'
    try:
        if int(o.get('svezhest', 0)) < 3:
            return 'ставка недостаточно острая (свежесть ниже 3) — ставь только на сильное наблюдение'
    except (TypeError, ValueError):
        return 'нет оценки свежести ставки'
    return ''


def podgotovit(o, d, rech, pam, pusto, final, tranzitor=False):
    """Проверить реплику. Возвращает (текст или '', причина отказа, поменять ли действие на kozyr).
    Не последняя попытка — отказ за повтор, язык и т. п.; последняя — говорит всё равно, кроме опасного.
    tranzitor — третья реплика: вместо пяти разных козырей проверяем разбор границы."""
    if OPASNO_RE.search(rech):
        return '', 'в речи ключ, ссылка или длинный код — такое не говорим', d
    if pusto:
        rech = bez_chata(rech)
        if len(rech.split()) < 4:
            return '', 'чат пуст, а реплика была к чату — говори с Александром о происходящем', d
    bukv = re.findall(r'[A-Za-zА-Яа-яЁё]', rech)
    if bukv and len(re.findall(r'[А-Яа-яЁё]', rech)) > 0.15 * len(bukv):
        return '', 'реплика не по-английски — говори только по-английски', d
    rech = ukorotit(rech, MAX_SLOV_BOY if o.get('boy') else MAX_SLOV)
    if d == 'stavka':
        pr = _otkaz_stavki(o, rech)
        if pr:
            return '', pr, d                                  # плохая ставка не звучит даже на последней попытке
    proshlye = [x.get('rech', '') for x in pam] + [re.sub(r'^\d\d:\d\d\s+\S+?:\s*', '', l) for l in hvost(LOG, PAMYAT_N)]
    dub = pohozhe(rech, proshlye)
    if dub:
        return '', 'повтор прошлой реплики («%s…») — другая мысль, другие слова' % dub, d
    if not final:
        if pam and str(o.get('priem', '')).strip() and str(o.get('priem', '')).strip() == str(pam[-1].get('priem', '')).strip():
            return '', 'тот же приём, что в прошлой реплике (%s) — выбери другой из пяти' % o.get('priem'), d
        if tranzitor:
            pr = _otkaz_tranzitora(o, rech)
            if pr:
                return '', pr, d
        elif tipy_kozyrej(o.get('kozyri')) < 5:
            return '', 'козырей меньше пяти РАЗНЫХ типов — нужно пять разных', d
        if len(str(o.get('analiz', '')).strip()) < 20:
            return '', 'нет анализа динамики ленты (поле analiz)', d
    return rech, '', d


def ispolzovano_novostej(rech, material):
    """Какие заголовки из материала реплика использовала (3+ общих значимых слова) — чтобы не повторять новость."""
    sr = set(w for w in slova(rech) if len(w) > 4)
    return [z for z in material if len(sr & set(w for w in slova(z) if len(w) > 4)) >= 3]


def istech(k, now):
    """Ставка и вызов без исхода живут не дольше 20 минут, потом «неясно» — в счёт не идут."""
    res = []
    for sp, zhizn, nm in ((k['stavki'], STAVKA_ZHIZN, 'ставка'), (k['vyzovy'], VYZOV_ZHIZN, 'вызов')):
        for x in sp:
            if x.get('itog') is None and now - x.get('t', now) > zhizn * MINUTA:
                x['itog'], x['t_itog'] = 'neyasno', now
                res.append('%s устарела: неясно' % nm)
    return res


def zakryt_po_t(spisok, t, itog):
    for x in spisok:
        if x.get('t') == t and x.get('itog') is None:
            x['itog'], x['t_itog'] = itog, time.time()
            return x
    return None


