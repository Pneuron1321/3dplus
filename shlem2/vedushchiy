def dnevnik():
    """Конец эфира: разница тетради за вечер — строкой в дневник пути (zhurnal.md). Без модели."""
    d = tetrad_chitat()
    sn = d.get('snimok') or {}
    ponyala = [z for z in d['zapisi'] if z['status'] == 'podtverzhdeno' and sn.get(str(z['id'])) != 'podtverzhdeno']
    oshiblas = [z for z in d['zapisi'] if z['status'] == 'oprovergnuto' and sn.get(str(z['id'])) != 'oprovergnuto']
    novye = [z for z in d['zapisi'] if str(z['id']) not in sn and z['status'] in ('vopros', 'gipoteza')]
    if not (ponyala or oshiblas or novye):
        return 'дневник: за вечер тетрадь не сдвинулась'
    kr = lambda sp: '; '.join('%s — %s' % (z.get('pro', '?'), z['tekst'][:90]) for z in sp[:4])
    stroka = '%s — дневник пути «Плюс учится играть», день %d: поняла — %s; ошиблась — %s; новые вопросы — %s.' % (
        time.strftime('%Y-%m-%d'), d.get('den', 0) or 1, kr(ponyala) or 'ничего', kr(oshiblas) or 'нет', kr(novye) or 'нет')
    try:
        with open(ZHURNAL, 'a') as f:
            f.write(stroka + '\n')
    except OSError:
        return 'дневник: не записался'
    d['snimok'] = {str(z['id']): z['status'] for z in d['zapisi']}  # второй конец эфира в тот же вечер — без повторов
    tetrad_pisat(d)
    return 'дневник: ' + stroka[:120]


