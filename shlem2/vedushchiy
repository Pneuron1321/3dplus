def chistyj(t, n):
    """Текст донатера — чужие слова: без управляющих знаков, ссылок и длинных кусков, в длину n."""
    t = re.sub(r'https?://\S+|\S+\.(?:com|ru|tv|gg|io)\S*', '', str(t or ''))
    t = re.sub(r'[\x00-\x1f\x7f]+', ' ', t)
    return re.sub(r'\s+', ' ', t).strip()[:n]


def donat_vyzov(k, now):
    """Вызов за донат — первым, всегда: не ждёт срока ленты и Haiku, ждёт только, пока Плюс говорит.
    Свой открытый вызов Плюс уступает донатному (закрывается «неясно»); донатный не закрыт — ждём."""
    stroki = ochered_donatov()
    if not stroki or plus_govorit() or zvali_nedavno(20) or not alex_tihij(6):
        return None
    try:
        v = json.loads(stroki[0])
        if not isinstance(v, dict) or not (v.get('ru') or v.get('en')):
            raise ValueError
    except ValueError:
        uberi_iz_ocheredi(stroki[0])                          # битая строка очереди
        return None
    ov = otkrytaya(k['vyzovy'])
    if ov is not None:
        if ov.get('ot') != 'plus':
            return None
        ov['itog'], ov['t_itog'] = 'neyasno', now
    kto = chistyj(v.get('kto'), 30) or 'A viewer'
    ru, en = chistyj(v.get('ru'), 200), chistyj(v.get('en'), 48)
    k['vyzovy'].append({'t': now, 'ru': ru, 'en': en, 'ot': kto, 'itog': None})
    k['posl_vyzov'] = k['posl_rech'] = now
    k['stavka_replik'] = k.get('stavka_replik', 0) + 1         # вызов за донат — тоже реплика
    skazat('%s throws you a challenge: %s' % (kto, chistyj(v.get('en') or v.get('ru'), 200)), 'вызов за донат')
    uberi_iz_ocheredi(stroki[0])
    return kto


