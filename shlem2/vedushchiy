    seychas — по команде, хватит одной новой реплики. Возвращает текст-итог."""
    if not _SAM.acquire(blocking=False):
        return 'самоанализ уже идёт'
    try:
        d = zametki_chitat()
        novye = [r for r in vse_repliki() if r.get('t', 0) > d.get('razobrano', 0) and r.get('rech')]
        if len(novye) < (1 if seychas else ANALIZ_KAZHDYE):
            return 'новых реплик %d из %d — рано' % (len(novye), ANALIZ_KAZHDYE)
        if not seychas and time.time() - _POSL_NEUDACHA['analiz'] < sek(POVTOR_ZHDEM):
