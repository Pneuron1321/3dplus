NACHALO = [None]                   # когда в этом эфире лента начала копиться (секунды)


def sek(x):
    """Секунды с учётом MINUTA (в проверке минута короче)."""
    return x * MINUTA / 60.0


def kuski():
    """Куски ленты в окне, старые первыми: [(t, [три файла])]. Неполные куски (меньше трёх кадров) не берём."""
    try:
        imena = os.listdir(LENTA_DIR)
    except OSError:
        return []
    gr = {}
    for n in imena:
        m = re.match(r'^(\d+)_(\d)\.jpg$', n)
        if m:
            gr.setdefault(int(m.group(1)), {})[int(m.group(2))] = os.path.join(LENTA_DIR, n)
    ot = time.time() - sek(OKNO_LENTY) - 3
    res = [(ms / 1000.0, [d[i] for i in range(KADROV_V_KUSKE)]) for ms, d in sorted(gr.items())
           if ms / 1000.0 >= ot and len(d) == KADROV_V_KUSKE]
    return res


def ochistit_lentu(vse=False):
    ot = time.time() - sek(OKNO_LENTY) - 20
    try:
        for n in os.listdir(LENTA_DIR):
            put = os.path.join(LENTA_DIR, n)
            if vse or os.path.getmtime(put) < ot:
                os.remove(put)
    except OSError:
        pass


def snyat_kusok(t0):
    """Три малых кадра с шагом 0,5 с (кадр приложения обновляется чаще раза в 0,5 с)."""
    os.makedirs(LENTA_DIR, exist_ok=True)
    ms = int(t0 * 1000)
    for i in range(KADROV_V_KUSKE):
        t = t0 + i * SHAG_KADRA
        if t > time.time():
            time.sleep(t - time.time())
        try:
            jpg = get('/frame.jpg', timeout=3)
        except Exception:
            return False
        if len(jpg) < 1000:
            return False
        tmp = os.path.join(LENTA_DIR, '.%d_%d.tmp' % (ms, i))
        with open(tmp, 'wb') as f:
            f.write(jpg)
        os.replace(tmp, os.path.join(LENTA_DIR, '%d_%d.jpg' % (ms, i)))
    return True


def potok_lenty():
    """Фоновый поток: пока идёт эфир — кусок каждые 10 секунд (6 в минуту, равномерно по минуте)."""
    shag = sek(60.0 / KUSKOV_V_MINUTU)
    net_s = None
    while True:
        try:
            if os.path.exists(OFF) or not efir_idyot():
                if net_s is None:
                    net_s = time.time()
                if NACHALO[0] is not None and time.time() - net_s > sek(90):
                    ochistit_lentu(vse=True)                  # эфир кончился (не мигнул): кадры прошлого эфира в новую ленту не мешаем
                    NACHALO[0] = None
                time.sleep(min(10, shag))
                ochistit_lentu()
                continue
            net_s = None
            t0 = math.ceil(time.time() / shag) * shag
            time.sleep(max(0, t0 - time.time()))
            if snyat_kusok(t0):
                if NACHALO[0] is None:
                    k = kuski()
                    NACHALO[0] = k[0][0] if k else t0
                ochistit_lentu()
        except Exception as e:
            log('лента:', type(e).__name__, str(e)[:80])
            time.sleep(5)


def listy():
    """Склеить ленту в листы (по 6 кусков-строк × 3 кадра, 320×180). Возвращает ([(путь, [t строк])], число кусков)."""
    ks = kuski()
    os.makedirs(DIR, exist_ok=True)
    res = []
    for n in range(0, len(ks), STROK_V_LISTE):
        gruppa = ks[n:n + STROK_V_LISTE]
        spisok = os.path.join(DIR, 'list%d.txt' % (n // STROK_V_LISTE))
        with open(spisok, 'w') as f:
            for t, fl in gruppa:
                for p in fl:
                    f.write("file '%s'\nduration 1\n" % p)
            f.write("file '%s'\n" % gruppa[-1][1][-1])
        vyhod = os.path.join(DIR, 'list%d.jpg' % (n // STROK_V_LISTE))
        try:
            os.remove(vyhod)
        except OSError:
            pass
        subprocess.run(['ffmpeg', '-nostdin', '-loglevel', 'error', '-y', '-f', 'concat', '-safe', '0', '-i', spisok,
                        '-vf', 'scale=320:180,tile=%dx%d:padding=3:color=white' % (KADROV_V_KUSKE, len(gruppa)),
                        '-frames:v', '1', '-q:v', '4', vyhod], capture_output=True, timeout=40)
        if os.path.exists(vyhod) and os.path.getsize(vyhod) > 1000:
            res.append((vyhod, [t for t, _ in gruppa]))
    return res, len(ks)


def opisanie_lenty(ls):
    """Подпись к листам — времена строк (секунд до «сейчас»)."""
    now = time.time()
    st = []
    for i, (p, ts) in enumerate(ls, 1):
        st.append('Лист %d (%s): %d строк сверху вниз, начало каждой за N секунд до «сейчас»: %s' % (
            i, p, len(ts), ', '.join('%d' % round((now - t) * 60 / MINUTA) for t in ts)))
    return st


