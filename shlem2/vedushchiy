        OTKAZ[0] = 'реплика банальная (свежесть %d) — нужна конкретная, из кадра' % svezhest
        d = 'molchu'
    if d != 'molchu' and rech:
        rech2, prichina, d2 = podgotovit(o, d, rech, pam, pusto, final, tranzitor=tr)
        if not rech2:
            sdelano.append('отвергнуто: ' + prichina[:70])
            OTKAZ[0] = prichina
            d = 'molchu'
        else:
            rech, d = rech2, d2
    if d != 'molchu' and rech:
        k['stavka_replik'] = k.get('stavka_replik', 0) + 1     # счётчик реплик (не времени) до следующей ставки
        k['replik_vsego'] = k.get('replik_vsego', 0) + 1       # своих реплик за вечер: каждая третья — Транзитор
        if tr:
            k['tranzitor_n'] = k.get('tranzitor_n', 0) + 1     # следующий Транзитор — на другой объект взгляда
        if d == 'stavka':
            zakryt(k['stavki'], 'neyasno') if otkrytaya(k['stavki']) else None
            k['stavki'].append({'t': now, 'ru': rech, 'en': (o.get('stavka_en') or '')[:60],
                                'proverka': (o.get('proverka') or '')[:200], 'itog': None,
                                'osnova': [str(x)[:120] for x in (o.get('osnova') or [])][:3],
                                'uslovie': (o.get('uslovie') or '')[:160], 'srok_min': int(o.get('srok_min'))})
            k['posl_stavka'] = now
            k['stavka_replik'] = 0
        elif d == 'vyzov':
            k['vyzovy'].append({'t': now, 'ru': (o.get('vyzov_ru') or rech)[:200], 'en': (o.get('vyzov_en') or '')[:48],
                                'ot': 'plus', 'itog': None})
            k['posl_vyzov'] = now
        if d == 'kozyr':
            k['posl_kozyr'] = now
            if not tr:
                k['tema'] += 1                                # Транзитор темы не тратит: следующий козырь — следующая тема
        if tema == 'новости' and material:                    # какие новости уже рассказаны — повторно не берём
            ist = ispolzovano_novostej(rech, material)
            if o.get('istochnik') in material and o['istochnik'] not in ist:
                ist.append(o['istochnik'])
            k['novosti_ispolz'] = (k.get('novosti_ispolz', []) + [z.lower() for z in ist])[-60:]
        try:
            os.makedirs(PAPKA, exist_ok=True)
            with open(os.path.join(PAPKA, 'kozyri.jsonl'), 'a') as f:     # для лаборатории козырей
                z = {'t': now, 'tema': tema, 'analiz': o.get('analiz', ''), 'kozyri': o.get('kozyri', []),
                     'vybor': o.get('vybor', ''), 'priem': o.get('priem', ''),
                     'kombinaciya': o.get('kombinaciya', ''), 'lestnica': o.get('lestnica', []),
                     'svezhest': svezhest, 'vid': d, 'rech': rech}
                if tr:
                    z['tranzitor'] = o.get('tranzitor') if isinstance(o.get('tranzitor'), dict) else {}
                f.write(json.dumps(z, ensure_ascii=False) + '\n')
        except OSError:
            pass
        for _ in range(int(sek(45) / 3)):                     # Плюс ещё говорит или её только что звали — дождись (до 45 с), потом всё равно скажи
            if not plus_govorit() and not zvali_nedavno(15):
                break
            time.sleep(3)
        k['posl_rech'] = time.time()
        sohranit(k)                                           # книга — до речи: ставка/вызов не потеряются, если skazhi упадёт
        skazat(rech, 'транзитор' if tr else {'stavka': 'ставка', 'vyzov': 'вызов', 'kozyr': 'козырь'}.get(d, ''))
        zapomnit(o, d, rech, uroven, tr)
        POPYTKA_T[1] = 0
        OTKAZ[0] = ''
        sdelano.append(('транзитор ' if tr else '') + d + ' [%s/%s/%d]: %s' % (o.get('priem', '?'), o.get('ton', '?'), uroven, rech[:60]))
    elif final:
        k['posl_rech'] = now                                  # три попытки без реплики — ждём следующий период
        POPYTKA_T[1] = 0
        OTKAZ[0] = ''
        sdelano.append('нечего сказать — до следующего периода')
    sohranit(k)
    tablo(k)
    return '; '.join(sdelano) or 'молчу'


def zashchita():
    """obnovi из зеркала мог подменить этот файл старой версией — вернуть свою копию (она с меткой MARKER)."""
    try:
        if MARKER in open(__file__, encoding='utf-8').read():
            return
        moy = open(MOY, encoding='utf-8').read()
        if MARKER not in moy:
            return
        compile(moy, MOY, 'exec')
        tmp = __file__ + '.moy'
        with open(tmp, 'w', encoding='utf-8') as f:
            f.write(moy)
        os.chmod(tmp, 0o755)
        os.replace(tmp, __file__)
        log('obnovi подменил файл — вернула свою версию с лентой')
    except (OSError, SyntaxError, ValueError):
        pass


def demon():
    z = open(LOCK, 'w')
    try:
        fcntl.flock(z, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0
    log('запущен, раз в', kazhdye(), 'мин, лента %d×%d кадра' % (KUSKOV_V_MINUTU, KADROV_V_KUSKE))
    mt = os.path.getmtime(__file__)
    time.sleep(random.uniform(0, 5))
    threading.Thread(target=potok_lenty, daemon=True).start()
    posl = None
    while True:
        zashchita()
        obnovilsya(mt)
        try:
            r = cikl()
        except Exception as e:
            r = 'сбой: %s %s' % (type(e).__name__, str(e)[:120])
        if r != posl or r.split(' (')[0] not in ('рано', 'нет эфира', 'выключен', 'копится лента'):
            log(r)
        posl = r
        time.sleep(sek(PROVERKA))


def obnovilsya(mt):
    """Новая версия файла на месте (обновление или возврат своей) — перезапуститься ею (замок отпускается сам: exec закрывает файл)."""
    try:
        if os.path.getmtime(__file__) == mt or time.time() - os.path.getmtime(__file__) < 5:
            return
        compile(open(__file__, encoding='utf-8').read(), __file__, 'exec')
    except (OSError, SyntaxError, ValueError):
        return
    log('новая версия — перезапускаюсь')
    os.execv(sys.executable, [sys.executable, os.path.abspath(__file__)] + sys.argv[1:])


