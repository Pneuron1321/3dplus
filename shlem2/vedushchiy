def vecher_hod(sost):
    """Из цикла демона: сводка вечера — через 90 с после конца эфира или раз в час, пока он идёт."""
    now = time.time()
    if efir_idyot():
        sost['byl'], sost['net_s'] = True, None
        prosh = vechera_chitat(1)
        posl = prosh[0].get('do_t', 0) if prosh else 0
        novye = [r for r in vse_repliki() if r.get('t', 0) > posl]
        if len(novye) >= SVODKA_MIN and now - novye[0]['t'] >= sek(SVODKA_CHEREZ) and \
                now - _POSL_NEUDACHA['svodka'] >= sek(POVTOR_ZHDEM) and not _SVOD.locked():
            v_fone(svodka_vechera, 'chas')
    elif sost.get('byl'):
        if sost.get('net_s') is None:
            sost['net_s'] = now
        elif now - sost['net_s'] > sek(90):
            sost['byl'] = False
            log(dnevnik())                                    # разница тетради — в дневник пути, без модели
            if not _SVOD.locked():
                v_fone(svodka_vechera, 'konec')


