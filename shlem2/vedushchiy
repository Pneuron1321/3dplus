def perevod_groq(tekst):
    """Перевод через уже существующий перевод субтитров (titr, Groq; ключ читает сам titr). Кириллица -> английский, иначе -> русский."""
    try:
        if _TITR[0] is None:
            import importlib.machinery
            import importlib.util
            ld = importlib.machinery.SourceFileLoader('titr_mod', TITR)
            sp = importlib.util.spec_from_loader('titr_mod', ld)
            m = importlib.util.module_from_spec(sp)
            ld.exec_module(m)
            _TITR[0] = m
        return _TITR[0].perevod(tekst)
    except Exception as e:
        log('перевод:', type(e).__name__, str(e)[:80])
        return None


def dve_stroki(tekst, ru=None, en=None):
    """(ru, en) для реплики: недостающее переводим (по языку самой реплики)."""
    if KIRILL.search(tekst):
        ru = ru or tekst
        en = en or perevod_groq(tekst)
    else:
        en = en or tekst
        ru = ru or perevod_groq(tekst)
    return ru, en


