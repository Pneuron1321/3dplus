            return 'рано'
        if POPYTKA_T[1] and now - POPYTKA_T[0] < sek(POPYTKA):
            return 'рано'
        if zvali_nedavno() and now - opora < period * 2:      # Александр только что звал Плюс — не перебиваем (из зеркала)
