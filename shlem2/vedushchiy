def zashchita():
    """obnovi из зеркала мог подменить этот файл старой версией — вернуть свою копию (она с меткой MARKER)."""
    try:
        if MARKER in open(__file__, encoding='utf-8').read():
            return
        moy = open(MOY, encoding='utf-8').read()
        if MARKER not in moy:
            return
        compile(moy, MOY, 'exec')
        tmp = __file__ + '.moy'
        with open(tmp, 'w', encoding='utf-8') as f:
            f.write(moy)
        os.chmod(tmp, 0o755)
        os.replace(tmp, __file__)
        log('obnovi подменил файл — вернула свою версию с лентой')
    except (OSError, SyntaxError, ValueError):
        pass


