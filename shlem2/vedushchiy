                time.strftime('%H:%M', time.localtime(r['t'])), r.get('priem', '?'), r.get('ton', '?'), r.get('tema', '?'),
                ', транзитор' if r.get('tr') else '', str(r.get('rech', ''))[:260], rk))
        ish = iskhody(k, novye[0]['t'])
        zapros.append('Исходы ставок и вызовов за это время: ' + ('; '.join(ish) if ish else 'нет'))
