def obzor_stroki(n):
    """Последние n записей автопросмотра без сообщений об ошибках («session limit» и т. п.)."""
    return [l for l in hvost(OBZOR, n + 6) if 'session limit' not in l and 'hit your' not in l][-n:]


def vozrast(l):
    """Сколько секунд назад записана строка лога вида «ЧЧ:ММ …» (нет времени — None)."""
    m = re.match(r'^(\d\d):(\d\d)\b', l)
    if not m:
        return None
    t = time.localtime()
    return ((t.tm_hour * 3600 + t.tm_min * 60 + t.tm_sec) - (int(m.group(1)) * 3600 + int(m.group(2)) * 60)) % 86400


def hod():
    """Как идёт у Александра — по двум последним взглядам автопросмотра (obzor пишет «выигрывает»,
    «проигрывает», «ровно» с 2.2.9): самое свежее, что видно; не видно или запись старше 20 минут — ''
    (вчерашнее «проигрывает» не должно запрещать ставки, а старое «выигрывает» — звать на вызов)."""
    for l in reversed(obzor_stroki(2)):
        v = vozrast(l)
        if v is not None and v > HOD_ZHIZN * MINUTA:
            continue
        slova = l.split(' | ', 1)[0].split()
        for h in ('выигрывает', 'проигрывает', 'ровно'):
            if h in slova:
                return h
    return ''


