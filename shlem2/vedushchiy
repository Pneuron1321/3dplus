            return 'самоанализ: пустой список — оставила прежние заметки'
        d.update({'t': time.time(), 'razobrano': max(r['t'] for r in novye), 'razborov': d.get('razborov', 0) + 1,
                  'itog': _chistaya_stroka(o.get('itog'), 300, 0), 'zametki': res[:MAX_ZAMETOK]})
        _zapisat_json(ZAMETKI, d)
        _POSL_NEUDACHA['analiz'] = 0.0
        log('самоанализ: %d реплик → %d заметок' % (len(novye), len(d['zametki'])))
        return 'самоанализ: %d реплик → %d заметок' % (len(novye), len(d['zametki']))
