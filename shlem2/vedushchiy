                         - (int(m.group(1)) * 3600 + int(m.group(2)) * 60 + int(m.group(3)))) % 86400
                    if v < 600:
                        t = max(t, time.time() - v)
                break
    except Exception:
        pass
    return t


def alex_tihij(nuzhno=None):
    """True — Александр молчит дольше nuzhno секунд (по умолчанию TISHINA_ALEX)."""
    return time.time() - alex_posledniy_raz() >= (TISHINA_ALEX if nuzhno is None else nuzhno)


def dozhdatsya_tishiny(maks, nuzhno=None, plus=True):
