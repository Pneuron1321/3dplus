MOST3_MOLCHIT = 'Мост 3 не отвечает: открой «Мост 3 — карта» в шлеме.'
NABORY3 = ('obychno', 'monitor', 'noch', 'yarko', 'rezko', 'hdr', 'kino')
PROFILI3 = ('efir', 'plavno', 'maks', '4k', 'hdr')
NABORY3_RU = {'obychno': 'обычно', 'monitor': 'как на мониторе', 'noch': 'ночь', 'yarko': 'ярко', 'rezko': 'резко',
              'hdr': 'HDR', 'kino': 'кино (без обработки)'}
# Слова → шаги шейдера Моста 3 (гамма светлит середину, не выжигая белое)
SLOVA3 = {'yarche': {'gamma': 0.1}, 'temnee': {'gamma': -0.1},
          'sochnee': {'nasyshch': 0.1, 'kontrast': 0.05}, 'blednee': {'nasyshch': -0.1, 'kontrast': -0.05},
          'kontrastnee': {'kontrast': 0.1}, 'myagche': {'kontrast': -0.1}, 'rezche': {'rezkost': 0.5}}
SHEJDER3 = ('gamma', 'teni', 'rezkost', 'avtonoch', 'lokalno')
SHEJDER3_RU = {'kontrast': 'контраст', 'nasyshch': 'насыщенность', 'gamma': 'гамма', 'teni': 'тени',
               'rezkost': 'резкость', 'avtonoch': 'авто-ночь', 'yarkost': 'яркость', 'lokalno': 'местная ночь'}


def most3_url():
    return os.environ.get('MOST3_URL') or MOST3


def most3_pokazyvaet():
    r = zapros(most3_url(), '/status', 2)
    d = razobrat(r[1]) if r and r[0] == 200 else None
    return bool(d and (d.get('video') or {}).get('idyot'))


def kartinka3_skazat(k, avto=None):
    chasti = ['%s %s' % (SHEJDER3_RU[i], round(k[i], 2)) for i in ('kontrast', 'nasyshch', 'gamma', 'teni', 'rezkost')
              if i in k]
    if k.get('lokalno'):
        chasti.append('местная ночь %s' % round(k['lokalno'], 2))
    if k.get('yarkost'):
        chasti.insert(0, 'яркость %+.2f' % k['yarkost'])
    out = 'Мост 3, картинка: ' + ', '.join(chasti)
    if k.get('avtonoch'):
        out += ', авто-ночь %s' % round(k['avtonoch'], 2) + (' (сейчас тени +%d %%)' % round(avto * 100) if avto else '')
    return out + '.'


def kartinka3(a):
    U = most3_url()
    shejder, ruchki = {}, []
    i = 0
    while i < len(a):
        w = a[i]
        if w in ('kak_bylo', 'kakbylo', 'sbros'):
            shejder['nabor'] = 'obychno'
        elif w in ('nabor', 'preset') and i + 1 < len(a) and a[i + 1] in NABORY3:
            shejder['nabor'] = a[i + 1]
            i += 1
        elif w in NABORY3:
            shejder['nabor'] = w
        elif w in SLOVA3:
            raz = 1
            if i + 1 < len(a) and a[i + 1].isdigit():
                raz = max(1, min(5, int(a[i + 1])))
                i += 1
            for k, d in SLOVA3[w].items():
                shejder[k] = shejder.get(k, 0) + d * raz
        elif w in SHEJDER3 and i + 1 < len(a) and re.fullmatch(r'[+-]?\d*\.?\d+|def', a[i + 1]):
            shejder[w] = a[i + 1]
            i += 1
        elif w in RUCHKI and i + 1 < len(a) and re.fullmatch(r'[+-]?\d+|=-?\d+|def', a[i + 1]):
            ruchki.append(w + '=' + a[i + 1])                  # ручки внутри карты — сырые числа, как в мосте 2
            i += 1
        else:
            return 1, ['karta kartinka (Мост 3) — как сейчас; yarche|temnee|sochnee|blednee|kontrastnee|myagche|rezche [2]; '
                       'obychno|monitor|noch|yarko|rezko|hdr|kino; gamma|teni|rezkost|avtonoch|lokalno 1.2|+0.1|def; kak_bylo.'], None
        i += 1
    if ruchki:
        r = zapros(U, '/karta/ruchki?' + '&'.join(ruchki), 5)
        if r is None:
            return 1, [MOST3_MOLCHIT], None
    q = []
    for k, v in shejder.items():
        if isinstance(v, float) or isinstance(v, int):
            v = '%+.3f' % v
        q.append('%s=%s' % (k, v))
    r = zapros(U, '/kartinka' + ('?' + '&'.join(q) if q else ''), 5)
    if r is None:
        return 1, [MOST3_MOLCHIT], None
    d = razobrat(r[1]) or {}
    if r[0] != 200:
        return 1, ['Мост 3: ' + str(d.get('oshibka') or 'не понял')], None
    avto = None
    st = zapros(U, '/status', 2)
    if st:
        avto = (razobrat(st[1]) or {}).get('avto_teni')
    out = kartinka3_skazat(d, avto)
    if 'nabor' in shejder:
        out = 'Набор «%s». ' % NABORY3_RU[shejder['nabor']] + out
    return 0, [out], None


def most3(a):
    """most3 — что показывает; zvuk 80|vkl|vykl; podklyuchit; rezhimy."""
    a = list(a)
    U = most3_url()
    c = a[0] if a else ''
    if c in ('', 'status', 's'):
        r = zapros(U, '/status', 3)
        if r is None:
            return 1, [MOST3_MOLCHIT], None
        d = razobrat(r[1]) or {}
        v = d.get('video') or {}
        z = d.get('zvuk') or {}
        if not v.get('idyot'):
            return 0, ['Мост 3 открыт, но карта не показывается: %s' % (v.get('oshibka') or d.get('oshibka') or 'нет карты')], None
        out = 'Мост 3 показывает: %s, приём %s к/с, показ %s к/с.' % (v.get('rezhim'), v.get('fps'), d.get('pokaz_fps'))
        if d.get('usb2'):
            out += ' Карта на USB 2 — только сжатый 1080p, без 1440p/4K: переткни карту, проверь кабель и хаб.'
        if z.get('idyot'):
            out += ' Звук игры %s дБ, громкость %d %%.' % (z.get('pik_db'), round((z.get('gromkost') or 0) * 100))
        elif not d.get('zvuk_vkl'):
            out += ' Звук выключен (most3 zvuk vkl).'
        else:
            out += ' Звука нет: %s' % (z.get('oshibka') or 'карта не отдала звук')
        if d.get('oshibka_pokaza'):
            out += ' Ошибка показа: ' + d['oshibka_pokaza']
        return 0, [out], None
    if c == 'zvuk':
        a2 = a[1] if len(a) > 1 else ''
        potolok = False
        if a2 in ('vkl', 'vykl'):
            put = '/zvuk?vkl=' + ('1' if a2 == 'vkl' else '0')
        elif a2.rstrip('%').isdigit():
            put = '/zvuk?g=' + a2.rstrip('%')
            if int(a2.rstrip('%')) > 150:
                potolok = True
        else:
            return 1, ['most3 zvuk 80 — громкость игры в %; most3 zvuk vkl|vykl.'], None
        r = zapros(U, put, 5)
        if r is None:
            return 1, [MOST3_MOLCHIT], None
        d = razobrat(r[1]) or {}
        if not d.get('idyot'):
            return 0, ['Мост 3: звук игры выключен.' if d.get('vkl') is False else 'Мост 3: звука нет.'], None
        return 0, ['Мост 3: звук игры, громкость %d %%%s.' % (round((d.get('gromkost') or 0) * 100),
                                                             ' — это потолок, громче мост не делает' if potolok else '')], None
    if c == 'podklyuchit':
        r = zapros(U, '/podklyuchit', 15)
        if r is None:
            return 1, [MOST3_MOLCHIT], None
        return 0, ['Мост 3: ' + str((razobrat(r[1]) or {}).get('otvet'))], None
    if c == 'klip':
        a2 = a[1] if len(a) > 1 else ''
        if a2 in ('vkl', 'vykl'):
            r = zapros(U, '/klip?vkl=' + ('1' if a2 == 'vkl' else '0'), 5)
            if r is None:
                return 1, [MOST3_MOLCHIT], None
            return 0, ['Мост 3: запись игры ' + ('включена.' if a2 == 'vkl' else 'выключена.')], None
        sek = a2 if a2.isdigit() else '150'
        r = zapros(U, '/klip?sek=' + sek, 150)
        if r is None:
            return 1, [MOST3_MOLCHIT], None
        d = razobrat(r[1]) or {}
        if d.get('oshibka'):
            return 1, ['Клип игры: ' + d['oshibka']], None
        return 0, ['Клип игры сохранён: %s, %s с, %s МБ%s.' % (d.get('put'), d.get('sek'), d.get('mb'),
                                                               '' if d.get('zvuk') else ', без звука')], None
    if c in ('diagnoz', 'otchet'):
        r = zapros(U, '/diagnoz', 10)
        if r is None:
            return 1, [MOST3_MOLCHIT], None
        return 0, r[1].strip().split('\n'), None
    if c == 'rezhimy':
        r = zapros(U, '/rezhimy', 5)
        if r is None:
            return 1, [MOST3_MOLCHIT], None
        return 0, r[1].strip().split('\n'), None
    if c == 'rezhim':
        a2 = a[1] if len(a) > 1 else ''
        if a2 in PROFILI3:
            put = '/rezhim?profil=' + a2
        elif a2.isdigit():
            put = '/rezhim?n=' + a2
        elif not a2:
            put = '/rezhim'
        else:
            return 1, ['most3 rezhim efir|plavno|maks|4k|hdr — профиль; most3 rezhim 3 — режим №3 из most3 rezhimy.'], None
        r = zapros(U, put, 5)
        if r is None:
            return 1, [MOST3_MOLCHIT], None
        d = razobrat(r[1]) or {}
        if r[0] != 200:
            return 1, ['Мост 3: ' + str(d.get('oshibka') or 'не понял')], None
        if 'otvet' not in d:
            return 0, ['Мост 3, профиль: %s.' % d.get('nadpis')], None
        # переподключение идёт в фоне (лестница — до ~2,5 с на ступень): дождаться и сказать, на чём встал
        out = ['Мост 3: %s.' % d['otvet']]
        time.sleep(float(os.environ.get('MOST3_SHAG') or 2))
        konec = time.time() + float(os.environ.get('MOST3_ZHDAT') or 18)
        st = None
        while time.time() < konec:
            r = zapros(U, '/status', 3)
            st = razobrat(r[1]) if r and r[0] == 200 else None
            if st and (st.get('video') or {}).get('idyot'):
                break
            time.sleep(float(os.environ.get('MOST3_SHAG') or 1))
        v = (st or {}).get('video') or {}
        if v.get('idyot'):
            out.append('Встал на: %s, приём %s к/с.' % (v.get('rezhim'), v.get('fps')))
            if st.get('usb2'):
                out.append('Карта на USB 2 — 1440p/4K недоступны: переткни карту, проверь кабель и хаб (нужен USB 3).')
        else:
            out.append('Пока не показывает: %s (подробно — most3 diagnoz).' % ((st or {}).get('oshibka') or v.get('oshibka') or 'ждёт карту'))
        return 0, out, None
    return 0, ['most3 — что показывает; most3 zvuk 80|vkl|vykl; most3 podklyuchit; most3 rezhimy; most3 rezhim maks|plavno|efir|4k|hdr|N; most3 diagnoz; most3 klip [60] — клип игры. '
               'Картинка — karta kartinka (сама идёт в Мост 3, если он открыт).'], None


# ---------- klipy: страница клипов для айфона (2.7.0) ----------

def klipy(a):
    """klipy — открыть страницу клипов на 15 минут; klipy zakryt; klipy status. Адрес с ключом — только на
    экране моста: приложение его сюда не отдаёт, и здесь его не печатаем."""
    U = os.environ.get('KLIPY_URL') or APP
    c = a[0] if a else ''
    put = {'': '/klipy/otkryt', 'otkryt': '/klipy/otkryt', 'start': '/klipy/otkryt', 'zakryt': '/klipy/zakryt',
           'stop': '/klipy/zakryt', 'status': '/klipy', 's': '/klipy'}.get(c)
    if put is None:
        return 1, ['klipy — открыть клипы на айфоне (15 минут); klipy zakryt — закрыть; klipy status.'], None
    r = zapros(U, put, 10)
    if r is None:
        return 1, [MOLCHIT], None
    if r[0] == 404:
        return 1, ['Клипы: это приложение ещё не умеет страницу клипов — нужна версия 2.7.0.'], None
    d = razobrat(r[1]) or {}
    if d.get('oshibka'):
        return 1, ['Клипы: ' + str(d['oshibka'])], None
    if put == '/klipy/zakryt':
        return 0, ['Страница клипов закрыта: старый адрес больше не открывается.'], None
    n = d.get('klipov')
    skolko = (' Клипов: %d.' % n) if isinstance(n, int) and n >= 0 else ''
    igra = '' if d.get('igra_vidna', True) else (' Клипы игры (Мост 3) пока не видны: в приложении 2 нажми «КЛИПЫ» '
                                                 'и «Разрешить» (доступ к видео).')
    if not d.get('otkryta'):
        return 0, ['Страница клипов закрыта%s. Открыть — klipy.' % (
            ' (кто-то подбирал адрес — закрыл её сам)' if d.get('podbor') else '') + skolko], None
    sek = int(d.get('sek') or 0)
    kak = ('http://%s:%s/k/…/' % (d['ip'], d.get('port'))) if d.get('ip') else 'адрес'
    if put == '/klipy':
        return 0, ['Страница клипов открыта, ещё %d мин %02d с.%s Адрес (%s) — на экране моста.' % (
            sek // 60, sek % 60, skolko, kak) + igra], None
    return 0, ['Страница клипов открыта на %d минут.%s На айфоне в Safari открой адрес с экрана моста (приложение 2): '
               '%s — ключ в нём только на экране, вслух его не называй.' % ((sek + 59) // 60, skolko, kak) + igra], None


# ---------- scena, vid: оформление эфира «Визор» (мост 2.7.0) ----------

SCENY = {'skoro': '«Скоро начнём»', 'otoshyol': '«Отошёл» (шторка, «Саша скоро вернётся»)', 'konec': '«Конец эфира» (итоги)'}
SCENA_PODSKAZKA = ('scena skoro 5 [фраза] — заставка «скоро начнём» с таймером на 5 минут; scena otoshyol [3] — шторка '
                   '«Саша скоро вернётся»; scena konec — итоги «конец эфира»; scena net — убрать; scena — какая сейчас.')


def scena_skazat(d):
    s = d.get('scena') or 'net'
    if s == 'net':
        return 'Сцены нет — в кадре игра.'
    t = SCENY.get(s, s)
    if d.get('tajmer'):
        o = int(d.get('ostalos_sek') or 0)
        t += ', таймер %d:%02d' % (o // 60, o % 60) if o else ', таймер дошёл до нуля'
    if d.get('fraza'):
        t += ', фраза «%s»' % d['fraza']
    return 'Сцена во весь кадр эфира: %s. Убрать — scena net.' % t


def scena(a):
    """scena skoro [минут] [фраза…] | otoshyol [минут] | konec | net — сцена во весь кадр эфира поверх игры (2.7.0);
    scena — какая сейчас. Живёт до scena net или конца эфира; поставленная до эфира — встанет с его началом."""
    a = list(a)
    U = os.environ.get('VIZOR_URL') or APP
    c = a[0] if a else ''
    if c in ('', 'status', 's'):
        put = '/efir/scena'
    elif c in ('net', 'ubrat', 'stop'):
        put = '/efir/scena?s=net'
    elif c in SCENY:
        q = 's=' + c
        ost = a[1:]
        if c != 'konec':
            if ost and re.fullmatch(r'\d{1,4}(?:[.,]\d+)?', ost[0]):
                q += '&min=' + ost[0].replace(',', '.')
                ost = ost[1:]
            if ost:
                q += '&t=' + urllib.parse.quote(' '.join(ost)[:140])
        put = '/efir/scena?' + q
    else:
        return 1, [SCENA_PODSKAZKA], None
    r = zapros(U, put, 5)
    if r is None:
        return 1, [MOLCHIT], None
    if r[0] == 404:
        return 1, ['Сцены: нужен мост 2.7.0 (обнови приложение).'], None
    d = razobrat(r[1]) or {}
    if d.get('oshibka'):
        return 1, ['Сцена: %s. %s' % (d['oshibka'], SCENA_PODSKAZKA)], None
    out = [scena_skazat(d)]
    if (d.get('scena') or 'net') != 'net':
        e = zapros(U, '/efir', 3)
        if e and (razobrat(e[1]) or {}).get('state') != 'efir':
            out.append('Эфир сейчас не идёт — сцена встанет в кадр с его началом.')
        if d.get('stil') == 'staryj':
            out.append('Стиль плашек — старый; сцены всё равно в стиле визора.')
    return 0, out, None


def vid(a):
    """vid stil viz|staryj — стиль плашек эфира: визор (золотые скобы, карточки, Unbounded и Manrope) или старый
    (как до 2.7.0); мост запоминает. vid — какой сейчас."""
    a = list(a)
    U = os.environ.get('VIZOR_URL') or APP
    if not a or a[0] in ('status', 's') or a == ['stil']:
        put = '/efir/stil'
    elif a[0] == 'stil' and len(a) > 1 and a[1] in ('viz', 'staryj'):
        put = '/efir/stil?v=' + a[1]
    elif a[0] == 'lico' and len(a) > 1 and a[1] in ('zver', 'plus'):
        put = '/efir/lico?v=' + a[1]
    elif a == ['lico']:
        put = '/efir/lico'
    else:
        return 1, ['vid stil viz — стиль «Визор» (по умолчанию); vid stil staryj — старые плашки; vid lico zver — в эфире '
                   'вместо лица Плюса живой рисунок зверя; vid lico plus — снова Плюс; vid — какой сейчас.'], None
    r = zapros(U, put, 5)
    if r is None:
        return 1, [MOLCHIT], None
    if r[0] == 404:
        return 1, [('Лицо зверя в эфире: нужен мост 2.7.1' if put.startswith('/efir/lico') else
                    'Стиль эфира: нужен мост 2.7.0') + ' (обнови приложение).'], None
    d = razobrat(r[1]) or {}
    if put.startswith('/efir/lico'):
        if d.get('lico') == 'zver':
            return 0, ['В эфире вместо лица Плюса — зверь: живой рисунок, пасть ходит под голос, глаза светятся '
                       '(мост запомнил). Вернуть Плюса — vid lico plus.'], None
        if d.get('lico') == 'plus':
            return 0, ['В эфире снова лицо Плюса (мост запомнил).'], None
        return 1, ['Лицо в эфире: непонятный ответ моста.'], None
    if d.get('stil') == 'viz':
        return 0, ['Стиль эфира — визор: золотые скобы по углам, карточки графит с золотом, шрифты Unbounded и Manrope '
                   '(мост запомнил).'], None
    if d.get('stil') == 'staryj':
        return 0, ['Стиль эфира — старый, как до 2.7.0 (мост запомнил). Вернуть визор — vid stil viz.'], None
    return 1, ['Стиль эфира: непонятный ответ моста.'], None


INSTRUMENTY = {'kadr': kadr, 'efir': efir, 'kamera': kamera, 'karta': karta, 'most3': most3, 'klipy': klipy}
INSTRUMENTY.update(scena=scena, vid=vid)                  # оформление «Визор» (2.7.0)


def main():
    f = INSTRUMENTY.get(sys.argv[1] if len(sys.argv) > 1 else '')
    if f is None:
        print('plus-lib kadr|efir|kamera|karta|most3|klipy [аргументы]')
        return 1
    kod, stroki, _ = f(sys.argv[2:])
    for s in stroki:
        print(s)
    return kod


if __name__ == '__main__':
    sys.exit(main())
