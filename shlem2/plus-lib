# 2.7.0: мульти-эфир — площадки, у каждой свой ключ (kluch twitch|kick|youtube) и своя строка в статусе
NAZV = {'twitch': 'Twitch', 'kick': 'Kick', 'youtube': 'YouTube'}
PL_IMENA = {'twitch': 'twitch', 'tw': 'twitch', 'твич': 'twitch', 'твитч': 'twitch', 'kick': 'kick', 'кик': 'kick',
            'youtube': 'youtube', 'yt': 'youtube', 'ютуб': 'youtube'}
SOST = {'idyot': 'идёт', 'podklyuchayus': 'подключаюсь', 'obryv': 'обрыв, переподключаюсь',
        'net_klyucha': 'не идёт', 'vykl': 'выключена'}


def efir_kluch_put(pl):
    """Файл ключа площадки (кладёт kluch; секрет — только читаем и шлём телом запроса)."""
    return os.environ.get({'twitch': 'EFIR_KEY', 'kick': 'EFIR_KEY_KICK', 'youtube': 'EFIR_KEY_YOUTUBE'}[pl]) \
        or '/root/.%s-key' % pl


def efir_pl(slova):
    """«twitch,kick» / «твич и кик» → ['twitch', 'kick']; None — чужое имя, пусто или больше трёх."""
    t = [x for x in re.split(r'[,\s+;]+', ' '.join(slova).lower()) if x and x != 'и']
    pl = []
    for x in t:
        if x not in PL_IMENA:
            return None
        if PL_IMENA[x] not in pl:
            pl.append(PL_IMENA[x])
    return pl if 0 < len(pl) <= 3 else None


def efir_ploshchadki(d):
    """Строка по каждой площадке (мост 2.7.0) и совет, если сеть не успевает."""
    out = []
    for p in d.get('ploshchadki') or []:
        imya = NAZV.get(p.get('pl'), p.get('pl'))
        s = p.get('sostoyanie')
        if s == 'idyot':
            t = '%s: идёт %s с, %s кбит/с, потерь %s, попыток %s' % (imya, p.get('sec'), p.get('kbps'), p.get('poteri'),
                                                                  p.get('popytki'))
            if p.get('zapasnoy'):
                t += ' (запасной адрес)'
        else:
            t = '%s: %s' % (imya, SOST.get(s, s))
            if p.get('oshibka'):
                t += ' — ' + p['oshibka']
            if s != 'net_klyucha':
                t += ', попыток %s, потерь %s' % (p.get('popytki'), p.get('poteri'))
        out.append(t + '.')
    if d.get('tesno_set'):
        out.append('Внимание, сеть: %s. Эфир идёт через мобильный интернет айфона — каждая площадка берёт '
                   'полный поток.' % (d.get('sovet_set') or 'отправка не успевает'))
    return out


def efir_skazat(U):
    r = zapros(U, '/efir', 5)
    if r is None:
        return 1, [MOLCHIT]
    d = razobrat(r[1])
    if d is None:
        return 1, ['Эфир: непонятный ответ приложения.']
    s, o = d.get('state'), d.get('oshibka') or ''
    out = []
    if s == 'efir':
        out.append('Эфир идёт: %s с, %s кбит/с (цель %s), %s, звук: %s, голос ×%s; потеряно кадров: %s.'
                   % (d.get('sec'), d.get('kbps'), d.get('tsel_kbps'), d.get('razmer'), d.get('zvuk'),
                      d.get('mic'), d.get('drops')))
        if d.get('mic_propuski') is not None:
            out.append('Голос: микропауз %s, сбросов %s (норма — 0).' % (d.get('mic_propuski'), d.get('mic_sbrosy', 0)))
        if d.get('avto30'):
            out.append('Шлему тесно — эфир сейчас на 30 кадрах (выбрано %s), вернётся сам через минуту спокойствия.' % d.get('fps_vybor'))
        r2 = zapros(U, '/efir/osnova', 3)               # 2.6.9: откуда кадр эфира — от этого зависят его кадры
        o = (razobrat(r2[1]) or {}) if r2 and r2[0] == 200 else {}
        if o.get('igra_idyot'):
            out.append('Основа эфира — игра из Моста 3 (кадров от него: %s): эфир получает столько кадров, сколько даёт карта.'
                       % o.get('igra_kadrov'))
        elif o:
            out.append('Основа эфира — вид шлема (режим %s): Мост 3 кадров эфиру не даёт, поэтому кадров не больше, чем у '
                       'захвата шлема.' % o.get('osnova'))
        if d.get('ekran_fps') is not None:             # 2.3.9: игра или эфир
            out.append('Захват шлема: %s кадров/с; плашки эфира: %s мс в секунду; глазам Плюса: %s кадра/с.'
                       % (d.get('ekran_fps'), d.get('plashki_ms'), d.get('glaza_fps')))
        g = golos_kuda()
        if g:
            out.append(g)
        out += efir_ploshchadki(d)
    elif s == 'podklyuchayus':
        kuda = ', '.join(NAZV.get(x, x) for x in d.get('vybor') or ['twitch'])
        out.append('Эфир: подключаюсь к %s… ' % kuda + o)
        out += efir_ploshchadki(d)
    elif s == 'obryv':
        out.append('Эфир: обрыв, переподключаюсь… ' + o)
        out += efir_ploshchadki(d)
    else:
        out.append('Эфир выключен.' + (' ' + o if o else ''))
        if isinstance(d.get('kluchi'), dict):            # мост 2.7.0: какие площадки запомнены и у каких есть ключ
            k = d['kluchi']
            out.append('Площадки: %s (запомнены); ключи: %s.' % (
                ', '.join(NAZV.get(x, x) for x in d.get('vybor') or ['twitch']),
                ', '.join('%s %s' % (NAZV[x], 'есть' if k.get(x) else 'нет') for x in ('twitch', 'kick', 'youtube'))))
    return 0, out


def efir_pusk(U, pl, c720):
    """Начать эфир (или сменить площадки на ходу): ключи площадок — приложению телом запроса, нигде не печатаются.
    pl — площадки из `efir na …` (None — запомненные мостом)."""
    r = zapros(U, '/status', 3)
    if r is None:
        return 1, [MOLCHIT]
    if '"capturing":true' not in r[1]:
        return 1, ['Захват не идёт: в Quest Claude Bridge 2 — «Начать захват» → «Разрешить».']
    r = zapros(U, '/efir', 5)
    d = (razobrat(r[1]) or {}) if r else {}
    mnogo = isinstance(d.get('kluchi'), dict)          # мост 2.7.0 умеет площадки
    vybor = pl or (d.get('vybor') if mnogo else None) or ['twitch']
    if not mnogo and vybor != ['twitch']:
        return 1, ['Эфир на Kick и YouTube — с мостом 2.7.0: обнови приложение (пока только Twitch: efir na twitch).']
    out, est = [], []
    for p in vybor:
        put = efir_kluch_put(p)
        try:
            klyuch = open(put, 'rb').read() if os.path.getsize(put) > 0 else b''
        except OSError:
            klyuch = b''
        if not klyuch:
            out.append('Нет ключа %s: в Ubuntu Плюса — kluch %s.' % (NAZV[p], p))
            continue
        r = zapros(U, '/efir/key' + ('' if p == 'twitch' else '?pl=' + p), 5, telo=klyuch)
        del klyuch
        if r is None:                                    # приложение замолчало (обновляется, выгружено) — ключ ни при чём
            return 1, [MOLCHIT]
        if '"key":true' not in r[1]:
            out.append('Приложение не приняло ключ (нужно приложение 2.1; ключ не похож на ключ Twitch?).' if p == 'twitch'
                       else 'Приложение не приняло ключ %s (не похож на ключ?).' % NAZV[p])
            continue
        if p == 'kick':                                  # адрес приёма Kick — свой у аккаунта (не секрет, но и не печатаем)
            try:
                adr = open(os.environ.get('EFIR_ADRES_KICK') or '/root/.kick-url').read().strip()
            except OSError:
                adr = ''
            if adr:
                r = zapros(U, '/efir/adres?pl=kick&url=' + urllib.parse.quote(adr, safe=''), 5)
                if not r or '"adres":true' not in r[1]:
                    out.append('Адрес Kick не принят: скопируй на странице Kick «Stream URL» (rtmps://…/app) и kluch kick.')
                    continue
            elif not d.get('adres_kick'):
                out.append('Нет адреса Kick: скопируй на странице Kick «Stream URL» и kluch kick (ключ — отдельно, тоже kluch kick).')
                continue
        est.append(p)
    if not est:
        return 1, out
    q = (['size=720&kbps=4500'] if c720 else []) + (['pl=' + ','.join(pl)] if pl else [])
    zapros(U, '/efir/start' + ('?' + '&'.join(q) if q else ''), 20)
    for _ in range(12):
        time.sleep(float(os.environ.get('EFIR_SHAG') or 1))
        r = zapros(U, '/efir', 3)
        d2 = razobrat(r[1]) if r else None
        if not d2:
            continue
        if d2.get('state') == 'off':
            break
        if d2.get('state') == 'efir' and all(x.get('sostoyanie') != 'podklyuchayus'
                                              for x in d2.get('ploshchadki') or [] if x.get('est_kluch')):
            break
    k, o2 = efir_skazat(U)
    return k, out + o2


def efir(a):
    """efir [720|1080] — начать; efir na twitch,kick — площадки (запомнить и начать / сменить на ходу);
    efir stop|status; efir mic 4|+25%|-20%. Ключи — из /root/.twitch-key, /root/.kick-key, /root/.youtube-key
    (кладёт `kluch twitch|kick|youtube`): уходят приложению телом запроса внутри шлема и нигде не печатаются."""
    a = list(a)
    U = os.environ.get('EFIR_URL') or APP
    c = a[0] if a else ''
    if c == 'stop':
        zapros(U, '/efir/stop', 15)
        k, out = efir_skazat(U)
    elif c in ('status', 's'):
        k, out = efir_skazat(U)
    elif c == 'mic':
        g = a[1] if len(a) > 1 else ''
        was = None
        if g[:1] in ('+', '-') and g:            # на слух: «на 25 % громче» — от того, что сейчас
            r = zapros(U, '/efir', 5)
            if r is None:
                return 1, [MOLCHIT], None
            m = re.fullmatch(r'([+-])(\d{1,3}(?:[.,]\d+)?)%?', g)
            if not m:
                return 1, ['efir mic +25% — на слух на 25 % громче, efir mic -20% — тише, efir mic 4 — ровно ×4.'], None
            p = float(m.group(2).replace(',', '.')) / 100
            p = p if m.group(1) == '+' else -min(p, 0.9)
            try:
                cur = float(json.loads(r[1]).get('mic') or 3)
            except (ValueError, AttributeError, TypeError):
                cur = 3.0
            # громкость на слух ~ сила звука в степени 0,6: на N % громче на слух — сила ×(1+N)^(1/0,6)
            was, g = '%.2f' % cur, '%.2f' % min(8.0, max(0.5, cur * (1 + p) ** (1 / 0.6)))
        elif not g or re.search(r'[^0-9.]', g):
            return 1, ['efir mic 4 — число от 0.5 до 8 (обычно 3); efir mic +25% — на слух на 25 % громче.'], None
        r = zapros(U, '/efir/mic?g=' + g, 5)
        if r is None:
            return 1, [MOLCHIT], None
        if r[0] != 200:
            return 1, ['Громкость не сохранилась: захват не идёт — в Quest Claude Bridge 2 «Начать захват».'], None
        out = ['Голос в эфире: ×%s → ×%s (на слух %s, приложение запомнило).' % (was, g, a[1]) if was
               else 'Голос в эфире: ×%s (приложение запомнило).' % g]
        k, o2 = efir_skazat(U)
        out += o2
    elif c in ('chastota', 'potok'):                    # 2.6.9: частота 30|50|60 и поток (Мбит или кбит/с) — запомнить, на ходу
        v = a[1].lower().rstrip('m').replace(',', '.') if len(a) > 1 else ''
        try:
            n = float(v)
        except ValueError:
            return 1, ['efir chastota 30|50|60 — кадров в секунду; efir potok 10 — поток в Мбит/с (до 12).'], None
        q = 'fps=%d' % n if c == 'chastota' else 'kbps=%d' % (n * 1000 if n <= 50 else n)
        r = zapros(U, '/efir/nastroyki?' + q, 5)
        if r is None:
            return 1, [MOLCHIT], None
        if r[0] == 404:
            return 1, ['Частота и поток эфира: нужен мост 2.6.9 (обнови приложение).'], None
        d = razobrat(r[1]) or {}
        out = ['Эфир: %s кадров в секунду, поток %s кбит/с (мост запомнил%s).' % (
