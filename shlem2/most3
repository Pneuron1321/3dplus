#!/bin/sh
# most3 — Мост 3 (22.10): игра с карты захвата в шлеме без HDMI Link (приложение «Мост 3 — карта», порт 8767).
#   most3                 — что показывает: режим, кадры в секунду, звук
#   most3 zvuk 80|vkl|vykl — звук игры: громкость в % / включить / выключить
#   most3 podklyuchit     — открыть карту заново
#   most3 rezhimy         — что умеет карта (список режимов)
#   most3 klip [60]       — последние 60 (по умолчанию 120) секунд игры в галерею (Movies/Plus); klip vkl|vykl — запись
#   most3 diagnoz         — самоотчёт: первая строка — итог, дальше всё для разбора чёрного экрана
# Картинку правит karta kartinka (сама идёт в Мост 3, если он показывает).
L=${0%/*}/plus-lib; [ -f "$L" ] || L=/usr/local/bin/plus-lib
exec python3 -S "$L" most3 "$@"
