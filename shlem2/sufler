def chat_lyudi(okno):
    """Сообщения настоящих зрителей за последние okno секунд (без своих и ботов): ['ник: текст']."""
    res, now = [], time.localtime()
    seychas = now.tm_hour * 60 + now.tm_min
    for l in hvost(CHAT, 40):
        m = re.match(r'^(\d\d):(\d\d) ([^:]{1,40}?)(?: \((?:Kick|YouTube)\))?: (.+)$', l.strip())
        if not m:
            continue
        minut = (seychas - (int(m.group(1)) * 60 + int(m.group(2)))) % 1440
        if minut * 60 > okno * SEK or m.group(3).strip().lower() in SVOI:
            continue
        res.append('%s: %s' % (m.group(3).strip(), m.group(4)[:140]))
    return res[-5:]


