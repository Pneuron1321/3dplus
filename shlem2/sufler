def log(*a):
    print(time.strftime('%H:%M:%S'), *a, flush=True)


def chitat(put, d=None):
    try:
        return json.load(open(put))
    except (OSError, ValueError):
        return d


def zapisat(put, d):
    try:
        os.makedirs(os.path.dirname(put), exist_ok=True)
        with open(put + '.tmp', 'w') as f:
            json.dump(d, f, ensure_ascii=False, indent=1)
        os.replace(put + '.tmp', put)
    except OSError:
        pass


def dopisat(put, d):
    try:
        os.makedirs(os.path.dirname(put), exist_ok=True)
        with open(put, 'a') as f:
            f.write(json.dumps(d, ensure_ascii=False) + '\n')
    except OSError:
        pass


