            print('  %d/%d  %s — %s' % (z.get('skazal', 0), z.get('dano', 0), z.get('en'), z.get('ru', '')))
    elif c == 'razminka':
        n = Sufler().razminka()
        print('Разминка в ухо:', '; '.join(en for _, en in n) if n else 'фраз пока нет')
    elif c == 'razgovornik':
        r = Sufler().razgovornik()
        print('Разговорник: %d фраз (растёт после каждого эфира).' % len(r))
        for z in r[-30:]:
            print('  %s — %s' % (z.get('ru'), z.get('en')))
    elif c == 'perevod' and len(a) > 1 and vkl_vykl(a[1]) is None:
        Sufler().perevesti(' '.join(a[1:]))
    elif c == 'proba':
        en = Sufler().podskazka()
        print('Подсказка в ухо:', en or 'не вышло (голос?)')
    elif c == 'demon':
        return demon()
    else:
        print(__doc__)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
