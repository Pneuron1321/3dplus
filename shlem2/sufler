                'messages': [{'role': 'system', 'content': zadanie}, {'role': 'user', 'content': tekst}]}
        if 'gpt-oss' in model:
            body['reasoning_effort'] = 'low'
        req = urllib.request.Request(GROQ, data=json.dumps(body).encode(), headers={
            'Authorization': 'Bearer ' + key, 'Content-Type': 'application/json', 'User-Agent': 'plus-sufler'})
        try:
            with urllib.request.urlopen(req, timeout=8) as r:
                d = json.loads(r.read().decode('utf-8'))
            o = json_iz(d['choices'][0]['message'].get('content') or '')
            if o:
                return o
            log('Groq', model, 'ответ без JSON')
        except urllib.error.HTTPError as e:
            log('Groq', model, 'HTTP', e.code)
        except Exception as e:
            log('Groq', model, type(e).__name__)
    return None


def most(put):
    try:
        with urllib.request.urlopen(MOST + put, timeout=3) as r:
            return json.loads(r.read().decode('utf-8', 'replace'))
    except Exception:
        return {}


def v_golos(tekst, vid='sufler'):
    """В очередь голоса: «.sufler» — подсказка в ухо (медленнее), «.uho» — голосом Плюса в ухо."""
    try:
        os.makedirs(G_Q, exist_ok=True)
        put = '%s/%d.%s' % (G_Q, time.time_ns(), vid)
        with open(put + '.tmp', 'w') as f:
            f.write(tekst)
        os.replace(put + '.tmp', put)
        return True
    except OSError:
        return False


def ved_sprosi(tekst):
    """Его английский ответ — соведущей, как продолжение разговора (она отвечает вслух)."""
    try:
        subprocess.Popen([VED_BIN, 'sprosi', '--dosluh', '--', tekst], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=open('/tmp/vedushchiy-sprosi.log', 'a'), start_new_session=True)
        return True
    except OSError as e:
        log('sprosi не запустился:', type(e).__name__)
        return False


SINHRON_RE = re.compile(r'^\d\d:\d\d:\d\d (\S+) (\S+?)( ЧИСТОВИК)? \| (.*?) \| (.*)$')


class Sufler:
    def __init__(self, groq_f=groq, most_f=most, golos_f=v_golos, sprosi_f=ved_sprosi):
        self.groq, self.most, self.golos, self.sprosi = groq_f, most_f, golos_f, sprosi_f
        self.efir = False
        self.efir_s = None        # начало эфира
        self.efir_posl = 0.0      # когда эфир видели последний раз
        self.efir_sled = 0.0
        self.sled = 0.0           # следующая подсказка
        self.posl_tip = None
        self.sinhron_poz = None   # смещение в sinhron-istoriya.log
        self.rech = None          # собираемая реплика Александра: {'t', 'tekst', 'yaz', 'obnovl'}
        self.ved_t = None         # последняя увиденная запись соведущей в dialog.jsonl
        self.ved_zhdu = None      # реплика соведущей, ждём «договорила»: {'t', 'en', 'ru', 'otvet'}
        self.okno_ved = None      # {'do', 'en', 'ved_t'} — его английский в это время — ей
        self.cep = 0              # обменов подряд, переданных соведущей
        self.mysli = []           # его свежие русские фразы: [(t, текст)] — материал вида «мысль»
        self.ru_vse = []          # его русские фразы (2+ слова, не команды): [(t, текст, перевод субтитров)]
        self.ru_efir = []         # русские фразы этого эфира — разговорник в итоге
        self.zapros = None        # просьба «по-английски»: {'t', 'vid', 'tekst', 'do'}
        self.recast_ochered = []  # его английские фразы на поправку: [(t, текст)]
        self.posl_recast = 0.0
        self.raund_vidno = None   # какой перерыв (номер раунда) уже видели
        self.klyuch = None        # ключ угла на раунд: {'raund_t', 'pereryv_t', 'tekst', 'skazan'}
        self.chist_est = False    # sinhron даёт чистовики — поправляем только их (меньше ошибок распознавания)
        self.mysl_vzyata = 0.0    # время последней мысли, уже отданной подсказкой
        self.slyshal = {}         # его английская фраза → когда (Whisper повторяет «Thank you»)
        self.ignor = 0            # подсказок подряд без его английского — реже
        self.zhdu_otveta = None   # время последней подсказки, на которую ещё нет ответа
        self.dialog_mt = None

    # ---------- память ----------
    def zhurnal(self, d):
        d.setdefault('t', round(time.time(), 1))
        dopisat(os.path.join(PAPKA, 'zhurnal.jsonl'), d)

    def zhurnal_chitat(self, ot=0):
        res = []
        try:
            for l in open(os.path.join(PAPKA, 'zhurnal.jsonl'), errors='replace'):
                try:
                    z = json.loads(l)
                except ValueError:
                    continue
                if isinstance(z, dict) and z.get('t', 0) >= ot:
                    res.append(z)
        except OSError:
            pass
        return res

    def slovar(self):
        return chitat(os.path.join(PAPKA, 'slovar.json'), {}) or {}

    def slovar_zapisat(self, en, ru='', tip='', dano=0, skazal=0):
        s = self.slovar()
        k = klyuch(en)
        if not k:
            return
        z = s.get(k) or {'en': en, 'ru': ru, 'tip': tip, 'dano': 0, 'skazal': 0}
        z['dano'] += dano
        z['skazal'] += skazal
        z['posl'] = round(time.time())
        s[k] = z
        if len(s) > 600:          # старые неосвоенные — прочь
            for kk in sorted(s, key=lambda x: s[x].get('posl', 0))[:len(s) - 600]:
                del s[kk]
        zapisat(os.path.join(PAPKA, 'slovar.json'), s)

    # ---------- эфир ----------
    def efir_proverka(self, now):
        if now < self.efir_sled:
            return
        self.efir_sled = now + EFIR_RAZ * SEK
        idyot = self.most('/efir').get('state') == 'efir'
        if idyot:
            if not self.efir:
                if not self.efir_s or now - self.efir_posl > KONEC_EFIRA * SEK:
                    self.efir_s = now                       # новый эфир (не короткий обрыв)
                    self.sled = now + PERVAYA * SEK
                    self.cep = 0
                    log('эфир начался — суфлёр слушает')
                self.efir = True
            self.efir_posl = now
        else:
            self.efir = False
            if self.efir_s and now - self.efir_posl > KONEC_EFIRA * SEK:
                if self.efir_posl - self.efir_s >= MIN_EFIR * SEK:
                    try:
                        self.itog(self.efir_s, self.efir_posl + 2 * EFIR_RAZ * SEK)
                    except Exception as e:
                        log('итог:', type(e).__name__, str(e)[:80])
                self.efir_s = None

    # ---------- речь Александра (субтитры sinhron) ----------
    def sinhron_chitat(self, now):
        try:
            razmer = os.path.getsize(SINHRON)
        except OSError:
            return
        if self.sinhron_poz is None or razmer < self.sinhron_poz:
            self.sinhron_poz = razmer if self.sinhron_poz is None else 0   # при запуске — только новое
            return
        if razmer == self.sinhron_poz:
            return
        with open(SINHRON, 'rb') as f:
            f.seek(self.sinhron_poz)
            kusok = f.read(razmer - self.sinhron_poz)
        konec = kusok.rfind(b'\n')
        if konec < 0:
            return
        self.sinhron_poz += konec + 1
        for l in kusok[:konec].decode('utf-8', 'replace').splitlines():
            m = SINHRON_RE.match(l.strip())
            if not m or m.group(1) != 'ya':
                continue
            tekst = m.group(4).strip()
            if not tekst:
                continue
            r = self.rech
            # черновик растёт в одной строке (все куски до этого), чистовик — замена: та же реплика
            if r and now - r['obnovl'] <= SOBRAT * SEK and (m.group(3) or tekst.startswith(r['tekst'][:max(8, len(r['tekst']) - 6)])):
                r.update(tekst=tekst, yaz=m.group(2), obnovl=now, perevod=m.group(5).strip(),
                         chist=bool(m.group(3)) or r.get('chist', False))
            else:
                self.rech_gotova()
                self.rech = {'t': now, 'tekst': tekst, 'yaz': m.group(2), 'obnovl': now, 'perevod': m.group(5).strip(),
                             'chist': bool(m.group(3))}
            if m.group(3):
                self.chist_est = True

    def rech_proverka(self, now):
        if self.rech and now - self.rech['obnovl'] > SOBRAT * SEK:
            self.rech_gotova()

    def rech_gotova(self):
        r, self.rech = self.rech, None
        now = time.time()
        if not r or not self.efir_s or (not self.efir and now - self.efir_posl > 2 * EFIR_RAZ * SEK):
            return                                      # вне эфира — не считаем
        tekst = r['tekst'].strip()
        if r['yaz'] == 'ru' or KIRILL.search(tekst):
            # русская мысль — материал подсказки «скажи это по-английски» (не команды Плюсу, не обрывки)
            if not KOMANDA_RU.match(tekst) and len(slova_ru(tekst)) >= 2:
                self.ru_vse = (self.ru_vse + [(now, tekst[:300], r.get('perevod', '')[:300])])[-10:]
                if len(slova_ru(tekst)) >= 4:
                    self.mysli = (self.mysli + [(now, tekst[:300])])[-5:]
                    self.ru_efir = (self.ru_efir + [tekst[:200]])[-150:]
            return
        if r['yaz'] != 'en' or not nastoyashchaya(tekst):
            return                                      # «Thank you», «Puh», «Okay» — Whisper, не речь
        k = klyuch(tekst)
        if now - self.slyshal.get(k, 0) < POVTOR_RECHI * SEK:
            return
        self.slyshal = {kk: tt for kk, tt in self.slyshal.items() if now - tt < POVTOR_RECHI * SEK}
        self.slyshal[k] = now
        z = {'vid': 'skazal', 'en': tekst[:300]}
        # первая настоящая фраза после подсказки — ответ на неё; дальше — «сам»
        posl = [x for x in self.zhurnal_chitat(now - OKNO_PODSKAZKI * SEK) if x.get('vid') in ('podskazka', 'otvet_ved')]
        if posl and self.zhdu_otveta is not None and posl[-1].get('t', 0) >= self.zhdu_otveta - 1:
            p = posl[-1]
            z['na'] = p.get('vid')
            z['itog'] = 'povtoril' if shodstvo(p.get('en', ''), tekst) >= SHODSTVO else 'svoimi'
            z['podskazka'] = p.get('en', '')
            if z['itog'] == 'povtoril':
                self.slovar_zapisat(p.get('en', ''), skazal=1)
            self.zhdu_otveta = None
        self.ignor = 0
        self.zhurnal(z)
        log('сказал по-английски:', tekst[:80], '|', z.get('itog', 'сам'))
        if len(slova(tekst)) >= 4 and z.get('itog') != 'povtoril' and (r.get('chist') or not self.chist_est):
            self.recast_ochered = (self.recast_ochered + [(now, tekst[:300])])[-5:]   # 1.1: поправка — на ЕГО фразе
        o = self.okno_ved
        if o and now <= o['do']:
            self.okno_ved = None
            n = nastroyki()
            if n['razgovor'] and self.cep < int(n['cepochka']) and not self.alex_otvetil_ey(o['ved_t']) \
                    and not os.path.exists(VED_OFF):
                self.cep += 1
                self.sprosi(tekst)
                log('ответ — соведущей (обмен %d)' % self.cep)

    def alex_otvetil_ey(self, ved_t):
        """Уши уже передали ей его фразу после её реплики (dialog: alex → ved)?"""
        for z in self.dialog_hvost(20):
            if z.get('rol') == 'alex' and z.get('komu') == 'ved' and z.get('t', 0) > ved_t:
                return True
        return False

    # ---------- соведущая ----------
    def dialog_hvost(self, n=30):
        res = []
        for l in hvost(DIALOG, n, 20000):
            try:
                z = json.loads(l)
            except ValueError:
                continue
            if isinstance(z, dict):
                res.append(z)
        return res

    def ved_chitat(self, now):
        try:
            mt = os.path.getmtime(DIALOG)
        except OSError:
            return
        if mt == self.dialog_mt:
            return
        self.dialog_mt = mt
        zapisi = self.dialog_hvost(30)
        if self.ved_t is None:                         # при запуске — только новое
            self.ved_t = max([z.get('t', 0) for z in zapisi] or [0])
            return
        for z in zapisi:
            t = z.get('t', 0)
            if t <= self.ved_t:
                continue
            self.ved_t = t
            if z.get('rol') != 'ved' or z.get('vid') in ('ideya', 'uho'):
                continue                                # идеи и разговор о них — в ухо, по-русски
            en = z.get('tekst') or ''                   # что прозвучало (en — может быть переводом русского)
            if KIRILL.search(en) or len(slova(en)) < 3:
                continue                                # в ухо по-русски или пусто — переводить нечего
            if z.get('komu') != 'alex':
                self.cep = 0                            # её своя реплика — новый разговор
            self.ved_zhdu = {'t': t, 'en': en[:600], 'ru': z.get('ru') or '', 'otvet': None, 'konec': None}

    def ved_proverka(self, now):
        z = self.ved_zhdu
        if not z:
            return
        n = nastroyki()
        if not n['ved'] or not self.efir:
            self.ved_zhdu = None
            return
        if z['otvet'] is None:                          # готовим, пока она говорит
            z['otvet'] = self.ved_otvet(z) or False
        if z['konec'] is None:
            try:
                with open(VED_KONEC) as f:
                    tk = float(f.read().split()[0])
                if tk >= z['t'] - 2:
                    z['konec'] = tk
            except (OSError, ValueError, IndexError):
                pass
            if z['konec'] is None and now > z['t'] + (len(slova(z['en'])) / 2.5 + VED_ZAPAS) * SEK:
                z['konec'] = now                        # метки нет (старый голос) — оцениваем
        if z['konec'] is None or now < z['konec'] + float(n['pauza']) * SEK:
            return
        if v_boyu():                                    # раунд — ждём угла; к месту не больше 90 с
            if now - z['konec'] > 90 * SEK:
                self.ved_zhdu = None
            return
        self.ved_zhdu = None
        o = z['otvet']
        if not o:
            return
        tekst = 'Она сказала: %s. Ответь: %s' % (o['sut'].rstrip('. '), o['en'])
        if n['perevod'] and o.get('ru'):
            tekst = 'Она сказала: %s. Ответь — %s: %s' % (o['sut'].rstrip('. '), o['ru'].rstrip('. ').lower(), o['en'])
        if self.golos(tekst, 'sufler'):
            self.zhdu_otveta = time.time()
            self.zhurnal({'vid': 'otvet_ved', 'ved': z['en'][:300], 'sut': o['sut'], 'en': o['en'], 'ru': o.get('ru', '')})
            self.okno_ved = {'do': time.time() + OKNO_VED * SEK, 'en': o['en'], 'ved_t': z['t']}
            self.sled = max(self.sled, time.time() + 40 * SEK)   # подсказка — не следом
            log('соведущей — перевод и ответ в ухо:', o['en'])

    def ved_otvet(self, z):
        kontekst = {
            'her_line': z['en'],
            'recent_dialog': [('%s: %s' % (x.get('rol'), (x.get('en') or x.get('tekst') or '')[:200]))
                              for x in self.dialog_hvost(8)][-6:],
            'game_now': [l[-160:] for l in hvost(OBZOR, 3)],
            'his_recent_english': [x.get('en') for x in self.zhurnal_chitat(time.time() - 600) if x.get('vid') == 'skazal'][-4:],
            'focus_of_the_week': nastroyki().get('fokus') or '',
        }
        o = self.groq(ZADANIE_OTVET, json.dumps(kontekst, ensure_ascii=False), 0.5)
        en = chistaya_en((o or {}).get('en'))
        if not en:
            return None
        sut = chistaya_ru((o or {}).get('sut'), 220)
        ru_polnyy = chistaya_ru(z.get('ru'), 400)
        if ru_polnyy and len(ru_polnyy.split()) <= VED_SUT:
            sut = ru_polnyy                              # короткая — полный перевод (он уже есть в журнале)
        if not sut:
            return None
        return {'sut': sut, 'en': en, 'ru': chistaya_ru((o or {}).get('ru'), 40)}

    # ---------- 1.1: раунд — не тишина, а ключ угла ----------
    def klyuch_proverka(self, now):
        """06.11 (Александр: «в раундах не нужно молчание, нужна помощь, только без вопросов»): совет Плюса в углу
        сжимается в команду из 2–4 слов («Левую выше») и звучит в ухо один раз на ~40-й секунде раунда."""
        st = chitat(SEK_SOST, {}) or {}
        if not st.get('boy'):
            self.klyuch, self.raund_vidno = None, None
            return
        if st.get('raund') != self.raund_vidno and now < st.get('raund_t', 0):    # новый перерыв (угол)
            self.raund_vidno = st.get('raund')
            self.klyuch = {'raund_t': st.get('raund_t', 0), 'pereryv_t': now, 'tekst': None, 'skazan': False}
        k = self.klyuch
        if not k or k['skazan']:
            return
        if k['tekst'] is None:
            try:
                mt = os.path.getmtime(G_POSL)
                sovet = open(G_POSL, errors='replace').read().strip() if mt >= k['pereryv_t'] - 2 * SEK else ''
            except OSError:
                sovet = ''
            if sovet:
                o = self.groq(ZADANIE_KLYUCH, sovet[:600], 0.2, 80) or {}
                k['tekst'] = chistaya_ru(o.get('klyuch'), 40) if not o.get('net') else ''
                log('ключ угла:', k['tekst'] or '—')
            elif now > k['raund_t'] + 60 * SEK:
                k['tekst'] = ''                         # совета не было — не выдумываем
        if not k.get('zhivoy_poshyol') and now >= k['raund_t'] + ZHIVOY_S * SEK \
                and v_boyu() and not os.path.exists(ZHIVOY_VYKL):
            k['zhivoy_poshyol'] = True                  # живой взгляд: свежие кадры раунда — в фоне, ключ угла — запасной
            import threading
            threading.Thread(target=self.zhivoy_vzglyad, args=(k,), daemon=True).start()
        if k.get('zhivoy_poshyol') and k.get('zhivoy') is None and now < k['raund_t'] + (KLYUCH_CHEREZ + 15) * SEK:
            return                                      # ждём живой взгляд (до 55-й секунды), потом — ключ угла
        if k.get('zhivoy'):
            k['tekst'] = k['zhivoy']
        if k['tekst'] and v_boyu() and now >= k['raund_t'] + KLYUCH_CHEREZ * SEK:
            k['skazan'] = True
            if now < k['raund_t'] + (KLYUCH_CHEREZ + 40) * SEK and self.golos(k['tekst'].rstrip('.') + '.', 'uho'):
                self.zhurnal({'vid': 'klyuch', 'tekst': k['tekst']})
        elif k['tekst'] == '':
            k['skazan'] = True

    def zhivoy_vzglyad(self, k):
        """Модель смотрит 3 свежих кадра раунда + совет угла → команда 2–4 слова. Не вышло — '' (останется ключ угла)."""
        try:
            kadry = sorted((os.path.join(BOY_PAPKA, f) for f in os.listdir(BOY_PAPKA) if f.startswith('k') and f.endswith('.jpg')),
                           key=os.path.getmtime)
            kadry = [f for f in kadry if os.path.getmtime(f) >= k['raund_t'] - 2 * SEK][-3:]
        except OSError:
            kadry = []
        if not kadry:
            k['zhivoy'] = ''
            log('живой ключ: кадров раунда нет — останется ключ угла')
            return
        try:
            sovet = open(G_POSL, errors='replace').read().strip()[:500]
        except OSError:
            sovet = ''
        zapros = 'Кадры раунда (читай Read-ом по порядку): %s\nСовет из угла: %s\nКлюч угла: %s' % (
            ' ; '.join(kadry), sovet or '—', k.get('tekst') or '—')
        env = dict(os.environ, CLAUDE_CODE_DISABLE_CLAUDE_MDS='1', CLAUDE_CODE_DISABLE_AUTO_MEMORY='1', GOLOS_RACIYA='1')
        cmd = [CLAUDE, '-p', '--model', ZHIVOY_MODEL, '--effort', 'low', '--tools', 'Read', '--allowedTools', 'Read',
               '--no-session-persistence', '--settings', '{"disableAllHooks":true}', '--output-format', 'json',
               '--system-prompt', ZADANIE_ZHIVOY, zapros]
        try:
            r = subprocess.run(cmd, cwd=BOY_PAPKA, env=env, capture_output=True, text=True, timeout=40,
                               stdin=subprocess.DEVNULL)
            t = json.loads(r.stdout).get('result', '') if r.stdout.strip() else ''
            k['zhivoy'] = chistaya_ru((json_iz(t) or {}).get('klyuch'), 40)
        except Exception as e:
            log('живой взгляд:', type(e).__name__)
            k['zhivoy'] = ''
        log('живой ключ:', k['zhivoy'] or '— (останется ключ угла)')

    # ---------- подсказка ----------
    def obstanovka(self):
        """Что есть в этот момент — только из этого подсказка и строится (и решается, говорить ли)."""
        now = time.time()
        igra = ''
        try:
            if now - os.path.getmtime(OBZOR) < IGRA_SVEZHAYA * SEK:
                igra = (hvost(OBZOR, 1) or [''])[-1][-300:]
        except OSError:
            pass
        mysl = [m for t, m in self.mysli if now - t < MYSL_SVEZHAYA * SEK and t > self.mysl_vzyata]
        ved = [(x.get('tekst') or '')[:220] for x in self.dialog_hvost(10)
               if x.get('rol') == 'ved' and x.get('vid') not in ('ideya', 'uho') and now - x.get('t', 0) < 300 * SEK]
        zr = self.most('/schet').get('zriteli_vsego')
        return {
            'chat_people': chat_lyudi(CHAT_OKNO),
            'viewers_now': zr if isinstance(zr, int) else None,
            'game_now': igra,
            'game_is_menu': bool(re.search(r'меню|загрузк|ИНТЕРЕС 0|главн\w* экран|home', igra, re.I)),
            'in_fight_break': (chitat(SEK_SOST, {}) or {}).get('boy', False),
            'his_last_russian': mysl[-1] if mysl else '',
            'co_host_recent': ved[-1:],
            'his_recent_english': [x.get('en') for x in self.zhurnal_chitat(now - 600) if x.get('vid') == 'skazal'][-4:],
        }

    def vybrat_tip(self, ob):
        """Вид, для которого в моменте есть материал; ничего нет — None (молчим)."""
        est = {'mysl': bool(ob['his_last_russian']),
               'plus': bool(ob['co_host_recent']) and not nastroyki()['ved'],   # с переводом соведущей — там и ответ
               'chat': bool(ob['chat_people']),
               'emociya': bool(ob['game_now']) and not ob['game_is_menu'] or ob['in_fight_break'],
               'igra': bool(ob['game_now']) and not ob['game_is_menu']}
        mozhno = [t for t in PRIORITET if est[t]]
        if not mozhno:
            return None
        if mozhno[0] == 'mysl':
            return 'mysl'                               # его собственная мысль — всегда первой
        drugie = [t for t in mozhno if t != self.posl_tip]
        return (drugie or mozhno)[0]

    def podskazka_proverka(self, now):
        n = nastroyki()
        if not self.efir or not n['vkl'] or now < self.sled:
            return
        if self.ved_zhdu or (self.okno_ved and now < self.okno_ved['do']) or v_boyu() or not uho_svobodno():
            self.sled = now + 20 * SEK                  # разговор с соведущей или раунд — подсказка подождёт
            return
        if self.zhdu_otveta is not None:                # прошлая осталась без ответа — следующая реже
            self.ignor = min(4, self.ignor + 1)
            self.zhdu_otveta = None
        self.sled = now + max(30.0, float(n['kazhdye'])) * (1 + 0.5 * self.ignor) * SEK
        self.podskazka()

    def podskazka(self, tip=None):
        n = nastroyki()
        ob = self.obstanovka()
        tip = tip or self.vybrat_tip(ob)
        if not tip:
            log('подсказки нет: в моменте нечего взять (чат пуст, игры нет, ты молчишь)')
            return None
        nedavno = [x for x in self.zhurnal_chitat(time.time() - 3 * 3600) if x.get('vid') == 'podskazka']
        nedavnie = [x.get('en', '') for x in nedavno][-30:]
        s = self.slovar()
        praktika = []                                   # учимся на его ошибках: поправки и новые фразы прошлых эфиров
        for v in self.vechera(3):
            if isinstance(v.get('popravka'), dict) and v['popravka'].get('nado'):
                praktika.append(v['popravka']['nado'])
            praktika += [x for x in (v.get('novye') or [])[:2]]
        praktika += [z['nado'] for z in self.zhurnal_chitat(time.time() - 7 * 86400) if z.get('vid') == 'recast'][-3:]
        kontekst = dict(ob, type=TIPY[tip][1], recent_lines=nedavnie, practice=praktika[-6:],
                        mastered_do_not_suggest=[z['en'] for z in s.values() if z.get('skazal', 0) >= OSVOENO][-20:],
                        focus_of_the_week=n.get('fokus') or '')
        o = self.groq(ZADANIE_PODSKAZKA, json.dumps(kontekst, ensure_ascii=False), 0.7, 150) or {}
        en, ru = chistaya_en(o.get('en'), 90), chistaya_ru(o.get('ru'), 40)
        if o.get('skip') or not en or any(shodstvo(x, en) >= 0.8 for x in nedavnie[-10:]):
            pochemu = chistaya_ru(o.get('pochemu'), 80) or ('Groq молчит' if not o else 'нечего сказать умного')
            log('подсказки нет (%s): %s' % (TIPY[tip][0], pochemu))
            self.zhurnal({'vid': 'molchu', 'tip': tip, 'pochemu': pochemu})
            return None
        if tip == 'mysl':
            self.mysl_vzyata = time.time()
        ru = ru or TIPY[tip][0].capitalize()
        tekst = '%s: %s' % (ru.rstrip('.: '), en) if n['perevod'] else en
        if not self.golos(tekst, 'sufler'):
            return None
        self.posl_tip = tip
        self.zhdu_otveta = time.time()
        self.zhurnal({'vid': 'podskazka', 'tip': tip, 'en': en, 'ru': ru})
        self.slovar_zapisat(en, ru, tip, dano=1)
        log('подсказка (%s): %s' % (TIPY[tip][0], en))
        return en

    # ---------- 1.1: по его просьбе ----------
    def zapros_chitat(self, now):
        """Уши положили просьбу (/tmp/sufler.zapros): «плюс, по-английски [фраза]» или «плюс, разминка»."""
        try:
            z = json.load(open(ZAPROS))
            os.remove(ZAPROS)
        except (OSError, ValueError):
            return
        if isinstance(z, dict):
            z['do'] = now + ZAPROS_ZHDAT * SEK
            self.zapros = z

    def zapros_proverka(self, now):
        z = self.zapros
        if not z:
            return
        if z.get('vid') == 'razminka':
            self.zapros = None
            self.razminka()
            return
        ru, podskazka = (z.get('tekst') or '').strip(), ''
        if not ru:
            if self.rech and self.rech.get('yaz') == 'ru':
                self.rech_gotova()                      # его фраза ещё собирается — забрать сейчас
            svezh = [x for x in self.ru_vse if x[0] >= z.get('t', now) - 90 * SEK]
            if not svezh:
                if now < z['do']:
                    return                              # субтитр его фразы ещё в пути — ждём
                self.zapros = None
                self.golos('Скажи по-русски, что хочешь сказать, — переведу.', 'sufler')
                return
            _, ru, podskazka = svezh[-1]
        self.zapros = None
        self.perevesti(ru, podskazka)

    def perevesti(self, ru, podskazka=''):
        o = self.groq(ZADANIE_PEREVOD, json.dumps({'his_words': ru, 'subtitle': podskazka}, ensure_ascii=False), 0.4) or {}
        en = chistaya_en(o.get('en'), 120) or chistaya_en(podskazka, 120)
        if not en:
            log('перевод не вышел:', ru[:60])
            return None
        self.golos('По-английски: %s' % en, 'sufler')
        self.zhdu_otveta = time.time()
        self.zhurnal({'vid': 'zapros', 'ru': ru[:300], 'en': en})
        self.slovar_zapisat(en, ru[:80], 'zapros', dano=1)
        log('по просьбе: %s → %s' % (ru[:50], en))
        return en

    # ---------- 1.1: поправка его английского ----------
    def recast_proverka(self, now):
        """Его английская фраза с ошибкой → «Лучше так: …» — в паузе, не в раунде, не поверх речи, не чаще RECAST_RAZ."""
        self.recast_ochered = [x for x in self.recast_ochered if now - x[0] < RECAST_SVEZHAYA * SEK]
        if not self.recast_ochered or now - self.posl_recast < RECAST_RAZ * SEK or self.rech is not None:
            return
        t, tekst = self.recast_ochered[-1]
        if now - t < RECAST_TISHINA * SEK or v_boyu() or self.ved_zhdu or self.zapros or not uho_svobodno(20):
            return
        self.recast_ochered = []
        self.posl_recast = now
        o = self.groq(ZADANIE_RECAST, json.dumps({'his_line': tekst}, ensure_ascii=False), 0.2, 150) or {}
        nado = chistaya_en(o.get('nado'), 140)
        if o.get('ok') or not nado or shodstvo(nado, tekst) >= 0.95 and shodstvo(tekst, nado) >= 0.95:
            return
        pochemu = chistaya_ru(o.get('pochemu'), 60)
        self.golos(('Поправка, %s: %s' % (pochemu.rstrip('. '), nado)) if pochemu else 'Лучше так: %s' % nado, 'sufler')
        self.zhurnal({'vid': 'recast', 'bylo': tekst, 'nado': nado, 'pochemu': pochemu})
        self.slovar_zapisat(nado, pochemu, 'recast', dano=1)
        log('поправка: %s → %s' % (tekst[:50], nado))

    # ---------- 1.1: разминка и разговорник ----------
    def razgovornik(self):
        return chitat(os.path.join(PAPKA, 'razgovornik.json'), []) or []

    def razminka(self):
        """«Плюс, разминка» (до эфира или в паузе): три фразы — поправка прошлого эфира и его типичные мысли
        из разговорника, которые он ещё не говорит сам: смысл по-русски, потом английская."""
        s = self.slovar()
        nabor = []
        for v in reversed(self.vechera(3)):
            p = v.get('popravka')
            if isinstance(p, dict) and p.get('nado'):
                nabor.append(('поправка: не «%s»' % p.get('bylo', ''), p['nado']))
                break
        for z in sorted(self.razgovornik(), key=lambda z: (s.get(klyuch(z.get('en', '')), {}).get('skazal', 0),
                                                          s.get(klyuch(z.get('en', '')), {}).get('dano', 0))):
            if len(nabor) >= 3:
                break
            nabor.append((z.get('ru', ''), z.get('en', '')))
        for z in [x for x in self.zhurnal_chitat(time.time() - 7 * 86400) if x.get('vid') == 'recast'][::-1]:
            if len(nabor) >= 3:
                break
            if z.get('nado') and z['nado'] not in [n[1] for n in nabor]:
                nabor.append(('поправка: %s' % z.get('pochemu', ''), z['nado']))
        if not nabor:
            self.golos('Для разминки пока нет твоих фраз: появятся после первого эфира с суфлёром.', 'sufler')
            return []
        self.golos('Разминка, %d %s. Повторяй за мной.' % (len(nabor), forma(len(nabor), 'фраза', 'фразы', 'фраз')), 'sufler')
        for ru, en in nabor:
            self.golos('%s. %s' % (ru.rstrip('. '), en), 'sufler')
            self.slovar_zapisat(en, ru[:80], 'razminka', dano=1)
        self.zhurnal({'vid': 'razminka', 'frazy': [en for _, en in nabor]})
        return nabor

    def razgovornik_popolnit(self):
        """После эфира: его типичные русские фразы → английские в его стиле (разговорник растёт от эфира к эфиру)."""
        if len(self.ru_efir) < 5:
            return 0
        est = self.razgovornik()
        o = self.groq(ZADANIE_RAZGOVORNIK, json.dumps({'lines': self.ru_efir[-120:], 'uzhe_est': [z.get('ru') for z in est][-60:]},
                                                      ensure_ascii=False), 0.4, 600) or {}
        novye = []
        for z in (o.get('frazy') or [])[:6]:
            if isinstance(z, dict) and chistaya_en(z.get('en'), 100) and chistaya_ru(z.get('ru'), 120):
                novye.append({'ru': chistaya_ru(z['ru'], 120), 'en': chistaya_en(z['en'], 100), 't': round(time.time())})
        if novye:
            zapisat(os.path.join(PAPKA, 'razgovornik.json'), (est + novye)[-100:])
        return len(novye)

    # ---------- итог эфира ----------
    def schet(self, ot, do=None):
        do = do or time.time() + 1
        zz = [z for z in self.zhurnal_chitat(ot) if z.get('t', 0) <= do]
        skazal = [z for z in zz if z.get('vid') == 'skazal']
        return {
            'fraz': len(skazal),
            'slov': sum(len(slova(z.get('en', ''))) for z in skazal),
            'podskazok': sum(1 for z in zz if z.get('vid') == 'podskazka'),
            'povtoril': sum(1 for z in skazal if z.get('itog') == 'povtoril'),
            'svoimi': sum(1 for z in skazal if z.get('itog') == 'svoimi'),
            'sam': sum(1 for z in skazal if not z.get('itog')),
            'ved_perevodov': sum(1 for z in zz if z.get('vid') == 'otvet_ved'),
            'ved_otvetil': sum(1 for z in skazal if z.get('na') == 'otvet_ved'),
            'prosil': sum(1 for z in zz if z.get('vid') == 'zapros'),
            'popravok': sum(1 for z in zz if z.get('vid') == 'recast'),
        }, [z.get('en', '') for z in skazal]

    def itog(self, ot, do):
        sc, frazy = self.schet(ot, do)
        popolnil = self.razgovornik_popolnit()          # его русские мысли за эфир → разговорник (даже без английского)
        self.ru_efir = []
        if not sc['fraz'] and not sc['podskazok'] and not sc['prosil']:
            return None
        analiz = {}
        if frazy:
            analiz = self.groq(ZADANIE_ITOG, json.dumps({'lines': [f[:200] for f in frazy[-40:]]}, ensure_ascii=False),
                               0.3, 500) or {}
        proshlye = self.vechera(1)
        z = dict(sc, t=round(time.time()), data=time.strftime('%Y-%m-%d'), minut=round((do - ot) / 60 / SEK),
                 luchshaya=chistaya_en(analiz.get('luchshaya'), 200), sovet=chistaya_ru(analiz.get('sovet'), 120),
                 novye=[chistaya_en(x, 100) for x in (analiz.get('novye') or [])[:5] if chistaya_en(x, 100)])
        p = analiz.get('popravka')
        if isinstance(p, dict) and chistaya_en(p.get('bylo'), 160) and chistaya_en(p.get('nado'), 160):
            z['popravka'] = {'bylo': chistaya_en(p['bylo'], 160), 'nado': chistaya_en(p['nado'], 160),
                             'pochemu': chistaya_ru(p.get('pochemu'), 100)}
        z['popolnil_razgovornik'] = popolnil
        dopisat(os.path.join(PAPKA, 'vechera.jsonl'), z)
        rech = 'Английский за эфир: %d %s по-английски' % (sc['fraz'], forma(sc['fraz'], 'фраза', 'фразы', 'фраз'))
        if proshlye:
            rech += ' (прошлый раз %d)' % proshlye[-1].get('fraz', 0)
        rech += '. Подсказок %d: повторил %d, своими словами %d.' % (sc['podskazok'], sc['povtoril'], sc['svoimi'])
        if sc['ved_perevodov']:
            rech += ' Соведущей ответил %d из %d.' % (sc['ved_otvetil'], sc['ved_perevodov'])
        if sc['prosil'] or sc['popravok']:
            rech += ' Просил перевод %d, поправок %d.' % (sc['prosil'], sc['popravok'])
        if z.get('luchshaya'):
            rech += ' Лучшая фраза: %s.' % z['luchshaya'].rstrip('.!?')
        if z.get('popravka'):
            rech += ' Поправка: не %s, а %s.' % (z['popravka']['bylo'].rstrip('.!?'), z['popravka']['nado'].rstrip('.!?'))
        if z.get('sovet'):
            rech += ' Совет: %s' % z['sovet']
        self.golos(rech, 'uho')
        log('итог английского:', rech)
        return z

    def vechera(self, n=10):
        res = []
        try:
            for l in open(os.path.join(PAPKA, 'vechera.jsonl'), errors='replace'):
                try:
                    res.append(json.loads(l))
                except ValueError:
                    pass
        except OSError:
            pass
        return res[-n:]

    # ---------- цикл ----------
    def tik(self, now=None):
        now = now or time.time()
        self.efir_proverka(now)
        self.sinhron_chitat(now)
        self.rech_proverka(now)
        self.ved_chitat(now)
        self.zapros_chitat(now)
        self.zapros_proverka(now)                       # по его просьбе — и вне эфира (разминка до него)
        if not self.efir:
            return
        self.recast_proverka(now)
        self.klyuch_proverka(now)
        self.ved_proverka(now)
        self.podskazka_proverka(now)


def forma(n, f1, f2, f5):
    n = abs(n) % 100
    if 10 < n < 20:
        return f5
    return f1 if n % 10 == 1 else f2 if 2 <= n % 10 <= 4 else f5


def demon():
    z = open(LOCK, 'w')
    try:
        fcntl.flock(z, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0
    mt = os.path.getmtime(__file__)
    s = Sufler()
    log('суфлёр запущен')
    while True:
        try:
            s.tik()
        except Exception as e:
            log('сбой:', type(e).__name__, str(e)[:120])
        try:
            if os.path.getmtime(__file__) != mt and time.time() - os.path.getmtime(__file__) > 5:
                compile(open(__file__, encoding='utf-8').read(), __file__, 'exec')
                log('новая версия — перезапускаюсь')
                os.execv(sys.executable, [sys.executable, os.path.abspath(__file__)] + sys.argv[1:])
        except (OSError, SyntaxError, ValueError):
            pass
        time.sleep(1 * SEK)


def vkl_vykl(a):
    return {'vkl': True, 'on': True, 'da': True, 'vykl': False, 'off': False, 'net': False}.get(a)


