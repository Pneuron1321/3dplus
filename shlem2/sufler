def hvost(put, n, znakov=4000):
    try:
        with open(put, 'rb') as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - znakov * 3))
            return [l for l in f.read().decode('utf-8', 'replace').splitlines() if l.strip()][-n:]
    except OSError:
        return []


def slova_ru(t):
    return re.findall(r'[а-яё]+', (t or '').lower())


def slova(t):
    return re.findall(r"[a-z']+", (t or '').lower().replace('’', "'"))


def klyuch(t):
    return ' '.join(slova(t))


def shodstvo(podskazka, fraza):
    p, f = slova(podskazka), set(slova(fraza))
    if not p:
        return 0.0
    return sum(1 for w in p if w in f) / len(p)


KIRILL = re.compile('[А-Яа-яЁё]')
OPASNO = re.compile(r'https?://|www\.|@\w|\b\d{4,}\b|[<>{}\\]|\b(?:fuck|shit|bitch|nigg|fag|retard)', re.I)


def chistaya_en(t, mx=110):
    t = re.sub(r'\s+', ' ', str(t or '')).strip().strip('"«»“”')
    if not t or KIRILL.search(t) or OPASNO.search(t) or IMENA_EN.search(t) or len(t) > mx or len(slova(t)) < 2:
        return ''
    return t


def chistaya_ru(t, mx=200):
    t = re.sub(r'\s+', ' ', str(t or '')).strip().strip('"«»“”')
    if OPASNO.search(t):
        return ''
    return t[:mx]


def nastoyashchaya(tekst):
    """Его английская фраза — речь, а не выдумка Whisper: 3+ слов, из них хотя бы 2 не из MUSOR, не одно слово по кругу."""
    w = slova(tekst)
    return len(w) >= 3 and len([x for x in w if x not in MUSOR]) >= 2 and len(set(w)) >= 3


