#!/bin/sh
# efir — эфир на Twitch прямо из приложения Quest Claude Bridge 2, вместе с глазами
# Плюса (BeamXR и ретранслятор не нужны; Termux тоже — эфир переживёт его убийство).
# Ключ Twitch — из /root/.twitch-key (кладёт `kluch twitch`): передаётся приложению
# внутри шлема (localhost, телом запроса) и нигде не печатается.
#   efir          — начать: 1080p, 30 к/с, 6000 кбит/с
#   efir 720      — начать в 720p, 4500 кбит/с (если сеть не тянет)
#   efir stop     — закончить
#   efir status   — как идёт
#   efir mic 4    — голос в эфире громче/тише (0,5–8, обычно 3; приложение запомнит)
#   efir mic +25% — на слух на 25 % громче (−20% — тише): громкость на слух растёт медленнее
#                   силы звука — «на 25 % громче» это ×1,45 (+3 дБ), а не ×1,25 (2.3.2)
# С 12.10 (этап 2 плана эфира) логика — в plus-lib: одна на этот скрипт и на plus-mcp, через
# который Плюс зовёт efir без нового процесса на вызов.
L=${0%/*}/plus-lib; [ -f "$L" ] || L=/usr/local/bin/plus-lib
exec python3 -S "$L" efir "$@"
