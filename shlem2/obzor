#!/usr/bin/env python3
"""obzor — автопросмотр игры (приложение 2.2.7): раз в N минут кадр эфира смотрит Haiku и пишет,
что происходит, в /tmp/obzor.log — для соведущего и итогов вечера. Отдельный запуск
`claude -p --model haiku`: основная модель Плюса (Sonnet) не меняется, подтверждений не нужно —
у просмотра только чтение одного кадра, без хуков (голос молчит) и без CLAUDE.md; сессия не
сохраняется (plus --continue её не подхватит). Один взгляд — около 4 тысяч токенов Haiku.
Смотрит только пока идёт эфир. По умолчанию — раз в 8 минут (Александр 09.10); `obzor vykl` — выключить.
С 2.2.9 пишет и ход игры — выигрывает Александр или проигрывает (по кадру, прошлым наблюдениям и его
словам): соведущий не бросает вызов, когда не идёт. obnovi положил новую версию — демон сам
перезапускается ею.
  obzor                 — включён ли, как часто, последние наблюдения
  obzor kazhdye N       — раз в N минут (1–60), пока идёт эфир
  obzor vykl            — выключить
  obzor seychas         — посмотреть сейчас и сказать что видно
  obzor demon           — сам цикл (его запускают obzor kazhdye и plus)"""
import fcntl
import json
import os
import subprocess
import sys
import time
import urllib.request

MOST = os.environ.get('OBZOR_MOST', 'http://localhost:8766')
CONF = os.environ.get('OBZOR_CONF', '/root/.obzor-min')
LOG = os.environ.get('OBZOR_LOG', '/tmp/obzor.log')
DIR = os.environ.get('OBZOR_DIR', '/tmp/obzor')          # не папка Плюса: --continue её не видит
LOCK = os.environ.get('OBZOR_LOCK', '/tmp/obzor.lock')
ISTORIYA = os.environ.get('OBZOR_ISTORIYA', '/tmp/titr-istoriya.log')   # слова Александра (субтитры)
CLAUDE = os.environ.get('OBZOR_CLAUDE', 'claude')
MODEL = os.environ.get('OBZOR_MODEL', 'haiku')
SEK_V_MIN = float(os.environ.get('OBZOR_SEK_V_MIN', 60))  # в проверке — быстрее
PO_UMOLCHANIYU = 8                                          # минут, пока Александр не задал другое
HODY = ('выигрывает', 'проигрывает', 'ровно')
ZADANIE = (
    'Ты смотришь кадр VR-игры, которую стримит Александр (шлем Quest 3), — для его соведущего '
    'Плюса. Прочитай файл кадра инструментом Read. Ответь ОДНОЙ строкой: ИНТЕРЕС|БОЙ|ХОД|ЧТО. '
    'ИНТЕРЕС — 0..3 (0 — меню, загрузка, ничего не происходит; 3 — яркий момент). БОЙ — да или '
    'нет (идёт бой или напряжённый момент — соведущему лучше молчать). ХОД — как идут дела у '
    'Александра: выигрывает (счёт в его пользу, победа в раунде, серия), проигрывает (экран '
    'смерти, наблюдение после гибели, счёт против, поражение, сам говорит, что не выходит), ровно, '
    'или — (не видно; не угадывай). ЧТО — одно-два коротких '
    'предложения по-русски: какая игра, где игрок, что делает, что изменилось с прошлого раза. '
    'Текст консоли, коды, ключи и адреса с кадра не переписывай. Без вступлений.')


def log(*a):
    print(time.strftime('%H:%M:%S'), 'obzor:', *a, file=sys.stderr, flush=True)


def get(path, timeout=5):
    with urllib.request.urlopen(MOST + path, timeout=timeout) as r:
        return r.read()


def efir_idyot():
    try:
        return json.loads(get('/efir').decode()).get('state') == 'efir'
    except Exception:
        return False


def kazhdye():
    """Раз в сколько минут смотреть: файла нет — по умолчанию (Александр 09.10: раз в 8 минут)."""
    try:
        return max(0, min(60, int(open(CONF).read().strip())))
    except OSError:
        return PO_UMOLCHANIYU
    except ValueError:
        return 0


def slova_aleksandra(n=3):
    """Последние слова Александра из субтитров («не могу победить» — тоже ход игры)."""
    try:
        stroki = open(ISTORIYA, errors='replace').read().splitlines()[-12:]
    except OSError:
        return []
    return [l.split(' | ')[1].strip() for l in stroki if ' Александр | ' in l][-n:]


def proshloe(n=2):
    try:
        return [l.split(' | ', 1)[1].strip() for l in open(LOG).read().splitlines()[-n:] if ' | ' in l]
    except OSError:
        return []


def vzglyad():
    """Один взгляд: кадр → Haiku → строка в журнал. Возвращает (интерес, бой, что) или None."""
    os.makedirs(DIR, exist_ok=True)
    kadr = os.path.join(DIR, 'kadr.jpg')
    try:
        jpg = get('/frame.jpg?size=big', timeout=8)
        if len(jpg) < 1000:
            raise ValueError('пустой кадр')
        open(kadr, 'wb').write(jpg)
    except Exception as e:
        log('кадра нет:', type(e).__name__, str(e)[:60])
        return None
    raz = proshloe()
    zapros = 'Кадр: %s' % kadr + ('\nРаньше: ' + ' / '.join(raz) if raz else '')
    slova = slova_aleksandra()
    if slova:
        zapros += '\nАлександр недавно говорил: ' + ' / '.join(slova)
    env = dict(os.environ, CLAUDE_CODE_DISABLE_CLAUDE_MDS='1', CLAUDE_CODE_DISABLE_AUTO_MEMORY='1',
               GOLOS_RACIYA='1')                            # голос-хук молчит, даже если хуки не выключились
    cmd = [CLAUDE, '-p', '--model', MODEL, '--tools', 'Read', '--allowedTools', 'Read',
           '--no-session-persistence', '--settings', '{"disableAllHooks":true}',
           '--output-format', 'json', '--system-prompt', ZADANIE, zapros]
    try:
        r = subprocess.run(cmd, cwd=DIR, env=env, capture_output=True, text=True, timeout=150)
        otvet = json.loads(r.stdout).get('result', '') if r.stdout.strip() else ''
    except Exception as e:
        log('Haiku не ответил:', type(e).__name__, str(e)[:80])
        return None
    if not otvet:
        log('Haiku: пусто, код', r.returncode, r.stderr.strip()[-200:])
        return None
    chasti = [c.strip() for c in otvet.strip().splitlines()[0].split('|', 3)]
    hod = ''
    if len(chasti) == 4:
        interes, boy, hod, chto = chasti
    elif len(chasti) == 3:                                  # старый ответ, без хода
        interes, boy, chto = chasti
    else:
        interes, boy, chto = '1', 'нет', otvet.strip().splitlines()[0]
    interes = interes if interes in ('0', '1', '2', '3') else '1'
    boy = 'да' if boy.lower().startswith('да') else 'нет'
    hod = next((h for h in HODY if hod.lower().startswith(h)), '')
    chto = ' '.join(chto.split())[:300]
    try:
        with open(LOG, 'a') as f:
            f.write('%s %s%s%s | %s\n' % (time.strftime('%H:%M'), interes, ' бой' if boy == 'да' else '',
                                          ' ' + hod if hod else '', chto))
    except OSError:
        pass
    return interes, boy, chto, hod


def demon():
    z = open(LOCK, 'w')
    try:
        fcntl.flock(z, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0                                             # уже смотрит другой
    log('запущен')
    mt = os.path.getmtime(__file__)
    sled = 0.0
    while True:
        obnovilsya(mt)
        n = kazhdye()
        if n <= 0:
            log('выключен — выхожу')
            return 0
        if time.time() >= sled and efir_idyot():
            vzglyad()
            sled = time.time() + n * SEK_V_MIN
        time.sleep(min(30.0, max(0.2, SEK_V_MIN / 2)))


def obnovilsya(mt):
    """obnovi положил новую версию — перезапуститься ею (замок отпускается сам: exec закрывает файл).
    Битый или недописанный файл не берём — работаем старой версией."""
    try:
        if os.path.getmtime(__file__) == mt or time.time() - os.path.getmtime(__file__) < 5:
            return
        compile(open(__file__, encoding='utf-8').read(), __file__, 'exec')
    except (OSError, SyntaxError, ValueError):
        return
    log('новая версия — перезапускаюсь')
    os.execv(sys.executable, [sys.executable, os.path.abspath(__file__)] + sys.argv[1:])


def zapustit_demon():
    subprocess.Popen([sys.executable, os.path.abspath(sys.argv[0]), 'demon'],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=open(os.environ.get('OBZOR_DEMON_LOG', '/tmp/obzor-demon.log'), 'a'),
                     start_new_session=True)


def main(a):
    if a and a[0] == 'demon':
        return demon()
    if a and a[0] == 'kazhdye' and len(a) == 2 and a[1].isdigit() and 1 <= int(a[1]) <= 60:
        open(CONF, 'w').write(a[1])
        zapustit_demon()
        print('Автопросмотр: раз в %s мин, пока идёт эфир (Haiku; основная модель — та же).' % a[1])
        return 0
    if a and a[0] == 'vykl':
        open(CONF, 'w').write('0')
        print('Автопросмотр выключен.')
        return 0
    if a and a[0] == 'seychas':
        v = vzglyad()
        print('Не вышло посмотреть (кадра нет или Haiku не ответил — /tmp/obzor-demon.log).' if v is None
              else 'Вижу: %s (интерес %s%s%s).' % (v[2], v[0], ', идёт бой' if v[1] == 'да' else '',
                                                  ', ' + v[3] if v[3] else ''))
        return 0 if v else 1
    if a and a[0] not in ('status', 's'):
        print(__doc__.split('\n', 6)[6])
        return 1
    n = kazhdye()
    print('Автопросмотр: ' + ('раз в %d мин, пока идёт эфир.' % n if n else 'выключен (obzor kazhdye N — включить).'))
    try:
        hvost = open(LOG).read().splitlines()[-3:]
    except OSError:
        hvost = []
    for l in hvost:
        print('  ' + l)
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
