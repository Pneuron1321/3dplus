class Fraza:
    def __init__(self, golos, wav, tihih, db, prishla, nachalo=None):
        self.golos, self.wav, self.tihih, self.db, self.prishla = golos, wav, tihih, db, prishla
        self.nachalo = nachalo if nachalo else prishla - self.sek - 0.6     # приложение не сказало — по приходу

    @property
    def sek(self):
        return max(0.0, (len(self.wav) - 44) / 32000.0)


def skleit(frazy):
    """Фразы одного голоса подряд — один WAV (между ними 0,25 с тишины)."""
    pcm = b''
    for i, f in enumerate(frazy):
        if i:
            pcm += b'\0' * 8000
        pcm += f.wav[44:]
    zag = bytearray(frazy[0].wav[:44])
    zag[4:8] = (36 + len(pcm)).to_bytes(4, 'little')
    zag[40:44] = len(pcm).to_bytes(4, 'little')
    return Fraza(frazy[0].golos, bytes(zag) + pcm, max(f.tihih for f in frazy), max(f.db for f in frazy),
                 frazy[0].prishla)


class Sinhron:
    def __init__(self):
        self.lock = threading.Condition()
        self.ochered = []
        self.perevod = []                     # (golos, tekst, yazyk, kogda)
        self.korzina = 3.0
        self.korzinaT = time.time()
        self.zvuk = None                      # корзина секунд звука (None — полная при первом запросе)
        self.igra_korzina = 1.0               # игре — свои корзины: треть темпа
        self.igra_zvuk = None
        self.igra_pusto = 0                   # пустых ответов по игре подряд
        self.igra_shag = 0                    # какая по счёту пауза
        self.igra_pauza_do = 0.0
        self.skazano = set()                  # о чём уже сказано в ухо
        self.pauza_do = 0.0                   # 429 — ждать до
        self.ostalos_den = None               # запросов Whisper на сегодня (из ответа Groq)
        self.ostalos_perevod = None
        self.perevod_model = 0
        self.mertvye = set()      # модели перевода, ответившие 404
        self.prompt = {}                      # прошлая фраза голоса — подсказка Whisper
        self.yaz = {}                         # язык прошлой фразы голоса — письмо имён в подсказке
        self.poslednee = {}                   # (golos) → (текст, когда) — не повторять одно и то же
        self.schet = {'fraz': 0, 'zaprosov': 0, 'subtitrov': 0, 'muzyka': 0, 'vydumki': 0, 'tishina': 0,
                      'starye': 0, 'skleeno': 0, 'perevodov': 0, 'oshibok': 0, 'shum': 0}
        self.oshibka = ''
        self.zhiv_most = False
        self.staroe = False                   # приложение без /titry/rech (старше 2.5.0)
        # черновик → чистовик
        self.id_da = None                     # мост понимает реплики (/titr ответил "id":true) — None: ещё не знаю
        self.repliki = {}                     # голос → открытая реплика
        self.repl_po_id = {}                  # id → реплика (и закрытые — пока живут)
        self.n_repl = 0
        self.chist_korzina = 2.0
        self.chist_zvuk = 120.0
        self.chistT = time.time()
        self.chist_pauza_do = 0.0
        self.ostalos_polnaya = None
        for k in ('chistovikov', 'chist_propusk', 'chist_zakrepleno'):
            self.schet[k] = 0

    # ---------- приём фраз ----------

    def priyom(self):
        while True:
            try:
                u = urllib.parse.urlsplit(MOST)
                c = http.client.HTTPConnection(u.hostname, u.port or 80, timeout=30)
                c.request('GET', '/titry/rech?zhdat=%g' % (20 * SEK))
                r = c.getresponse()
                telo = r.read()
                self.zhiv_most = True
                self.staroe = r.status == 404
                if r.status == 200 and telo[:4] == b'RIFF':
                    f = Fraza(r.getheader('X-Golos', ''), telo, float(r.getheader('X-Tihih', '0.5')),
                              float(r.getheader('X-Db', '-30')), time.time(),
                              float(r.getheader('X-Nachalo') or 0) / 1000.0)
                    with self.lock:
                        self.ochered.append(f)
                        self.schet['fraz'] += 1
                        self.lock.notify_all()
                c.close()
                if r.status not in (200, 204):        # приложение старше 2.5.0 (404) или сбой — не долбить шлем
                    time.sleep(10 * SEK)
            except Exception:
                self.zhiv_most = False
                time.sleep(3 * SEK)

    # ---------- очередь и бюджет ----------

    def vzyat(self):
        """Следующая фраза для Whisper (или склейка); ждёт; None — ничего."""
        with self.lock:
            while True:
                now = time.time()
                self.ochered = [f for f in self.ochered if self._svezhaya(f, now)]
                malo = self.ostalos_den is not None and self.ostalos_den < 200
                ochen_malo = self.ostalos_den is not None and self.ostalos_den < 60
                shum = now < self.igra_pauza_do
                for f in list(self.ochered):
                    if f.golos == 'igra' and (f.tihih < POROG_TIHIH or malo or shum):
                        self.ochered.remove(f)
                        self.schet['muzyka' if f.tihih < POROG_TIHIH else 'shum' if shum else 'starye'] += 1
                if self.ochered and now >= self.pauza_do:
                    self._dolit(now)
                    kandidaty = [f for f in self.ochered if f.golos != 'igra' or self.igra_korzina >= 1]
                    if kandidaty and self.korzina >= 1:
                        self.korzina -= 1
                        perv = min(kandidaty, key=lambda f: (f.golos == 'igra', f.prishla))
                        igra = perv.golos == 'igra'
                        odin = [f for f in self.ochered if f.golos == perv.golos]
                        # копится (бюджет тесный) — склеить фразы этого голоса, сколько влезет
                        vmeste = [perv]
                        if len(self.ochered) > 1 or ochen_malo:
                            for f in odin[1:]:
                                if sum(x.sek for x in vmeste) + f.sek <= SKLEIT_MAKS:
                                    vmeste.append(f)
                        cena = max(MIN_SEK, sum(x.sek for x in vmeste))
                        if self.zvuk is not None and self.zvuk < cena:     # секунд звука нет — копим
                            self.korzina += 1
                            self.lock.wait(min(2.0, (cena - self.zvuk) * 3600 / max(ash(), 1)) * SEK)
                            continue
                        if igra and self.igra_zvuk is not None and self.igra_zvuk < cena:   # треть секунд игры — кончилась
                            self.korzina += 1
                            self.lock.wait(min(2.0, (cena - self.igra_zvuk) * 3600 / max(ash() * IGRA_DOLYA, 1)) * SEK)
                            continue
                        if self.zvuk is not None:
                            self.zvuk -= cena
                        if igra:
                            self.igra_korzina -= 1
                            if self.igra_zvuk is not None:
                                self.igra_zvuk -= cena
                        for f in vmeste:
                            self.ochered.remove(f)
                        if len(vmeste) > 1:
                            self.schet['skleeno'] += len(vmeste) - 1
                            return skleit(vmeste)
                        return perv
                zhdat = 0.5 if self.ochered else 5.0
                if self.ochered and now < self.pauza_do:
                    zhdat = min(zhdat, self.pauza_do - now)
                self.lock.wait(zhdat * SEK)

    def _svezhaya(self, f, now):
        if now - f.prishla > (STAROE_IGRA if f.golos == 'igra' else STAROE) * max(SEK, 0.05):
            self.schet['starye'] += 1
            return False
        return True

    def _dolit(self, now):
        dt = (now - self.korzinaT) / max(SEK, 0.001)
        self.korzina = min(3.0, self.korzina + dt * rpm() / 60.0)
        self.igra_korzina = min(1.0, self.igra_korzina + dt * rpm() / 60.0 * IGRA_DOLYA)
        a = ash()
        if not a:
            self.zvuk = self.igra_zvuk = None     # платный уровень — секунды не считаем
        else:
            vmest = min(60.0, max(MIN_SEK, a / 60.0))          # запас — минута звука, не меньше одного запроса
            self.zvuk = vmest if self.zvuk is None else min(vmest, self.zvuk + dt * a / 3600.0)
            vi = max(MIN_SEK, vmest * IGRA_DOLYA)
            self.igra_zvuk = vi if self.igra_zvuk is None else min(vi, self.igra_zvuk + dt * a * IGRA_DOLYA / 3600.0)
        self.korzinaT = now

    # ---------- Whisper ----------

    def slushat(self):
        while True:
            f = self.vzyat()
            if f is None:
                continue
            try:
                self.raspoznat(f)
            except Exception as e:
                self.schet['oshibok'] += 1
                self.oshibka = '%s %s' % (type(e).__name__, str(e)[:80])
                log('whisper:', self.oshibka)

    def raspoznat(self, f):
        key = klyuch()
        if not key:
            self.oshibka = 'нет ключа Groq (! kluch)'
            time.sleep(10 * SEK)
            return
        porog = 0.4 if f.golos == 'igra' else 0.6
        pod = self.podskazka(f.golos)
        d, zag = self.whisper(f, key, pod=pod)
        self.schet['zaprosov'] += 1
        yazyk = LANGS.get((d.get('language') or '').lower(), (d.get('language') or '')[:2].lower())
        igra = f.golos == 'igra'
        tekst = self.otbor(d, porog, pod, igra, f.golos == 'ya')
        if tekst and igra and yazyk not in IGRA_YAZYKI:
            self.schet['vydumki'] += 1
            log('игра не на ru/uk/en (%s): %s' % (yazyk, tekst[:60]))
            tekst = ''
        if igra:
            self._igra_itog(bool(tekst))
        if not tekst:
            return
        nado = None
        if f.golos == 'ya' and yazyk not in ('ru', 'uk', 'en'):     # как у слуха: Александр — по-русски
            nado = 'ru'
        elif yazyk in ('ru', 'uk', 'en') and pismo(tekst) not in (None, 'lat' if yazyk == 'en' else 'kir'):
            nado = yazyk          # услышал английский, а написал по-русски (или наоборот) — ещё раз, с языком
        if nado:
            pod = self.podskazka(f.golos, nado)
            d2, _ = self.whisper(f, key, nado, pod)
            self.schet['zaprosov'] += 1
            tekst = self.otbor(d2, porog, pod, igra, f.golos == 'ya')
            yazyk = nado
            if not tekst:
                return
        p = pismo(tekst)                      # перевод — по тому, чем написано: два русских ряда не показывать
        if p == 'kir' and yazyk == 'en':
            yazyk = 'ru'
        elif p == 'lat' and yazyk in ('ru', 'uk'):
            yazyk = 'en'
        pr = self.poslednee.get(f.golos)
        if pr and pr[0] == tekst and time.time() - pr[1] < 6:
            return
        self.poslednee[f.golos] = (tekst, time.time())
        self.prompt[f.golos] = tekst[-200:]
        self.yaz[f.golos] = yazyk
        with self.lock:
            meta = self._v_repliku(f, tekst, yazyk)
            self.perevod.append((f.golos, tekst, yazyk, time.time(), meta))
            self.lock.notify_all()

    # ---------- черновик → чистовик ----------

    def _v_repliku(self, f, tekst, yazyk):
        """Кусок — в открытую реплику голоса (или новую). Под self.lock. → (id, номер куска) или None."""
        if self.id_da is False:
            return None
        r = self.repliki.get(f.golos)
        konec_kuska = f.nachalo + f.sek
        if (r is None or r['zakryta'] or f.nachalo - r['konec'] > REPLIKA_PAUZA * SEK
                or r['sek'] + f.sek > SKLEIT_MAKS or len(' '.join(r['teksty'])) + len(tekst) > 150
                or self.id_da is None and r['teksty']):           # пока не знаю, понимает ли мост, — по строке на кусок
            self.n_repl += 1
            r = {'id': 'r%d-%d' % (os.getpid() % 10000, self.n_repl), 'golos': f.golos, 'frazy': [], 'teksty': [],
                 'perevody': [], 'yazyk': yazyk, 'sek': 0.0, 'konec': konec_kuska, 'prishla': f.prishla,
                 'zakryta': False, 'rodilas': time.time()}
            self.repliki[f.golos] = r
            self.repl_po_id[r['id']] = r
            for rid in [k for k, v in self.repl_po_id.items() if time.time() - v['rodilas'] > REPLIKA_ZHIVET * SEK * 2]:
                del self.repl_po_id[rid]
        r['frazy'].append(f)
        r['teksty'].append(tekst)
        r['perevody'].append(None)
        r['sek'] += f.sek
        r['konec'] = max(r['konec'], konec_kuska)
        r['prishla'] = f.prishla
        r['yazyk'] = yazyk
        return (r['id'], len(r['teksty']) - 1)

    def chistovik(self):
        """Тишина после реплики — вся реплика полной моделью одним запросом; строка заменяется чистовиком."""
        while True:
            time.sleep(0.25 * SEK)
            r = None
            with self.lock:
                now = time.time()
                for g, x in list(self.repliki.items()):
                    if x['zakryta'] or now - x['prishla'] < REPLIKA_KONEC * SEK:
                        continue
                    if any(f.golos == g for f in self.ochered):              # голос ещё говорит — ждём
                        continue
                    if any(m and m[0] == x['id'] for *_, m in self.perevod):   # черновик ещё не показан
                        continue
                    x['zakryta'] = True
                    del self.repliki[g]
                    log('реплика %s закрыта: кусков %d, %.1f с' % (x['id'], len(x['frazy']), x['sek']))
                    if self.id_da and g in CHIST_GOLOSA and now - x['rodilas'] < REPLIKA_ZHIVET * SEK:
                        r = x
                        break
            if r is None:
                continue
            try:
                self.chistovik_odin(r)
            except Exception as e:
                self.schet['oshibok'] += 1
                self.oshibka = 'чистовик: %s %s' % (type(e).__name__, str(e)[:60])
                log(self.oshibka)

    def _chist_byudzhet(self, cena):
        now = time.time()
        dt = (now - self.chistT) / max(SEK, 0.001)
        self.chistT = now
        self.chist_korzina = min(2.0, self.chist_korzina + dt * CHIST_RPM / 60.0)
        self.chist_zvuk = min(120.0, self.chist_zvuk + dt * CHIST_ASH / 3600.0)
        if now < self.chist_pauza_do or self.chist_korzina < 1 or self.chist_zvuk < cena:
            return False
        if self.ostalos_polnaya is not None and self.ostalos_polnaya < CHIST_DEN_MIN:
            return False
        self.chist_korzina -= 1
        self.chist_zvuk -= cena
        return True

    def chistovik_odin(self, r):
        if model() == MODEL_POLNAYA and len(r['frazy']) < 2:
            return                                  # платный уровень: черновик уже полной моделью
        key = klyuch()
        if not key:
            return
        f = skleit(r['frazy']) if len(r['frazy']) > 1 else r['frazy'][0]
        log('чистовик %s: %d кусков' % (r['id'], len(r['frazy'])))
        if not self._chist_byudzhet(max(MIN_SEK, f.sek)):
            self.schet['chist_propusk'] += 1
            return
        golos, ya = r['golos'], r['golos'] == 'ya'
        yazyk = r['yazyk'] if r['yazyk'] in ('ru', 'uk', 'en') else ('ru' if ya else None)
        pod = self.podskazka(golos, yazyk)
        d, _ = self.whisper(f, key, yazyk, pod, mdl=MODEL_POLNAYA)
        self.schet['zaprosov'] += 1
        tekst = self.otbor(d, 0.6, pod, False, ya)
        chern = ' '.join(r['teksty'])
        if not tekst or tekst == chern:
            return
        self.prompt[golos] = tekst[-200:]
        self.schet['chistovikov'] += 1
        with self.lock:
            self.perevod.append((golos, tekst, yazyk or r['yazyk'], time.time(), (r['id'], -1)))
            self.lock.notify_all()

    def _igra_itog(self, est_rech):
        """Речь в игре — пауз нет; пустых ответов подряд IGRA_PUSTYH — игру пропускаем, паузы растут."""
        if est_rech:
            self.igra_pusto = self.igra_shag = 0
            return
        self.igra_pusto += 1
        if self.igra_pusto >= IGRA_PUSTYH:
            pauza = min(IGRA_PAUZA_MAKS, IGRA_PAUZA * 2 ** self.igra_shag)
            self.igra_pauza_do = time.time() + pauza * SEK
            self.igra_shag += 1
            self.igra_pusto = 0
            log('игра: %d пустых подряд — пропускаю %g с' % (IGRA_PUSTYH, pauza))

    def podskazka(self, golos, yazyk=None):
        """Игре — пусто; остальным — имена письмом языка (заданного или прошлой фразы) и прошлая фраза,
        если она тем же письмом."""
        if golos == 'igra':
            return ''
        en = (yazyk or self.yaz.get(golos)) == 'en'
        pr = self.prompt.get(golos, '')
        if pismo(pr) != ('lat' if en else 'kir'):
            pr = ''
        return ((NAMES_EN if en else NAMES) + pr)[-220:]

    def otbor(self, d, porog, podskazka='', igra=False, ya=False):
        """Текст без выдумок и тишины — по каждому куску Whisper отдельно: в склейке одна пустая фраза
        не должна съесть остальные. Пусто — нечего показывать (счётчики — почему)."""
        segs = d.get('segments')
        if not segs:
            segs = [{'text': d.get('text') or '', 'no_speech_prob': 0, 'avg_logprob': 0, 'compression_ratio': 1}]
        ostalos = []
        for sg in segs:
            t = (sg.get('text') or '').strip()
            nsp = sg.get('no_speech_prob', 0) or 0
            lp = sg.get('avg_logprob', 0) or 0
            cr = sg.get('compression_ratio', 1) or 1
            if len(t) < 2:
                continue
            if ya and KOMANDA_RE.search(t):               # слова вызова — вон, сам разговор с Плюсом — в кадр
                self.schet['komandy'] = self.schet.get('komandy', 0) + 1
                t = re.sub(r'\s{2,}', ' ', KOMANDA_RE.sub(' ', t)).strip(' ,.!-—')
                if len(slova(t)) < 1:
                    continue
            if (GALLYU.search(t) or (KOROTKIE.match(t) and nsp > 0.3) or cr > 2.4 or ekho(t, podskazka)
                    or podpis_zvuka(t) or igra and (len(set(slova(t))) <= 1 or GALLYU_IGRA.search(t))):
                self.schet['vydumki'] += 1
                log('выдумка', t[:60])
                continue
            if (nsp > porog and lp < -0.6) or lp < -1.2:
                self.schet['tishina'] += 1
                continue
            t = OSKORB.sub(lambda m: m.group(0)[0] + '*' * (len(m.group(0)) - 1), t)
            ostalos.append(t)
        return ' '.join(ostalos).strip()

    def whisper(self, f, key, yazyk=None, pod='', mdl=None):
        b = uuid.uuid4().hex
        chist = mdl is not None                 # чистовик: свои лимиты, своя пауза — черновики не ждут
        polya = {'model': mdl or model(), 'response_format': 'verbose_json', 'temperature': '0'}
        if pod:
            polya['prompt'] = pod
        if yazyk:
            polya['language'] = yazyk
        telo = b''.join(('--%s\r\nContent-Disposition: form-data; name="%s"\r\n\r\n%s\r\n' % (b, k, v)).encode()
                        for k, v in polya.items())
        telo += ('--%s\r\nContent-Disposition: form-data; name="file"; filename="fraza.wav"\r\n'
                 'Content-Type: audio/wav\r\n\r\n' % b).encode() + f.wav + ('\r\n--%s--\r\n' % b).encode()
        req = urllib.request.Request(GROQ + '/audio/transcriptions', data=telo, headers={
            'Authorization': 'Bearer ' + key, 'User-Agent': 'plus-sinhron',
            'Content-Type': 'multipart/form-data; boundary=' + b})
        try:
            with urllib.request.urlopen(req, timeout=12) as r:
                self._limity(r.headers, 'polnaya' if chist else 'whisper')
                return json.loads(r.read().decode('utf-8')), r.headers
        except urllib.error.HTTPError as e:
            self._limity(e.headers, 'polnaya' if chist else 'whisper')
            if e.code == 429 and chist:
                self.chist_pauza_do = time.time() + max(60.0, self._pauza(e.headers)) * SEK
                log('чистовик: лимит полной модели (429) — пауза')
            elif e.code == 429:
                pauza = self._pauza(e.headers)
                self.pauza_do = time.time() + pauza * SEK
                self.oshibka = 'Groq: лимит (429), жду %.0f с' % pauza
                log(self.oshibka)
            raise

    def _limity(self, h, chto):
        if h is None:
            return
        try:
            v = h.get('x-ratelimit-remaining-requests')
            if v is not None:
                if chto == 'polnaya':
                    self.ostalos_polnaya = int(float(v))
                elif chto == 'whisper':
                    self.ostalos_den = int(float(v))
                    if self.ostalos_den < 200 and 'malo' not in self.skazano:
                        self.skazano.add('malo')
                        v_uho('Субтитры: у Groq на сегодня осталось меньше двухсот запросов. Игру больше не '
                              'подписываю, только тебя и гостей.')
                else:
                    self.ostalos_perevod = int(float(v))
        except (TypeError, ValueError):
            pass

    @staticmethod
    def _pauza(h):
        try:
            return max(1.0, min(120.0, float(h.get('retry-after'))))
        except (TypeError, ValueError, AttributeError):
            return 20.0

    # ---------- перевод и показ ----------

    def perevodit(self):
        while True:
            with self.lock:
                while not self.perevod:
                    self.lock.wait(5 * SEK)
                pervaya = self.perevod[0][3]
                zhdat = ZHDAT_PEREVOD * SEK - (time.time() - pervaya)
                if zhdat > 0 and len(self.perevod) < 4:
                    self.lock.wait(zhdat)
                pachka, self.perevod = self.perevod, []
            try:
                perevody = self.perevesti(pachka)
            except Exception as e:
                self.schet['oshibok'] += 1
                self.oshibka = 'перевод: %s' % type(e).__name__
                perevody = [None] * len(pachka)
            for (golos, tekst, yazyk, _, meta), p in zip(pachka, perevody):
                if not meta:
                    self.pokazat(golos, tekst, p, yazyk)
                    continue
                rid, i = meta
                with self.lock:
                    r = self.repl_po_id.get(rid)
                    if r is not None and i >= 0:
                        r['perevody'][i] = p or ''
                        tekst = ' '.join(r['teksty'][:i + 1])            # черновик реплики — все куски до этого
                        p = ' '.join(x for x in r['perevody'][:i + 1] if x)
                self.pokazat(golos, tekst, p, yazyk, rid, tochno=i < 0)

    def perevesti(self, pachka):
        key = klyuch()
        if not key or not pachka:
            return [None] * len(pachka)
        stroki = ['%d. [to %s] %s' % (i + 1, 'Russian' if y == 'en' else 'English', t)
                  for i, (_, t, y, *_) in enumerate(pachka)]
        zadanie = ('You translate live-stream subtitles (a VR game stream with guests). Each user line is '
                   '"N. [to LANGUAGE] text". Translate every line into its target language: short, natural, '
                   'spoken style; keep names (Plus, Alexander, guest names), game terms and numbers; add '
                   'nothing. Alexander (the streamer) is male, Plus is female: keep Russian gender forms right. '
                   'Answer with exactly the same number of lines, each "N. translation".')
        poryadok = PEREVOD[self.perevod_model:] + PEREVOD[:self.perevod_model]
        for model in poryadok:
            model = model.strip()
            if model in self.mertvye:
                continue
            body = {'model': model, 'temperature': 0.2, 'max_completion_tokens': 120 + 90 * len(pachka),
                    'messages': [{'role': 'system', 'content': zadanie}, {'role': 'user', 'content': '\n'.join(stroki)}]}
            if 'gpt-oss' in model:
                body['reasoning_effort'] = 'low'
            req = urllib.request.Request(GROQ + '/chat/completions', data=json.dumps(body).encode(), headers={
                'Authorization': 'Bearer ' + key, 'Content-Type': 'application/json', 'User-Agent': 'plus-sinhron'})
            try:
                with urllib.request.urlopen(req, timeout=10) as r:
                    self._limity(r.headers, 'perevod')
                    if self.ostalos_perevod is not None and self.ostalos_perevod < 150 and model == PEREVOD[0].strip():
                        self.perevod_model = 1 % len(PEREVOD)            # бережём дневной лимит titr
                    d = json.loads(r.read().decode('utf-8'))
                t = (d['choices'][0]['message'].get('content') or '').strip()
            except urllib.error.HTTPError as e:
                log('перевод', model, 'HTTP', e.code)
                if e.code == 404:
                    self.mertvye.add(model)            # модели больше нет — не зовём до перезапуска
                continue
            except Exception as e:
                log('перевод', model, type(e).__name__)
                continue
            out = [None] * len(pachka)
            for line in t.splitlines():
                m = re.match(r'\s*(\d+)[.)]\s*(.+)', line)
                if m and 1 <= int(m.group(1)) <= len(pachka):
                    p = re.sub(r'^\[to \w+\]\s*', '', m.group(2).strip(), flags=re.I)   # 19.10: «[to English]» в кадре
                    p = p.strip('"«»“”').strip()
                    if p and len(p) <= 3 * len(pachka[int(m.group(1)) - 1][1]) + 40:     # не сочинение
                        out[int(m.group(1)) - 1] = p
            self.schet['perevodov'] += 1
            return out
        return [None] * len(pachka)

    def pokazat(self, golos, tekst, perevod, yazyk, rid=None, tochno=False):
        q = {'kto': golos, 't': tekst, 'ot': 's'}
        if rid:
            q['id'] = rid
        if tochno:
            q['tochno'] = '1'
        if perevod and pismo(perevod) not in (None, 'kir' if yazyk == 'en' else 'lat'):
            perevod = None                    # «перевод» тем же языком — второй ряд не нужен
        if perevod and perevod != tekst:
            q['t2'] = perevod
        try:
            otv = most('/titr?' + urllib.parse.urlencode(q, quote_via=urllib.parse.quote))
            self.schet['subtitrov'] += 1
            self.id_da = '"id":true' in otv                  # мост 2.6.8+ понимает реплики
            if '"zakreplena":true' in otv and not tochno:
                self.schet['chist_zakrepleno'] += 1           # чистовик уже поставили уши
        except Exception as e:
            self.oshibka = 'приложение: %s' % type(e).__name__
        try:
            with open(ISTORIYA, 'a') as f:
                f.write('%s %s %s%s | %s | %s\n' % (time.strftime('%H:%M:%S'), golos, yazyk, ' ЧИСТОВИК' if tochno else '',
                                                    tekst, perevod or ''))
        except OSError:
            pass

    # ---------- состояние ----------

    def sostoyanie(self):
        while True:
            try:
                d = dict(self.schet, rpm=rpm(), ash=ash(), zvuk=None if self.zvuk is None else round(self.zvuk),
                         ostalos_den=self.ostalos_den, ostalos_perevod=self.ostalos_perevod,
                         v_ocheredi=len(self.ochered), pauza=max(0, round(self.pauza_do - time.time())),
                         most=self.zhiv_most, staroe=self.staroe, oshibka=self.oshibka, model=model(),
                         igra_pauza=max(0, round((self.igra_pauza_do - time.time()) / max(SEK, 0.001))),
                         perevod=PEREVOD[self.perevod_model].strip(), ms=int(time.time() * 1000),
                         chistovik=self.id_da, ostalos_polnaya=self.ostalos_polnaya)
                tmp = SOST + '.novyy'
                with open(tmp, 'w') as f:
                    json.dump(d, f, ensure_ascii=False)
                os.replace(tmp, SOST)
            except Exception:
                pass
            time.sleep(3 * SEK)


def obnovilsya(mt):
    try:
        if os.path.getmtime(__file__) != mt:
            log('новая версия — перезапускаюсь')
            os.execv(sys.executable, [sys.executable, '-S', os.path.abspath(__file__)] + sys.argv[1:])
    except OSError:
        pass


def demon():
    z = open(LOCK, 'w')
    try:
        fcntl.flock(z, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0
    log('запущен')
    s = Sinhron()
    for f in (s.priyom, s.slushat, s.perevodit, s.sostoyanie, s.chistovik):
        threading.Thread(target=f, daemon=True).start()
    mt = os.path.getmtime(__file__)
    while True:
        obnovilsya(mt)
        time.sleep(10 * SEK)


def main(a):
    if a and a[0] == 'demon':
        return demon()
    if a and a[0] == 'rpm':
        try:
            n = max(1, min(600, int(a[1])))
        except (IndexError, ValueError):
            print('sinhron rpm ЧИСЛО — запросов к Whisper в минуту (бесплатный Groq — до 20).')
            return 1
        with open(RPM_F, 'w') as f:
            f.write(str(n))
        print('Whisper для субтитров — до %d запросов в минуту.' % n)
        return 0
    if a and a[0] in ('platnyy', 'besplatnyy'):
        p = a[0] == 'platnyy'
        with open(RPM_F, 'w') as f:
            f.write('120' if p else '18')
        with open(ASH_F, 'w') as f:
            f.write('0' if p else str(int(ASH)))
        print('Groq платный: Whisper до 120 запросов в минуту, секунды звука не считаю, модель полная (large-v3).' if p else
              'Groq бесплатный: Whisper до 18 запросов в минуту и 7000 секунд звука в час, модель turbo.')
        return 0
    if a and a[0] in ('igra', 'ya', 'gosti') and len(a) >= 2:
        if a[0] == 'gosti' and a[1] in ('u_plitki', 'vnizu'):
            q = 'gde=' + a[1]
        elif a[1] in ('vkl', 'vykl'):
            q = '%s=%s' % (a[0], '1' if a[1] == 'vkl' else '0')
        else:
            print('sinhron igra|ya|gosti vkl|vykl; sinhron gosti u_plitki|vnizu.')
            return 1
        try:
            d = json.loads(most('/titry/upr?' + q))
        except Exception:
            print('Приложение 2 не отвечает (или старое, без субтитров по голосам): открой бридж и «Начать захват».')
            return 1
        print(opisanie(d))
        return 0
    if a and a[0] not in ('status', 's'):
        print(__doc__.split('\n  sinhron  ')[0].strip().split('\n')[0])
        print('sinhron; sinhron igra|ya|gosti vkl|vykl; sinhron gosti u_plitki|vnizu; sinhron rpm N; '
              'sinhron platnyy|besplatnyy.')
        return 1
    try:
        d = json.loads(most('/titry/upr'))
        print(opisanie(d))
    except Exception:
        print('Приложение 2 не отвечает (или старое, без субтитров по голосам).')
    try:
        s = json.load(open(SOST))
        zhiv = time.time() * 1000 - s.get('ms', 0) < 15000
    except (OSError, ValueError):
        s, zhiv = {}, False
    if not zhiv:
        print('Демон sinhron не работает (его запускает plus; вручную: setsid nohup sinhron demon &).')
        return 0
    od = s.get('ostalos_den')
    print('Whisper: %s, до %g запросов в минуту, %s; на сегодня осталось: %s.' % (
        s.get('model'), s.get('rpm'),
        ('секунд звука в час — %g; копилка на минуту: %s из %d с (пополняется сама, это не остаток часа)'
         % (s['ash'], s.get('zvuk'), round(min(60.0, max(MIN_SEK, s['ash'] / 60.0))))) if s.get('ash') else 'секунды звука не считаю',
        od if od is not None else 'не знаю (ещё не спрашивала)'))
    print('Игра: не больше трети бюджета; шум без речи пропущено %d%s.' % (
        s.get('shum', 0), (', пауза ещё %d с' % s['igra_pauza']) if s.get('igra_pauza') else ''))
    print('Фраз пришло %d, распознано запросами %d, субтитров %d; музыка игры мимо %d, выдумки %d, тишина %d, '
          'устарели %d, склеено %d; перевод — %s.' % (
              s.get('fraz', 0), s.get('zaprosov', 0), s.get('subtitrov', 0), s.get('muzyka', 0), s.get('vydumki', 0),
              s.get('tishina', 0), s.get('starye', 0), s.get('skleeno', 0), s.get('perevod')))
    if s.get('chistovik'):
        print('Черновик → чистовик: чистовиков %d, пропущено (копилка полной модели) %d, поставили уши %d; '
              'у полной модели на сегодня: %s.' % (s.get('chistovikov', 0), s.get('chist_propusk', 0),
                                                   s.get('chist_zakrepleno', 0), s.get('ostalos_polnaya') or 'не знаю'))
    elif s.get('chistovik') is False:
        print('Черновик → чистовик: мост старше 2.6.8 — только черновики.')
    if s.get('staroe'):
        print('Приложение 2 старше 2.5.0 — фраз по голосам не отдаёт: субтитры начнутся с APK 2.5.0.')
    if s.get('pauza'):
        print('Пауза по лимиту Groq: ещё %d с.' % s['pauza'])
    if s.get('oshibka'):
        print('Последняя ошибка: ' + s['oshibka'])
    return 0


def opisanie(d):
    vkl = lambda x: 'да' if x else 'нет'
    return ('Субтитры по голосам: Александр — %s, игра — %s, гости — %s (%s); эфир — %s, демон — %s, в очереди %s.' % (
        vkl(d.get('ya')), vkl(d.get('igra')), vkl(d.get('gosti')),
        'у плитки' if d.get('gosti_gde') == 'u_plitki' else 'внизу', vkl(d.get('efir')), vkl(d.get('demon')),
        d.get('v_ocheredi', 0)))


