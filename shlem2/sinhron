def pismo(t):
    """'kir' — кириллица, 'lat' — латиница (чего больше), None — букв нет."""
    kir = len(re.findall(r'[а-яёіїєґ]', t, re.I))
    lat = len(re.findall(r'[a-z]', t, re.I))
    return None if not (kir or lat) else 'kir' if kir > lat else 'lat'


def slova(t):
    return re.findall(r'\w+', t.lower())


def podpis_zvuka(t):
    """Подпись звука, а не речь: «PHONE RINGS», «BOOM!», «[музыка]», «*смех*»."""
    t = t.strip()
    if re.fullmatch(r'[\[(*].*[\])*]\W*', t):
        return True
    bukvy = [c for c in t if c.isalpha()]
    return len(bukvy) >= 4 and sum(c.isupper() for c in bukvy) >= 0.8 * len(bukvy)


def ekho(t, podskazka):
    """Whisper на шуме повторяет подсказку: кусок — почти одни имена из неё или её длинный кусок."""
    s = slova(t)
    imen = sum(w in IMENA for w in s)
    if s and len(s) <= 6 and imen >= 2 and imen >= len(s) - 1:
        return True
    n = ' '.join(s)
    return len(n) >= 20 and n in ' '.join(slova(podskazka))


