#!/usr/bin/env python3
# treki — Плюс ищет Александру НОВЫЕ треки (29.10, Александр: «темп и жанр я делаю сам плейлистами, а чтобы Плюс мог
# найти мне новых треков — хорошая основа»). Только свободная музыка без Content ID для эфира: каталог Kevin MacLeod
# (incompetech.com, CC BY 4.0 — у каждого трека в каталоге есть жанр, настроение и темп), запасной — ccMixter
# (только CC BY, без NC; темп там неизвестен). Находки — в /root/muzyka и в плейлист «novye»: Александр слушает,
# лучшее переносит в свои плейлисты (`treki ostavit`), лишнее удаляет (`muzyka udalit`). Удалённое второй раз не придёт.
#
#   treki najti [что] [темп] [N]   — найти и скачать N новых (3 по умолчанию, до 10). «что» — жанр, настроение или
#                                    слова по-русски или по-английски: техно, рок, джаз, эмбиент, мрачный, бодрый,
#                                    эпичный, спокойный, погоня…; темп — «120-130», «темп 128», «быстрый», «медленный»
#   treki pokazat [что] [темп] [N] — то же, но только показать, ничего не качать
#   treki novye                    — что лежит в плейлисте novye
#   treki ostavit ТРЕК ПЛЕЙЛИСТ    — перенести трек из novye в свой плейлист
#   treki katalog                  — обновить каталог сейчас (сам — раз в неделю)
import json
import os
import random
import re
import sys
import time
import urllib.parse
import urllib.request

E = os.environ.get
DIR = E('MUZYKA_DIR', '/root/muzyka')
KATALOG = E('TREKI_KATALOG', '/root/.treki-katalog.json')
