def najti(slova, kachat):
    gruppy, temp, n, ist = razobrat_zapros(slova)
    vse = kandidaty(gruppy, temp, n, ist)
    zapros = ' '.join(slova)
    if not vse:
        print('Новых треков%s не нашла. Попробуй шире (жанр или настроение без темпа) или найди сама в интернете и '
              'скачай по ссылке: treki skachat ССЫЛКА.' % ((' под «%s»' % zapros) if zapros else ''))
        return 1
    if not kachat:
        sp = [t for t in vse if not temp or t['bpm']][:n] or vse[:n]
        print('Нашла (показываю %d): %s.%s' % (len(sp), '; '.join(opisat(t) for t in sp),
                                              ' Темп у остальных измерю при скачивании.' if temp else ''))
        return 0
    b = bylo()
    gotovo, oshibki, mimo = [], [], 0
    popytok = 0
    for t in vse:
        if len(gotovo) >= n or popytok >= n * 3:
            break
        popytok += 1
        try:
            f = skachat_pryamo(t['url'], t['imya'])
        except Exception as e:
            oshibki.append('%s: %s' % (t['imya'], str(e)[:50]))
            b.add(t['url'])
            continue
        b.add(t['url'])
        if not t['bpm'] and (temp or shutil.which('ffmpeg')):
            t['bpm'] = izmerit_temp(os.path.join(DIR, f))
        if temp and t['bpm'] and not (temp[0] <= t['bpm'] <= temp[1]):
            os.remove(os.path.join(DIR, f))                           # не тот темп — не нужен
            mimo += 1
            continue
        polozhit(f, t['avtor'], t['lic'])
        gotovo.append(opisat(t))
    bylo_zapisat(b)
    if not gotovo:
        print('Не скачалось ни одного%s%s.' % ((' (мимо темпа %d)' % mimo) if mimo else '',
                                              (': ' + '; '.join(oshibki)) if oshibki else ''))
        return 1
    print('Скачала %d новых в плейлист novye: %s.%s Послушать — muzyka pleylist novye vkl; понравился — treki ostavit '
          'ТРЕК ПЛЕЙЛИСТ; нет — muzyka udalit ТРЕК.' % (
              len(gotovo), '; '.join(gotovo), (' Не скачались: %s.' % '; '.join(oshibki)) if oshibki else ''))
    return 0


def lic_iz_metadannyh(m):
    lic = m.get('license') or ''
    opis = str(m.get('description') or '')[:4000].lower()
    if not lic:
        for s in ('creative commons attribution', 'cc by', 'cc-by', 'cc0', 'royalty free', 'royalty-free', 'streambeats',
                  'no copyright', 'free to use', 'copyright free'):
            if s in opis:
                lic = s + ' (из описания — проверь)'
                break
    return lic


def skachat(rest):
    if not rest:
        print('treki skachat ССЫЛКА [лицензия] — например: treki skachat https://… cc-by')
        return 1
    url, lic_ruchnaya = rest[0], ' '.join(rest[1:]).strip()
    if not re.match(r'^https?://', url):
        print('Нужна ссылка http(s)://…')
        return 1
    put = urllib.parse.urlparse(url).path.lower()
    if put.endswith(EXT):
        try:
            imya = urllib.parse.unquote(os.path.splitext(os.path.basename(urllib.parse.urlparse(url).path))[0]).replace('_', ' ')
            f = skachat_pryamo(url, imya)
        except Exception as e:
            print('Не скачалось: %s.' % str(e)[:100])
            return 1
        avtor, lic = '', lic_ruchnaya
    else:
        if not shutil.which(YTDLP):
            print('Для такой ссылки нужен yt-dlp, его нет. Поставь: pip install -U yt-dlp (или apt install yt-dlp), '
                  'потом повтори.')
            return 1
        os.makedirs(DIR, exist_ok=True)
        tmpd = tempfile.mkdtemp(prefix='treki-', dir=DIR)
        try:
            r = subprocess.run([YTDLP, '--no-playlist', '-x', '--audio-format', 'mp3', '--audio-quality', '0', '--no-progress',
                                '--write-info-json', '-o', os.path.join(tmpd, 'trek.%(ext)s'), url],
                               capture_output=True, text=True, timeout=900)
            mp3 = [x for x in os.listdir(tmpd) if x.lower().endswith(EXT)]
            if r.returncode != 0 or not mp3:
                print('yt-dlp не скачал: %s' % (r.stderr.strip().splitlines() or ['?'])[-1][:200])
                return 1
            try:
                m = json.load(open(os.path.join(tmpd, next(x for x in os.listdir(tmpd) if x.endswith('.info.json'))), encoding='utf-8'))
            except Exception:
                m = {}
            imya = m.get('track') or m.get('title') or 'trek'
            avtor = m.get('artist') or m.get('creator') or m.get('uploader') or ''
            lic = lic_ruchnaya or lic_iz_metadannyh(m)
            f = imya_fajla(imya, os.path.splitext(mp3[0])[1])
            os.replace(os.path.join(tmpd, mp3[0]), os.path.join(DIR, f))
        finally:
            shutil.rmtree(tmpd, ignore_errors=True)
    b = bylo()
    b.add(url)
    bylo_zapisat(b)
    bpm = izmerit_temp(os.path.join(DIR, f))
    pl = polozhit(f, avtor, lic)
    f = os.path.basename(f)
    t = '«%s»%s%s' % (os.path.splitext(f)[0], (' — %s' % avtor) if avtor else '', (', %d BPM' % bpm) if bpm else '')
    if pl == PLEYLIST:
        print('Скачала %s, лицензия %s — в плейлист novye, можно в эфир.' % (t, lic))
    else:
        print('Скачала %s, но лицензия %s — положила не в музыку эфира, а в %s: послушать можно, в ЭФИР НЕЛЬЗЯ '
              '(Twitch заглушит или заблокирует). Если знаешь, что трек свободный, — treki skachat ССЫЛКА cc-by.' % (
                  t, lic or 'неизвестна', LICHNOE_DIR))
    return 0


def temp_treka(rest):
    z = norm(' '.join(rest))
    try:
        vse = sorted(f for f in os.listdir(DIR) if f.lower().endswith(EXT))
    except OSError:
        vse = []
    n = [f for f in vse if norm(os.path.splitext(f)[0]) == z] or [f for f in vse if z and z in norm(os.path.splitext(f)[0])]
    if len(n) != 1:
        print(('Подходит несколько: %s. Уточни.' % ', '.join(os.path.splitext(f)[0] for f in n[:8])) if n else 'Не нашла трек.')
        return 1
    b = izmerit_temp(os.path.join(DIR, n[0]))
    print(('«%s» — около %d BPM.' % (os.path.splitext(n[0])[0], b)) if b else 'Темп не измерился.')
    return 0 if b else 1


def pokazat_pleylist(pl):
    if pl == LICHNOE:
        try:
            sp = sorted(f for f in os.listdir(LICHNOE_DIR) if f.lower().endswith(EXT))
        except OSError:
            sp = []
        print(('Не для эфира (%s) %d: %s.' % (LICHNOE_DIR, len(sp), ', '.join(os.path.splitext(f)[0] for f in sp))) if sp
              else 'Треков не для эфира нет.')
        return 0
    try:
        sp = [l.strip() for l in open(os.path.join(DIR, '.pleylist-%s.txt' % pl), encoding='utf-8') if l.strip()]
    except OSError:
        sp = []
    sp = [f for f in sp if os.path.exists(os.path.join(DIR, f))]
    print('В плейлисте %s %d: %s.' % (pl, len(sp), ', '.join(os.path.splitext(f)[0] for f in sp)) if sp else
          'Плейлист %s пуст.%s' % (pl, ' Найти — treki najti техно, treki najti спокойный 90-100…' if pl == PLEYLIST else ''))
    return 0


def ostavit(rest):
    if len(rest) < 2:
        print('treki ostavit ТРЕК ПЛЕЙЛИСТ — например: treki ostavit Volatile Reaction tekhno')
        return 1
    pl = rest[-1]
    z = norm(' '.join(rest[:-1]))
    for otkuda in (PLEYLIST, LICHNOE):
        try:
            sp = sorted(f for f in os.listdir(LICHNOE_DIR) if f.lower().endswith(EXT)) if otkuda == LICHNOE else \
                [l.strip() for l in open(os.path.join(DIR, '.pleylist-%s.txt' % otkuda), encoding='utf-8') if l.strip()]
        except OSError:
            sp = []
        n = [f for f in sp if z == norm(os.path.splitext(f)[0])] or [f for f in sp if z in norm(os.path.splitext(f)[0])]
        if len(n) > 1:
            print('Подходит несколько: %s. Уточни.' % ', '.join(os.path.splitext(f)[0] for f in n))
            return 1
        if n:
            if otkuda == LICHNOE:                                     # Александр сам решил — переносит в музыку эфира
                os.makedirs(DIR, exist_ok=True)
                shutil.move(os.path.join(LICHNOE_DIR, n[0]), os.path.join(DIR, n[0]))
            dlina = len(v_pleylist(pl, n[0]))
            if otkuda == PLEYLIST:
                v_pleylist(otkuda, n[0], ubrat=True)
            print('«%s» — в плейлисте %s (там %d).%s' % (os.path.splitext(n[0])[0], pl, dlina,
                  ' Внимание: лицензия не свободная — теперь он в музыке эфира, Twitch может заглушить.' if otkuda == LICHNOE else ''))
            return 0
    print('В novye и среди треков не для эфира нет «%s».' % ' '.join(rest[:-1]))
    return 1


def main(a):
    cmd = a[0].lower() if a else ''
    rest = a[1:]
    if cmd in ('najti', 'naiti', 'find', 'iskat'):
        return najti(rest, True)
    if cmd in ('pokazat', 'show', 'spisok'):
        return najti(rest, False)
    if cmd in ('skachat', 'download', 'url', 'ssylka'):
        return skachat(rest)
    if cmd in ('temp', 'bpm', 'tempo'):
        return temp_treka(rest)
    if cmd in ('novye', 'new', ''):
        return pokazat_pleylist(PLEYLIST)
    if cmd in ('lichnoe', 'lichnye'):
        return pokazat_pleylist(LICHNOE)
    if cmd in ('ostavit', 'keep', 'perenesti'):
        return ostavit(rest)
    if cmd in ('katalog', 'catalog'):
        t = katalog(svezhiy=True)
        print('В каталоге %d треков Kevin MacLeod.' % len(t) if t else 'Каталог не скачался.')
        return 0 if t else 1
    print('treki najti [что] [темп] [N] [iz openverse|archive|macleod|ccmixter] | pokazat … | skachat ССЫЛКА [лицензия] | '
          'temp ТРЕК | novye | lichnoe | ostavit ТРЕК ПЛЕЙЛИСТ | katalog')
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
