#!/usr/bin/env python3
"""itogi — итоги вечера (приложение 2.2.7): тёмный экран во весь кадр эфира — сколько шёл эфир,
налёт за эфир и всего, сколько раз звали Плюса, цель доната и до 6 строк лучших моментов.
Строки — по-английски, коротко (до 90 знаков): подписи в эфире только по-английски.
  itogi                        — что на экране итогов
  itogi pokazat | skryt        — показать / убрать (то же — кнопка «ИТОГИ ВЕЧЕРА» в приложении)
  itogi stroki "…" "…"         — лучшие моменты: каждая строка — в своих кавычках
  itogi sbros                  — убрать строки"""
import json
import os
import sys
import urllib.parse
import urllib.request

U = os.environ.get('ITOGI_URL', 'http://localhost:8766')


def zapros(q=None):
    put = '/itogi' if q is None else '/itogi/upr?' + urllib.parse.urlencode(q, quote_via=urllib.parse.quote)
    with urllib.request.urlopen(U + put, timeout=5) as r:
        return json.loads(r.read().decode('utf-8'))


def main(a):
    q = None
    if a and a[0] in ('pokazat', 'skryt'):
        q = {'pokaz': '1' if a[0] == 'pokazat' else '0'}
    elif a and a[0] == 'stroki' and len(a) > 1:
        q = {'stroki': '\n'.join(' '.join(x.split()) for x in a[1:] if x.strip())}
    elif a and a[0] == 'sbros':
        q = {'sbros': '1'}
    elif a and a[0] not in ('status', 's'):
        print(__doc__.split('\n', 3)[3])
        return 1
    try:
        d = zapros(q)
    except Exception:
        print('Приложение 2 не отвечает: открой Quest Claude Bridge 2 и «Начать захват».')
        return 1
    s = 'Итоги вечера: ' + ('на экране эфира' if d.get('vidny') else 'не показаны')
    s += '; звали Плюса за эфир: %s' % d.get('vyzovov', 0)
    st = d.get('stroki') or []
    s += ('; строк: %d — ' % len(st) + ' | '.join(st)) if st else '; строк от тебя нет (itogi stroki "…")'
    print(s + '.')
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
