#!/usr/bin/env python3
# ushi — уши Плюса в Ubuntu. Берёт услышанное
# quest-bridge (/ear) и вписывает фразу в Claude
# (tmux-сессия «plus»). Вызов и «тихо» глушат
# Аву без токенов. «Зум зум» — сам берёт кадр.
# «Компакт» — подготовка, «компакт плюс» — сжатие.
# Фразу точнее распознаёт Whisper (sluh), если
# он поставлен; иначе — текст Vosk из приложения.
# Запускает plus; лог — /tmp/ushi.log (время
# Whisper на фразу). Последние 10 фраз — в
# /tmp/frazy: sluh-test сравнит на них модели.
# Обновили ushi, sluh, /root/.sluh-model,
# .sluh-threads или .ushi-pauza — уши
# перезапускаются сами.
import glob
import json
import os
import re
import select
import subprocess
import sys
import threading
import time
import urllib.request

EAR = 'http://localhost:8765/ear'
FRAZY = '/tmp/frazy'
# «копи копи» в конце фразы (как «приём» в рации):
# приложение уже отправило фразу, слова Плюсу не нужны.
# Два слова подряд в конце срезаем всегда (в речи так не
# бывает), одно — только если приложение отметило stop.
KOPI = (r'(?:капи|копи|капі|копі|кэпи|капе|копе|капий'
        r'|копий|копия|copy|coppy|kopi|kapi|cappy|capi)')
KAPI = re.compile(r'(?:[\s,.!?…—-]*\b' + KOPI
                  + r'\b){1,2}[\s.!?…]*$', re.I)
KAPI2 = re.compile(r'(?:[\s,.!?…—-]*\b' + KOPI
                   + r'\b){2}[\s.!?…]*$', re.I)
PAUZA = '/root/.ushi-pauza'   # тишина конца фразы, с
ME = os.path.abspath(__file__)
TIHO = ('тихо', 'замолчи', 'стоп', 'хватит')
COMPACT = (
    '/compact Сохрани: что делаем сейчас, '
    'принятые решения, открытые задачи, '
    'договорённости о голосе, глазах и фразах, '
    'всё из /root/pamyat.md. Выкинь: описания '
    'старых кадров, вывод команд, повторы.')
ZOOM = {
    'x2': ('x2', 'зум зум — кадр вдвое крупнее'),
    'x4': ('x4', 'зум зум зум — кадр вчетверо крупнее'),
    'centr': ('centr', 'зум зум центр — центр вида'),
}


def get(url):
    with urllib.request.urlopen(url, timeout=3) as r:
        return json.loads(r.read().decode('utf-8'))


def say(text):
    subprocess.run(['skazhi', text])


def keys(*args):
    subprocess.run(['tmux', 'send-keys', '-t', 'plus']
                   + list(args))


def v_plus(text):
    """Вписать фразу в Claude и нажать Enter."""
    keys('-l', '(голосом) ' + text)
    keys('Enter')


class Sluh:
    """Whisper в своём процессе: модель грузится
    один раз (первый запуск — скачивание)."""
    PY = os.environ.get(
        'SLUH_PY', '/opt/sluh/bin/python')
    SCRIPT = os.environ.get(
        'SLUH_SCRIPT', '/usr/local/bin/sluh')

    def __init__(self):
        self.p, self.ready, self.via = None, False, ''
        if os.path.exists(self.PY) and \
                os.path.exists(self.SCRIPT):
            self.p = subprocess.Popen(
                [self.PY, self.SCRIPT],
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=open('/tmp/sluh.log', 'a'),
                text=True, bufsize=1)
            threading.Thread(target=self._ready,
                             daemon=True).start()

    def _ready(self):
        line = self.p.stdout.readline()
        self.ready = '"ready"' in line
        print(time.strftime('%H:%M:%S'), 'слух:',
              'готов' if self.ready else 'не запустился',
              flush=True)

    def hear(self, wav, timeout=25):
        if not wav or not self.ready or \
                self.p.poll() is not None:
            return None
        try:
            self.p.stdin.write(wav + '\n')
            self.p.stdin.flush()
            out = [self.p.stdout]
            if not select.select(out, [], [], timeout)[0]:
                return None
            d = json.loads(self.p.stdout.readline())
            self.via = d.get('via', '')
            return d.get('text', '').strip()
        except Exception:
            return None


def fetch(event_id):
    """Скачать WAV фразы, хранить последние 10."""
    os.makedirs(FRAZY, exist_ok=True)
    wav = '%s/%d.wav' % (FRAZY, event_id)
    url = '%s/wav?id=%d' % (EAR, event_id)
    try:
        with urllib.request.urlopen(url, timeout=5) as r:
            open(wav, 'wb').write(r.read())
    except Exception:
        return None
    old = sorted(glob.glob(FRAZY + '/*.wav'),
                 key=os.path.getmtime)[:-10]
    for f in old:
        os.remove(f)
    return wav


def pauza():
    """Пауза конца фразы из PAUZA — приложение
    (0.3.7+) забывает её при перезапуске."""
    try:
        p = float(open(PAUZA).read())
        print(time.strftime('%H:%M:%S'), 'пауза:',
              get('%s/set?pause=%s' % (EAR, p)),
              flush=True)
    except (OSError, ValueError):
        pass


def compact(kind):
    if kind == 'go':
        say('Сжимаю контекст.')
        keys('-l', COMPACT)
        keys('Enter')
    else:
        v_plus('компакт: подготовка')


def zoom(kind):
    arg, what = ZOOM.get(kind, ZOOM['x2'])
    r = subprocess.run(['kadr', arg],
                       capture_output=True, text=True)
    if r.returncode == 0:
        v_plus(what + ' уже в /root/view.jpg — '
               'открой и скажи, что там важно')
    else:
        say(r.stdout.strip() or 'Кадр не получился.')


def handle(e, sluh):
    kind = e['kind']
    t = e.get('text', '').strip()
    if kind == 'text' and e.get('audio'):
        t0 = time.time()
        w = sluh.hear(fetch(e['id']))
        print(time.strftime('%H:%M:%S'), 'vosk:', t,
              '| whisper %s %.1f с:'
              % (sluh.via, time.time() - t0),
              w, flush=True)
        if w:
            w = (KAPI if e.get('stop') else KAPI2).sub('', w)
        if w:
            t = w.strip(' .!?…').strip()
        elif not t:
            say('Не расслышала.')
    print(time.strftime('%H:%M:%S'), kind, t, flush=True)
    low = t.lower()
    if kind in ('wake', 'tiho') or low in TIHO:
        subprocess.run(['tiho'])
    elif kind == 'zoom':
        zoom(t)
    elif kind == 'compact':
        compact(t)
    elif kind == 'text' and low in ('компакт', 'compact'):
        compact('prep')   # пауза после «плюс плюс»
    elif kind == 'text' and low in ('компакт плюс',
                                    'compact plus'):
        compact('go')
    elif kind == 'text' and t:
        v_plus(t)


def plus_alive():
    """Claude Плюса работает (tmux «plus») — приложение
    тогда не запускает его заново, а только открывает
    Termux."""
    return subprocess.run(
        ['tmux', 'has-session', '-t', 'plus'],
        capture_output=True).returncode == 0


def stamp():
    out = []
    for f in (ME, Sluh.SCRIPT, '/root/.sluh-model',
              '/root/.sluh-threads', PAUZA):
        try:
            out.append(os.path.getmtime(f))
        except OSError:
            out.append(0)
    return out


def obnovleny(st):
    """Файлы ушей сменились и дописаны: True —
    пора перезапуститься. Битый ushi — не трогаем."""
    time.sleep(2)              # curl мог не дописать
    if stamp() != st:
        return False
    try:
        compile(open(ME).read(), ME, 'exec')
    except (OSError, SyntaxError) as x:
        print(time.strftime('%H:%M:%S'),
              'новый ushi с ошибкой:', x, flush=True)
        return False
    return True


def main():
    open('/tmp/ushi.pid', 'w').write(str(os.getpid()))
    sluh = Sluh()
    last = None
    st, n, alive = stamp(), 0, plus_alive()
    while True:
        n += 1
        if n % 8 == 0:                     # ~3 с
            alive = plus_alive()
        if n % 8 == 0 and stamp() != st:
            st = stamp()
            if obnovleny(st):
                print(time.strftime('%H:%M:%S'),
                      'обновлены — перезапуск', flush=True)
                if sluh.p:
                    sluh.p.terminate()
                os.execv(sys.executable,
                         [sys.executable, ME])
        try:
            if last is None:
                last = get(EAR)['id']   # старое не повторяем
                pauza()
            e = get('%s?after=%d%s' % (
                EAR, last, '&plus=1' if alive else ''))
            kind = e.get('kind', 'none')
            if kind == 'none' and e['id'] < last:
                last = e['id']   # мост перезапущен
            elif kind != 'none':
                last = e['id']
                handle(e, sluh)
                continue
        except Exception as x:   # мост выключен — ждём
            last = None if isinstance(x, OSError) else last
        time.sleep(0.4)


if __name__ == '__main__':
    main()
