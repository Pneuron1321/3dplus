#!/bin/sh
# retr — свой ретранслятор стрима в шлеме. Quest даёт захват экрана только одному
# приложению, поэтому во время стрима глаза Плюса берут кадры из трансляции:
#   BeamXR (RTMP: сервер rtmp://127.0.0.1:1935/live, ключ plus)
#     → приёмник (ffmpeg) → кадр раз в ключевой кадр в /tmp/strim.jpg (для kadr)
#                         → поток без перекодирования на udp 127.0.0.1:23000
#     → отправщик (ffmpeg) → Twitch, если есть /root/.twitch-key (кладёт `kluch twitch`).
# Отправщик отдельно: споткнётся Twitch — приём от BeamXR не рвётся.
# retr — запустить (если ещё не запущен); retr stop; retr status.
# Ключ Twitch — секрет: не печатать командные строки ffmpeg (ps, pgrep -a).
IN=${RETR_IN:-rtmp://127.0.0.1:1935/live/plus}
UDP=udp://127.0.0.1:${RETR_UDP:-23000}
JPG=${RETR_JPG:-/tmp/strim.jpg}
KEY=${RETR_KEY:-/root/.twitch-key}
TW=${RETR_TWITCH:-rtmp://live.twitch.tv/app}
PID=${RETR_PID:-/tmp/retr.pid}
LOG=${RETR_LOG:-/tmp/retr.log}

zhiv() { P=$(cat "$PID" 2> /dev/null) && [ -n "$P" ] && kill -0 $P 2> /dev/null; }

case "$1" in
  priem)
    while :; do
      ffmpeg -nostdin -loglevel error -skip_frame nokey -listen 1 -i "$IN" \
        -map 0 -c copy -f mpegts "$UDP?pkt_size=1316" \
        -map 0:v:0 -fps_mode passthrough -q:v 3 -update 1 -atomic_writing 1 -y "$JPG"
      sleep 1
    done ;;
  twitch)
    while :; do
      if [ -s "$KEY" ]; then
        ffmpeg -nostdin -loglevel error -probesize 2M -analyzeduration 2M \
          -i "$UDP?timeout=5000000&fifo_size=100000&overrun_nonfatal=1" \
          -c copy -f flv "$TW/$(cat "$KEY")" 2>&1 | sed "s#$TW/[^ ]*#$TW/***#g"
      fi
      sleep 1
    done ;;
  stop)
    zhiv && kill -- -$(cat "$PID") 2> /dev/null
    rm -f "$PID"; sleep 2; echo "Ретранслятор остановлен." ;;
  status)
    if zhiv; then
      a=-1; [ -f "$JPG" ] && a=$(( $(date +%s) - $(stat -c %Y "$JPG") ))
      if [ "$a" -ge 0 ] && [ "$a" -lt 6 ]; then echo "Ретранслятор: стрим идёт, кадр $a с назад."
      else echo "Ретранслятор ждёт BeamXR (rtmp://127.0.0.1:1935/live, ключ plus)."; fi
      [ -s "$KEY" ] && echo "На Twitch: ключ есть." || echo "На Twitch: ключа нет (kluch twitch) — только глаза Плюса."
    else echo "Ретранслятор не запущен (retr)."; fi ;;
  *)
    zhiv && { echo "Ретранслятор уже работает."; exit 0; }
    command -v ffmpeg > /dev/null || { echo "Нет ffmpeg: apt install -y ffmpeg"; exit 1; }
    setsid sh -c "echo \$\$ > '$PID'; '$0' priem & '$0' twitch & wait" >> "$LOG" 2>&1 < /dev/null &
    sleep 1; echo "Ретранслятор запущен: BeamXR → rtmp://127.0.0.1:1935/live, ключ plus." ;;
esac
