#!/bin/sh
# kadr — один взгляд Плюса: свежий кадр шлема в /root/view.jpg
#   kadr          — весь вид, 768 px (≈450 токенов)
#   kadr x2       — «зум зум»: вдвое больше точек, 1086 px (≈900 токенов)
#   kadr x4       — «зум зум зум»: вчетверо, 1536 px (≈1800 токенов)
#   kadr centr    — «зум зум центр»: центр вида в полном разрешении, 960×540 (≈700 токенов)
U=http://localhost:8765
OUT=${KADR_OUT:-/root/view.jpg}
# Стрим идёт через ретранслятор (retr) — кадр из стрима: захват экрана у BeamXR,
# наш захват его бы оборвал (Quest даёт захват одному приложению).
S=${KADR_STRIM:-/tmp/strim.jpg}
if [ -f "$S" ]; then
  sa=$(( $(date +%s) - $(stat -c %Y "$S") ))
  if [ "$sa" -lt 6 ]; then
    case "$1" in
      x2) VF='scale=1086:-2' ;;
      x4|krupno) VF='scale=1536:-2' ;;
      centr) VF='crop=iw/2:ih/2,scale=960:-2' ;;
      *) VF='scale=768:-2' ;;
    esac
    ffmpeg -nostdin -loglevel error -y -i "$S" -vf "$VF" -q:v 3 "$OUT" || { echo "Кадр из стрима не получился."; exit 1; }
    echo "Кадр из стрима: $OUT · возраст ~$sa с (то, что видят зрители)"
    exit 0
  fi
fi
case "$1" in
  x2) Q='?size=x2' ;;
  x4|krupno) Q='?size=big' ;;
  centr) Q='?zoom=2' ;;
  *) Q='' ;;
esac
s=$(curl -s --max-time 3 $U/status) || { echo "Глаза выключены: quest-bridge не отвечает. Открой Quest Claude Bridge и нажми «Начать захват»."; exit 1; }
case "$s" in *'"capturing":false'*) echo "Захват остановлен. В Quest Claude Bridge нажми «Начать захват»."; exit 1;; esac
case "$s" in *'"stale":true'*) echo "Захват застыл (системная видеозапись?). В Quest Claude Bridge: «Остановить» → «Начать захват» → «Разрешить»."; exit 2;; esac
age=$(echo "$s" | grep -o '"ageMs":-*[0-9]*' | cut -d: -f2)
if [ -z "$age" ] || [ "$age" -lt 0 ]; then echo "Кадров ещё нет — подожди пару секунд."; exit 1; fi
if [ "$age" -gt 5000 ]; then echo "Захват застыл: последний кадр $((age / 1000)) с назад (системная видеозапись?). В Quest Claude Bridge: «Остановить» → «Начать захват» → «Разрешить»."; exit 2; fi
curl -sf --max-time 5 -o "$OUT" "$U/frame.jpg$Q" || { echo "Кадр не скачался${Q:+ (крупный кадр — с quest-bridge 0.3)}."; exit 1; }
echo "Кадр: $OUT · возраст $age мс"
